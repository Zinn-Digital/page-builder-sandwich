{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/tabs",
	"title": "Tabs",
	"category": "pbs-content",
	"icon": "index-card",
	"description": "Content in tabs: visitors switch between panels by mouse or keyboard.",
	"keywords": [
		"tabs",
		"tabbed",
		"panels"
	],
	"textdomain": "page-builder-sandwich",
	"allowedBlocks": [
		"pbs/tab"
	],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"vertical": {
			"type": "boolean",
			"default": false
		},
		"selected": {
			"type": "integer",
			"default": 0
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-blocks-editor"
}
