{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/fixture",
	"title": "Sample content",
	"category": "text",
	"icon": "text",
	"description": "A heading and a paragraph, rendered with neutral class names. It is the reference block for the translation contract.",
	"keywords": [ "sample", "text" ],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"heading": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"body": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"tone": {
			"type": "string",
			"enum": [ "plain", "accent" ],
			"default": "plain"
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false,
		"inserter": false
	},
	"editorScript": "pbsw-editor"
}
