{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/widget",
	"title": "Widget",
	"category": "widgets",
	"icon": "welcome-widgets-menus",
	"description": "Shows one of the site's registered classic widgets.",
	"keywords": [
		"widget"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"widget": {
			"type": "string",
			"default": ""
		},
		"instance": {
			"type": "object",
			"default": {}
		},
		"fallbackHtml": {
			"type": "string",
			"source": "raw",
			"default": ""
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-core-editor"
}
