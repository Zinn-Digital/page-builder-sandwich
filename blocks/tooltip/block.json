{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/tooltip",
	"title": "Tooltip",
	"category": "pbs-content",
	"icon": "info-outline",
	"description": "A word or phrase that shows a short explanation on hover and keyboard focus.",
	"keywords": [
		"tooltip",
		"hint",
		"definition"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"text": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"tip": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"placement": {
			"type": "string",
			"enum": [
				"top",
				"bottom"
			],
			"default": "top"
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-blocks-editor"
}
