{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/reading-progress",
	"title": "Reading progress bar",
	"category": "pbs-site",
	"icon": "minus",
	"description": "A thin bar at the edge of the window that fills as visitors scroll through the page.",
	"keywords": [
		"progress",
		"reading",
		"scroll"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"position": {
			"type": "string",
			"enum": [
				"top",
				"bottom"
			],
			"default": "top"
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false,
		"multiple": false
	},
	"editorScript": "pbsw-blocks-editor"
}
