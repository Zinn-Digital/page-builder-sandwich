{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/whatsapp",
	"title": "WhatsApp chat button",
	"category": "pbs-marketing",
	"icon": "format-chat",
	"description": "A floating button in a corner of the page that opens a WhatsApp chat with you.",
	"keywords": [
		"whatsapp",
		"chat",
		"floating",
		"message"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"phone": {
			"type": "string",
			"default": ""
		},
		"message": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"showLabel": {
			"type": "boolean",
			"default": false
		},
		"position": {
			"type": "string",
			"enum": [
				"end",
				"start"
			],
			"default": "end"
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false,
		"multiple": false
	},
	"editorScript": "pbsw-blocks-editor"
}
