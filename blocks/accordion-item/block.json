{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/accordion-item",
	"title": "Accordion item",
	"category": "pbs-content",
	"icon": "arrow-down-alt2",
	"description": "One section of an accordion: a title that opens its content.",
	"parent": [
		"pbs/accordion"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"open": {
			"type": "boolean",
			"default": false
		},
		"level": {
			"type": "integer",
			"default": 0
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-blocks-editor"
}
