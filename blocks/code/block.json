{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/code",
	"title": "Code",
	"category": "pbs-data",
	"icon": "editor-code",
	"description": "A code listing with syntax highlighting, line numbers and a copy button. Stays readable if the plugin is ever turned off.",
	"keywords": [
		"code",
		"syntax",
		"highlight",
		"snippet",
		"programming"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"code": {
			"type": "string",
			"default": ""
		},
		"language": {
			"type": "string",
			"default": "auto"
		},
		"filename": {
			"type": "string",
			"default": ""
		},
		"lineNumbers": {
			"type": "boolean",
			"default": false
		},
		"copy": {
			"type": "boolean",
			"default": true
		},
		"wrap": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false,
		"interactivity": true
	},
	"editorScript": "pbsw-blocks-editor"
}
