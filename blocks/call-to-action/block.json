{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/call-to-action",
	"title": "Call to action",
	"category": "pbs-marketing",
	"icon": "megaphone",
	"description": "A heading, a sentence and one or two buttons that ask the visitor to act.",
	"keywords": [
		"cta",
		"button",
		"banner",
		"sign up"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"content": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"level": {
			"type": "integer",
			"default": 2
		},
		"primaryText": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"primaryUrl": {
			"type": "string",
			"default": ""
		},
		"primaryNewTab": {
			"type": "boolean",
			"default": false
		},
		"secondaryText": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"secondaryUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryNewTab": {
			"type": "boolean",
			"default": false
		},
		"layout": {
			"type": "string",
			"enum": [
				"stacked",
				"split"
			],
			"default": "stacked"
		},
		"align": {
			"type": "string",
			"enum": [
				"start",
				"center"
			],
			"default": "center"
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-blocks-editor"
}
