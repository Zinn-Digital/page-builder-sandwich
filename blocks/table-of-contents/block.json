{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/table-of-contents",
	"title": "Table of contents",
	"category": "pbs-site",
	"icon": "editor-ol",
	"description": "A list of the headings on the page, built automatically, that links to each one.",
	"keywords": [
		"toc",
		"contents",
		"headings",
		"index"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"minLevel": {
			"type": "integer",
			"default": 2
		},
		"maxLevel": {
			"type": "integer",
			"default": 3
		},
		"ordered": {
			"type": "boolean",
			"default": false
		},
		"collapsible": {
			"type": "boolean",
			"default": false
		},
		"collapsed": {
			"type": "boolean",
			"default": false
		},
		"spy": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-blocks-editor"
}
