{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/column",
	"title": "Column",
	"category": "design",
	"icon": "align-full-width",
	"description": "A column inside a row. It can hold any block.",
	"keywords": [
		"column",
		"layout"
	],
	"textdomain": "page-builder-sandwich",
	"parent": [
		"pbs/row"
	],
	"attributes": {
		"style": {
			"type": "string",
			"default": ""
		},
		"legacyClass": {
			"type": "string",
			"default": ""
		},
		"legacyData": {
			"type": "object"
		},
		"legacy": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-core-editor"
}
