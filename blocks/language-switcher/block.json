{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/language-switcher",
	"title": "Language switcher",
	"category": "design",
	"icon": "translation",
	"description": "Lets visitors read this page in another language, styled to match your page. Needs the Tranzly plugin for the languages.",
	"keywords": [ "language", "switcher", "translation", "multilingual" ],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"design": {
			"type": "string",
			"enum": [ "list", "pills", "buttons", "dropdown", "codes" ],
			"default": "pills"
		},
		"display": {
			"type": "string",
			"enum": [ "name", "code", "name_code" ],
			"default": "name"
		},
		"flags": {
			"type": "boolean",
			"default": false
		},
		"showCurrent": {
			"type": "boolean",
			"default": true
		},
		"hideMissing": {
			"type": "boolean",
			"default": false
		},
		"vertical": {
			"type": "boolean",
			"default": false
		},
		"label": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"vars": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-editor"
}
