{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/contact-buttons",
	"title": "Contact buttons",
	"category": "pbs-marketing",
	"icon": "phone",
	"description": "Buttons to call, email, text or message you on WhatsApp.",
	"keywords": [
		"contact",
		"call",
		"phone",
		"email",
		"whatsapp",
		"sms"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			},
			"role": "content"
		},
		"message": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-blocks-editor"
}
