{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/sidebar",
	"title": "Widget area",
	"category": "widgets",
	"icon": "welcome-widgets-menus",
	"description": "Shows the widgets in one of the theme's widget areas.",
	"keywords": [
		"sidebar",
		"widget area"
	],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"sidebar": {
			"type": "string",
			"default": ""
		},
		"fallbackHtml": {
			"type": "string",
			"source": "raw",
			"default": ""
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-core-editor"
}
