{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbs/shortcode",
	"title": "Shortcode (add-on)",
	"category": "widgets",
	"icon": "shortcode",
	"description": "A shortcode from an add-on written for the classic Page Builder Sandwich editor, with the settings the add-on declared.",
	"keywords": [ "shortcode", "add-on" ],
	"textdomain": "page-builder-sandwich",
	"attributes": {
		"tag": {
			"type": "string",
			"default": ""
		},
		"attrs": {
			"type": "object",
			"default": {}
		},
		"content": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"className": false,
		"customClassName": false,
		"html": false
	},
	"editorScript": "pbsw-dev-compat"
}
