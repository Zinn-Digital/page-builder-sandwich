            "": {
                "domain": "messages",
                "lang": "hi_IN",
                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0915\u0947\u0935\u0932 \u0935\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091c\u094b \u0905\u0928\u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0915\u093f\u090f \u0917\u090f HTML \u0915\u094b \u091c\u094b\u0921\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0915\u0938\u094d\u091f\u092e CSS \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0907\u0938 CSS \u0915\u093e \u0915\u0941\u091b \u0939\u093f\u0938\u094d\u0938\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e: \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f @import, expression(), javascript: URL, \"<\" \u0914\u0930 \u0905\u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u092c\u094d\u0930\u0947\u0938\u093f\u091c\u093c \u0939\u091f\u093e \u0926\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
            ],
            "Page CSS": [
                "\u092a\u0947\u091c \u0938\u0940\u090f\u0938\u090f\u0938"
            ],
            "Global classes": [
                "\u0917\u094d\u0932\u094b\u092c\u0932 \u0915\u094d\u0932\u093e\u0938\u0947\u091c"
            ],
            "Classes": [
                "\u0935\u0930\u094d\u0917"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0938\u093e\u0907\u091f \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u092e\u0947\u0902 \u0915\u094d\u0932\u093e\u0938 \u092c\u0928\u093e\u090f\u0901, \u092b\u093f\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u092f\u0939\u093e\u0901 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
            ],
            "Custom CSS": [
                "\u0915\u0938\u094d\u091f\u092e \u0938\u0940\u090f\u0938\u090f\u0938"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u0907\u0938 \u0924\u0924\u094d\u0935 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u092f\u092e \u0932\u093f\u0916\u0947\u0902\u0964 \"selector\" \u0915\u093e \u0905\u0930\u094d\u0925 \u092f\u0939 \u0924\u0924\u094d\u0935 \u0939\u0948, \u091c\u0948\u0938\u0947 selector:hover { opacity: .8 } \u2014 \u0938\u093e\u0926\u0940 \u0918\u094b\u0937\u0923\u093e\u090f\u0901 \u0938\u0940\u0927\u0947 \u0924\u0924\u094d\u0935 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964"
            ],
            "CSS for this page": [
                "\u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u0915\u0947 \u0932\u093f\u090f \u0938\u0940\u090f\u0938\u090f\u0938"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0915\u0947\u0935\u0932 \u0907\u0938\u0940 \u092a\u0947\u091c \u092a\u0930, \u0938\u093e\u0907\u091f \u0915\u0940 \u0938\u094d\u091f\u093e\u0907\u0932 \u0915\u0947 \u092c\u093e\u0926 \u0932\u094b\u0921 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092a\u0947\u091c \u0915\u0947 \u0938\u093e\u0925 \u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e\u0964"
            ]
        }
    }
}
