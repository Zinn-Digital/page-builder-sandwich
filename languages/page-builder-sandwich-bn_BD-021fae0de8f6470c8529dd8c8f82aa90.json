        "messages": {
            "": {
                "domain": "messages",
                "lang": "bn_BD",
                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09af\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be \u0986\u09a8\u09ab\u09bf\u09b2\u09cd\u099f\u09be\u09b0\u09a1 HTML \u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u09a4\u09be\u09b0\u09be\u0987 \u0995\u09be\u09b8\u09cd\u099f\u09ae CSS \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964"
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u098f\u0987 CSS-\u098f\u09b0 \u0995\u09bf\u099b\u09c1 \u0985\u0982\u09b6 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u09a8\u09be: \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be\u09b0 \u09b8\u09cd\u09ac\u09be\u09b0\u09cd\u09a5\u09c7 @import, expression(), javascript: URLs, \"<\" \u098f\u09ac\u0982 \u0985\u09b8\u09ae\u09be\u09aa\u09cd\u09a4 \u09ac\u09cd\u09b0\u09cd\u09af\u09be\u0995\u09c7\u099f\u0997\u09c1\u09b2\u09cb \u09b8\u09b0\u09bf\u09df\u09c7 \u09a6\u09c7\u0993\u09df\u09be \u09b9\u09df\u09c7\u099b\u09c7\u0964"
            ],
            "Page CSS": [
                "\u09aa\u09c7\u099c CSS"
            ],
            "Global classes": [
                "\u0997\u09cd\u09b2\u09cb\u09ac\u09be\u09b2 \u0995\u09cd\u09b2\u09be\u09b8"
            ],
            "Classes": [
                "\u0995\u09cd\u09b2\u09be\u09b8\u09b8\u09ae\u09c2\u09b9"
            ],
            "Create classes in Site design, then add them here.": [
                "\u09b8\u09be\u0987\u099f \u09a1\u09bf\u099c\u09be\u0987\u09a8\u09c7 \u0995\u09cd\u09b2\u09be\u09b8 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8, \u09a4\u09be\u09b0\u09aa\u09b0 \u098f\u0996\u09be\u09a8\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964"
            ],
            "Custom CSS": [
                "\u0995\u09be\u09b8\u09cd\u099f\u09ae \u09b8\u09bf\u098f\u09b8\u098f\u09b8"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u098f\u0987 \u0989\u09aa\u09be\u09a6\u09be\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09bf\u09af\u09bc\u09ae \u09b2\u09bf\u0996\u09c1\u09a8\u0964 \"selector\" \u09ae\u09be\u09a8\u09c7 \u098f\u0987 \u0989\u09aa\u09be\u09a6\u09be\u09a8, \u09af\u09c7\u09ae\u09a8 selector:hover { opacity: .8 } \u2014 \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u0998\u09cb\u09b7\u09a3\u09be\u0997\u09c1\u09b2\u09bf \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u0989\u09aa\u09be\u09a6\u09be\u09a8\u09c7\u09b0 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7 \u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af\u0964"
            ],
            "CSS for this page": [
                "\u098f\u0987 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09b0 \u099c\u09a8\u09cd\u09af CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u098f\u0987 \u09aa\u09c7\u099c\u09c7, \u09b8\u09be\u0987\u099f\u09c7\u09b0 \u09b8\u09cd\u099f\u09be\u0987\u09b2\u09c7\u09b0 \u09aa\u09b0\u09c7 \u09b2\u09cb\u09a1 \u09b9\u09df\u0964 \u09aa\u09c7\u099c\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09c7\u09ad \u0995\u09b0\u09be \u09b9\u09df\u0964"
            ]
        }
    }
}
