            "Mark this up as a How-To for search engines.": [
                "\u062f\u0627 \u062f \u0644\u067c\u0648\u0646 \u0627\u0646\u062c\u0646\u0648\u0646\u0648 \u0644\u067e\u0627\u0631\u0647 \u062f How-To \u067e\u0647 \u062a\u0648\u06ab\u0647 \u067e\u0647 \u0646\u069a\u0647 \u06a9\u0693\u0626."
            ],
            "Mark the plans up as a Product with offers for search engines.": [
                "\u062f \u0644\u067c\u0648\u0646 \u0627\u0646\u062c\u0646\u0648\u0646\u0648 \u0644\u067e\u0627\u0631\u0647 \u067e\u0644\u0627\u0646\u0648\u0646\u0647 \u062f \u0648\u0693\u0627\u0646\u062f\u06cc\u0632\u0648\u0646\u0648 \u0633\u0631\u0647 \u062f \u0645\u062d\u0635\u0648\u0644 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u067e\u0647 \u0646\u069a\u0647 \u06a9\u0693\u0626."
            ],
            "Mark this up as a Review for search engines.": [
                "\u062f\u0627 \u062f \u0644\u067c\u0648\u0646 \u0627\u0646\u062c\u0646\u0648\u0646\u0648 \u0644\u067e\u0627\u0631\u0647 \u062f \u06cc\u0648\u06d0 \u06a9\u062a\u0646\u06d0 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u067e\u0647 \u0646\u069a\u0647 \u06a9\u0693\u0626."
            ],
            "Structured data": [
                "\u062c\u0648\u0693\u069a\u062a \u0645\u0648\u0646\u062f\u0644\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a"
            ],
            "Add schema.org structured data": [
                "\u062f schema.org \u062c\u0648\u0693\u069a\u062a \u0644\u0631\u0648\u0646\u06a9\u064a \u0689\u0627\u067c\u0627 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626"
            ],
            "%s KB": [
                "%s KB"
            ],
            "Performance": [
                "\u06a9\u0693\u0646\u0647"
            ],
            "Measure again": [
                "\u0628\u06cc\u0627 \u0627\u0646\u062f\u0627\u0632\u0647 \u06a9\u0693\u0626"
            ],
            "Measure this page": [
                "\u062f\u0627 \u0645\u062e \u0627\u0646\u062f\u0627\u0632\u0647 \u06a9\u0693\u0626"
            ],
            "Page weight %1$s in %2$d requests": [
                "\u062f \u067e\u0627\u06bc\u06d0 \u0627\u0646\u062f\u0627\u0632\u0647 %1$s \u067e\u0647 %2$d \u063a\u0648\u069a\u062a\u0646\u0648 \u06a9\u06d0"
            ],
            "Layout shift %s (good: under 0.1)": [
                "\u062f \u062a\u0631\u062a\u06cc\u0628 \u0628\u062f\u0644\u0648\u0646 %s (\u069a\u0647: \u0644\u0647 0.1 \u0685\u062e\u0647 \u06a9\u0645)"
            ],
            "Largest content shown after %d ms on this computer": [
                "\u067e\u0647 \u062f\u06d0 \u06a9\u0645\u067e\u06cc\u0648\u067c\u0631 \u06a9\u06d0 \u062f %d \u0645\u0644\u06cc \u062b\u0627\u0646\u06cc\u06d0 \u0648\u0631\u0648\u0633\u062a\u0647 \u062a\u0631\u067c\u0648\u0644\u0648 \u0644\u0648\u06cc \u0645\u06cc\u0646\u0681\u067e\u0627\u0646\u06ab\u0647 \u0648\u069a\u0648\u062f\u0644 \u0634\u0648\u0647"
            ],
            "Images in the content: %1$s (%2$d)": [
                "\u067e\u0647 \u0645\u0646\u0681\u067e\u0627\u0646\u06ab\u0647 \u06a9\u06d0 \u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0647: %1$s (%2$d)"
            ],
            "The largest image is lazy-loaded, which delays it.": [
                "\u062a\u0631\u067c\u0648\u0644\u0648 \u0644\u0648\u06cc \u0627\u0646\u0681\u0648\u0631 \u067e\u0647 \u0681\u0646\u0689 \u0633\u0631\u0647 \u0628\u0627\u0631 \u0634\u0648\u06cc (lazy-loaded)\u060c \u0686\u06d0 \u062f\u0627 \u06cc\u06d0 \u0681\u0646\u0689\u0648\u064a."
            ],
            "%d image(s) have no width and height, which can make the page jump.": [
                "%d \u0627\u0646\u0681\u0648\u0631(\u0648\u0646\u0647) \u067e\u0644\u0646\u0648\u0627\u0644\u06cc \u0627\u0648 \u0644\u0648\u0693\u0648\u0627\u0644\u06cc \u0646\u0647 \u0644\u0631\u064a\u060c \u0686\u06d0 \u062f\u0627 \u06a9\u0648\u0644\u06cc \u0634\u064a \u067e\u0627\u06bc\u0647 \u0648\u063a\u0648\u0631\u0681\u0648\u064a."
            ],
            "An image is larger than it is shown (%1$s). A smaller size saves %2$s.": [
                "\u06cc\u0648 \u0627\u0646\u0681\u0648\u0631 \u062a\u0631 \u0647\u063a\u0647 \u0644\u0648\u06cc \u062f\u06cc \u0686\u06d0 \u069a\u0648\u062f\u0644 \u0634\u0648\u06cc (%1$s). \u06cc\u0648 \u06a9\u0648\u0686\u0646\u06cc \u0627\u0646\u062f\u0627\u0632\u0647 %2$s \u0633\u067e\u0645\u0648\u064a."
            ],
            "Use the smaller size": [
                "\u06a9\u0648\u0686\u0646\u06cd \u06a9\u0686\u0647 \u0648\u06a9\u0627\u0631\u0648\u0626"
            ],
            "%d fix(es) made; save the page, then measure again.": [
                "%d \u0633\u0645\u0648\u0646\u0648\u0646\u0647 \u062a\u0631\u0633\u0631\u0647 \u0634\u0648\u0644\u061b \u067e\u0627\u06bc\u0647 \u062e\u0648\u0646\u062f\u064a \u06a9\u0693\u0626\u060c \u0628\u06cc\u0627 \u06cc\u06d0 \u0628\u06cc\u0627 \u0627\u0646\u062f\u0627\u0632\u0647 \u06a9\u0693\u0626."
            ]
        }
    }
