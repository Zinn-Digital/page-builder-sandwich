            ],
            "Theme colours are back to the theme\u2019s own values.": [
                "\u09a5\u09bf\u09ae\u09c7\u09b0 \u09b0\u0999\u0997\u09c1\u09b2\u09cb \u09a5\u09bf\u09ae\u09c7\u09b0 \u09a8\u09bf\u099c\u09b8\u09cd\u09ac \u09ae\u09be\u09a8\u09c7 \u09ab\u09bf\u09b0\u09bf\u09af\u09bc\u09c7 \u0986\u09a8\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964"
