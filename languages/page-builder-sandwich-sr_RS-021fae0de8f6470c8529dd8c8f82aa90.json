                "plural-forms": "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0421\u0430\u043c\u043e \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u0446\u0438 \u043a\u043e\u0458\u0438 \u043c\u043e\u0433\u0443 \u0434\u043e\u0434\u0430\u0432\u0430\u0442\u0438 \u043d\u0435\u0444\u0438\u043b\u0442\u0440\u0438\u0440\u0430\u043d\u0438 HTML \u043c\u043e\u0433\u0443 \u043c\u0435\u045a\u0430\u0442\u0438 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0435\u043d\u0438 CSS."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0414\u0435\u043e \u043e\u0432\u043e\u0433 CSS-\u0430 \u043d\u0435\u045b\u0435 \u0431\u0438\u0442\u0438 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0459\u0435\u043d: @import, expression(), javascript: URL-\u043e\u0432\u0438, \u201e<\u201d \u0438 \u043d\u0435\u0443\u0440\u0430\u0432\u043d\u043e\u0442\u0435\u0436\u0435\u043d\u0435 \u0432\u0438\u0442\u0438\u0447\u0430\u0441\u0442\u0435 \u0437\u0430\u0433\u0440\u0430\u0434\u0435 \u0441\u0435 \u0443\u043a\u043b\u0430\u045a\u0430\u0458\u0443 \u0440\u0430\u0434\u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438."
            ],
            "Page CSS": [
                "CSS \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435"
            ],
            "Global classes": [
                "\u0413\u043b\u043e\u0431\u0430\u043b\u043d\u0435 \u043a\u043b\u0430\u0441\u0435"
            ],
            "Classes": [
                "\u041a\u043b\u0430\u0441\u0435"
            ],
            "Create classes in Site design, then add them here.": [
                "\u041d\u0430\u043f\u0440\u0430\u0432\u0438\u0442\u0435 \u043a\u043b\u0430\u0441\u0435 \u0443 \u0414\u0438\u0437\u0430\u0458\u043d\u0443 \u0432\u0435\u0431 \u043c\u0435\u0441\u0442\u0430, \u0430 \u0437\u0430\u0442\u0438\u043c \u0438\u0445 \u0434\u043e\u0434\u0430\u0458\u0442\u0435 \u043e\u0432\u0434\u0435."
            ],
            "Custom CSS": [
                "\u041f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0435\u043d\u0438 CSS"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0435\u043b\u0435\u043c\u0435\u043d\u0442. \u201eselector\u201c \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430 \u043e\u0432\u0430\u0458 \u0435\u043b\u0435\u043c\u0435\u043d\u0442, \u043d\u043f\u0440. selector:hover { opacity: .8 } \u2014 \u043e\u0431\u0438\u0447\u043d\u0435 \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u0458\u0435 \u0441\u0435 \u043f\u0440\u0438\u043c\u0435\u045a\u0443\u0458\u0443 \u043d\u0430 \u0441\u0430\u043c \u0435\u043b\u0435\u043c\u0435\u043d\u0442."
            ],
            "CSS for this page": [
                "CSS \u0437\u0430 \u043e\u0432\u0443 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0423\u0447\u0438\u0442\u0430\u0432\u0430 \u0441\u0435 \u0441\u0430\u043c\u043e \u043d\u0430 \u043e\u0432\u043e\u0458 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0438, \u043d\u0430\u043a\u043e\u043d \u0441\u0442\u0438\u043b\u043e\u0432\u0430 \u0432\u0435\u0431-\u043c\u0435\u0441\u0442\u0430. \u0421\u0430\u0447\u0443\u0432\u0430\u043d\u043e \u0441\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u043e\u043c."
            ]
        }
    }
