            ],
            "Turn a Figma frame into an editable page: auto layout becomes rows, columns and grids, text keeps its fonts and sizes, and images are copied into your media library. The site talks to Figma with your own Figma account; nothing goes through us.": [
                "\u054e\u0565\u0580\u0561\u056e\u0565\u0584 Figma \u0577\u0580\u057b\u0561\u0576\u0561\u056f\u0568 \u056d\u0574\u0562\u0561\u0563\u0580\u0565\u056c\u056b \u0567\u057b\u056b. \u0561\u057e\u057f\u0578\u0574\u0561\u057f \u0564\u0561\u057d\u0561\u057e\u0578\u0580\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568 \u0564\u0561\u057c\u0576\u0578\u0582\u0574 \u0567 \u057f\u0578\u0572\u0565\u0580, \u057d\u0575\u0578\u0582\u0576\u0561\u056f\u0576\u0565\u0580 \u0587 \u0581\u0561\u0576\u0581\u0565\u0580, \u057f\u0565\u0584\u057d\u057f\u0568 \u057a\u0561\u0570\u057a\u0561\u0576\u0578\u0582\u0574 \u0567 \u056b\u0580 \u057f\u0561\u057c\u0561\u057f\u0565\u057d\u0561\u056f\u0576\u0565\u0580\u0576 \u0578\u0582 \u0579\u0561\u0583\u0565\u0580\u0568, \u056b\u057d\u056f \u057a\u0561\u057f\u056f\u0565\u0580\u0576\u0565\u0580\u0568 \u057a\u0561\u057f\u0573\u0565\u0576\u057e\u0578\u0582\u0574 \u0565\u0576 \u0571\u0565\u0580 \u0574\u0565\u0564\u056b\u0561 \u0563\u0580\u0561\u0564\u0561\u0580\u0561\u0576\u0578\u0582\u0574: \u053f\u0561\u0575\u0584\u0568 \u0570\u0561\u0572\u0578\u0580\u0564\u0561\u056f\u0581\u057e\u0578\u0582\u0574 \u0567 Figma-\u056b \u0570\u0565\u057f \u0571\u0565\u0580 \u057d\u0565\u0583\u0561\u056f\u0561\u0576 Figma \u0570\u0561\u0577\u057e\u056b \u0574\u056b\u057b\u0578\u0581\u0578\u057e. \u0578\u0579\u056b\u0576\u0579 \u0574\u0565\u0580 \u0574\u056b\u057b\u0578\u057e \u0579\u056b \u0561\u0576\u0581\u0576\u0578\u0582\u0574:"
