        "messages": {
            "": {
                "domain": "messages",
                "lang": "am",
                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Conversion tracking": [
                "\u12e8\u120d\u12c8\u1323 \u12ad\u1275\u1275\u120d"
            ],
            "API key": [
                "\u12e8-API \u1241\u120d\u134d"
            ],
            "Marketing": [
                "\u130d\u1265\u12ed\u1275"
            ],
            "Disconnect": [
                "\u12a0\u124b\u122d\u1325"
            ],
            "Cookie banner": [
                "\u12e8\u12a9\u12aa \u1263\u1290\u122d"
            ],
            "Form submissions": [
                "\u12e8\u1245\u133d \u121b\u1235\u1308\u1262\u12eb\u12ce\u127d"
            ],
            "Save": [
                "\u12a0\u1235\u1240\u121d\u1325"
            ],
            "Saved.": [
                "\u1270\u1240\u121d\u1327\u120d\u1362"
            ],
            "Connected (key %s).": [
                "\u1270\u1308\u1293\u129d\u1277\u120d (\u1241\u120d\u134d %s)\u1362"
            ],
            "API URL": [
                "\u12e8-API \u12e9\u12a0\u122d\u12a4\u120d"
            ],
            "Replace the API key": [
                "\u12e8-API \u1241\u120d\u1349\u1295 \u12ed\u1270\u12a9"
            ],
            "Where to find your %s API key": [
                "\u12e8\u12a5\u122d\u1235\u12ce\u1295 \u12e8%s API \u1241\u120d\u134d \u12e8\u1275 \u121b\u130d\u1298\u1275 \u12a5\u1295\u12f0\u121a\u127d\u1209"
            ],
            "Check and save": [
                "\u12ed\u1348\u1275\u1239 \u12a5\u1293 \u12eb\u1235\u1240\u121d\u1321"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u12a0\u1295\u12f5 \u130a\u12dc \u12e8\u12f0\u1265\u12f3\u1264 \u12dd\u122d\u12dd\u122d \u12a0\u1308\u120d\u130d\u120e\u1275\u1295 \u12eb\u1308\u1293\u1299\u1364 \u12a8\u12da\u12eb \u121b\u1295\u129b\u12cd\u121d \u1245\u133d \u12e8\u121a\u121e\u1209\u1275\u1295 \u1230\u12ce\u127d \u12c8\u12f0 \u12a0\u1295\u12f1 \u12dd\u122d\u12dd\u122d\u12ce \u121b\u12a8\u120d \u12ed\u127d\u120b\u120d (\u12e8\u1245\u133d \u12a5\u1308\u12f3 \u1245\u1295\u1265\u122e\u127d \u2192 \u12a8\u120b\u12a9 \u1260\u128b\u120b)\u1362 \u1241\u120d\u134e\u127d \u12a8\u12a0\u1308\u120d\u130d\u120e\u1271 \u130b\u122d \u12ed\u1228\u130b\u1308\u1323\u1209\u1363 \u1260\u12da\u1205 \u1323\u1262\u12eb \u120b\u12ed \u1270\u1218\u1235\u1325\u1228\u12cd \u12ed\u1240\u1218\u1323\u1209 \u12a5\u1295\u12f2\u1201\u121d \u12f3\u130d\u1218\u129b \u12a0\u12ed\u1273\u12e9\u121d\u1362"
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u12eb\u1208 \u121d\u1295\u121d \u12ae\u12f5 \u12e8\u1245\u133d \u121b\u1235\u1228\u12a8\u1262\u12eb\u12ce\u127d\u1295 \u12a5\u1293 \u12e8\u12a0\u12dd\u122b\u122d \u1320\u1245\u1273\u12ce\u127d\u1295 \u12c8\u12f0 \u12a5\u122d\u1235\u12ce \u1275\u1295\u1273\u1294\u12ce\u127d \u12ed\u120b\u12a9\u1362 \u12eb\u1295\u1295 \u12a0\u1308\u120d\u130d\u120e\u1275 \u1208\u1218\u12dd\u1208\u120d \u1218\u1273\u12c8\u1242\u12eb\u12cd\u1295 \u1263\u12f6 \u12ed\u1270\u12c9\u1275\u1362 \u12a0\u12dd\u122b\u122e\u127d \u1260\u120b\u1241 \u1353\u1290\u120b\u1278\u12cd \u12cd\u1235\u1325 \u12e8\"\u120d\u12c8\u1323 \u12ad\u1235\u1270\u1275\" \u1218\u1235\u12ad \u12eb\u1308\u129b\u1209\u1362 \u12e8\u12a9\u12aa \u1263\u1290\u122d \u1232\u1260\u122b\u1363 \u130e\u1265\u129a\u12cd \u12a5\u1235\u12aa\u1235\u121b\u121b \u12f5\u1228\u1235 \u121d\u1295\u121d \u1290\u1308\u122d \u12a0\u12ed\u132b\u1295\u121d\u1362"
            ],
            "Google Analytics 4 measurement ID": [
                "\u12e8Google Analytics 4 \u12e8\u1218\u1208\u12aa\u12eb \u1218\u1273\u12c8\u1242\u12eb"
            ],
            "Google Tag Manager container ID": [
                "\u12e8 Google Tag Manager \u12d5\u1243 \u1218\u12eb\u12e3 \u1218\u1208\u12eb"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "\u12e8Meta Pixel \u1218\u1273\u12c8\u1242\u12eb (\u1260Meta \u12ad\u1235\u1270\u1276\u127d \u12a0\u1235\u1270\u12f3\u12f3\u122a \u12cd\u1235\u1325 \u12e8\u121a\u1273\u12e8\u12cd \u1241\u1325\u122d)"
            ],
            "Load these tags on my site": [
                "\u12a5\u1290\u12da\u1205\u1295 \u1218\u1208\u12eb\u12ce\u127d \u1260\u1323\u1262\u12eb\u12ec \u120b\u12ed \u132b\u1295"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u132d\u1265\u1325\u12ce \u12c8\u12ed\u121d \u120c\u120b \u1270\u1230\u12aa \u12a0\u1235\u1240\u12f5\u121e \u12ab\u12a8\u120b\u1278\u12cd \u12eb\u1325\u1349\u1364 \u12ad\u1235\u1270\u1276\u127d \u12a0\u1201\u1295\u121d \u12ed\u120b\u12ab\u1209\u1362"
            ],
            "Event name for form submissions": [
                "\u12e8\u1245\u133d \u121b\u1235\u1228\u12a8\u1262\u12eb\u12ce\u127d \u12e8\u12ad\u1235\u1270\u1275 \u1235\u121d"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u1263\u1290\u1229 \u1260\u1265\u120e\u12ae\u127d \u12e8\u121a\u1290\u12f5\u1349\u1275 \u1265\u1245-\u1263\u12ed \u1290\u12cd\u1362 \u12a0\u12dd\u122b\u122e\u1279 \u12a8#consent-accept\u1363 #consent-reject \u12a5\u1293 #consent-save \u130b\u122d \u12ed\u1308\u1293\u129b\u1209 (\u1208\"save\" analytics \u12a5\u1293 marketing \u12e8\u1270\u1230\u1299 \u12a0\u1218\u120d\u12ab\u127d \u1233\u1325\u1296\u127d \u12eb\u1209\u1275)\u1364 \u12c8\u12f0 #consent-open \u12e8\u121a\u12c8\u1235\u12f5 \u12a0\u1308\u1293\u129d \u1260\u121b\u1293\u1278\u12cd\u121d \u1266\u1273 \u12a5\u1295\u12f0\u1308\u1293 \u12eb\u1233\u12e8\u12cb\u120d\u1362 \u130e\u1265\u129a \u12a5\u1235\u12aa\u1240\u1260\u120d \u12f5\u1228\u1235 \u12e8\u1218\u12a8\u1273\u1270\u12eb \u1218\u1208\u12eb\u12ce\u127d \u12a0\u12ed\u132b\u1291\u121d\u1363 Google Consent Mode \"denied\" \u12a5\u1295\u12f0\u1206\u1290 \u12ed\u1246\u12eb\u120d\u1363 \u12a5\u1293 \u12a5\u122d\u1235\u12ce \u12e8\u12d8\u1228\u12d8\u122f\u1278\u12cd \u1235\u12ad\u122a\u1355\u1276\u127d \u12a5\u1295\u12f0\u1320\u1349 \u12ed\u1246\u12eb\u1209\u1362"
            ],
            "Create a ready-made banner": [
                "\u12dd\u130d\u1301 \u12e8\u1206\u1290 \u1230\u1295\u12f0\u1245 \u12d3\u120b\u121b \u12ed\u134d\u1320\u1229"
            ],
            "Show a cookie banner": [
                "\u12e8\u12a9\u12aa \u1263\u1290\u122d \u12a0\u1233\u12ed"
            ],
            "Banner": [
                "\u1263\u1290\u122d"
            ],
            "Choose a popup\u2026": [
                "\u1265\u1245-\u1263\u12ed \u12ed\u121d\u1228\u1321\u2026"
            ],
            "%s (draft)": [
                "%s (\u1228\u1242\u1245)"
            ],
            "Edit the banner": [
                "\u1263\u1290\u1229\u1295 \u12eb\u122d\u1275\u12d1"
            ],
            "Remember the choice for (days)": [
                "\u121d\u122d\u132b\u12cd\u1295 \u1208(\u1240\u1293\u1275) \u12a0\u1235\u1273\u12cd\u1235"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u12a8\u12a0\u12cd\u122e\u1353 \u1205\u1265\u1228\u1275\u1363 \u12a8\u12a0\u12cd\u122e\u1353 \u12a2\u12ae\u1296\u121a \u12ad\u120d\u120d \u12a5\u1293 \u12a8\u12a5\u1295\u130d\u120a\u12dd \u12cd\u132d\u1366 \u130e\u1265\u129a\u12cd \u12a5\u121d\u1262 \u12a5\u1235\u12aa\u120d \u12f5\u1228\u1235 \u12ad\u1275\u1275\u120d\u1295 \u12ed\u132b\u1291"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u1320\u134d\u1277\u120d\u1366 \u12a5\u12eb\u1295\u12f3\u1295\u12f1 \u130e\u1265\u129a \u1218\u1300\u1218\u122a\u12eb \u1218\u1235\u121b\u121b\u1275 \u12a0\u1208\u1260\u1275 (\u1260\u1323\u121d \u1325\u1265\u1241 \u12f0\u1295\u1265 \u12a5\u1293 \u1290\u1263\u122a\u12cd)\u1362 \u1260\u122d\u1277\u120d\u1366 \u12a0\u1235\u1270\u1293\u130b\u1305\u12ce \u12c8\u12ed\u121d CDN \u12e8\u130e\u1265\u129a\u12cd\u1295 \u12a0\u1308\u122d \u1232\u12eb\u1233\u12cd\u1245 \u1265\u127b (\u1208\u121d\u1233\u120c \u12e8 Cloudflare CF-IPCountry \u122b\u1235\u130c) \u12a5\u1293 \u12a8 EU\u1363 EEA\u1363 UK \u12a5\u1293 \u1235\u12ca\u12d8\u122d\u120b\u1295\u12f5 \u12cd\u132d \u1232\u1206\u1295\u1362 \u1263\u1290\u1229 \u12a0\u1201\u1295\u121d \u12ed\u1273\u12eb\u120d\u1363 \u12a5\u1293 \u12e8\u121b\u12ed\u1273\u12c8\u1245 \u12a0\u1308\u122d \u12a5\u1295\u12f0 EU \u12cd\u1235\u1325 \u12ed\u1246\u1320\u122b\u120d\u1362"
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u1235\u121d\u121d\u1290\u1275 \u12a5\u1235\u12aa\u1308\u129d \u12f5\u1228\u1235 \u12e8\u121a\u1246\u12e9 \u120c\u120e\u127d \u1235\u12ad\u122a\u1355\u1276\u127d (handle:analytics \u12c8\u12ed\u121d handle:marketing\u1363 \u1260\u1290\u1320\u120b \u1230\u1228\u12dd \u12e8\u1270\u1208\u12e9)"
            ],
            "Popups, slide-ins and bars": [
                "\u1265\u1245-\u1263\u12ee\u127d\u1363 \u1270\u1295\u1238\u122b\u1273\u127e\u127d \u12a5\u1293 \u12a0\u121e\u120c\u12ce\u127d"
            ],
            "A\/B test results": [
                "\u12e8A\/B \u1219\u12a8\u122b \u12cd\u1324\u1276\u127d"
            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u1218\u1218\u122a\u12eb\u12ce\u127d\u1366 \u1245\u133e\u127d\u1363 \u1265\u1245-\u1263\u12ee\u127d\u1363 \u12a5\u1295\u1245\u1235\u1243\u1234\u1363 \u12ad\u1275\u1275\u120d\u1363 \u12e8A\/B \u1219\u12a8\u122b\u12ce\u127d \u12a5\u1293 \u12e8\u12a9\u12aa \u1263\u1290\u122d"
            ],
            "Mailing-list connections": [
                "\u12e8\u1218\u120d\u12a5\u12ad\u1275 \u12dd\u122d\u12dd\u122d \u130d\u1295\u1299\u1290\u1276\u127d"
            ]
        }
    }
}
