            "Delete it": [
                "\u0627\u062d\u0630\u0641\u0647"
            ],
            "In your Cloudflare dashboard, open R2 Object Storage and create a bucket (for example \u201cmy-pbs-library\u201d). Keep it private: do not connect a public domain.": [
                "\u0641\u064a \u0644\u0648\u062d\u0629 \u062a\u062d\u0643\u0645 Cloudflare \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643\u060c \u0627\u0641\u062a\u062d R2 Object Storage \u0648\u0623\u0646\u0634\u0626 \u062d\u0627\u0648\u064a\u0629 (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \"my-pbs-library\"). \u0627\u062c\u0639\u0644\u0647\u0627 \u062e\u0627\u0635\u0629: \u0644\u0627 \u062a\u0642\u0645 \u0628\u062a\u0648\u0635\u064a\u0644 \u0646\u0637\u0627\u0642 \u0639\u0627\u0645."
            ],
            "Open \u201cManage API tokens\u201d in R2 and create an API token with \u201cObject Read & Write\u201d permission, limited to that one bucket.": [
                "\u0627\u0641\u062a\u062d \"\u0625\u062f\u0627\u0631\u0629 \u0631\u0645\u0648\u0632 \u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a\" (Manage API tokens) \u0641\u064a R2 \u0648\u0623\u0646\u0634\u0626 \u0631\u0645\u0632 \u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0628\u0645\u0646\u062d\u0646\u0649 \"\u0642\u0631\u0627\u0621\u0629 \u0648\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0643\u0627\u0626\u0646\u0627\u062a\" (Object Read & Write)\u060c \u0645\u0642\u0635\u0648\u0631\u0627\u064b \u0639\u0644\u0649 \u062a\u0644\u0643 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u0648\u062d\u062f\u0647\u0627."
            ],
            "Copy the Access Key ID and the Secret Access Key it shows (the secret is shown only once).": [
                "\u0627\u0646\u0633\u062e \u0645\u0639\u0631\u0641 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0633\u0631\u064a \u0627\u0644\u0630\u064a \u064a\u0638\u0647\u0631 (\u064a\u062a\u0645 \u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0633\u0631\u064a \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u0642\u0637)."
            ],
            "Copy the S3 endpoint for your account. It looks like https:\/\/<account-id>.r2.cloudflarestorage.com. Region is \u201cauto\u201d.": [
                "\u0627\u0646\u0633\u062e \u0646\u0642\u0637\u0629 \u0646\u0647\u0627\u064a\u0629 S3 \u0644\u062d\u0633\u0627\u0628\u0643. \u0648\u0647\u064a \u062a\u0628\u062f\u0648 \u0645\u062b\u0644 https:\/\/<account-id>.r2.cloudflarestorage.com. \u0648\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0647\u064a \"auto\"."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d. Switch the library to your storage only when the test passes.": [
                "\u0627\u0644\u0635\u0642 \u0627\u0644\u0642\u064a\u0645 \u0623\u062f\u0646\u0627\u0647\u060c \u062b\u0645 \u0627\u062d\u0641\u0638\u060c \u062b\u0645 \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \"\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644\". \u0642\u0645 \u0628\u0627\u0644\u062a\u0628\u062f\u064a\u0644 \u0625\u0644\u0649 \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u064a\u0646\u062c\u062d \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631."
            ],
            "Create a private bucket with your provider (Amazon S3, Backblaze B2, Wasabi, MinIO or any S3-compatible service).": [
                "\u0623\u0646\u0634\u0626 \u062d\u0627\u0648\u064a\u0629 \u062e\u0627\u0635\u0629 \u0644\u062f\u0649 \u0645\u0632\u0648\u062f \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 (Amazon S3 \u0623\u0648 Backblaze B2 \u0623\u0648 Wasabi \u0623\u0648 MinIO \u0623\u0648 \u0623\u064a \u062e\u062f\u0645\u0629 \u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 S3)."
            ],
            "Create an access key that can read, write and delete objects in that bucket only.": [
                "\u0623\u0646\u0634\u0626 \u0645\u0641\u062a\u0627\u062d \u0648\u0635\u0648\u0644 \u064a\u0645\u0643\u0646\u0647 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0643\u0627\u0626\u0646\u0627\u062a \u0648\u0643\u062a\u0627\u0628\u062a\u0647\u0627 \u0648\u062d\u0630\u0641\u0647\u0627 \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u062d\u0627\u0648\u064a\u0629 \u0641\u0642\u0637."
            ],
            "Find the S3 endpoint (for Amazon S3: https:\/\/s3.<region>.amazonaws.com) and the bucket\u2019s region.": [
                "\u0627\u0628\u062d\u062b \u0639\u0646 \u0646\u0642\u0637\u0629 \u0646\u0647\u0627\u064a\u0629 S3 (\u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0640 Amazon S3: https:\/\/s3.<region>.amazonaws.com) \u0648\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u062f\u0644\u0648."
            ],
            "Amazon S3 uses virtual-hosted addresses: switch off \u201cPath-style addresses\u201d. Most other services use path-style.": [
                "\u062a\u0633\u062a\u062e\u062f\u0645 Amazon S3 \u0639\u0646\u0627\u0648\u064a\u0646 \u062a\u0633\u062a\u0636\u064a\u0641\u0647\u0627 \u062e\u0648\u0627\u062f\u0645 \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629: \u0623\u0648\u0642\u0641 \u062a\u0634\u063a\u064a\u0644 \"\u0639\u0646\u0627\u0648\u064a\u0646 \u0628\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0645\u0633\u0627\u0631\". \u062a\u0633\u062a\u062e\u062f\u0645 \u0645\u0639\u0638\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0645\u0633\u0627\u0631."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d.": [
                "\u0627\u0644\u0635\u0642 \u0627\u0644\u0642\u064a\u0645 \u0623\u062f\u0646\u0627\u0647\u060c \u062b\u0645 \u0627\u062d\u0641\u0638\u060c \u0648\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \"\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644\"."
            ],
            "Storage settings saved.": [
                "\u062a\u0645 \u062d\u0641\u0638 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u062e\u0632\u064a\u0646."
            ],
            "Your cloud library is kept in Zinn Digital\u00ae storage with the space your plan includes. You can keep it in your own Cloudflare R2 or S3-compatible bucket instead: then no Zinn Digital\u00ae quota applies, and every site you connect to the same bucket shares the library. Team libraries always use Zinn Digital\u00ae storage.": [
                "\u064a\u062a\u0645 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0645\u0643\u062a\u0628\u062a\u0643 \u0627\u0644\u0633\u062d\u0627\u0628\u064a\u0629 \u0641\u064a \u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0640 Zinn Digital\u00ae \u0627\u0644\u0645\u0636\u0645\u0646\u0629 \u0641\u064a \u0628\u0627\u0642\u062a\u0643. \u064a\u0645\u0643\u0646\u0643 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0630\u0644\u0643 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0647\u0627 \u0641\u064a \u062d\u0648\u0636 Cloudflare R2 \u0623\u0648 \u0627\u0644\u062d\u0648\u0636 \u0627\u0644\u0645\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 S3 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643: \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062d\u0627\u0644\u0629 \u0644\u0627 \u064a\u064f\u0637\u0628\u0642 \u062d\u062f Zinn Digital\u00ae\u060c \u0648\u0643\u0644 \u0645\u0648\u0642\u0639 \u062a\u0631\u0628\u0637\u0647 \u0628\u0646\u0641\u0633 \u0627\u0644\u062d\u0648\u0636 \u064a\u062a\u0634\u0627\u0631\u0643 \u0627\u0644\u0645\u0643\u062a\u0628\u0629. \u062a\u0633\u062a\u062e\u062f\u0645 \u0645\u0643\u062a\u0628\u0627\u062a \u0627\u0644\u0641\u0631\u064a\u0642 \u062f\u0627\u0626\u0645\u0627\u064b \u0645\u0633\u0627\u062d\u0629 \u062a\u062e\u0632\u064a\u0646 Zinn Digital\u00ae."
            ],
            "Connect your own storage: step by step": [
                "\u0627\u0631\u0628\u0637 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643: \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629"
            ],
            "Another S3-compatible service": [
                "\u062e\u062f\u0645\u0629 \u0623\u062e\u0631\u0649 \u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 S3"
            ],
            "Read the full guide": [
                "\u0627\u0642\u0631\u0623 \u0627\u0644\u062f\u0644\u064a\u0644 \u0627\u0644\u0643\u0627\u0645\u0644"
            ],
            "S3 endpoint": [
                "\u0646\u0642\u0637\u0629 \u0646\u0647\u0627\u064a\u0629 S3"
            ],
            "Bucket": [
                "\u0645\u062c\u0644\u062f"
            ],
            "Region": [
                "\u0627\u0644\u0645\u0646\u0637\u0642\u0629"
            ],
            "Cloudflare R2: auto.": [
                "Cloudflare R2: \u062a\u0644\u0642\u0627\u0626\u064a"
            ],
            "Access key ID": [
