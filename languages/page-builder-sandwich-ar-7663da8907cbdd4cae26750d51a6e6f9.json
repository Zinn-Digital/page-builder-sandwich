            ],
            "Deleted from your library.": [
                "\u062a\u0645 \u0627\u0644\u062d\u0630\u0641 \u0645\u0646 \u0645\u0643\u062a\u0628\u062a\u0643."
            ],
            "Save any section or page from the editor: open the block\u2019s \u22ee menu and choose \u201cSave to cloud library\u201d. Insert saved designs from the Cloud library panel in the editor, on any of your sites.": [
                "\u0627\u062d\u0641\u0638 \u0623\u064a \u0642\u0633\u0645 \u0623\u0648 \u0635\u0641\u062d\u0629 \u0645\u0646 \u0645\u062d\u0631\u0631 \u0627\u0644\u0646\u0635\u0648\u0635: \u0627\u0641\u062a\u062d \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0643\u062a\u0644\u0629 \u22ee \u0648\u0627\u062e\u062a\u0631 \"\u062d\u0641\u0638 \u0641\u064a \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0633\u062d\u0627\u0628\u0629\". \u0623\u062f\u0631\u062c \u0627\u0644\u062a\u0635\u0627\u0645\u064a\u0645 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0645\u0646 \u0644\u0648\u062d\u0629 \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0633\u062d\u0627\u0628\u0629 \u0641\u064a \u0627\u0644\u0645\u062d\u0631\u0631\u060c \u0639\u0644\u0649 \u0623\u064a \u0645\u0646 \u0645\u0648\u0627\u0642\u0639\u0643."
