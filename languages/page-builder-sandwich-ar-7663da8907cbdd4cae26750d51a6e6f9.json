            ],
            "Stored. Leave empty to keep it.": [
                "\u062a\u0645 \u0627\u0644\u062d\u0641\u0638. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u0627\u064b \u0644\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0647."
            ],
            "Secret access key": [
                "\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0648\u0635\u0648\u0644 \u0627\u0644\u0633\u0631\u064a"
