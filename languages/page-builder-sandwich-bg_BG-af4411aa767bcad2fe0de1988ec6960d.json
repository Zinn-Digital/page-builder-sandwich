            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u0411\u0435\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u0438\u0442\u0435 \u0441\u0435 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0442 \u0437\u0430 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0440\u0430\u043d\u0438 \u0438\u043d\u0441\u0442\u0430\u043b\u0430\u0446\u0438\u0438 Pro, \u043a\u043e\u0438\u0442\u043e \u0441\u0430 \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u0438 \u0441 \u0442\u0435\u0445\u043d\u0438\u044f \u0430\u043a\u0430\u0443\u043d\u0442. \u0412\u0435\u0434\u043d\u044a\u0436 \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u0438, \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u0430 \u0441\u0435 \u043f\u0440\u0438\u0441\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u0435 \u043e\u0442 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430 \u201e\u0410\u043a\u0430\u0443\u043d\u0442\u201c."
            ],
