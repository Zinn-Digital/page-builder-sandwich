            ],
            "%d post still holds legacy content.": [
                "%d \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f \u0432\u0441\u0435 \u043e\u0449\u0435 \u0441\u044a\u0434\u044a\u0440\u0436\u0430 \u0441\u0442\u0430\u0440\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435.",
                "\u041e\u0441\u0442\u0430\u0432\u0430\u0442 %d \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\u044a\u0441 \u0441\u0442\u0430\u0440\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435."
