            "Your library is kept in your own storage bucket, so no Zinn Digital\u00ae quota applies.": [
                "\u0633\u062a\u0627\u0633\u0648 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u0633\u062a\u0627\u0633\u0648 \u062f \u062e\u067e\u0644\u06d0 \u0632\u06d0\u0631\u0645\u06d0 \u067e\u0647 \u0633\u0637\u0644 \u06a9\u06d0 \u0633\u0627\u062a\u0644 \u06a9\u06d0\u0696\u064a\u060c \u0646\u0648 \u0681\u06a9\u0647 \u062f Zinn Digital\u00ae \u0647\u06d0\u0685 \u06a9\u0648\u067c\u0647 \u0646\u0647 \u067e\u0644\u06d0 \u06a9\u06d0\u0696\u064a."
            ],
            "%1$s of %2$s used (%3$d%%)": [
                "\u062f %2$s \u0685\u062e\u0647 %1$s \u06a9\u0627\u0631\u0648\u0644 \u0634\u0648\u06cc (%3$d%%)"
            ],
            "%1$d of %2$d designs \u00b7 up to %3$s per design \u00b7 images are resized to 2560 px and stored once": [
                "\u062f %2$d \u0689\u06cc\u0632\u0627\u06cc\u0646\u0648\u0646\u0648 \u0685\u062e\u0647 %1$d \u00b7 \u067e\u0647 \u0647\u0631 \u0689\u06cc\u0632\u0627\u06cc\u0646 \u062a\u0631 %3$s \u067e\u0648\u0631\u06d0 \u00b7 \u062f \u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0648 \u0627\u0646\u062f\u0627\u0632\u0647 2560 px \u062a\u0647 \u0628\u062f\u0644\u06cc\u0696\u064a \u0627\u0648 \u06cc\u0648 \u0681\u0644 \u062e\u0648\u0646\u062f\u064a \u06a9\u06cc\u0696\u064a"
            ],
            "Deleted from your library.": [
                "\u0633\u062a\u0627\u0633\u0648 \u0644\u0647 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u0685\u062e\u0647 \u0693\u0646\u06ab \u0634\u0648."
            ],
            "Save any section or page from the editor: open the block\u2019s \u22ee menu and choose \u201cSave to cloud library\u201d. Insert saved designs from the Cloud library panel in the editor, on any of your sites.": [
                "\u0644\u0647 \u0627\u06cc\u0689\u06cc\u067c\u0631 \u0685\u062e\u0647 \u0647\u0631\u0647 \u0628\u0631\u062e\u0647 \u06cc\u0627 \u067e\u0627\u06bc\u0647 \u062e\u0648\u0646\u062f\u064a \u06a9\u0693\u0626: \u062f \u0628\u0644\u0627\u06a9 \u22ee \u0645\u06cc\u0646\u0648 \u067e\u0631\u0627\u0646\u06cc\u0632\u0626 \u0627\u0648 \u00ab\u067e\u0647 \u06a9\u0644\u0627\u0648\u0689 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u06a9\u06d0 \u062e\u0648\u0646\u062f\u064a \u06a9\u0648\u0644\u00bb \u0648\u067c\u0627\u06a9\u0626. \u067e\u0647 \u0627\u06cc\u0689\u06cc\u067c\u0631 \u06a9\u06d0 \u062f \u06a9\u0644\u0627\u0648\u0689 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u0644\u0647 \u067e\u06cc\u0646\u0644 \u0685\u062e\u0647\u060c \u067e\u0647 \u062e\u067e\u0644\u0648 \u0647\u0631 \u06cc\u0648 \u0633\u0627\u06cc\u067c\u0648\u0646\u0648 \u06a9\u06d0 \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u064a \u0689\u06cc\u0632\u0627\u06cc\u0646\u0648\u0646\u0647 \u062f\u0646\u0646\u0647 \u06a9\u0693\u0626."
            ],
