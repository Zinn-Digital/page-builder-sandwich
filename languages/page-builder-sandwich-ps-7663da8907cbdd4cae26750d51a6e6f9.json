            "Read it back": [
                "\u062f\u0627 \u0628\u06d0\u0631\u062a\u0647 \u0648\u0644\u0648\u0644\u0626"
            ],
            "Delete it": [
                "\u062f\u0627 \u0693\u0646\u06ab \u06a9\u0693\u0626"
            ],
            "In your Cloudflare dashboard, open R2 Object Storage and create a bucket (for example \u201cmy-pbs-library\u201d). Keep it private: do not connect a public domain.": [
                "\u062e\u067e\u0644 Cloudflare \u0689\u0634\u0628\u0648\u0631\u0689 \u06a9\u06d0\u060c R2 Object Storage \u062e\u0644\u0627\u0635 \u06a9\u0693\u0626 \u0627\u0648 \u06cc\u0648 \u0628\u06a9\u067c \u062c\u0648\u0693 \u06a9\u0693\u0626 (\u062f \u0628\u06d0\u0644\u06ab\u06d0 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u201cmy-pbs-library\u201d). \u062f\u0627 \u0634\u062e\u0635\u064a \u0648\u0633\u0627\u062a\u0626: \u0639\u0627\u0645\u0647 \u0689\u0648\u0645\u06cc\u0646 \u0645\u0647 \u0648\u0631\u0633\u0631\u0647 \u0646\u069a\u0644\u0648\u0626."
            ],
            "Open \u201cManage API tokens\u201d in R2 and create an API token with \u201cObject Read & Write\u201d permission, limited to that one bucket.": [
                "\u067e\u0647 R2 \u06a9\u06d0 \u201cManage API tokens\u201d \u067e\u0631\u0627\u0646\u06cc\u0632\u0626 \u0627\u0648 \u062f \u201cObject Read & Write\u201d \u0627\u062c\u0627\u0632\u06d0 \u0633\u0631\u0647 \u06cc\u0648 \u062f API \u067c\u0648\u06a9\u0646 \u062c\u0648\u0693 \u06a9\u0693\u0626\u060c \u0686\u06d0 \u06cc\u0648\u0627\u0632\u06d0 \u062a\u0631 \u0647\u063a\u0647 \u06cc\u0648 \u0628\u0627\u0644\u067c \u067e\u0648\u0631\u06d0 \u0645\u062d\u062f\u0648\u062f \u0648\u064a."
            ],
            "Copy the Access Key ID and the Secret Access Key it shows (the secret is shown only once).": [
                "\u0647\u063a\u0647 \u062f \u0644\u0627\u0633\u0631\u0633\u064a \u06a9\u0648\u0646\u062c\u064a \u067e\u06d0\u0698\u0646\u062f (Access Key ID) \u0627\u0648 \u062f \u067e\u067c \u0644\u0627\u0633\u0631\u0633\u064a \u06a9\u0648\u0646\u062c\u064a (Secret Access Key) \u06a9\u0627\u067e\u064a \u06a9\u0693\u0626 \u0686\u06d0 \u062f\u0627 \u06cc\u06d0 \u069a\u06cc\u064a (\u067e\u067c\u0647 \u06a9\u0648\u0646\u062c\u064a \u06cc\u0648\u0627\u0632\u06d0 \u06cc\u0648 \u0681\u0644 \u069a\u0648\u062f\u0644 \u06a9\u06d0\u0696\u064a)."
            ],
            "Copy the S3 endpoint for your account. It looks like https:\/\/<account-id>.r2.cloudflarestorage.com. Region is \u201cauto\u201d.": [
                "\u062f \u062e\u067e\u0644 \u062d\u0633\u0627\u0628 \u0644\u067e\u0627\u0631\u0647 \u062f S3 \u067e\u0627\u06cc \u067c\u06a9\u06cc \u06a9\u0627\u067e\u064a \u06a9\u0693\u0626. \u062f\u0627 \u062f https:\/\/<account-id>.r2.cloudflarestorage.com \u067e\u0647 \u0685\u06d0\u0631 \u069a\u06a9\u0627\u0631\u064a. \u0633\u06cc\u0645\u0647 \"auto\" \u062f\u0647."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d. Switch the library to your storage only when the test passes.": [
                "\u0644\u0627\u0646\u062f\u06d0 \u0627\u0631\u0632\u069a\u062a\u0648\u0646\u0647 \u067e\u06cc\u0633\u067c \u06a9\u0693\u0626\u060c \u062e\u0648\u0646\u062f\u064a \u06cc\u06d0 \u06a9\u0693\u0626\u060c \u0627\u0648 \u0628\u06cc\u0627 \"\u062f \u067e\u06cc\u0648\u0633\u062a\u0648\u0646 \u0627\u0632\u0645\u0648\u06cc\u0646\u0647 \u0648\u06a9\u0693\u0626\" \u06a9\u06cc\u06a9\u0627\u0696\u0626. \u06cc\u0648\u0627\u0632\u06d0 \u0647\u063a\u0647 \u0648\u062e\u062a \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u062e\u067e\u0644 \u0632\u06d0\u0631\u0645\u062a\u0648\u0646 \u062a\u0647 \u0648\u0627\u0693\u0648\u0626 \u06a9\u0644\u0647 \u0686\u06d0 \u0627\u0632\u0645\u0648\u06cc\u0646\u0647 \u0628\u0631\u06cc\u0627\u0644\u06cd \u0634\u064a."
            ],
            "Create a private bucket with your provider (Amazon S3, Backblaze B2, Wasabi, MinIO or any S3-compatible service).": [
                "\u062f \u062e\u067e\u0644 \u0686\u0645\u062a\u0648 \u06a9\u0648\u0646\u06a9\u064a \u0633\u0631\u0647 \u06cc\u0648 \u0634\u062e\u0635\u064a \u0628\u0627\u0644\u067c (\u0628\u0627\u06a9\u067c) \u062c\u0648\u0693 \u06a9\u0693\u0626 (Amazon S3\u060c Backblaze B2\u060c Wasabi\u060c MinIO \u06cc\u0627 \u06a9\u0648\u0645 \u0628\u0644 S3 \u0633\u0631\u0647 \u0645\u0637\u0627\u0628\u0642 \u062e\u062f\u0645\u062a)."
            ],
            "Create an access key that can read, write and delete objects in that bucket only.": [
                "\u062f \u0644\u0627\u0633\u0631\u0633\u064a \u06cc\u0648\u0647 \u06a9\u0644\u064a \u062c\u0648\u0693\u0647 \u06a9\u0693\u0626 \u0686\u06d0 \u0648\u06a9\u0648\u0644\u06cc \u0634\u064a \u06cc\u0648\u0627\u0632\u06d0 \u067e\u0647 \u0647\u063a\u0647 \u0628\u0627\u0644\u067c \u06a9\u06d0 \u0634\u062a\u0647 \u062a\u0648\u06a9\u064a \u0648\u0644\u0648\u0644\u064a\u060c \u0648\u0644\u06cc\u06a9\u064a \u0627\u0648 \u0693\u0646\u06ab \u06a9\u0693\u064a."
            ],
            "Find the S3 endpoint (for Amazon S3: %s) and the bucket\u2019s region.": [
                "\u062f S3 \u067e\u0627\u06cc \u067c\u06a9\u06cc (\u062f Amazon S3 \u0644\u067e\u0627\u0631\u0647: %s) \u0627\u0648 \u062f \u0628\u0627\u0644\u067c \u0633\u06cc\u0645\u0647 \u0648\u0645\u0648\u0645\u0626."
            ],
            "Amazon S3 uses virtual-hosted addresses: switch off \u201cPath-style addresses\u201d. Most other services use path-style.": [
                "Amazon S3 \u0645\u062c\u0627\u0632\u06cc \u06a9\u0648\u0631\u0628\u0647 \u062a\u0648\u0628 \u0634\u0648\u06d0 \u067e\u062a\u06d0 \u06a9\u0627\u0631\u0648\u064a: \u00abPath-style addresses\u00bb \u0628\u0646\u062f \u06a9\u0693\u0626. \u0689\u06d0\u0631\u06cc \u0646\u0648\u0631 \u062e\u062f\u0645\u062a\u0648\u0646\u0647 \u062f \u0644\u0627\u0631\u06d0 \u0628\u06bc\u0647 \u06a9\u0627\u0631\u0648\u064a."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d.": [
                "\u0644\u0627\u0646\u062f\u06d0 \u0627\u0631\u0632\u069a\u062a\u0648\u0646\u0647 \u0648\u067e\u06d0\u0633\u067c \u06a9\u0693\u0626\u060c \u0648\u06cc\u06d0 \u0633\u0627\u062a\u0626\u060c \u0627\u0648 \u0628\u06cc\u0627 \u201cTest connection\u201d \u06a9\u06d0\u06a9\u0627\u0696\u0626."
            ],
            "Storage settings saved.": [
                "\u062f \u0632\u06d0\u0631\u0645\u062a\u0648\u0646 \u0627\u0645\u0633\u062a\u0646\u06d0 \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u06d0."
            ],
            "Your cloud library is kept in Zinn Digital\u00ae storage with the space your plan includes. You can keep it in your own Cloudflare R2 or S3-compatible bucket instead: then no Zinn Digital\u00ae quota applies, and every site you connect to the same bucket shares the library. Team libraries always use Zinn Digital\u00ae storage.": [
                "\u0633\u062a\u0627\u0633\u0648 \u062f \u0648\u0631\u06d0\u0681\u06d0 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u062f Zinn Digital\u00ae \u067e\u0647 \u0632\u06d0\u0631\u0645\u062a\u0648\u0646 \u06a9\u06d0 \u062f \u0647\u063a\u0647 \u0681\u0627\u06cc \u0633\u0631\u0647 \u0633\u0627\u062a\u0644 \u06a9\u06d0\u0696\u064a \u0686\u06d0 \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 \u067e\u0644\u0627\u0646 \u06a9\u06d0 \u0634\u0627\u0645\u0644 \u062f\u06cc. \u062a\u0627\u0633\u06d0 \u06a9\u0648\u0644\u06cc \u0634\u0626 \u067e\u0631\u0681\u0627\u06cc \u06cc\u06d0 \u062f\u0627 \u067e\u0647 \u062e\u067e\u0644 Cloudflare R2 \u06cc\u0627 \u062f S3 \u0633\u0631\u0647 \u0633\u0645\u0648\u0646 \u0644\u0631\u0648\u0646\u06a9\u06d0 \u0633\u0637\u0644 \u06a9\u06d0 \u0648\u0633\u0627\u062a\u0626: \u0628\u06cc\u0627 \u062f Zinn Digital\u00ae \u0647\u06d0\u0685 \u06a9\u0648\u067c\u0647 \u0646\u0647 \u067e\u0644\u064a \u06a9\u06d0\u0696\u064a\u060c \u0627\u0648 \u0647\u0631 \u0647\u063a\u0647 \u0633\u0627\u06cc\u067c \u0686\u06d0 \u062a\u0627\u0633\u06d0 \u06cc\u06d0 \u0648\u0631\u062a\u0647 \u0633\u0637\u0644 \u0633\u0631\u0647 \u0646\u069a\u0644\u0648\u0626 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u0634\u0631\u06cc\u06a9\u0648\u064a. \u062f \u0689\u0644\u06d0 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646\u0648\u0646\u0647 \u062a\u0644 \u062f Zinn Digital\u00ae \u0632\u06d0\u0631\u0645\u062a\u0648\u0646 \u06a9\u0627\u0631\u0648\u064a."
            ],
            "Connect your own storage: step by step": [
                "\u062e\u067e\u0644\u0647 \u0632\u06d0\u0631\u0645\u0647 \u0648\u0646\u069a\u0644\u0648\u0626: \u06ab\u0627\u0645 \u067e\u0647 \u06ab\u0627\u0645"
            ],
            "Another S3-compatible service": [
                "\u0628\u0644 S3 \u0633\u0631\u0647 \u062a\u0648\u0627\u0641\u0642 \u0644\u0631\u0648\u0646\u06a9\u06cc \u062e\u062f\u0645\u062a"
            ],
            "Read the full guide": [
                "\u0628\u0634\u067e\u0693 \u0644\u0627\u0631\u069a\u0648\u062f \u0648\u0644\u0648\u0644\u0626"
            ],
            "S3 endpoint": [
                "\u062f S3 \u067e\u0627\u06cc \u067c\u06a9\u06cc"
            ],
            "Bucket": [
                "\u0628\u0627\u06a9\u067c"
            ],
            "Region": [
                "\u0633\u064a\u0645\u0647"
            ],
            "Cloudflare R2: auto.": [
                "Cloudflare R2: \u062e\u067e\u0644\u06a9\u0627\u0631."
            ],
            "Access key ID": [
                "\u062f \u0644\u0627\u0633\u0631\u0633\u064a \u06a9\u06cc\u0644\u064a \u067e\u06d0\u0698\u0646\u062f"
