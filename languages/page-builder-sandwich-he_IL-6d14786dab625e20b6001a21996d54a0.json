            "Where to find your %s API key": [
                "\u05d4\u05d9\u05db\u05df \u05dc\u05de\u05e6\u05d5\u05d0 \u05d0\u05ea \u05de\u05e4\u05ea\u05d7 \u05d4-API \u05e9\u05dc %s \u05e9\u05dc\u05da"
            ],
            "Check and save": [
                "\u05d1\u05d3\u05d5\u05e7 \u05d5\u05e9\u05de\u05d5\u05e8"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u05d7\u05d1\u05e8\u05d5 \u05e9\u05d9\u05e8\u05d5\u05ea \u05e8\u05e9\u05d9\u05de\u05ea \u05ea\u05e4\u05d5\u05e6\u05d4 \u05e4\u05e2\u05dd \u05d0\u05d7\u05ea; \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05db\u05dc \u05d8\u05d5\u05e4\u05e1 \u05d9\u05d5\u05db\u05dc \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05d0\u05ea \u05d4\u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05de\u05de\u05dc\u05d0\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5 \u05dc\u05d0\u05d7\u05ea \u05de\u05d4\u05e8\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05dc\u05db\u05dd (\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d1\u05dc\u05d5\u05e7 \u05d4\u05d8\u05d5\u05e4\u05e1 \u2190 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e9\u05dc\u05d9\u05d7\u05d4). \u05d4\u05de\u05e4\u05ea\u05d7\u05d5\u05ea \u05e0\u05d1\u05d3\u05e7\u05d9\u05dd \u05de\u05d5\u05dc \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea, \u05e0\u05e9\u05de\u05e8\u05d9\u05dd \u05de\u05d5\u05e6\u05e4\u05e0\u05d9\u05dd \u05d1\u05d0\u05ea\u05e8 \u05d6\u05d4 \u05d5\u05dc\u05e2\u05d5\u05dc\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e6\u05d2\u05d9\u05dd \u05e9\u05d5\u05d1."
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u05e9\u05dc\u05d7 \u05d4\u05d2\u05e9\u05d5\u05ea \u05d8\u05e4\u05e1\u05d9\u05dd \u05d5\u05dc\u05d7\u05d9\u05e6\u05d5\u05ea \u05e2\u05dc \u05db\u05e4\u05ea\u05d5\u05e8\u05d9\u05dd \u05d0\u05dc \u05db\u05dc\u05d9 \u05d4\u05e0\u05d9\u05ea\u05d5\u05d7 \u05e9\u05dc\u05da \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05e7\u05d5\u05d3. \u05d4\u05e9\u05d0\u05e8 \u05de\u05d6\u05d4\u05d4 \u05e8\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d3\u05dc\u05d2 \u05e2\u05dc \u05e9\u05d9\u05e8\u05d5\u05ea \u05d6\u05d4. \u05db\u05e4\u05ea\u05d5\u05e8\u05d9\u05dd \u05de\u05e7\u05d1\u05dc\u05d9\u05dd \u05e9\u05d3\u05d4 \"Conversion event\" \u05d1\u05d7\u05dc\u05d5\u05e0\u05d9\u05ea \u05d4\u05de\u05ea\u05e7\u05d3\u05de\u05ea \u05e9\u05dc\u05d4\u05dd. \u05db\u05d0\u05e9\u05e8 \u05d1\u05d0\u05e0\u05e8 \u05e7\u05d5\u05d1\u05e6\u05d9 \u05d4\u05e2\u05d5\u05d2\u05d9\u05d5\u05ea \u05e4\u05e2\u05d9\u05dc, \u05e9\u05d5\u05dd \u05d3\u05d1\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d8\u05e2\u05df \u05e2\u05d3 \u05e9\u05d4\u05de\u05d1\u05e7\u05e8 \u05de\u05e1\u05db\u05d9\u05dd."
            ],
            "Google Analytics 4 measurement ID": [
                "\u05de\u05d6\u05d4\u05d4 \u05de\u05d3\u05d9\u05d3\u05d4 \u05e9\u05dc Google Analytics 4"
            ],
            "Google Tag Manager container ID": [
                "\u05de\u05d6\u05d4\u05d4 \u05de\u05d0\u05e8\u05d6 Google Tag Manager"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "\u05de\u05d6\u05d4\u05d4 Meta Pixel (\u05d4\u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-Meta Events Manager)"
            ],
            "Load these tags on my site": [
                "\u05d8\u05e2\u05df \u05ea\u05d2\u05d9\u05d5\u05ea \u05d0\u05dc\u05d4 \u05d1\u05d0\u05ea\u05e8 \u05e9\u05dc\u05d9"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u05d9\u05e9 \u05dc\u05db\u05d1\u05d5\u05ea \u05d0\u05dd \u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d9\u05e6\u05d5\u05d1 \u05e9\u05dc\u05da \u05d0\u05d5 \u05ea\u05d5\u05e1\u05e3 \u05d0\u05d7\u05e8 \u05db\u05d1\u05e8 \u05de\u05d5\u05e1\u05d9\u05e4\u05d9\u05dd \u05d0\u05d5\u05ea\u05dd; \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e2\u05d3\u05d9\u05d9\u05df \u05d9\u05d9\u05e9\u05dc\u05d7\u05d5."
            ],
            "Event name for form submissions": [
                "\u05e9\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05dc\u05e9\u05dc\u05d9\u05d7\u05d5\u05ea \u05d8\u05d5\u05e4\u05e1"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u05d4\u05d1\u05d0\u05e0\u05e8 \u05d4\u05d5\u05d0 \u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5 \u05e9\u05d0\u05ea\u05dd \u05de\u05e2\u05e6\u05d1\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d1\u05dc\u05d5\u05e7\u05d9\u05dd. \u05d4\u05db\u05e4\u05ea\u05d5\u05e8\u05d9\u05dd \u05e9\u05dc\u05d5 \u05de\u05e7\u05e9\u05e8\u05d9\u05dd \u05d0\u05dc #consent-accept, #consent-reject \u05d5-#consent-save (\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05ea \u05e1\u05d9\u05de\u05d5\u05df \u05d1\u05e9\u05dd analytics \u05d5-marketing \u05e2\u05d1\u05d5\u05e8 \"save\"); \u05e7\u05d9\u05e9\u05d5\u05e8 \u05d0\u05dc #consent-open \u05d1\u05db\u05dc \u05de\u05e7\u05d5\u05dd \u05d9\u05e6\u05d9\u05d2 \u05d0\u05d5\u05ea\u05d5 \u05e9\u05d5\u05d1. \u05e2\u05d3 \u05e9\u05d4\u05de\u05d1\u05e7\u05e8 \u05de\u05d0\u05e9\u05e8, \u05ea\u05d2\u05d9\u05d5\u05ea \u05d4\u05de\u05e2\u05e7\u05d1 \u05d0\u05d9\u05e0\u05df \u05e0\u05d8\u05e2\u05e0\u05d5\u05ea, Google Consent Mode \u05e0\u05e9\u05d0\u05e8 \u05d1\u05e1\u05d8\u05d8\u05d5\u05e1 \"denied\", \u05d5\u05d4\u05e1\u05e7\u05e8\u05d9\u05e4\u05d8\u05d9\u05dd \u05e9\u05e6\u05d9\u05d9\u05e0\u05ea\u05dd \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05de\u05d5\u05e9\u05d1\u05ea\u05d9\u05dd."
            ],
            "Create a ready-made banner": [
                "\u05d9\u05e6\u05d9\u05e8\u05ea \u05d1\u05d0\u05e0\u05e8 \u05de\u05d5\u05db\u05df \u05de\u05e8\u05d0\u05e9"
            ],
            "Show a cookie banner": [
                "\u05d4\u05e6\u05d2\u05ea \u05d1\u05d0\u05e0\u05e8 \u05e2\u05d5\u05d2\u05d9\u05d5\u05ea"
            ],
            "Banner": [
                "\u05d1\u05d0\u05e0\u05e8"
            ],
            "Choose a popup\u2026": [
                "\u05d1\u05d7\u05d9\u05e8\u05ea \u05d7\u05dc\u05d5\u05df \u05e7\u05d5\u05e4\u05e5\u2026"
            ],
            "%s (draft)": [
                "%s (\u05d8\u05d9\u05d5\u05d8\u05d4)"
            ],
            "Edit the banner": [
                "\u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05d1\u05d0\u05e0\u05e8"
            ],
            "Remember the choice for (days)": [
                "\u05d6\u05db\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05dc\u05de\u05e9\u05da (\u05d9\u05de\u05d9\u05dd)"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u05de\u05d7\u05d5\u05e5 \u05dc\u05d0\u05d9\u05d7\u05d5\u05d3 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e4\u05d9, \u05d4-EEA \u05d5\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4: \u05d8\u05e2\u05df \u05de\u05e2\u05e7\u05d1 \u05e2\u05d3 \u05e9\u05d4\u05de\u05d1\u05e7\u05e8 \u05d9\u05e1\u05e8\u05d1"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u05db\u05d1\u05d5\u05d9: \u05db\u05dc \u05de\u05d1\u05e7\u05e8 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05e1\u05db\u05d9\u05dd \u05ea\u05d7\u05d9\u05dc\u05d4 (\u05d4\u05db\u05dc\u05dc \u05d4\u05de\u05d7\u05de\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8, \u05d5\u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc). \u05e4\u05e2\u05d9\u05dc: \u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d0\u05e8\u05d7 \u05d0\u05d5 \u05d4-CDN \u05e9\u05dc\u05da \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc \u05de\u05d3\u05d9\u05e0\u05ea \u05d4\u05de\u05d1\u05e7\u05e8 (\u05dc\u05de\u05e9\u05dc \u05db\u05d5\u05ea\u05e8\u05ea \u05d4-CF-IPCountry \u05e9\u05dc Cloudflare) \u05d5\u05d4\u05d9\u05d0 \u05de\u05d7\u05d5\u05e5 \u05dc-EU, \u05dc-EEA, \u05dc\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4 \u05d5\u05dc\u05e9\u05d5\u05d5\u05d9\u05d9\u05e5. \u05d4\u05d1\u05d0\u05e0\u05e8 \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05d5\u05e6\u05d2, \u05d5\u05de\u05d3\u05d9\u05e0\u05d4 \u05dc\u05d0 \u05d9\u05d3\u05d5\u05e2\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05db\u05e0\u05de\u05e6\u05d0\u05ea \u05d1\u05ea\u05d5\u05da \u05d4-EU."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u05e1\u05e7\u05e8\u05d9\u05e4\u05d8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05dc\u05d4\u05e9\u05d4\u05d9\u05d4 \u05e2\u05d3 \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05e1\u05db\u05de\u05d4 (handle:analytics \u05d0\u05d5 handle:marketing, \u05de\u05d5\u05e4\u05e8\u05d3\u05d9\u05dd \u05d1\u05e4\u05e1\u05d9\u05e7\u05d9\u05dd)"
            ],
            "Popups, slide-ins and bars": [
                "\u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05e7\u05d5\u05e4\u05e6\u05d9\u05dd, \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e0\u05e9\u05dc\u05e4\u05d5\u05ea \u05d5\u05e8\u05e6\u05d5\u05e2\u05d5\u05ea"
            ],
            "A\/B test results": [
                "\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d1\u05d3\u05d9\u05e7\u05ea A\/B"
            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u05de\u05d3\u05e8\u05d9\u05db\u05d9\u05dd: \u05d8\u05e4\u05e1\u05d9\u05dd, \u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05e7\u05d5\u05e4\u05e6\u05d9\u05dd, \u05ea\u05e0\u05d5\u05e2\u05d4, \u05de\u05e2\u05e7\u05d1, \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea A\/B \u05d5\u05d1\u05d0\u05e0\u05e8 \u05e7\u05d5\u05d1\u05e6\u05d9 \u05d4-cookie"
            ],
            "Mailing-list connections": [
                "\u05d7\u05d9\u05d1\u05d5\u05e8\u05d9 \u05e8\u05e9\u05d9\u05de\u05ea \u05ea\u05e4\u05d5\u05e6\u05d4"
            ]
        }
    }
}
