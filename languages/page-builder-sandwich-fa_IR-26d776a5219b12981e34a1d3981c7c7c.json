            ],
            "Saved. Trustpilot reviews are fetched in the background within a minute or two; Google reviews load live on the page.": [
                "\u0630\u062e\u06cc\u0631\u0647 \u0634\u062f. \u0646\u0638\u0631\u0627\u062a Trustpilot \u062f\u0631 \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0638\u0631\u0641 \u06cc\u06a9 \u06cc\u0627 \u062f\u0648 \u062f\u0642\u06cc\u0642\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u0646\u0638\u0631\u0627\u062a Google \u0628\u0647 \u0635\u0648\u0631\u062a \u0632\u0646\u062f\u0647 \u062f\u0631 \u0635\u0641\u062d\u0647 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f."
            ],
            "Trustpilot reviews are fetched once a day in the background and kept on your site, so a busy page costs nothing extra on your Trustpilot account; if a refresh fails, the last reviews stay. Google does not allow its reviews to be stored, so they are loaded live when a visitor views the page: each view is one request on your own Google key, billed by Google.": [
                "\u0646\u0638\u0631\u0627\u062a Trustpilot \u06cc\u06a9 \u0628\u0627\u0631 \u062f\u0631 \u0631\u0648\u0632 \u062f\u0631 \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u0634\u062f\u0647 \u0648 \u0631\u0648\u06cc \u0633\u0627\u06cc\u062a \u0634\u0645\u0627 \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u06cc\u06a9 \u0635\u0641\u062d\u0647 \u067e\u0631\u0628\u0627\u0632\u062f\u06cc\u062f \u0647\u0632\u06cc\u0646\u0647 \u0627\u0636\u0627\u0641\u06cc \u0628\u0631\u0627\u06cc \u062d\u0633\u0627\u0628 Trustpilot \u0634\u0645\u0627 \u0646\u062f\u0627\u0631\u062f\u061b \u0627\u06af\u0631 \u0628\u0627\u0631\u06af\u06cc\u0631\u06cc \u0645\u062c\u062f\u062f \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0627\u0634\u062f\u060c \u0622\u062e\u0631\u06cc\u0646 \u0646\u0638\u0631\u0627\u062a \u0628\u0627\u0642\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f. Google \u0627\u062c\u0627\u0632\u0647 \u0630\u062e\u06cc\u0631\u0647 \u0646\u0638\u0631\u0627\u062a \u062e\u0648\u062f \u0631\u0627 \u0646\u0645\u06cc\u200c\u062f\u0647\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0648\u0642\u062a\u06cc \u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647\u200c\u0627\u06cc \u0635\u0641\u062d\u0647 \u0631\u0627 \u0645\u0634\u0627\u0647\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0622\u0646\u200c\u0647\u0627 \u0628\u0647 \u0635\u0648\u0631\u062a \u0632\u0646\u062f\u0647 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f: \u0647\u0631 \u0628\u0627\u0632\u062f\u06cc\u062f \u06cc\u06a9 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0631\u0648\u06cc \u06a9\u0644\u06cc\u062f Google \u062e\u0648\u062f \u0634\u0645\u0627 \u0627\u0633\u062a \u06a9\u0647 \u062a\u0648\u0633\u0637 Google \u0635\u0648\u0631\u062a\u200c\u062d\u0633\u0627\u0628 \u0645\u06cc\u200c\u0634\u0648\u062f."
            ],
            "Where to find it": [
                "\u06a9\u062c\u0627 \u0622\u0646 \u0631\u0627 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f"
            ],
            "Saved (\u2026%s). Type a new one to replace it.": [
                "\u0630\u062e\u06cc\u0631\u0647 \u0634\u062f (\u2026%s). \u0628\u0631\u0627\u06cc \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc \u0622\u0646\u060c \u0645\u0648\u0631\u062f \u062c\u062f\u06cc\u062f\u06cc \u062a\u0627\u06cc\u067e \u06a9\u0646\u06cc\u062f."
            ],
            "Remove the %s details and its reviews": [
                "\u062c\u0632\u0626\u06cc\u0627\u062a %s \u0648 \u0646\u0638\u0631\u0627\u062a \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0622\u0646 \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f"
            ],
            "Refreshed.": [
                "\u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06cc \u0634\u062f."
            ],
            "Refresh now": [
                "\u0627\u06a9\u0646\u0648\u0646 \u062a\u0627\u0632\u0647\u200c\u0633\u0627\u0632\u06cc \u06a9\u0646\u06cc\u062f"
            ],
            "Next daily refresh: %s.": [
                "\u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0631\u0648\u0632\u0627\u0646\u0647 \u0628\u0639\u062f\u06cc: %s."
            ],
            "Your Google and Trustpilot details, for the Reviews block.": [
                "\u062c\u0632\u0626\u06cc\u0627\u062a Google \u0648 Trustpilot \u0634\u0645\u0627\u060c \u0628\u0631\u0627\u06cc \u0628\u0644\u0648\u06a9 \u0646\u0638\u0631\u0627\u062a."
            ]
        }
    }
}
