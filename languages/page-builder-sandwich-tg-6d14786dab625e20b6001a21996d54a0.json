            "Load these tags on my site": [
                "\u0418\u043d \u0442\u0435\u0433\u04b3\u043e\u0440\u043e \u0431\u0430 \u0441\u0430\u0439\u0442\u0438 \u043c\u0430\u043d \u0431\u043e\u0440 \u043a\u0443\u043d\u0435\u0434"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0410\u0433\u0430\u0440 \u049b\u043e\u043b\u0430\u0431 \u0451 \u044f\u0433\u043e\u043d \u043f\u043b\u0430\u0433\u0438\u043d\u0438 \u0434\u0438\u0433\u0430\u0440\u0438 \u0448\u0443\u043c\u043e \u0438\u043d\u04b3\u043e\u0440\u043e \u0430\u043b\u043b\u0430\u043a\u0430\u0439 \u0438\u043b\u043e\u0432\u0430 \u043a\u0443\u043d\u0430\u0434, \u043e\u043d\u0440\u043e \u0445\u043e\u043c\u04ef\u0448 \u043a\u0443\u043d\u0435\u0434; \u0447\u043e\u0440\u0430\u0431\u0438\u043d\u0438\u04b3\u043e \u04b3\u0430\u043c\u043e\u043d\u0430\u043c \u0438\u0440\u0441\u043e\u043b \u043c\u0435\u0448\u0430\u0432\u0430\u043d\u0434."
            ],
            "Event name for form submissions": [
                "\u041d\u043e\u043c\u0438 \u0440\u04ef\u0439\u0445\u0430\u0442 \u0431\u0430\u0440\u043e\u0438 \u0444\u0438\u0440\u0438\u0441\u0442\u043e\u0434\u0430\u043d\u0438 \u0432\u0430\u0440\u0430\u049b\u0430\u04b3\u043e"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0411\u0430\u043d\u043d\u0435\u0440 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u0431\u043e\u0439 \u0432\u0441\u043f\u043b\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043e\u043a\u043d\u043e, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u044b \u0441\u043e\u0437\u0434\u0430\u0435\u0442\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0431\u043b\u043e\u043a\u043e\u0432. \u0415\u0433\u043e \u043a\u043d\u043e\u043f\u043a\u0438 \u0432\u0435\u0434\u0443\u0442 \u043d\u0430 #consent-accept, #consent-reject \u0438 #consent-save (\u0441 \u0444\u043b\u0430\u0436\u043a\u0430\u043c\u0438 analytics \u0438 marketing \u0434\u043b\u044f \u00absave\u00bb); \u0441\u0441\u044b\u043b\u043a\u0430 \u043d\u0430 #consent-open \u0432 \u043b\u044e\u0431\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0435\u0433\u043e \u0441\u043d\u043e\u0432\u0430. \u041f\u043e\u043a\u0430 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044c \u043d\u0435 \u0434\u0430\u0441\u0442 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435, \u0442\u0435\u0433\u0438 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f \u043d\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044e\u0442\u0441\u044f, \u0440\u0435\u0436\u0438\u043c Google Consent Mode \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0432 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u00abdenied\u00bb, \u0430 \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u0432\u0430\u043c\u0438 \u0441\u043a\u0440\u0438\u043f\u0442\u044b \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u043c\u0438."
            ],
            "Create a ready-made banner": [
                "\u042d\u04b7\u043e\u0434\u0438 \u0431\u0430\u043d\u043d\u0435\u0440 \u043e\u043c\u043e\u0434\u0430\u0448\u0443\u0434\u0430"
            ],
            "Show a cookie banner": [
                "\u041d\u0430\u043c\u043e\u0438\u0448 \u0434\u043e\u0434\u0430\u043d\u0438 \u0431\u0430\u043d\u043d\u0435\u0440\u0438 \u043a\u0443\u043a\u0438\u04b3\u043e"
            ],
            "Banner": [
                "\u0411\u0430\u043d\u043d\u0435\u0440"
            ],
            "Choose a popup\u2026": [
                "\u0418\u043d\u0442\u0438\u0445\u043e\u0431\u0438 \u0440\u0430\u0432\u0437\u0430\u043d\u0430\u0438 \u043f\u0430\u0439\u0434\u043e\u0448\u0430\u0432\u0430\u043d\u0434\u0430\u2026"
            ],
            "%s (draft)": [
                "%s (\u043b\u043e\u0438\u04b3\u0430)"
            ],
            "Edit the banner": [
                "\u0422\u0430\u04b3\u0440\u0438\u0440\u0438 \u0431\u0430\u043d\u043d\u0435\u0440"
            ],
            "Remember the choice for (days)": [
                "\u0418\u043d\u0442\u0438\u0445\u043e\u0431\u0440\u043e \u0431\u0430\u0440\u043e\u0438 (days) \u0434\u0430\u0440 \u0445\u043e\u0442\u0438\u0440 \u0434\u043e\u0440\u0435\u0434"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u0411\u0435\u0440\u0443\u043d \u0430\u0437 \u0418\u0442\u0442\u0438\u04b3\u043e\u0434\u0438 \u0410\u0432\u0440\u0443\u043f\u043e, \u041c\u0438\u043d\u0442\u0430\u049b\u0430\u0438 \u0438\u049b\u0442\u0438\u0441\u043e\u0434\u0438\u0438 \u0415\u0432\u0440\u043e\u043f\u0430 \u0432\u0430 \u0411\u0440\u0438\u0442\u0430\u043d\u0438\u044f\u0438 \u041a\u0430\u0431\u0438\u0440: \u043f\u0430\u0439\u0433\u0438\u0440\u0438\u0438 \u0431\u043e\u0440\u043a\u0443\u043d\u04e3 \u0442\u043e \u043e\u043d \u0434\u0430\u043c\u0435, \u043a\u0438 \u0431\u043e\u0437\u0434\u0438\u0434\u043a\u0443\u043d\u0430\u043d\u0434\u0430 \u0440\u0430\u0434 \u043c\u0435\u043a\u0443\u043d\u0430\u0434"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u0425\u043e\u043c\u04ef\u0448: \u04b3\u0430\u0440 \u044f\u043a \u0431\u043e\u0437\u0434\u0438\u0434\u043a\u0443\u043d\u0430\u043d\u0434\u0430 \u0431\u043e\u044f\u0434 \u0430\u0432\u0432\u0430\u043b \u0440\u043e\u0437\u04e3 \u0448\u0430\u0432\u0430\u0434 (\u049b\u043e\u0438\u0434\u0430\u0438 \u049b\u0430\u0442\u044a\u0438\u0442\u0430\u0440\u0438\u043d \u0432\u0430 \u043f\u0435\u0448\u0444\u0430\u0440\u0437). \u0424\u0430\u044a\u043e\u043b: \u0442\u0430\u043d\u04b3\u043e \u0432\u0430\u049b\u0442\u0435 \u043a\u0438 \u043c\u0438\u0437\u0431\u043e\u043d \u0451 CDN-\u0438 \u0448\u0443\u043c\u043e \u043a\u0438\u0448\u0440\u0438 \u0431\u043e\u0437\u0434\u0438\u0434\u043a\u0443\u043d\u0430\u043d\u0434\u0430\u0440\u043e \u0433\u0443\u0437\u043e\u0440\u0438\u0448 \u043c\u0435\u0434\u0438\u04b3\u0430\u0434 (\u043c\u0430\u0441\u0430\u043b\u0430\u043d, \u0441\u0430\u0440\u043b\u0430\u0432\u04b3\u0430\u0438 CF-IPCountry-\u0438 Cloudflare) \u0432\u0430 \u043e\u043d \u0431\u0435\u0440\u0443\u043d \u0430\u0437 EU, EEA, UK \u0432\u0430 \u0428\u0432\u0435\u0439\u0442\u0441\u0430\u0440\u0438\u044f \u0430\u0441\u0442. \u0411\u0430\u043d\u043d\u0435\u0440 \u04b3\u0430\u043d\u04ef\u0437 \u04b3\u0430\u043c \u043d\u0430\u043c\u043e\u0438\u0448 \u0434\u043e\u0434\u0430 \u043c\u0435\u0448\u0430\u0432\u0430\u0434 \u0432\u0430 \u043a\u0438\u0448\u0440\u0438 \u043d\u043e\u043c\u0430\u044a\u043b\u0443\u043c \u04b3\u0430\u043c\u0447\u0443\u043d \u0434\u0430\u0440\u0443\u043d\u0438 EU \u0431\u0430\u0440\u0440\u0430\u0441\u04e3 \u043c\u0435\u0448\u0430\u0432\u0430\u0434."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0421\u043a\u0440\u0438\u043f\u0442\u04b3\u043e\u0438 \u0434\u0438\u0433\u0430\u0440 \u0431\u0430\u0440\u043e\u0438 \u043d\u0438\u0433\u043e\u04b3 \u0434\u043e\u0448\u0442\u0430\u043d \u0442\u043e \u0433\u0438\u0440\u0438\u0444\u0442\u0430\u043d\u0438 \u0440\u043e\u0437\u0438\u0433\u04e3 (\u0438\u0434\u043e\u0440\u0430\u043a\u0443\u043d\u04e3:analytics \u0451 \u0438\u0434\u043e\u0440\u0430\u043a\u0443\u043d\u04e3:marketing, \u0431\u043e \u0432\u0435\u0440\u0433\u0443\u043b \u04b7\u0443\u0434\u043e \u043a\u0430\u0440\u0434\u0430 \u0448\u0443\u0434\u0430\u0430\u043d\u0434)"
