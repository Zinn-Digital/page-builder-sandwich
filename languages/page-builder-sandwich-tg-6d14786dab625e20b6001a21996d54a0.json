            ],
            "Where to find your %s API key": [
                "\u041a\u0430\u043b\u0438\u0434\u0438 API-\u0438 %s-\u0438 \u0445\u0443\u0434\u0440\u043e \u0430\u0437 \u043a\u0443\u04b7\u043e \u043f\u0430\u0439\u0434\u043e \u043a\u0430\u0440\u0434\u0430\u043d \u043c\u0443\u043c\u043a\u0438\u043d \u0430\u0441\u0442"
            ],
            "Check and save": [
                "\u0421\u0430\u043d\u04b7\u0435\u0434 \u0432\u0430 \u0437\u0430\u0445\u0438\u0440\u0430 \u043a\u0443\u043d\u0435\u0434"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u0425\u0438\u0434\u043c\u0430\u0442\u0438 \u0440\u04ef\u0439\u0445\u0430\u0442\u0438 \u043f\u0430\u0451\u043c\u04b3\u043e\u0440\u043e \u044f\u043a \u043c\u0430\u0440\u043e\u0442\u0438\u0431\u0430 \u043f\u0430\u0439\u0432\u0430\u0441\u0442 \u043a\u0443\u043d\u0435\u0434; \u043f\u0430\u0441 \u0430\u0437 \u0438\u043d, \u04b3\u0430\u0440 \u044f\u043a \u0448\u0430\u043a\u043b \u043c\u0435\u0442\u0430\u0432\u043e\u043d\u0430\u0434 \u0448\u0430\u0445\u0441\u043e\u043d\u0435\u0440\u043e, \u043a\u0438 \u043e\u043d\u0440\u043e \u043f\u0443\u0440 \u043c\u0435\u043a\u0443\u043d\u0430\u043d\u0434, \u0431\u0430 \u044f\u043a\u0435 \u0430\u0437 \u0440\u04ef\u0439\u0445\u0430\u0442\u04b3\u043e\u0438 \u0428\u0443\u043c\u043e \u0438\u043b\u043e\u0432\u0430 \u043d\u0430\u043c\u043e\u044f\u0434 (\u0442\u0430\u043d\u0437\u0438\u043c\u043e\u0442\u0438 \u0431\u043b\u043e\u043a\u0438 \u0448\u0430\u043a\u043b \u2192 \u0411\u0430\u044a\u0434 \u0430\u0437 \u0444\u0438\u0440\u0438\u0441\u0442\u043e\u0434\u0430\u043d). \u041a\u0430\u043b\u0438\u0434\u04b3\u043e \u0442\u0430\u0432\u0430\u0441\u0441\u0443\u0442\u0438 \u0445\u0438\u0434\u043c\u0430\u0442 \u0441\u0430\u043d\u04b7\u0438\u0434\u0430 \u0448\u0443\u0434\u0430, \u0434\u0430\u0440 \u0438\u043d \u0441\u043e\u043c\u043e\u043d\u0430 \u0431\u0430 \u0441\u0443\u0440\u0430\u0442\u0438 \u0440\u0430\u043c\u0437\u0433\u0443\u0437\u043e\u0440\u0438\u0448\u0443\u0434\u0430 \u043d\u0438\u0433\u043e\u04b3 \u0434\u043e\u0448\u0442\u0430 \u043c\u0435\u0448\u0430\u0432\u0430\u043d\u0434 \u0432\u0430 \u0434\u0438\u0433\u0430\u0440 \u04b3\u0435\u04b7 \u0433\u043e\u04b3 \u043d\u0438\u0448\u043e\u043d \u0434\u043e\u0434\u0430 \u043d\u0430\u043c\u0435\u0448\u0430\u0432\u0430\u043d\u0434."
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u0418\u0440\u0441\u043e\u043b\u0438 \u0448\u0430\u043a\u043b\u04b3\u043e \u0432\u0430 \u043f\u0430\u0445\u0448\u0438 \u0442\u0443\u0433\u043c\u0430\u04b3\u043e\u0440\u043e \u0431\u0435 \u044f\u0433\u043e\u043d \u0440\u0430\u043c\u0437 \u0431\u0430 \u0442\u0430\u04b3\u043b\u0438\u043b\u0438 \u0445\u0443\u0434 \u0444\u0438\u0440\u0438\u0441\u0442\u0435\u0434. \u0411\u0430\u0440\u043e\u0438 \u043d\u043e\u0434\u0438\u0434\u0430 \u0433\u0438\u0440\u0438\u0444\u0442\u0430\u043d\u0438 \u043e\u043d \u0445\u0438\u0434\u043c\u0430\u0442, ID-\u0440\u043e \u0445\u043e\u043b\u04e3 \u0433\u0443\u0437\u043e\u0440\u0435\u0434. \u0422\u0443\u0433\u043c\u0430\u04b3\u043e \u0434\u0430\u0440 \u043b\u0430\u0432\u04b3\u0430\u0438 Advanced-\u0438 \u0445\u0443\u0434 \u043c\u0430\u0439\u0434\u043e\u043d\u0438 \"Conversion event\" \u043c\u0435\u0433\u0438\u0440\u0430\u043d\u0434. \u04b2\u0430\u043d\u0433\u043e\u043c\u0438 \u0444\u0430\u044a\u043e\u043b \u0431\u0443\u0434\u0430\u043d\u0438 \u0431\u0430\u043d\u043d\u0435\u0440\u0438 \u043a\u0443\u043a\u0438\u04b3\u043e, \u0442\u043e \u043e\u043d \u0434\u0430\u043c\u0435 \u043a\u0438 \u043c\u0435\u04b3\u043c\u043e\u043d \u0440\u043e\u0437\u0438\u0433\u04e3 \u043d\u0430\u0434\u0438\u04b3\u0430\u0434, \u04b3\u0435\u04b7 \u0447\u0438\u0437 \u0431\u043e\u0440 \u043a\u0430\u0440\u0434\u0430 \u043d\u0430\u043c\u0435\u0448\u0430\u0432\u0430\u0434."
            ],
            "Google Analytics 4 measurement ID": [
                "\u0428\u0438\u043d\u043e\u0441\u0430\u0438 \u0430\u043d\u0434\u043e\u0437\u0430\u0433\u0438\u0440\u0438\u0438 Google Analytics 4"
            ],
            "Google Tag Manager container ID": [
                "ID-\u0438 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0438 Google Tag Manager"
