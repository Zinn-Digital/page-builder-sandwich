        "messages": {
            "": {
                "domain": "messages",
                "lang": "ps",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u06cc\u0648\u0627\u0632\u06d0 \u0647\u063a\u0647 \u06a9\u0627\u0631\u0648\u0648\u0646\u06a9\u064a \u0686\u06d0 \u06a9\u0648\u0644\u06cc \u0634\u064a \u0641\u0644\u067c\u0631 \u0646\u0647 \u0634\u0648\u06d0 HTML \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u064a\u060c \u06a9\u0648\u0644\u06cc \u0634\u064a \u062f\u0648\u062f\u06cc\u0632 CSS \u0628\u062f\u0644 \u06a9\u0693\u064a."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u062f \u062f\u06d0 CSS \u0681\u06cc\u0646\u06d0 \u0628\u0631\u062e\u06d0 \u0628\u0647 \u0648\u0646\u0647 \u06a9\u0627\u0631\u0648\u0644 \u0634\u064a: \u062f \u062e\u0648\u0646\u062f\u06cc\u062a\u0648\u0628 \u0644\u067e\u0627\u0631\u0647 @import\u060c expression()\u060c \u062f javascript: URLs\u060c \"<\" \u0627\u0648 \u0646\u0627\u0633\u0645\u06d0 \u0642\u0648\u0633\u0648\u0646\u0647 \u0644\u0631\u06d0 \u0634\u0648\u064a \u062f\u064a."
            ],
            "Page CSS": [
                "\u062f \u067e\u0627\u06bc\u06d0 CSS"
            ],
            "Global classes": [
                "\u0646\u0693\u06cc\u0648\u0627\u0644 \u067c\u0648\u0644\u06ab\u064a"
            ],
            "Classes": [
                "\u0635\u0646\u0641\u0648\u0646\u0647"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0644\u0648\u0645\u0693\u06cc \u062f \u0633\u0627\u06cc\u067c \u067e\u0647 \u0689\u06cc\u0632\u0627\u06cc\u0646 \u06a9\u06d0 \u067c\u0648\u0644\u06ab\u064a \u062c\u0648\u0693 \u06a9\u0693\u0626\u060c \u0628\u06cc\u0627 \u06cc\u06d0 \u062f\u0644\u062a\u0647 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626."
            ],
            "Custom CSS": [
                "\u06ab\u0633\u067c\u0645 \u0633\u064a \u0627\u06cc\u0633 \u0627\u06cc\u0633"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u062f \u062f\u06d0 \u0639\u0646\u0635\u0631 \u0644\u067e\u0627\u0631\u0647 \u0627\u0635\u0648\u0644 \u0648\u0644\u06cc\u06a9\u0626. \"selector\" \u062f \u062f\u06d0 \u0639\u0646\u0635\u0631 \u0645\u0639\u0646\u06cc \u0644\u0631\u064a\u060c \u062f \u0628\u06cc\u0644\u06ab\u06d0 \u067e\u0647 \u062a\u0648\u06ab\u0647 selector:hover { opacity: .8 } \u2014 \u0633\u0627\u062f\u0647 \u0627\u0639\u0644\u0627\u0646\u0648\u0646\u0647 \u067e\u062e\u067e\u0644\u0647 \u067e\u0631 \u0639\u0646\u0635\u0631 \u067e\u0644\u064a \u06a9\u06cc\u0696\u064a."
            ],
            "CSS for this page": [
                "\u062f\u06d0 \u067e\u0627\u06bc\u06d0 \u0644\u067e\u0627\u0631\u0647 CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u06cc\u0648\u0627\u0632\u06d0 \u067e\u0647 \u062f\u06d0 \u067e\u0627\u06bc\u0647 \u06a9\u06d0\u060c \u062f \u0633\u0627\u06cc\u067c \u062f \u0633\u067c\u0627\u06cc\u0644\u0648\u0646\u0648 \u0648\u0631\u0648\u0633\u062a\u0647 \u0628\u0627\u0631 \u0634\u0648\u06cc. \u062f \u067e\u0627\u06bc\u06d0 \u0633\u0631\u0647 \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u06cc."
            ]
        }
    }
}
