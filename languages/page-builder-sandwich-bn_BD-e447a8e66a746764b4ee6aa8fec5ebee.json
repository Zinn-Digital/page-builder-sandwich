                "\u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u09ac\u0982 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09b8\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u0989\u0987\u099a \u09b8\u09cd\u099f\u09c1\u09a1\u09bf\u0993\u09a4\u09c7 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af %d\u099f\u09bf \u09aa\u09cd\u09b2\u09be\u0997\u0987\u09a8 \u09ac\u09a8\u09cd\u09a7 \u0986\u099b\u09c7\u0964 \u09b2\u09be\u0987\u09ad \u09b8\u09be\u0987\u099f \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0\u09be \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u09bf\u09a4 \u09b9\u09a8 \u09a8\u09be\u0964"
            ],
