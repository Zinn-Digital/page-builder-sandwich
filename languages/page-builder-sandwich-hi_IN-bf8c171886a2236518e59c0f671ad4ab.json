            "This image has no width and height, so the page will jump when it loads. Choose it from the Media Library, or set its width and height.": [
                "\u0907\u0938 \u091b\u0935\u093f \u0915\u0940 \u0915\u094b\u0908 \u091a\u094c\u0921\u093c\u093e\u0908 \u0914\u0930 \u090a\u0901\u091a\u093e\u0908 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u092a\u0943\u0937\u094d\u0920 \u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0909\u091b\u0932\u0947\u0917\u093e\u0964 \u0907\u0938\u0947 \u092e\u0940\u0921\u093f\u092f\u093e \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940 \u0938\u0947 \u091a\u0941\u0928\u0947\u0902, \u092f\u093e \u0907\u0938\u0915\u0940 \u091a\u094c\u0921\u093c\u093e\u0908 \u0914\u0930 \u090a\u0901\u091a\u093e\u0908 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
