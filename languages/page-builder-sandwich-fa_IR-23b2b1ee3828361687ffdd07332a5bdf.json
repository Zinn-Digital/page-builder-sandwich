            ],
            "Images saved on this page appear here once the page is saved.": [
                "\u062a\u0635\u0627\u0648\u06cc\u0631 \u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0628\u0631\u06af\u0647\u060c \u067e\u0633 \u0627\u0632 \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f\u0646 \u0628\u0631\u06af\u0647 \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f."
