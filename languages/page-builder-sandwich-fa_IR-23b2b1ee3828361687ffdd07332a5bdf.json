            "The AI request failed. Try again.": [
                "\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062f. \u0644\u0637\u0641\u0627\u064b \u062f\u0648\u0628\u0627\u0631\u0647 \u062a\u0644\u0627\u0634 \u06a9\u0646\u06cc\u062f."
            ],
            "Fix it": [
                "\u0631\u0641\u0639 \u0645\u0634\u06a9\u0644"
            ],
            "AI uses your own AI provider account. Connect one to start.": [
