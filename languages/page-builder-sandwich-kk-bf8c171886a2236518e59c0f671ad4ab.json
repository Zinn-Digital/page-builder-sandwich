            ],
            "An image, video or frame in this HTML has no width and height, so the page will jump when it loads. Add width and height attributes to it.": [
                "\u0411\u04b1\u043b HTML-\u0434\u0435\u0433\u0456 \u043a\u0435\u0441\u043a\u0456\u043d, \u0432\u0438\u0434\u0435\u043e \u043d\u0435\u043c\u0435\u0441\u0435 \u043a\u0430\u0434\u0440\u0434\u0430 \u0435\u043d\u0456 \u043c\u0435\u043d \u0431\u0438\u0456\u043a\u0442\u0456\u0433\u0456 \u0436\u043e\u049b, \u0441\u043e\u043d\u0434\u044b\u049b\u0442\u0430\u043d \u0431\u0435\u0442 \u0436\u04af\u043a\u0442\u0435\u043b\u0433\u0435\u043d \u043a\u0435\u0437\u0434\u0435 \u0441\u0435\u043a\u0456\u0440\u0456\u043f \u043a\u0435\u0442\u0435\u0434\u0456. \u041e\u0493\u0430\u043d \u0435\u043d\u0456 \u043c\u0435\u043d \u0431\u0438\u0456\u043a\u0442\u0456\u0433\u0456 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u0442\u0430\u0440\u044b\u043d \u049b\u043e\u0441\u044b\u04a3\u044b\u0437."
            ],
