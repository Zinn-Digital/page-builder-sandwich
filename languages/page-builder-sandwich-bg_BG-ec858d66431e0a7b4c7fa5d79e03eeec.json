                "%d \u0437\u0430\u043c\u0435\u043d\u0435\u043d\u0438"
            ],
            "%d kept as they were": [
                "%d \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438 \u043a\u0430\u043a\u0442\u043e \u0431\u044f\u0445\u0430",
                "%d \u0437\u0430\u043f\u0430\u0437\u0435\u043d\u0438 \u043a\u0430\u043a\u0442\u043e \u0431\u044f\u0445\u0430"
