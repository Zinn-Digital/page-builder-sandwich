            ],
            "Importing will give: %s.": [
                "\u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0435\u0442\u043e \u0449\u0435 \u0434\u043e\u0432\u0435\u0434\u0435 \u0434\u043e: %s."
            ],
            "Imported: %s.": [
                "\u0418\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0438: %s."
            ],
            "Exported %d item.": [
                "\u0415\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d \u0435 %d \u0435\u043b\u0435\u043c\u0435\u043d\u0442.",
                "\u0415\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0438 \u0441\u0430 %d \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430."
            ],
            "That file could not be read as an export file.": [
                "\u0422\u043e\u0437\u0438 \u0444\u0430\u0439\u043b \u043d\u0435 \u043c\u043e\u0436\u0430 \u0434\u0430 \u0431\u044a\u0434\u0435 \u043f\u0440\u043e\u0447\u0435\u0442\u0435\u043d \u043a\u0430\u0442\u043e \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0435\u043d \u0444\u0430\u0439\u043b."
            ],
            "Export": [
                "\u0415\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0435"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0418\u0437\u0442\u0435\u0433\u043b\u0435\u0442\u0435 \u0432\u0430\u0448\u0438\u0442\u0435 \u0448\u0430\u0431\u043b\u043e\u043d\u0438, \u043c\u043e\u0442\u0438\u0432\u0438 \u0438 \u0434\u0438\u0437\u0430\u0439\u043d \u043d\u0430 \u0441\u0430\u0439\u0442\u0430 \u043a\u0430\u0442\u043e \u0435\u0434\u0438\u043d \u0444\u0430\u0439\u043b \u0437\u0430 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0435 \u0432 \u0434\u0440\u0443\u0433 \u0441\u0430\u0439\u0442."
            ],
            "There are no templates or patterns to export yet.": [
                "\u0412\u0441\u0435 \u043e\u0449\u0435 \u043d\u044f\u043c\u0430 \u043d\u0430\u043b\u0438\u0447\u043d\u0438 \u0448\u0430\u0431\u043b\u043e\u043d\u0438 \u0438\u043b\u0438 \u0441\u0445\u0435\u043c\u0438 \u0437\u0430 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0435."
            ],
            "Include the settings": [
                "\u0412\u043a\u043b\u044e\u0447\u0432\u0430\u043d\u0435 \u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435"
            ],
            "Download the export file": [
                "\u0418\u0437\u0442\u0435\u0433\u043b\u044f\u043d\u0435 \u043d\u0430 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043d\u0438\u044f \u0444\u0430\u0439\u043b"
            ],
            "Choose an export file": [
                "\u0418\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0435\u043d \u0444\u0430\u0439\u043b"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0424\u0430\u0439\u043b\u044a\u0442 \u0441\u044a\u0434\u044a\u0440\u0436\u0430 %1$d \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u043e\u0442 %2$s.",
                "\u0424\u0430\u0439\u043b\u044a\u0442 \u0441\u044a\u0434\u044a\u0440\u0436\u0430 %1$d \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043e\u0442 %2$s."
            ],
            "When an item with the same name already exists here": [
                "\u041a\u043e\u0433\u0430\u0442\u043e \u0442\u0443\u043a \u0432\u0435\u0447\u0435 \u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430 \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u0441\u044a\u0441 \u0441\u044a\u0449\u043e\u0442\u043e \u0438\u043c\u0435"
            ],
            "Keep the one on this site": [
                "\u0417\u0430\u043f\u0430\u0437\u0435\u0442\u0435 \u0442\u043e\u0437\u0438 \u043d\u0430 \u0442\u043e\u0437\u0438 \u0441\u0430\u0439\u0442"
            ],
            "Replace it with the imported one": [
                "\u0417\u0430\u043c\u0435\u043d\u0435\u0442\u0435 \u0433\u043e \u0441 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0438\u044f"
            ],
            "Import a copy beside it": [
                "\u0418\u043f\u043e\u0440\u0442\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043f\u0438\u0435 \u0434\u043e \u043d\u0435\u0433\u043e"
            ],
            "Apply the settings in the file": [
                "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u0442\u0435 \u0432\u044a\u0432 \u0444\u0430\u0439\u043b\u0430"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u041a\u043e\u043f\u0438\u0440\u0430\u0439\u0442\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u0442\u0430 \u0432 \u043c\u0435\u0434\u0438\u0439\u043d\u0430\u0442\u0430 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430 \u043d\u0430 \u0442\u043e\u0437\u0438 \u0441\u0430\u0439\u0442"
            ],
            "Show what will happen": [
                "\u041f\u043e\u043a\u0430\u0436\u0438 \u043a\u0430\u043a\u0432\u043e \u0449\u0435 \u0441\u0435 \u0441\u043b\u0443\u0447\u0438"
            ]
        }
    }
