            ],
            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0442\u044b \u0442\u0435\u043a\u0441\u0435\u0440\u0443 \u043a\u04e9\u043f\u0442\u0435\u0433\u0435\u043d \u043c\u04d9\u0441\u0435\u043b\u0435\u043b\u0435\u0440\u0434\u0456 \u0442\u0430\u0431\u0430\u0434\u044b, \u0431\u0456\u0440\u0430\u049b \u043e\u043b\u0430\u0440\u0434\u044b\u04a3 \u0431\u0430\u0440\u043b\u044b\u0493\u044b\u043d \u0435\u043c\u0435\u0441. \u0421\u043e\u043d\u0434\u0430\u0439-\u0430\u049b \u0431\u0435\u0442\u0442\u0456 \u0442\u0435\u043a \u043f\u0435\u0440\u043d\u0435\u0442\u0430\u049b\u0442\u0430\u043c\u0435\u043d \u0436\u04d9\u043d\u0435 \u044d\u043a\u0440\u0430\u043d \u043e\u049b\u0443 \u049b\u04b1\u0440\u0430\u043b\u044b\u043c\u0435\u043d \u0442\u0435\u043a\u0441\u0435\u0440\u0456\u043f \u043a\u04e9\u0440\u0456\u04a3\u0456\u0437."
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u041c\u04d9\u0442\u0456\u043d \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u044b %1$s:1; \u043e\u049b\u044b\u043b\u0443\u044b \u04af\u0448\u0456\u043d \u043a\u0435\u043c\u0456\u043d\u0434\u0435 %2$s:1 \u0431\u043e\u043b\u0443\u044b \u043a\u0435\u0440\u0435\u043a."
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u043e\u0441\u044b\u043d\u0434\u0430 \u0431\u0430\u0441\u044b\u04a3\u044b\u0437,\u043e\u0441\u044b\u043d\u0434\u0430,\u0442\u043e\u043b\u044b\u0493\u044b\u0440\u0430\u049b \u043e\u049b\u0443,\u0442\u0430\u0493\u044b,\u0441\u0456\u043b\u0442\u0435\u043c\u0435,\u043e\u0441\u044b \u0441\u0456\u043b\u0442\u0435\u043c\u0435,\u0442\u043e\u043b\u044b\u0493\u044b\u0440\u0430\u049b \u0431\u0456\u043b\u0443,\u04e9\u0442\u0443"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u0421\u0456\u043b\u0442\u0435\u043c\u0435\u0434\u0435 \u043c\u04d9\u0442\u0456\u043d \u0436\u043e\u049b, \u0441\u043e\u043d\u0434\u044b\u049b\u0442\u0430\u043d \u044d\u043a\u0440\u0430\u043d\u0434\u044b\u049b \u043e\u049b\u0443 \u049b\u04b1\u0440\u0430\u043b\u044b \u0442\u0435\u043a \u00ab\u0441\u0456\u043b\u0442\u0435\u043c\u0435\u00bb \u0434\u0435\u043f \u0445\u0430\u0431\u0430\u0440\u043b\u0430\u0439\u0434\u044b. \u041c\u04d9\u0442\u0456\u043d \u043d\u0435\u043c\u0435\u0441\u0435 \u0431\u0435\u043b\u0433\u0456 \u049b\u043e\u0441\u044b\u04a3\u044b\u0437."
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\"%s\" \u0441\u0456\u043b\u0442\u0435\u043c\u0435 \u043c\u04d9\u0442\u0456\u043d\u0456 \u049b\u0430\u0439\u0434\u0430 \u0430\u043f\u0430\u0440\u0430\u0442\u044b\u043d\u044b\u043d \u043a\u04e9\u0440\u0441\u0435\u0442\u043f\u0435\u0439\u0434\u0456. \u041e\u043d\u044b\u04a3 \u043e\u0440\u043d\u044b\u043d\u0430 \u0442\u0430\u0493\u0430\u0439\u044b\u043d\u0434\u0430\u043b\u0493\u0430\u043d \u043e\u0440\u044b\u043d\u0434\u044b \u0441\u0438\u043f\u0430\u0442\u0442\u0430\u04a3\u044b\u0437."
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u042d\u043b\u0435\u043c\u0435\u043d\u0442\u0442\u0435 \u043e\u04a3 tabindex \u0431\u0430\u0440, \u043e\u043b \u043f\u0435\u0440\u043d\u0435\u0442\u0430\u049b\u0442\u0430 \u0440\u0435\u0442\u0456\u043d \u043e\u049b\u0443 \u0440\u0435\u0442\u0456\u043d\u0435\u043d \u04e9\u0437\u0433\u0435\u0440\u0442\u0435\u0434\u0456. 0 \u043c\u04d9\u043d\u0456\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u044b\u04a3\u044b\u0437 \u043d\u0435\u043c\u0435\u0441\u0435 \u043e\u043d\u044b \u0430\u043b\u044b\u043f \u0442\u0430\u0441\u0442\u0430\u04a3\u044b\u0437."
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u0411\u0430\u0441\u044b\u043b\u0430\u0442\u044b\u043d \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043a\u0435 \u043f\u0435\u0440\u043d\u0435\u0442\u0430\u049b\u0442\u0430 \u0430\u0440\u049b\u044b\u043b\u044b \u049b\u043e\u043b \u0436\u0435\u0442\u043a\u0456\u0437\u0443 \u043c\u04af\u043c\u043a\u0456\u043d \u0435\u043c\u0435\u0441. \u041d\u0430\u049b\u0442\u044b \u0431\u0430\u0442\u044b\u0440\u043c\u0430\u043d\u044b \u043d\u0435\u043c\u0435\u0441\u0435 \u0441\u0456\u043b\u0442\u0435\u043c\u0435\u043d\u0456 \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u044b\u04a3\u044b\u0437."
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u0415\u043d\u0434\u0456\u0440\u0456\u043b\u0433\u0435\u043d \u0444\u0440\u0435\u0439\u043c\u043d\u0456\u04a3 \u0442\u0430\u049b\u044b\u0440\u044b\u0431\u044b \u0436\u043e\u049b, \u0441\u043e\u043d\u0434\u044b\u049b\u0442\u0430\u043d \u044d\u043a\u0440\u0430\u043d\u043d\u0430\u043d \u043e\u049b\u0443 \u049b\u04b1\u0440\u0430\u043b\u044b \u043e\u043d\u044b\u04a3 \u043d\u0435 \u0435\u043a\u0435\u043d\u0456\u043d \u0430\u0439\u0442\u0430 \u0430\u043b\u043c\u0430\u0439\u0434\u044b."
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u041f\u0456\u0448\u0456\u043d \u04e9\u0440\u0456\u0441\u0456\u043d\u0434\u0435 \u0431\u0435\u043b\u0433\u0456 \u0436\u043e\u049b, \u0441\u043e\u043d\u0434\u044b\u049b\u0442\u0430\u043d \u043e\u043d\u044b\u04a3 \u043c\u0430\u049b\u0441\u0430\u0442\u044b \u0445\u0430\u0431\u0430\u0440\u043b\u0430\u043d\u0431\u0430\u0439\u0434\u044b."
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u0411\u04b1\u043b \u0442\u0430\u049b\u044b\u0440\u044b\u043f\u0448\u0430 \u0431\u043e\u0441. \u042d\u043a\u0440\u0430\u043d \u043e\u049b\u0443 \u049b\u04b1\u0440\u0430\u043b\u044b\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u0443\u0448\u044b\u043b\u0430\u0440 \u0442\u0430\u049b\u044b\u0440\u044b\u043f\u0448\u0430\u043b\u0430\u0440 \u0430\u0440\u049b\u044b\u043b\u044b \u0448\u0430\u0440\u043b\u0430\u0439\u0434\u044b; \u043e\u043d\u044b \u04e9\u0448\u0456\u0440\u0456\u04a3\u0456\u0437 \u043d\u0435\u043c\u0435\u0441\u0435 \u043c\u04d9\u0442\u0456\u043d \u049b\u043e\u0441\u044b\u04a3\u044b\u0437."
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
                "\u0411\u0435\u0442\u0442\u0456\u04a3 \u0430\u0442\u0430\u0443\u044b \u049b\u0430\u0437\u0456\u0440\u0434\u0456\u04a3 \u04e9\u0437\u0456\u043d\u0434\u0435 H1 \u0431\u043e\u043b\u044b\u043f \u0442\u0430\u0431\u044b\u043b\u0430\u0434\u044b; \u043c\u0430\u0437\u043c\u04b1\u043d\u043d\u044b\u04a3 \u0436\u043e\u0493\u0430\u0440\u0493\u044b \u0434\u0435\u04a3\u0433\u0435\u0439\u0456 \u04af\u0448\u0456\u043d H2 \u0442\u0435\u0433\u0456\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u044b\u04a3\u044b\u0437."
            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u0411\u04b1\u043b H%1$d \u0434\u0435\u04a3\u0433\u0435\u0439\u0434\u0456 \u0430\u0442\u0442\u0430\u043f \u04e9\u0442\u0435\u0434\u0456; \u043e\u043d\u044b\u04a3 \u0430\u043b\u0434\u044b\u043d\u0434\u0430\u0493\u044b\u0441\u044b \u2014 H%2$d. \u041e\u043d\u044b H%3$d \u0435\u0442\u0456\u043f \u04e9\u0437\u0433\u0435\u0440\u0442\u0456\u04a3\u0456\u0437."
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u0411\u04b1\u043b \u043a\u0435\u0441\u043a\u0456\u043d\u0434\u0435 \u0431\u0430\u043b\u0430\u043c\u0430\u043b\u044b \u043c\u04d9\u0442\u0456\u043d \u0436\u043e\u049b. \u041e\u043d\u044b \u0441\u0438\u043f\u0430\u0442\u0442\u0430\u04a3\u044b\u0437 \u043d\u0435\u043c\u0435\u0441\u0435 \u0435\u0448\u049b\u0430\u043d\u0434\u0430\u0439 \u043c\u04d9\u043d \u049b\u043e\u0441\u043f\u0430\u0441\u0430, \u0441\u04d9\u043d\u0434\u0456\u043a \u0434\u0435\u043f \u0431\u0435\u043b\u0433\u0456\u043b\u0435\u04a3\u0456\u0437."
            ],
            "Close panel": [
                "\u041f\u0430\u043d\u0435\u043b\u044c\u0434\u0456 \u0436\u0430\u0431\u0443"
            ]
        }
