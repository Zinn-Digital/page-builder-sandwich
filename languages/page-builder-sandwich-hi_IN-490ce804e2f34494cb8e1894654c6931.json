            "Checking\u2026": [
                "\u091c\u093e\u0901\u091a \u0915\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948\u2026"
            ],
            "No accessibility problems found on this page.": [
                "\u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0915\u094b\u0908 \u092a\u0939\u0941\u0902\u091a \u0938\u0902\u092c\u0902\u0927\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u090f\u0902 \u0928\u0939\u0940\u0902 \u092a\u093e\u0908 \u0917\u0908\u0902\u0964"
