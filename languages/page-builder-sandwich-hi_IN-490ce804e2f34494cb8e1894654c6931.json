            "%d thing to check": [
                "\u091c\u093e\u0902\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f %d \u092c\u093e\u0924",
                "\u091c\u093e\u0901\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f %d \u092c\u093e\u0924\u0947\u0902"
            ],
            "Check again": [
                "\u092a\u0941\u0928\u0903 \u091c\u093e\u0901\u091a\u0947\u0902"
            ],
            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u090f\u0915 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u091c\u093e\u0901\u091a \u0915\u0908 \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0924\u0940 \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0938\u092d\u0940 \u0915\u093e \u0928\u0939\u0940\u0902\u0964 \u092a\u0943\u0937\u094d\u0920 \u0915\u094b \u0915\u0947\u0935\u0932 \u0915\u0940\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0940 \u0906\u091c\u093c\u092e\u093e\u090f\u0901\u0964"
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u0902\u091f\u094d\u0930\u093e\u0938\u094d\u091f %1$s:1 \u0939\u0948; \u092a\u0920\u0928\u0940\u092f \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u0915\u092e \u0938\u0947 \u0915\u092e %2$s:1 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u092f\u0939\u093e\u0901 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902,\u092f\u0939\u093e\u0901,\u0914\u0930 \u092a\u0922\u093c\u0947\u0902,\u0905\u0927\u093f\u0915,\u0932\u093f\u0902\u0915,\u092f\u0939 \u0932\u093f\u0902\u0915,\u0914\u0930 \u091c\u093e\u0928\u0947\u0902,\u091c\u093e\u090f\u0901"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u0915\u093f\u0938\u0940 \u0932\u093f\u0902\u0915 \u092e\u0947\u0902 \u0915\u094b\u0908 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0915\u0947\u0935\u0932 \"\u0932\u093f\u0902\u0915\" \u092c\u094b\u0932\u0924\u093e \u0939\u0948\u0964 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092f\u093e \u0915\u094b\u0908 \u0932\u0947\u092c\u0932 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\u0932\u093f\u0902\u0915 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u201c%s\u201d \u092f\u0939 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e\u0924\u093e \u0915\u093f \u092f\u0939 \u0915\u0939\u093e\u0901 \u0932\u0947 \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u0917\u0902\u0924\u0935\u094d\u092f \u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0947\u0902\u0964"
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u0915\u093f\u0938\u0940 \u0924\u0924\u094d\u0935 \u092e\u0947\u0902 \u090f\u0915 \u0927\u0928\u093e\u0924\u094d\u092e\u0915 tabindex \u0939\u0948, \u091c\u094b \u0915\u0940\u092c\u094b\u0930\u094d\u0921 \u0915\u094d\u0930\u092e \u0915\u094b \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u0915\u094d\u0930\u092e \u0938\u0947 \u0905\u0932\u0917 \u0915\u0930 \u0926\u0947\u0924\u093e \u0939\u0948\u0964 0 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902 \u092f\u093e \u0907\u0938\u0947 \u0939\u091f\u093e \u0926\u0947\u0902\u0964"
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u0915\u093f\u0938\u0940 \u0924\u0924\u094d\u0935 \u0924\u0915 \u0915\u0940\u092c\u094b\u0930\u094d\u0921 \u0938\u0947 \u0928\u0939\u0940\u0902 \u092a\u0939\u0941\u0901\u091a\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0915\u093f\u0938\u0940 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092c\u091f\u0928 \u092f\u093e \u0932\u093f\u0902\u0915 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u090f\u092e\u094d\u092c\u0947\u0921 \u0915\u093f\u090f \u0917\u090f \u092b\u093c\u094d\u0930\u0947\u092e \u0915\u093e \u0915\u094b\u0908 \u0936\u0940\u0930\u094d\u0937\u0915 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u092f\u0939 \u0928\u0939\u0940\u0902 \u092c\u0924\u093e \u0938\u0915\u0924\u093e \u0915\u093f \u092f\u0939 \u0915\u094d\u092f\u093e \u0939\u0948\u0964"
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u092b\u093c\u0949\u0930\u094d\u092e \u092b\u093c\u0940\u0932\u094d\u0921 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0932\u0947\u092c\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0907\u0938\u0915\u0947 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0940 \u0918\u094b\u0937\u0923\u093e \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u092f\u0939 \u0936\u0940\u0930\u094d\u0937\u0915 \u0930\u093f\u0915\u094d\u0924 \u0939\u0948\u0964 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0936\u0940\u0930\u094d\u0937\u0915\u094b\u0902 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0928\u0947\u0935\u093f\u0917\u0947\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902; \u0907\u0938\u0947 \u0939\u091f\u093e\u090f\u0902 \u092f\u093e \u092a\u093e\u0920 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
                "\u092a\u0947\u091c \u0915\u093e \u0936\u0940\u0930\u094d\u0937\u0915 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 H1 \u0939\u0948; \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u0947 \u0936\u0940\u0930\u094d\u0937 \u0938\u094d\u0924\u0930 \u0915\u0947 \u0932\u093f\u090f H2 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u092f\u0939 H%1$d \u090f\u0915 \u0938\u094d\u0924\u0930 \u091b\u094b\u0921\u093c\u0924\u093e \u0939\u0948; \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u0935\u093e\u0932\u093e H%2$d \u0939\u0948\u0964 \u0907\u0938\u0947 H%3$d \u092c\u0928\u093e\u090f\u0902\u0964"
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u0907\u0938 \u091b\u0935\u093f \u0915\u093e \u0915\u094b\u0908 \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u092a\u093e\u0920 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0907\u0938\u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0947\u0902, \u092f\u093e \u092f\u0926\u093f \u092f\u0939 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u091c\u094b\u0921\u093c\u0924\u0940 \u0939\u0948 \u0924\u094b \u0907\u0938\u0947 \u0938\u091c\u093e\u0935\u091f\u0940 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091a\u093f\u0939\u094d\u0928\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
            ],
            "Close panel": [
                "\u092a\u0948\u0928\u0932 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902"
            ]
        }
    }
