            ],
            "Install Tranzly and list two or more languages, and the switcher appears here.": [
                "Tranzly \u0631\u0627 \u0646\u0635\u0628 \u06a9\u0646\u06cc\u062f \u0648 \u062f\u0648 \u06cc\u0627 \u0686\u0646\u062f \u0632\u0628\u0627\u0646 \u0631\u0627 \u0627\u0636\u0627\u0641\u0647 \u0646\u0645\u0627\u06cc\u06cc\u062f \u062a\u0627 \u0633\u0648\u0626\u06cc\u0686\u0631 \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0638\u0627\u0647\u0631 \u0634\u0648\u062f."
