            "A Dashicons name (for example dashicons-admin-customizer) or an https:\/\/ image address.": [
                "\u0a07\u0a71\u0a15 Dashicons \u0a28\u0a3e\u0a2e (\u0a09\u0a26\u0a3e\u0a39\u0a30\u0a28 \u0a32\u0a08 dashicons-admin-customizer) \u0a1c\u0a3e\u0a02 \u0a07\u0a71\u0a15 https:\/\/ \u0a1a\u0a3f\u0a71\u0a24\u0a30 \u0a2a\u0a24\u0a3e\u0964"
            ],
            "Hide the plugin from the Plugins screen": [
                "\u0a2a\u0a32\u0a71\u0a17\u0a07\u0a28 \u0a38\u0a15\u0a4d\u0a30\u0a40\u0a28 \u0a24\u0a4b\u0a02 \u0a2a\u0a32\u0a71\u0a17\u0a07\u0a28 \u0a32\u0a41\u0a15\u0a3e\u0a13"
            ],
            "Agency users who still see the real product and these settings": [
                "\u0a0f\u0a1c\u0a70\u0a38\u0a40 \u0a09\u0a2a\u0a2d\u0a4b\u0a17\u0a24\u0a3e \u0a1c\u0a4b \u0a05\u0a1c\u0a47 \u0a35\u0a40 \u0a05\u0a38\u0a32 \u0a09\u0a24\u0a2a\u0a3e\u0a26 \u0a05\u0a24\u0a47 \u0a07\u0a39 \u0a38\u0a48\u0a1f\u0a3f\u0a70\u0a17\u0a3e\u0a02 \u0a26\u0a47\u0a16\u0a26\u0a47 \u0a39\u0a28"
            ]
        }
