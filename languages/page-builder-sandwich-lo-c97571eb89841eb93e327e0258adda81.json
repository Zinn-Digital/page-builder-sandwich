            ],
            "%d fix(es) made; save the page, then measure again.": [
                "\u0ec4\u0e94\u0ec9\u0e94\u0eb3\u0ec0\u0e99\u0eb5\u0e99\u0e81\u0eb2\u0e99\u0ec1\u0e81\u0ec9\u0ec4\u0e82 %d \u0ea5\u0eb2\u0e8d\u0e81\u0eb2\u0e99; \u0e9a\u0eb1\u0e99\u0e97\u0eb6\u0e81\u0edc\u0ec9\u0eb2, \u0e88\u0eb2\u0e81\u0e99\u0eb1\u0ec9\u0e99\u0ea7\u0eb1\u0e94\u0ec1\u0e97\u0e81\u0ead\u0eb5\u0e81\u0e84\u0eb1\u0ec9\u0e87."
