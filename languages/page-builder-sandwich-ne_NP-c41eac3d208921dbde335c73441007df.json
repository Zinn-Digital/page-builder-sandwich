            ],
            "Save role settings": [
                "\u092d\u0942\u092e\u093f\u0915\u093e \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942 \u092c\u091a\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Saved. Reload the page to see the new names.": [
                "\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0917\u0930\u093f\u092f\u094b\u0964 \u0928\u092f\u093e\u0901 \u0928\u093e\u092e\u0939\u0930\u0942 \u0939\u0947\u0930\u094d\u0928 \u092a\u0943\u0937\u094d\u0920 \u092a\u0941\u0928: \u0932\u094b\u0921 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"
            ],
            "Rename the builder and hide our branding on this site": [
                "\u092c\u093f\u0932\u094d\u0921\u0930\u0915\u094b \u0928\u093e\u092e \u092c\u0926\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0930 \u092f\u0938 \u0938\u093e\u0907\u091f\u092e\u093e \u0939\u093e\u092e\u094d\u0930\u094b \u092c\u094d\u0930\u093e\u0928\u094d\u0921\u093f\u0919 \u0932\u0941\u0915\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Shown everywhere the product name appears: menus, the editor, notices.": [
                "\u0909\u0924\u094d\u092a\u093e\u0926\u0928\u0915\u094b \u0928\u093e\u092e \u0926\u0947\u0916\u093f\u0928\u0947 \u0938\u092c\u0948 \u0920\u093e\u0909\u0901\u092e\u093e \u0926\u0947\u0916\u093e\u0907\u0928\u094d\u091b: \u092e\u0947\u0928\u0941\u0939\u0930\u0942, \u0938\u092e\u094d\u092a\u093e\u0926\u0915, \u0938\u0942\u091a\u0928\u093e\u0939\u0930\u0942\u0964"
            ],
            "Leave empty to use the builder name.": [
                "\u0928\u093f\u0930\u094d\u092e\u093e\u0924\u093e\u0915\u094b \u0928\u093e\u092e \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u0928 \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"
            ],
            "Description on the Plugins screen": [
                "\u092a\u094d\u0932\u0917\u0907\u0928 \u0938\u094d\u0915\u094d\u0930\u093f\u0928\u092e\u093e \u0935\u093f\u0935\u0930\u0923"
            ],
            "A Dashicons name (for example dashicons-admin-customizer) or an https:\/\/ image address.": [
                "\u090f\u0915 Dashicons \u0928\u093e\u092e (\u0909\u0926\u093e\u0939\u0930\u0923\u0915\u093e \u0932\u093e\u0917\u093f dashicons-admin-customizer) \u0935\u093e \u090f\u0915 https:\/\/ \u091b\u0935\u093f \u0920\u0947\u0917\u093e\u0928\u093e\u0964"
            ],
            "Hide the plugin from the Plugins screen": [
                "\u092a\u094d\u0932\u0917\u0907\u0928\u0939\u0930\u0942 \u0938\u094d\u0915\u094d\u0930\u093f\u0928\u092c\u093e\u091f \u092a\u094d\u0932\u0917\u0907\u0928 \u0932\u0941\u0915\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Agency users who still see the real product and these settings": [
                "\u090f\u091c\u0947\u0928\u094d\u0938\u0940 \u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0939\u0930\u0942 \u091c\u0938\u0932\u0947 \u0905\u091d\u0948 \u092a\u0928\u093f \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0909\u0924\u094d\u092a\u093e\u0926\u0928 \u0930 \u092f\u0940 \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942 \u0926\u0947\u0916\u094d\u0928\u0941\u0939\u0941\u0928\u094d\u091b"
            ]
        }
    }
}
