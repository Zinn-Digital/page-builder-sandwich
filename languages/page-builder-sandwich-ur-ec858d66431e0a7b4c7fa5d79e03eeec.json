    "locale_data": {
        "messages": {
            "": {
                "domain": "messages",
                "lang": "ur",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Import and export": [
                "\u062f\u0631\u0622\u0645\u062f \u0627\u0648\u0631 \u0628\u0631\u0622\u0645\u062f"
            ],
            "Import": [
                "\u062f\u0631\u0622\u0645\u062f \u06a9\u0631\u06cc\u06ba"
            ],
            "%d new": [
                "%d \u0646\u06cc\u0627",
                "%d \u0646\u06cc\u0627"
            ],
            "%d replaced": [
                "%d \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631 \u062f\u06cc\u0627 \u06af\u06cc\u0627",
                "%d \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631 \u062f\u06cc\u0627 \u06af\u06cc\u0627"
            ],
            "%d kept as they were": [
                "%d \u0627\u0633\u06cc \u0637\u0631\u062d \u0631\u06a9\u06be\u06d2 \u06af\u0626\u06d2 \u062c\u06cc\u0633\u06d2 \u0648\u06c1 \u062a\u06be\u06d2",
                "%d \u06a9\u0648 \u062c\u0648\u06ba \u06a9\u0627 \u062a\u0648\u06ba \u0631\u06a9\u06be\u0627 \u06af\u06cc\u0627"
            ],
            "%d setting": [
                "%d \u062a\u0631\u062a\u06cc\u0628\u0627\u062a",
                "%d \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"
            ],
            "Importing will give: %s.": [
                "\u062f\u0631\u0622\u0645\u062f \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u062d\u0627\u0635\u0644 \u06c1\u0648\u06af\u0627: %s\u06d4"
            ],
            "Imported: %s.": [
                "\u062f\u0631\u0622\u0645\u062f \u0634\u062f\u06c1: %s\u06d4"
            ],
            "Exported %d item.": [
                "%d \u0622\u0626\u0679\u0645 \u0628\u0631\u0622\u0645\u062f \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4",
                "%d \u0622\u0626\u0679\u0645\u0632 \u0628\u0631\u0622\u0645\u062f \u06a9\u06cc\u06d2 \u06af\u0626\u06d2\u06d4"
            ],
            "That file could not be read as an export file.": [
                "\u0627\u0633 \u0641\u0627\u0626\u0644 \u06a9\u0648 \u0627\u06cc\u06a9\u0633\u067e\u0648\u0631\u0679 \u0641\u0627\u0626\u0644 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u067e\u0691\u06be\u0627 \u0646\u06c1\u06cc\u06ba \u062c\u0627 \u0633\u06a9\u0627\u06d4"
            ],
            "Export": [
                "\u0628\u0631\u0622\u0645\u062f \u06a9\u0631\u06cc\u06ba"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u06a9\u0633\u06cc \u062f\u0648\u0633\u0631\u06cc \u0633\u0627\u0626\u0679 \u067e\u0631 \u062f\u0631\u0622\u0645\u062f \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u067e\u0646\u06d2 \u0633\u0627\u0646\u0686\u06d2\u060c \u067e\u06cc\u0679\u0631\u0646 \u0627\u0648\u0631 \u0633\u0627\u0626\u0679 \u06a9\u0627 \u0688\u06cc\u0632\u0627\u0626\u0646 \u0628\u0637\u0648\u0631 \u0627\u06cc\u06a9 \u0641\u0627\u0626\u0644 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"
            ],
            "There are no templates or patterns to export yet.": [
                "\u0628\u0631\u0622\u0645\u062f \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0628\u06be\u06cc \u062a\u06a9 \u06a9\u0648\u0626\u06cc \u0679\u06cc\u0645\u067e\u0644\u06cc\u0679\u0633 \u06cc\u0627 \u0646\u0645\u0648\u0646\u06d2 \u0645\u0648\u062c\u0648\u062f \u0646\u06c1\u06cc\u06ba \u06c1\u06cc\u06ba\u06d4"
            ],
            "Include the settings": [
                "\u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba"
            ],
            "Download the export file": [
                "\u0628\u0631\u0622\u0645\u062f\u06cc \u0641\u0627\u0626\u0644 \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba"
            ],
            "Choose an export file": [
                "\u0627\u06cc\u06a9 \u0628\u0631\u0622\u0645\u062f\u06cc \u0641\u0627\u0626\u0644 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba %2$s \u0633\u06d2 %1$d \u0622\u0626\u0679\u0645 \u0634\u0627\u0645\u0644 \u06c1\u06d2\u06d4",
                "\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba %2$s \u0633\u06d2 %1$d \u0622\u0626\u0679\u0645\u0632 \u0645\u0648\u062c\u0648\u062f \u06c1\u06cc\u06ba\u06d4"
            ],
            "When an item with the same name already exists here": [
                "\u062c\u0628 \u0627\u0633\u06cc \u0646\u0627\u0645 \u06a9\u06cc \u06a9\u0648\u0626\u06cc \u0686\u06cc\u0632 \u067e\u06c1\u0644\u06d2 \u06c1\u06cc \u06cc\u06c1\u0627\u06ba \u0645\u0648\u062c\u0648\u062f \u06c1\u0648"
            ],
            "Keep the one on this site": [
                "\u0627\u0633 \u0633\u0627\u0626\u0679 \u067e\u0631 \u0645\u0648\u062c\u0648\u062f \u0631\u06a9\u06be\u06cc\u06ba"
            ],
            "Replace it with the imported one": [
                "\u0627\u0633\u06d2 \u062f\u0631\u0622\u0645\u062f \u0634\u062f\u06c1 \u0648\u0627\u0644\u06d2 \u0633\u06d2 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u06cc\u06ba"
            ],
            "Import a copy beside it": [
                "\u0627\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u06cc\u06a9 \u06a9\u0627\u067e\u06cc \u062f\u0631\u0622\u0645\u062f \u06a9\u0631\u06cc\u06ba"
            ],
            "Apply the settings in the file": [
                "\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba \u0645\u0648\u062c\u0648\u062f \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06a9\u0627 \u0627\u0637\u0644\u0627\u0642 \u06a9\u0631\u06cc\u06ba"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u062a\u0635\u0627\u0648\u06cc\u0631 \u06a9\u0648 \u0627\u0633 \u0633\u0627\u0626\u0679 \u06a9\u06cc \u0645\u06cc\u0688\u06cc\u0627 \u0644\u0627\u0626\u0628\u0631\u06cc\u0631\u06cc \u0645\u06cc\u06ba \u06a9\u0627\u067e\u06cc \u06a9\u0631\u06cc\u06ba"
            ],
            "Show what will happen": [
                "\u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba \u06a9\u06c1 \u06a9\u06cc\u0627 \u06c1\u0648\u06af\u0627"
            ]
        }
    }
}
