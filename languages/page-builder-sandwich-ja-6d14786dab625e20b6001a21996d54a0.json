            "Check and save": [
                "\u78ba\u8a8d\u3057\u3066\u4fdd\u5b58"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u30e1\u30fc\u30ea\u30f3\u30b0\u30ea\u30b9\u30c8\u30b5\u30fc\u30d3\u30b9\u3092\u4e00\u5ea6\u63a5\u7d9a\u3059\u308b\u3068\u3001\u4efb\u610f\u306e\u30d5\u30a9\u30fc\u30e0\u3067\u5165\u529b\u8005\u3092\u30ea\u30b9\u30c8\u306e\u3044\u305a\u308c\u304b\u306b\u8ffd\u52a0\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059 (\u30d5\u30a9\u30fc\u30e0\u30d6\u30ed\u30c3\u30af\u306e\u8a2d\u5b9a \u2192 \u9001\u4fe1\u5f8c)\u3002\u30ad\u30fc\u306f\u30b5\u30fc\u30d3\u30b9\u3067\u78ba\u8a8d\u3055\u308c\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u6697\u53f7\u5316\u3055\u308c\u3066\u4fdd\u5b58\u3055\u308c\u3001\u4e8c\u5ea6\u3068\u8868\u793a\u3055\u308c\u307e\u305b\u3093\u3002"
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u30b3\u30fc\u30c9\u3092\u4f7f\u7528\u305b\u305a\u306b\u3001\u30d5\u30a9\u30fc\u30e0\u306e\u9001\u4fe1\u3084\u30dc\u30bf\u30f3\u306e\u30af\u30ea\u30c3\u30af\u3092\u30a2\u30ca\u30ea\u30c6\u30a3\u30af\u30b9\u306b\u9001\u4fe1\u3057\u307e\u3059\u3002\u305d\u306e\u30b5\u30fc\u30d3\u30b9\u3092\u30b9\u30ad\u30c3\u30d7\u3059\u308b\u306b\u306f\u3001ID \u3092\u7a7a\u306e\u307e\u307e\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30dc\u30bf\u30f3\u306e\u8a73\u7d30\u30d1\u30cd\u30eb\u306b\u306f\u300c\u30b3\u30f3\u30d0\u30fc\u30b8\u30e7\u30f3\u30a4\u30d9\u30f3\u30c8\u300d\u30d5\u30a3\u30fc\u30eb\u30c9\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002Cookie \u30d0\u30ca\u30fc\u304c\u6709\u52b9\u306b\u306a\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u8a2a\u554f\u8005\u304c\u540c\u610f\u3059\u308b\u307e\u3067\u4f55\u3082\u8aad\u307f\u8fbc\u307e\u308c\u307e\u305b\u3093\u3002"
            ],
            "Google Analytics 4 measurement ID": [
                "Google Analytics 4 \u6e2c\u5b9a ID"
            ],
            "Google Tag Manager container ID": [
                "Google Tag Manager \u30b3\u30f3\u30c6\u30ca ID"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "Meta \u30d4\u30af\u30bb\u30eb ID (Meta \u30a4\u30d9\u30f3\u30c8\u30de\u30cd\u30fc\u30b8\u30e3\u306b\u8868\u793a\u3055\u308c\u308b\u756a\u53f7)"
            ],
            "Load these tags on my site": [
                "\u3053\u308c\u3089\u306e\u30bf\u30b0\u3092\u30de\u30a4\u30b5\u30a4\u30c8\u306b\u8aad\u307f\u8fbc\u3080"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u30c6\u30fc\u30de\u307e\u305f\u306f\u4ed6\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u306b\u3088\u3063\u3066\u3059\u3067\u306b\u8ffd\u52a0\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u306f\u7121\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a4\u30d9\u30f3\u30c8\u306f\u5f15\u304d\u7d9a\u304d\u9001\u4fe1\u3055\u308c\u307e\u3059\u3002"
            ],
            "Event name for form submissions": [
                "\u30d5\u30a9\u30fc\u30e0\u9001\u4fe1\u306e\u30a4\u30d9\u30f3\u30c8\u540d"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u30d0\u30ca\u30fc\u306f\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u3063\u3066\u30c7\u30b6\u30a4\u30f3\u3059\u308b\u30dd\u30c3\u30d7\u30a2\u30c3\u30d7\u3067\u3059\u3002\u305d\u306e\u30dc\u30bf\u30f3\u306f #consent-accept\u3001#consent-reject\u3001#consent-save \u306b\u30ea\u30f3\u30af\u3057\u307e\u3059 (\"save\" \u7528\u306b\u306f analytics \u3068 marketing \u3068\u3044\u3046\u540d\u524d\u306e\u30c1\u30a7\u30c3\u30af\u30dc\u30c3\u30af\u30b9\u3092\u4f7f\u7528)\u3002\u3069\u3053\u304b\u3089\u3067\u3082 #consent-open \u3078\u306e\u30ea\u30f3\u30af\u3092\u8a2d\u7f6e\u3059\u308b\u3068\u518d\u5ea6\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u8a2a\u554f\u8005\u304c\u540c\u610f\u3059\u308b\u307e\u3067\u3001\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u30bf\u30b0\u306f\u8aad\u307f\u8fbc\u307e\u308c\u305a\u3001Google Consent Mode \u306f \"denied\" \u306e\u307e\u307e\u306b\u306a\u308a\u3001\u6307\u5b9a\u3057\u305f\u30b9\u30af\u30ea\u30d7\u30c8\u306f\u30aa\u30d5\u306e\u307e\u307e\u306b\u306a\u308a\u307e\u3059\u3002"
            ],
            "Create a ready-made banner": [
                "\u65e2\u6210\u306e\u30d0\u30ca\u30fc\u3092\u4f5c\u6210"
            ],
            "Show a cookie banner": [
                "Cookie \u30d0\u30ca\u30fc\u3092\u8868\u793a"
            ],
            "Banner": [
                "\u30d0\u30ca\u30fc"
            ],
            "Choose a popup\u2026": [
                "\u30dd\u30c3\u30d7\u30a2\u30c3\u30d7\u3092\u9078\u629e\u2026"
            ],
            "%s (draft)": [
                "%s (\u4e0b\u66f8\u304d)"
            ],
            "Edit the banner": [
                "\u30d0\u30ca\u30fc\u3092\u7de8\u96c6"
            ],
            "Remember the choice for (days)": [
                "\u9078\u629e\u3092 (\u65e5\u6570) \u8a18\u61b6\u3059\u308b"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u6b27\u5dde\u9023\u5408\u3001EEA\u3001\u82f1\u56fd\u4ee5\u5916: \u8a2a\u554f\u8005\u304c\u62d2\u5426\u3059\u308b\u307e\u3067\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u3092\u8aad\u307f\u8fbc\u3080"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u30aa\u30d5: \u3059\u3079\u3066\u306e\u8a2a\u554f\u8005\u304c\u6700\u521d\u306b\u540c\u610f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059 (\u6700\u3082\u53b3\u683c\u306a\u30eb\u30fc\u30eb\u3067\u3042\u308a\u3001\u30c7\u30d5\u30a9\u30eb\u30c8\u3067\u3059)\u3002\u30aa\u30f3: \u30db\u30b9\u30c8\u307e\u305f\u306f CDN \u304c\u8a2a\u554f\u8005\u306e\u56fd\u3092\u5831\u544a\u3057 (\u4f8b: Cloudflare \u306e CF-IPCountry \u30d8\u30c3\u30c0\u30fc)\u3001\u305d\u308c\u304c EU\u3001EEA\u3001\u82f1\u56fd\u3001\u30b9\u30a4\u30b9\u4ee5\u5916\u3067\u3042\u308b\u5834\u5408\u306e\u307f\u3067\u3059\u3002\u30d0\u30ca\u30fc\u306f\u5f15\u304d\u7d9a\u304d\u8868\u793a\u3055\u308c\u3001\u4e0d\u660e\u306a\u56fd\u306f EU \u5185\u3068\u3057\u3066\u6271\u308f\u308c\u307e\u3059\u3002"
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u540c\u610f\u304c\u5f97\u3089\u308c\u308b\u307e\u3067\u4fdd\u7559\u3059\u308b\u305d\u306e\u4ed6\u306e\u30b9\u30af\u30ea\u30d7\u30c8 (handle:analytics \u307e\u305f\u306f handle:marketing\u3001\u30ab\u30f3\u30de\u533a\u5207\u308a)"
            ],
