            ],
            "Square": [
                "\u0e2a\u0e35\u0e48\u0e40\u0e2b\u0e25\u0e35\u0e48\u0e22\u0e21\u0e08\u0e31\u0e15\u0e38\u0e23\u0e31\u0e2a"
            ],
            "Portrait": [
                "\u0e41\u0e19\u0e27\u0e15\u0e31\u0e49\u0e07"
            ],
            "Generate and add": [
