            ],
            "CSS helper": [
                "\u0e15\u0e31\u0e27\u0e0a\u0e48\u0e27\u0e22 CSS"
            ],
            "Select a block to work on its custom CSS.": [
                "\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e1a\u0e25\u0e47\u0e2d\u0e01\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e1b\u0e23\u0e31\u0e1a\u0e41\u0e15\u0e48\u0e07 CSS \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21"
            ],
            "What should the CSS do?": [
                "CSS \u0e04\u0e27\u0e23\u0e17\u0e33\u0e2d\u0e30\u0e44\u0e23?"
            ],
            "Write": [
                "\u0e40\u0e02\u0e35\u0e22\u0e19"
            ],
            "Fix": [
                "\u0e41\u0e01\u0e49\u0e44\u0e02"
            ],
            "Explain": [
                "\u0e2d\u0e18\u0e34\u0e1a\u0e32\u0e22"
            ],
            "Use this CSS": [
                "\u0e43\u0e0a\u0e49 CSS \u0e19\u0e35\u0e49"
            ],
            "Image without alt text": [
                "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e17\u0e35\u0e48\u0e44\u0e21\u0e48\u0e21\u0e35\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e01\u0e33\u0e01\u0e31\u0e1a\u0e20\u0e32\u0e1e"
            ],
            "Heading skips a level": [
