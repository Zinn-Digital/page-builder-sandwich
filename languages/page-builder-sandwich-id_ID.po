msgstr "https://zinndigital.com/wordpress-plugins/page-builder-sandwich"

#. Description of the plugin
#: class-plugin.php
msgid "The foundation release of the rebuilt Page Builder Sandwich: a settings and About screen, a footprint-free front-end output layer, and one sample content block."
msgstr "Rilis perdana dari Page Builder Sandwich yang dibangun ulang: layar pengaturan dan Tentang, lapisan output front-end yang bebas footprint, dan satu blok konten sampel."

#. Author of the plugin
#: class-plugin.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
