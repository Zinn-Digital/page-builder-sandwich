            ],
            "Build these pages as drafts": [
                "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u044d\u0442\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u043a\u0430\u043a \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438"
            ],
            "Create with AI": [
