            ],
            "%1$d fixed, %2$d left for you. The page was saved; its previous version is in the revisions.": [
                "\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e: %1$d, \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0434\u043b\u044f \u0432\u0430\u0441: %2$d. \u0421\u0442\u0440\u0430\u043d\u0438\u0446\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430; \u0435\u0451 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0440\u0435\u0434\u0430\u043a\u0446\u0438\u044f\u0445."
            ],
            "Add a section": [
