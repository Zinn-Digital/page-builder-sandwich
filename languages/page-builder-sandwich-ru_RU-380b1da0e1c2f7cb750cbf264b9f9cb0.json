            ],
            "For example: \"make the hero shorter and friendlier\", \"add an FAQ about delivery after the pricing\", \"translate this section into Spanish\". Select a block first to point at it.": [
                "\u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440: \u00ab\u0441\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u0431\u0430\u043d\u043d\u0435\u0440 \u043a\u043e\u0440\u043e\u0447\u0435 \u0438 \u0434\u0440\u0443\u0436\u0435\u043b\u044e\u0431\u043d\u0435\u0435\u00bb, \u00ab\u0434\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0438 \u043e\u0442\u0432\u0435\u0442\u044b \u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435 \u043f\u043e\u0441\u043b\u0435 \u0446\u0435\u043d\u00bb, \u00ab\u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0438\u0442\u0435 \u044d\u0442\u043e\u0442 \u0440\u0430\u0437\u0434\u0435\u043b \u043d\u0430 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0439\u00bb. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u043b\u043e\u043a, \u0447\u0442\u043e\u0431\u044b \u0443\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430 \u043d\u0435\u0433\u043e."
            ],
            "Ask": [
