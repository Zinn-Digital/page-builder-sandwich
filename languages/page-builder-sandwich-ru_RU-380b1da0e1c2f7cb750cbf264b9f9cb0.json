            ],
            "Describe a component (\"a team member card with photo, name, role and a short bio\"). It is saved to My patterns, with its texts editable on every page that uses it.": [
                "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 (\u00ab\u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0441 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439, \u0438\u043c\u0435\u043d\u0435\u043c, \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c\u044e \u0438 \u043a\u0440\u0430\u0442\u043a\u043e\u0439 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u0435\u0439\u00bb). \u041e\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u00ab\u041c\u043e\u0438 \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u044b\u00bb, \u043f\u0440\u0438 \u044d\u0442\u043e\u043c \u0435\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u044b \u043c\u043e\u0436\u043d\u043e \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0430 \u043a\u0430\u0436\u0434\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435, \u0433\u0434\u0435 \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f."
            ],
            "Block created and added to the page.": [
