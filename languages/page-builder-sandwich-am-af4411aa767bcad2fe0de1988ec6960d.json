            ],
            "Built by Neil Lock, CEO of Zinn Digital\u00ae Ltd": [
                "\u1260Zinn Digital\u00ae Ltd \u12cb\u1293 \u1235\u122b \u12a0\u1235\u1348\u1343\u121a \u1260Neil Lock \u12e8\u1270\u1308\u1290\u1263"
            ],
