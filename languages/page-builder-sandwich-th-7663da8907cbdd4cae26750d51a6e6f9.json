            ],
            "In your Cloudflare dashboard, open R2 Object Storage and create a bucket (for example \u201cmy-pbs-library\u201d). Keep it private: do not connect a public domain.": [
                "\u0e43\u0e19\u0e41\u0e14\u0e0a\u0e1a\u0e2d\u0e23\u0e4c\u0e14 Cloudflare \u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 \u0e43\u0e2b\u0e49\u0e40\u0e1b\u0e34\u0e14 R2 Object Storage \u0e41\u0e25\u0e30\u0e2a\u0e23\u0e49\u0e32\u0e07 bucket \u0e02\u0e36\u0e49\u0e19\u0e21\u0e32 (\u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u201cmy-pbs-library\u201d) \u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e43\u0e2b\u0e49\u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e48\u0e27\u0e19\u0e15\u0e31\u0e27: \u0e2d\u0e22\u0e48\u0e32\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e42\u0e14\u0e40\u0e21\u0e19\u0e2a\u0e32\u0e18\u0e32\u0e23\u0e13\u0e30"
            ],
            "Open \u201cManage API tokens\u201d in R2 and create an API token with \u201cObject Read & Write\u201d permission, limited to that one bucket.": [
                "\u0e40\u0e1b\u0e34\u0e14 \u201c\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e42\u0e17\u0e40\u0e04\u0e47\u0e19 API\u201d \u0e43\u0e19 R2 \u0e41\u0e25\u0e30\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e42\u0e17\u0e40\u0e04\u0e47\u0e19 API \u0e17\u0e35\u0e48\u0e21\u0e35\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e4c \u201c\u0e2d\u0e48\u0e32\u0e19\u0e41\u0e25\u0e30\u0e40\u0e02\u0e35\u0e22\u0e19\u0e2d\u0e2d\u0e1a\u0e40\u0e08\u0e47\u0e01\u0e15\u0e4c\u201d \u0e42\u0e14\u0e22\u0e08\u0e33\u0e01\u0e31\u0e14\u0e44\u0e27\u0e49\u0e40\u0e09\u0e1e\u0e32\u0e30\u0e1a\u0e31\u0e04\u0e40\u0e01\u0e47\u0e15\u0e19\u0e31\u0e49\u0e19\u0e40\u0e1e\u0e35\u0e22\u0e07\u0e2d\u0e31\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27"
            ],
            "Copy the Access Key ID and the Secret Access Key it shows (the secret is shown only once).": [
                "\u0e04\u0e31\u0e14\u0e25\u0e2d\u0e01 Access Key ID \u0e41\u0e25\u0e30 Secret Access Key \u0e17\u0e35\u0e48\u0e41\u0e2a\u0e14\u0e07\u0e02\u0e36\u0e49\u0e19\u0e21\u0e32 (\u0e23\u0e2b\u0e31\u0e2a\u0e25\u0e31\u0e1a\u0e08\u0e30\u0e41\u0e2a\u0e14\u0e07\u0e43\u0e2b\u0e49\u0e40\u0e2b\u0e47\u0e19\u0e40\u0e1e\u0e35\u0e22\u0e07\u0e04\u0e23\u0e31\u0e49\u0e07\u0e40\u0e14\u0e35\u0e22\u0e27)"
            ],
            "Copy the S3 endpoint for your account. It looks like https:\/\/<account-id>.r2.cloudflarestorage.com. Region is \u201cauto\u201d.": [
                "\u0e04\u0e31\u0e14\u0e25\u0e2d\u0e01 S3 \u0e1b\u0e25\u0e32\u0e22\u0e17\u0e32\u0e07\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1a\u0e31\u0e0d\u0e0a\u0e35\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 \u0e0b\u0e36\u0e48\u0e07\u0e08\u0e30\u0e21\u0e35\u0e25\u0e31\u0e01\u0e29\u0e13\u0e30\u0e14\u0e31\u0e07\u0e19\u0e35\u0e49 https:\/\/<account-id>.r2.cloudflarestorage.com \u0e20\u0e39\u0e21\u0e34\u0e20\u0e32\u0e04\u0e04\u0e37\u0e2d \u201cauto\u201d"
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d. Switch the library to your storage only when the test passes.": [
                "\u0e27\u0e32\u0e07\u0e04\u0e48\u0e32\u0e14\u0e49\u0e32\u0e19\u0e25\u0e48\u0e32\u0e07 \u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01 \u0e08\u0e32\u0e01\u0e19\u0e31\u0e49\u0e19\u0e01\u0e14 \u201c\u0e17\u0e14\u0e2a\u0e2d\u0e1a\u0e01\u0e32\u0e23\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u201d \u0e2a\u0e25\u0e31\u0e1a\u0e44\u0e25\u0e1a\u0e23\u0e32\u0e23\u0e35\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e1e\u0e37\u0e49\u0e19\u0e17\u0e35\u0e48\u0e40\u0e01\u0e47\u0e1a\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e09\u0e1e\u0e32\u0e30\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e17\u0e14\u0e2a\u0e2d\u0e1a\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08\u0e40\u0e17\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19"
            ],
            "Create a private bucket with your provider (Amazon S3, Backblaze B2, Wasabi, MinIO or any S3-compatible service).": [
                "\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1e\u0e32\u0e2a\u0e40\u0e27\u0e34\u0e23\u0e4c\u0e14\u0e2a\u0e48\u0e27\u0e19\u0e15\u0e31\u0e27\u0e01\u0e31\u0e1a\u0e1c\u0e39\u0e49\u0e43\u0e2b\u0e49\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 (Amazon S3, Backblaze B2, Wasabi, MinIO \u0e2b\u0e23\u0e37\u0e2d\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e43\u0e14\u0e46 \u0e17\u0e35\u0e48\u0e23\u0e2d\u0e07\u0e23\u0e31\u0e1a S3)"
            ],
            "Create an access key that can read, write and delete objects in that bucket only.": [
                "\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e04\u0e35\u0e22\u0e4c\u0e01\u0e32\u0e23\u0e40\u0e02\u0e49\u0e32\u0e16\u0e36\u0e07\u0e17\u0e35\u0e48\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e2d\u0e48\u0e32\u0e19 \u0e40\u0e02\u0e35\u0e22\u0e19 \u0e41\u0e25\u0e30\u0e25\u0e1a\u0e2d\u0e2d\u0e1a\u0e40\u0e08\u0e47\u0e01\u0e15\u0e4c\u0e43\u0e19\u0e16\u0e31\u0e07\u0e40\u0e01\u0e47\u0e1a\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e19\u0e31\u0e49\u0e19\u0e40\u0e17\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19"
            ],
            "Find the S3 endpoint (for Amazon S3: https:\/\/s3.<region>.amazonaws.com) and the bucket\u2019s region.": [
                "\u0e04\u0e49\u0e19\u0e2b\u0e32 S3 endpoint (\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a Amazon S3: https:\/\/s3.<region>.amazonaws.com) \u0e41\u0e25\u0e30\u0e20\u0e39\u0e21\u0e34\u0e20\u0e32\u0e04\u0e02\u0e2d\u0e07\u0e1a\u0e31\u0e04\u0e40\u0e01\u0e47\u0e15"
