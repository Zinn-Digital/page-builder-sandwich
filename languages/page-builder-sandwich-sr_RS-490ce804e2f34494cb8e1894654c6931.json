            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u0414\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 \u043d\u0430 \u043a\u043e\u0458\u0438 \u0441\u0435 \u043c\u043e\u0436\u0435 \u043a\u043b\u0438\u043a\u043d\u0443\u0442\u0438 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0441\u0435 \u0434\u043e\u045b\u0438 \u043f\u043e\u043c\u043e\u045b\u0443 \u0442\u0430\u0441\u0442\u0430\u0442\u0443\u0440\u0435. \u041a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0435 \u043f\u0440\u0430\u0432\u043e \u0434\u0443\u0433\u043c\u0435 \u0438\u043b\u0438 \u0432\u0435\u0437\u0443."
