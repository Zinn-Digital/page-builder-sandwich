            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u043a\u043b\u0438\u043a\u043d\u0438\u0442\u0435 \u043e\u0432\u0434\u0435,\u043e\u0432\u0434\u0435,\u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0458\u0442\u0435 \u0432\u0438\u0448\u0435,\u0432\u0438\u0448\u0435,\u0432\u0435\u0437\u0430,\u043e\u0432\u0430 \u0432\u0435\u0437\u0430,\u0441\u0430\u0437\u043d\u0430\u0458\u0442\u0435 \u0432\u0438\u0448\u0435,\u0438\u0434\u0438"
