            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u12eb\u120d\u1270\u1323\u122b HTML \u12e8\u121b\u12a8\u120d \u1348\u1243\u12f5 \u12eb\u120b\u1278\u12cd \u1270\u1320\u1243\u121a\u12ce\u127d \u1265\u127b \u1265\u1301 CSS \u1218\u1208\u12c8\u1325 \u12ed\u127d\u120b\u1209\u1362"
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u12a8\u12da\u1205 CSS \u12cd\u1235\u1325 \u12e8\u1270\u12c8\u1230\u1290\u12cd \u1325\u1245\u121d \u120b\u12ed \u12a0\u12ed\u12cd\u120d\u121d\u1361- \u1208\u12f0\u1205\u1295\u1290\u1275 \u1232\u1263\u120d @import\u1363 expression()\u1363 javascript: URLs\u1363 \"<\" \u12a5\u1293 \u12eb\u120d\u1270\u1218\u1323\u1320\u1291 \u1245\u1295\u134e\u127d \u1270\u12c8\u130d\u12f0\u12cb\u120d\u1362"
            ],
            "Page CSS": [
                "\u12e8\u1308\u133d CSS"
            ],
            "Global classes": [
                "\u12a0\u1320\u1243\u120b\u12ed \u12ad\u134d\u120e\u127d"
            ],
            "Classes": [
                "\u12ad\u134d\u120e\u127d"
            ],
            "Create classes in Site design, then add them here.": [
                "\u12ad\u134d\u120e\u127d\u1295 \u1260\u1323\u1262\u12eb \u1295\u12f5\u134d \u12cd\u1235\u1325 \u12ed\u134d\u1320\u1229\u1363 \u12a8\u12da\u12eb \u12a5\u12da\u1205 \u12eb\u12ad\u120f\u1278\u12cd\u1362"
            ],
            "Custom CSS": [
                "\u1265\u1301 CSS"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u1208\u12da\u1205 \u12a0\u12ab\u120d \u12f0\u1295\u1266\u127d\u1295 \u12ed\u133b\u1349\u1362 \"selector\" \u121b\u1208\u1275 \u12ed\u1205 \u12a0\u12ab\u120d \u121b\u1208\u1275 \u1290\u12cd\u1363 \u1208\u121d\u1233\u120c selector:hover { opacity: .8 } \u2014 \u1270\u122b \u1218\u130d\u1208\u132b\u12ce\u127d \u1260\u122b\u1231 \u12a0\u12ab\u120d \u120b\u12ed \u1270\u130d\u1263\u122b\u12ca \u12ed\u1206\u1293\u1209\u1362"
            ],
            "CSS for this page": [
                "\u1208\u12da\u1205 \u1308\u133d \u12e8\u121a\u1206\u1295 CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u12e8\u1323\u1262\u12eb\u12cd \u1245\u1326\u127d \u12a8\u1270\u132b\u1291 \u1260\u128b\u120b \u1260\u12da\u1205 \u1308\u133d \u120b\u12ed \u1265\u127b \u1270\u132d\u1297\u120d\u1362 \u12a8\u1308\u1339 \u130b\u122d \u1270\u1240\u121d\u1327\u120d\u1362"
            ]
        }
