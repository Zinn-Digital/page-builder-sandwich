            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u0422\u043e\u0432\u0430 H%1$d \u043f\u0440\u0435\u0441\u043a\u0430\u0447\u0430 \u043d\u0438\u0432\u043e; \u043f\u0440\u0435\u0434\u0445\u043e\u0434\u043d\u043e\u0442\u043e \u0435 H%2$d. \u041d\u0430\u043f\u0440\u0430\u0432\u0435\u0442\u0435 \u0433\u043e H%3$d."
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u0422\u043e\u0432\u0430 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043d\u044f\u043c\u0430 \u0430\u043b\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u0435\u043d \u0442\u0435\u043a\u0441\u0442. \u041e\u043f\u0438\u0448\u0435\u0442\u0435 \u0433\u043e \u0438\u043b\u0438 \u0433\u043e \u043c\u0430\u0440\u043a\u0438\u0440\u0430\u0439\u0442\u0435 \u043a\u0430\u0442\u043e \u0434\u0435\u043a\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u043e, \u0430\u043a\u043e \u043d\u0435 \u0434\u043e\u0431\u0430\u0432\u044f \u043d\u0438\u0449\u043e \u043d\u043e\u0432\u043e."
            ],
            "Close panel": [
                "\u0417\u0430\u0442\u0432\u0430\u0440\u044f\u043d\u0435 \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0430"
