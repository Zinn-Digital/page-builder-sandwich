            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0430\u0442\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043e\u0442\u043a\u0440\u0438\u0432\u0430 \u043c\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438, \u043d\u043e \u043d\u0435 \u0432\u0441\u0438\u0447\u043a\u0438. \u0421\u044a\u0449\u043e \u0442\u0430\u043a\u0430 \u0438\u0437\u043f\u0440\u043e\u0431\u0432\u0430\u0439\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430 \u0441\u0430\u043c\u043e \u0441 \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430 \u0438 \u0441 \u0435\u043a\u0440\u0430\u043d\u0435\u043d \u0447\u0435\u0442\u0435\u0446."
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u041a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u044a\u0442 \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u0430 \u0435 %1$s:1; \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0435 \u0434\u0430 \u0431\u044a\u0434\u0435 \u043f\u043e\u043d\u0435 %2$s:1, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0447\u0435\u0442\u0435."
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u0449\u0440\u0430\u043a\u043d\u0435\u0442\u0435 \u0442\u0443\u043a,\u0442\u0443\u043a,\u043f\u0440\u043e\u0447\u0435\u0442\u0435\u0442\u0435 \u043f\u043e\u0432\u0435\u0447\u0435,\u043e\u0449\u0435,\u0432\u0440\u044a\u0437\u043a\u0430,\u0442\u0430\u0437\u0438 \u0432\u0440\u044a\u0437\u043a\u0430,\u043d\u0430\u0443\u0447\u0435\u0442\u0435 \u043f\u043e\u0432\u0435\u0447\u0435,\u043e\u0442\u0438\u0434\u0435\u0442\u0435"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u0412\u0440\u044a\u0437\u043a\u0430\u0442\u0430 \u043d\u044f\u043c\u0430 \u0442\u0435\u043a\u0441\u0442, \u0442\u0430\u043a\u0430 \u0447\u0435 \u0435\u043a\u0440\u0430\u043d\u043d\u0438\u044f\u0442 \u0447\u0435\u0442\u0435\u0446 \u0441\u044a\u043e\u0431\u0449\u0430\u0432\u0430 \u0441\u0430\u043c\u043e \u201e\u0432\u0440\u044a\u0437\u043a\u0430\u201c. \u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u0438\u043b\u0438 \u0435\u0442\u0438\u043a\u0435\u0442."
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\u0422\u0435\u043a\u0441\u0442\u044a\u0442 \u043d\u0430 \u0432\u0440\u044a\u0437\u043a\u0430\u0442\u0430 \u201e%s\u201c \u043d\u0435 \u043f\u043e\u0441\u043e\u0447\u0432\u0430 \u043d\u0430\u043a\u044a\u0434\u0435 \u0432\u043e\u0434\u0438. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0432\u0430 \u043e\u043f\u0438\u0448\u0435\u0442\u0435 \u0434\u0435\u0441\u0442\u0438\u043d\u0430\u0446\u0438\u044f\u0442\u0430."
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u0415\u043b\u0435\u043c\u0435\u043d\u0442 \u0438\u043c\u0430 \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u043d\u0430 \u0441\u0442\u043e\u0439\u043d\u043e\u0441\u0442 \u0437\u0430 tabindex, \u043a\u043e\u0435\u0442\u043e \u043f\u0440\u043e\u043c\u0435\u043d\u044f \u0440\u0435\u0434\u0430 \u043d\u0430 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f \u0441 \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430 \u0441\u043f\u0440\u044f\u043c\u043e \u0440\u0435\u0434\u0430 \u043d\u0430 \u0447\u0435\u0442\u0435\u043d\u0435. \u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 0 \u0438\u043b\u0438 \u0433\u043e \u043f\u0440\u0435\u043c\u0430\u0445\u043d\u0435\u0442\u0435."
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u0414\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442, \u0432\u044a\u0440\u0445\u0443 \u043a\u043e\u0439\u0442\u043e \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0449\u0440\u0430\u043a\u043d\u0435, \u043d\u0435 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0435 \u0441 \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430\u0442\u0430. \u0418\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0439\u0442\u0435 \u0438\u0441\u0442\u0438\u043d\u0441\u043a\u0438 \u0431\u0443\u0442\u043e\u043d \u0438\u043b\u0438 \u0432\u0440\u044a\u0437\u043a\u0430."
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u0412\u0433\u0440\u0430\u0434\u0435\u043d\u0430\u0442\u0430 \u0440\u0430\u043c\u043a\u0430 \u043d\u044f\u043c\u0430 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435, \u0442\u0430\u043a\u0430 \u0447\u0435 \u0435\u043a\u0440\u0430\u043d\u043d\u0438\u044f\u0442 \u0447\u0435\u0442\u0435\u0446 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0434\u0430 \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441\u0435 \u043a\u0430\u043a\u0432\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0432\u0430 \u0442\u044f."
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u041f\u043e\u043b\u0435 \u043e\u0442 \u0444\u043e\u0440\u043c\u0443\u043b\u044f\u0440 \u043d\u044f\u043c\u0430 \u0435\u0442\u0438\u043a\u0435\u0442, \u0442\u0430\u043a\u0430 \u0447\u0435 \u0446\u0435\u043b\u0442\u0430 \u043c\u0443 \u043d\u0435 \u0441\u0435 \u043e\u043f\u043e\u0432\u0435\u0441\u0442\u044f\u0432\u0430."
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u0422\u043e\u0432\u0430 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0435 \u043f\u0440\u0430\u0437\u043d\u043e. \u041f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438\u0442\u0435 \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u043d\u0438 \u0447\u0435\u0442\u0446\u0438 \u043d\u0430\u0432\u0438\u0433\u0438\u0440\u0430\u0442 \u043f\u043e \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u044f; \u043f\u0440\u0435\u043c\u0430\u0445\u043d\u0435\u0442\u0435 \u0433\u043e \u0438\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u0442\u0435\u043a\u0441\u0442."
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
