                "domain": "messages",
                "lang": "mr",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u092b\u0915\u094d\u0924 \u0905\u0928\u092b\u093f\u0932\u094d\u091f\u0930\u094d\u0921 HTML \u091c\u094b\u0921\u0942 \u0936\u0915\u0923\u093e\u0930\u0947 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947\u091a \u0915\u0938\u094d\u091f\u092e CSS \u092c\u0926\u0932\u0942 \u0936\u0915\u0924\u093e\u0924."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u092f\u093e CSS \u092e\u0927\u0940\u0932 \u0915\u093e\u0939\u0940 \u092d\u093e\u0917 \u0935\u093e\u092a\u0930\u0932\u093e \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940: \u0938\u0941\u0930\u0915\u094d\u0937\u0947\u0938\u093e\u0920\u0940 @import, expression(), javascript: URLs, \"<\" \u0906\u0923\u093f \u0905\u0938\u0902\u0924\u0941\u0932\u093f\u0924 \u092c\u094d\u0930\u0945\u0915\u0947\u091f\u094d\u0938 \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u0932\u0947 \u0906\u0939\u0947\u0924."
            ],
            "Page CSS": [
                "\u092a\u0947\u091c CSS"
            ],
            "Global classes": [
                "\u091c\u093e\u0917\u0924\u093f\u0915 \u0935\u0930\u094d\u0917"
            ],
            "Classes": [
                "\u0935\u0930\u094d\u0917"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0938\u093e\u0907\u091f \u0921\u093f\u091d\u093e\u0907\u0928\u092e\u0927\u094d\u092f\u0947 \u0915\u094d\u0932\u093e\u0938\u0947\u0938 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e, \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0924\u0947 \u092f\u0947\u0925\u0947 \u091c\u094b\u0921\u093e."
            ],
            "Custom CSS": [
                "\u0915\u0938\u094d\u091f\u092e \u0938\u0940\u090f\u0938\u090f\u0938"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u092f\u093e \u0918\u091f\u0915\u093e\u0938\u093e\u0920\u0940 \u0928\u093f\u092f\u092e \u0932\u093f\u0939\u093e. \"selector\" \u092e\u094d\u0939\u0923\u091c\u0947 \u0939\u093e \u0918\u091f\u0915, \u0909\u0926\u093e. selector:hover { opacity: .8 } \u2014 \u0938\u093e\u0927\u0940 \u0921\u093f\u0915\u094d\u0932\u0930\u0947\u0936\u0928\u094d\u0938 \u0925\u0947\u091f \u0918\u091f\u0915\u093e\u0932\u093e \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u093e\u0924."
            ],
            "CSS for this page": [
                "\u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0938\u093e\u0920\u0940 CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0915\u0947\u0935\u0933 \u092f\u093e \u092a\u093e\u0928\u093e\u0935\u0930, \u0938\u093e\u0907\u091f\u091a\u094d\u092f\u093e \u0936\u0948\u0932\u0940\u0902\u0928\u0902\u0924\u0930 \u0932\u094b\u0921 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0947. \u092a\u093e\u0928\u093e\u0938\u0939 \u0938\u0947\u0935\u094d\u0939 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0947."
            ]
        }
    }
}
