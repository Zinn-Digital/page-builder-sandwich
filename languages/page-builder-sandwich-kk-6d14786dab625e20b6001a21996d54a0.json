                "\u0414\u0430\u0439\u044b\u043d \u0431\u0430\u043d\u043d\u0435\u0440 \u0436\u0430\u0441\u0430\u0443"
            ],
            "Show a cookie banner": [
                "Cookie \u0431\u0430\u043d\u043d\u0435\u0440\u0456\u043d \u043a\u04e9\u0440\u0441\u0435\u0442\u0443"
