            "Check and save": [
                "\u062a\u062d\u0642\u0642 \u0648\u0627\u062d\u0641\u0638"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u0642\u0645 \u0628\u0631\u0628\u0637 \u062e\u062f\u0645\u0629 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0628\u0631\u064a\u062f\u064a\u0629 \u0644\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u061b \u0648\u0628\u0639\u062f \u0630\u0644\u0643 \u064a\u0645\u0643\u0646 \u0644\u0623\u064a \u0646\u0645\u0648\u0630\u062c \u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0627\u0644\u0630\u064a\u0646 \u064a\u0645\u0644\u0624\u0648\u0646\u0647 \u0625\u0644\u0649 \u0625\u062d\u062f\u0649 \u0642\u0648\u0627\u0626\u0645\u0643 (\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0643\u062a\u0644\u0629 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u2190 \u0628\u0639\u062f \u0627\u0644\u0625\u0631\u0633\u0627\u0644). \u064a\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0628\u0648\u0627\u0633\u0637\u0629 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0648\u064a\u062a\u0645 \u062a\u062e\u0632\u064a\u0646\u0647\u0627 \u0645\u0634\u0641\u0631\u0629 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639 \u0648\u0644\u0646 \u062a\u064f\u0639\u0631\u0636 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0639\u0644\u0649 \u0627\u0644\u0625\u0637\u0644\u0627\u0642."
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u0623\u0631\u0633\u0644 \u0639\u0645\u0644\u064a\u0627\u062a \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0648\u0646\u0642\u0631\u0627\u062a \u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u0625\u0644\u0649 \u062a\u062d\u0644\u064a\u0644\u0627\u062a\u0643 \u062f\u0648\u0646 \u0627\u0644\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0628\u0631\u0645\u062c\u0629. \u0627\u062a\u0631\u0643 \u0627\u0644\u0645\u0639\u0631\u0651\u0641 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u062a\u062e\u0637\u064a \u062a\u0644\u0643 \u0627\u0644\u062e\u062f\u0645\u0629. \u062a\u062d\u0635\u0644 \u0627\u0644\u0623\u0632\u0631\u0627\u0631 \u0639\u0644\u0649 \u062d\u0642\u0644 \"\u062d\u062f\u062b \u0627\u0644\u0625\u062d\u0627\u0644\u0629 \u0627\u0644\u0646\u0627\u062c\u062d\u0629\" \u0641\u064a \u0627\u0644\u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u0627. \u0639\u0646\u062f \u062a\u0641\u0639\u064a\u0644 \u0634\u0631\u064a\u0637 \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637\u060c \u0644\u0646 \u064a\u062a\u0645 \u062a\u062d\u0645\u064a\u0644 \u0623\u064a \u0634\u064a\u0621 \u062d\u062a\u0649 \u064a\u0648\u0627\u0641\u0642 \u0627\u0644\u0632\u0627\u0626\u0631."
            ],
            "Google Analytics 4 measurement ID": [
