            ],
            "Load these tags on my site": [
                "\u062a\u062d\u0645\u064a\u0644 \u0647\u0630\u0647 \u0627\u0644\u0648\u0633\u0648\u0645 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639\u064a"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0642\u0645 \u0628\u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0642\u0627\u0644\u0628\u0643 \u0623\u0648 \u0625\u0636\u0627\u0641\u0629 \u0623\u062e\u0631\u0649 \u062a\u0636\u064a\u0641\u0647\u0627 \u0628\u0627\u0644\u0641\u0639\u0644\u061b \u0645\u0639 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0623\u062d\u062f\u0627\u062b."
            ],
            "Event name for form submissions": [
                "\u0627\u0633\u0645 \u0627\u0644\u062d\u062f\u062b \u0644\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0646\u0645\u0627\u0630\u062c"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0627\u0644\u0644\u0627\u0641\u062a\u0629 \u0639\u0628\u0627\u0631\u0629 \u0639\u0646 \u0646\u0627\u0641\u0630\u0629 \u0645\u0646\u0628\u062b\u0642\u0629 \u062a\u0642\u0648\u0645 \u0628\u062a\u0635\u0645\u064a\u0645\u0647\u0627 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629 (blocks). \u062a\u0631\u062a\u0628\u0637 \u0623\u0632\u0631\u0627\u0631\u0647\u0627 \u0628\u0640 #consent-accept \u0648#consent-reject \u0648#consent-save (\u0645\u0639 \u0645\u0631\u0628\u0639\u0627\u062a \u0627\u062e\u062a\u064a\u0627\u0631 \u062a\u0633\u0645\u0649 analytics \u0648marketing \u0644\u0640 \"save\")\u061b \u0648\u064a\u0624\u062f\u064a \u0648\u062c\u0648\u062f \u0631\u0627\u0628\u0637 \u0625\u0644\u0649 #consent-open \u0641\u064a \u0623\u064a \u0645\u0643\u0627\u0646 \u0625\u0644\u0649 \u0625\u0638\u0647\u0627\u0631\u0647\u0627 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. \u0625\u0644\u0649 \u0623\u0646 \u064a\u0648\u0627\u0641\u0642 \u0627\u0644\u0632\u0627\u0626\u0631\u060c \u0644\u0646 \u064a\u062a\u0645 \u062a\u062d\u0645\u064a\u0644 \u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062a\u0628\u0639\u060c \u0648\u0633\u064a\u0638\u0644 Google Consent Mode \u0645\u0636\u0628\u0648\u0637\u064b\u0627 \u0639\u0644\u0649 \"denied\"\u060c \u0648\u0633\u062a\u0638\u0644 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0646\u0635\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062f\u0631\u062c\u0647\u0627 \u063a\u064a\u0631 \u0645\u0641\u0639\u0644\u0629."
            ],
            "Create a ready-made banner": [
                "\u0625\u0646\u0634\u0627\u0621 \u0628\u0627\u0646\u0631 \u062c\u0627\u0647\u0632"
            ],
            "Show a cookie banner": [
                "\u0625\u0638\u0647\u0627\u0631 \u0634\u0631\u064a\u0637 \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637"
            ],
            "Banner": [
                "\u0628\u0627\u0646\u0631"
            ],
            "Choose a popup\u2026": [
                "\u0627\u062e\u062a\u0631 \u0646\u0627\u0641\u0630\u0629 \u0645\u0646\u0628\u062b\u0642\u0629\u2026"
            ],
            "%s (draft)": [
                "%s (\u0645\u0633\u0648\u062f\u0629)"
            ],
            "Edit the banner": [
                "\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0634\u0639\u0627\u0631"
            ],
            "Remember the choice for (days)": [
                "\u062a\u0630\u0643\u0631 \u0627\u0644\u062e\u064a\u0627\u0631 \u0644\u0645\u062f\u0629 (\u0623\u064a\u0627\u0645)"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u062e\u0627\u0631\u062c \u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a \u0648\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a\u0629 \u0648\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629: \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u062a\u062a\u0628\u0639 \u062d\u062a\u0649 \u064a\u0631\u0641\u0636 \u0627\u0644\u0632\u0627\u0626\u0631"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u0645\u0639\u0637\u0644: \u064a\u062c\u0628 \u0639\u0644\u0649 \u0643\u0644 \u0632\u0627\u0626\u0631 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0623\u0648\u0644\u0627\u064b (\u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0635\u0631\u0627\u0645\u0629\u060c \u0648\u0647\u064a \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a). \u0645\u0641\u0639\u0651\u0644: \u0641\u0642\u0637 \u0639\u0646\u062f\u0645\u0627 \u064a\u0628\u0644\u063a \u0645\u0636\u064a\u0641\u0643 \u0623\u0648 CDN \u0639\u0646 \u0628\u0644\u062f \u0627\u0644\u0632\u0627\u0626\u0631 (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u062a\u0631\u0648\u064a\u0633\u0629 CF-IPCountry \u0645\u0646 Cloudflare) \u0648\u064a\u0643\u0648\u0646 \u062e\u0627\u0631\u062c EU \u0648EEA \u0648\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0648\u0633\u0648\u064a\u0633\u0631\u0627. \u0633\u064a\u0638\u0644 \u0627\u0644\u0634\u0639\u0627\u0631 \u0645\u0639\u0631\u0648\u0636\u0627\u064b\u060c \u0648\u062a\u062a\u0645 \u0645\u0639\u0627\u0645\u0644\u0629 \u0627\u0644\u0628\u0644\u062f \u063a\u064a\u0631 \u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0643\u0645\u0627 \u0644\u0648 \u0643\u0627\u0646 \u062f\u0627\u062e\u0644 EU."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0646\u0635\u064a\u0629 \u0623\u062e\u0631\u0649 \u0644\u0644\u062a\u0639\u0644\u064a\u0642 \u062d\u062a\u0649 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 (handle:analytics \u0623\u0648 handle:marketing\u060c \u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0648\u0627\u0635\u0644)"
            ],
            "Popups, slide-ins and bars": [
                "\u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629\u060c \u0648\u0627\u0644\u0645\u0646\u0632\u0644\u0642\u0629\u060c \u0648\u0627\u0644\u0623\u0634\u0631\u0637\u0629"
            ],
            "A\/B test results": [
                "\u0646\u062a\u0627\u0626\u062c \u0627\u062e\u062a\u0628\u0627\u0631 A\/B"
            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u0627\u0644\u0623\u062f\u0644\u0629: \u0627\u0644\u0646\u0645\u0627\u0630\u062c\u060c \u0648\u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u0645\u0646\u0628\u062b\u0642\u0629\u060c \u0648\u0627\u0644\u062d\u0631\u0643\u0629\u060c \u0648\u0627\u0644\u062a\u062a\u0628\u0639\u060c \u0648\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a A\/B\u060c \u0648\u0634\u0631\u064a\u0637 \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637"
            ],
            "Mailing-list connections": [
                "\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0628\u0631\u064a\u062f\u064a\u0629"
            ]
        }
