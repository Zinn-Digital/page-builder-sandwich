            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u05dc\u05de\u05e1\u05d2\u05e8\u05ea \u05de\u05d5\u05d8\u05de\u05e2\u05ea \u05d0\u05d9\u05df \u05db\u05d5\u05ea\u05e8\u05ea, \u05d5\u05dc\u05db\u05df \u05e7\u05d5\u05e8\u05d0 \u05de\u05e1\u05da \u05d0\u05d9\u05e0\u05d5 \u05d9\u05db\u05d5\u05dc \u05dc\u05d5\u05de\u05e8 \u05de\u05d4 \u05d4\u05d9\u05d0."
            ],
