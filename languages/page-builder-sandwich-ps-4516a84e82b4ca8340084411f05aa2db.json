            "%s MB": [
                "%s \u0627\u06cc\u0645 \u0628\u06cc"
            ],
            "Cleaned %d item(s).": [
                "%d \u062a\u0648\u06a9\u064a \u067e\u0627\u06a9 \u0634\u0648\u0644."
            ],
            "Site health and clean-up": [
                "\u062f \u0633\u0627\u06cc\u067c \u0631\u0648\u063a\u062a\u06cc\u0627 \u0627\u0648 \u067e\u0627\u06a9\u0648\u0644"
            ],
            "Finds old revisions, synced patterns nothing uses, heavy original images and design classes no page uses, and cleans each up in one click.": [
                "\u0632\u0648\u0693\u06d0 \u0628\u06cc\u0627\u06a9\u062a\u0646\u06d0\u060c \u0646\u0647 \u06a9\u0627\u0631\u0648\u0644 \u0634\u0648\u06d0 \u0647\u0645\u063a\u0696\u06d0 \u0634\u0648\u06d0 \u0628\u06bc\u06d0\u060c \u062f\u0631\u0627\u0646\u0647 \u0627\u0635\u0644\u064a \u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0647 \u0627\u0648 \u062f \u0689\u06cc\u0632\u0627\u06cc\u0646 \u067c\u0648\u0644\u06ab\u064a \u0686\u06d0 \u0647\u06d0\u0685 \u067e\u0627\u06bc\u0647 \u06cc\u06d0 \u0646\u0647 \u06a9\u0627\u0631\u0648\u064a \u0644\u067c\u0648\u064a\u060c \u0627\u0648 \u0647\u0631 \u06cc\u0648 \u067e\u0647 \u06cc\u0648 \u06a9\u0644\u06cc\u06a9 \u0633\u0631\u0647 \u067e\u0627\u06a9\u0648\u064a."
            ],
            "Run the report again": [
                "\u0631\u0627\u067e\u0648\u0631 \u0628\u06cc\u0627 \u067e\u06cc\u0644 \u06a9\u0693\u0626"
            ],
            "Run the report": [
                "\u0631\u0627\u067e\u0648\u0631 \u067e\u06cc\u0644 \u06a9\u0693\u0626"
            ],
            "%1$d old revisions on %2$d posts (the newest %3$d of each are kept).": [
                "\u067e\u0647 %2$d \u067e\u0648\u0633\u067c\u0648\u0646\u0648 \u06a9\u06d0 %1$d \u067e\u062e\u0648\u0627\u0646\u06cd \u0628\u06cc\u0627\u06a9\u062a\u0646\u06d0 (\u062f \u0647\u0631 \u06cc\u0648 \u0685\u062e\u0647 \u062a\u0631\u067c\u0648\u0644\u0648 \u0646\u0648\u06d0 %3$d \u0633\u0627\u062a\u0644 \u0634\u0648\u064a \u062f\u064a)."
            ],
            "Delete the old revisions? This cannot be undone.": [
                "\u0632\u0648\u0693 \u062a\u0639\u062f\u06cc\u0644\u0627\u062a \u0693\u0646\u06ab \u06a9\u0693\u0626\u061f \u062f\u0627 \u0628\u06d0\u0631\u062a\u0647 \u0646\u0647 \u0634\u064a \u06ab\u0631\u0681\u06d0\u062f\u0644\u06cc."
            ],
            "Delete old revisions": [
                "\u067e\u062e\u0648\u0627\u0646\u06cd \u0628\u064a\u0627\u06a9\u062a\u0646\u06d0 \u0693\u0646\u06ab\u06d0 \u06a9\u0693\u0626"
            ],
            "%d synced pattern is not used anywhere.": [
                "%d \u0647\u0645\u063a\u0696\u06cc \u0634\u0648\u06d0 \u0628\u06bc\u0647 \u067e\u0647 \u0647\u06d0\u0685 \u0681\u0627\u06cc \u06a9\u06d0 \u0646\u0647 \u06a9\u0627\u0631\u0648\u0644 \u06a9\u06d0\u0696\u064a.",
                "%d \u0647\u0645\u063a\u0696\u064a \u0634\u0648\u064a \u0646\u0645\u0648\u0646\u06d0 \u067e\u0647 \u0647\u06cc\u0685 \u0681\u0627\u06cc \u06a9\u06d0 \u0646\u0647 \u06a9\u0627\u0631\u0648\u0644 \u06a9\u06cc\u0696\u064a."
            ],
            "Move them to the trash": [
                "\u0647\u063a\u0647 \u06a9\u062b\u0627\u0641\u0627\u062a\u062f\u0627\u0646\u06cd \u062a\u0647 \u0648\u0627\u0633\u062a\u0648\u0626"
            ],
            "%1$d heavy images (%2$s).": [
                "%1$d \u062f\u0631\u0627\u0646\u0647 \u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0647 (%2$s)."
            ],
            "Make lighter copies (originals kept)": [
                "\u0633\u067e\u06a9\u06d0 \u06a9\u0627\u067e\u064a\u0627\u0646\u06d0 \u062c\u0648\u0693\u06d0 \u06a9\u0693\u0626 (\u0627\u0635\u0644\u064a \u0628\u0647 \u0648\u0633\u0627\u062a\u0644 \u0634\u064a)"
            ],
            "%d design class is not used.": [
                "%d \u0689\u06cc\u0632\u0627\u06cc\u0646 \u06a9\u0644\u0627\u0633 \u0646\u0647 \u06a9\u0627\u0631\u0648\u0644 \u06a9\u06d0\u0696\u064a.",
                "%d \u0689\u06cc\u0632\u0627\u06cc\u0646 \u067c\u0648\u0644\u06ab\u064a \u0646\u0647 \u062f\u064a \u06a9\u0627\u0631\u0648\u0644 \u0634\u0648\u064a."
            ],
            "Remove unused classes": [
                "\u0646\u0647 \u06a9\u0627\u0631\u0648\u0644 \u0634\u0648\u064a \u067c\u0648\u0644\u06ab\u064a \u0644\u0631\u06d0 \u06a9\u0693\u0626"
            ]
        }
    }
