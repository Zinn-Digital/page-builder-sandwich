msgid "Lists the site's languages from the translation plugin, when one is active. It renders nothing otherwise."
msgstr "Ó ṣe àkójọ àwọn èdè ojú-wọlé láti inú plọ́gìnnì ìtumọ̀, nígbà tí ẹnì kan bá ń ṣiṣẹ́. Kò ní fi ohunkohun hàn bí bẹ́ẹ̀ kọ́."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "Èdè"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "olùyípadà"

#: blocks/fixture/block.json
msgctxt "block title"
msgid "Sample content"
msgstr "Àkọsẹ̀ṣe àpẹẹrẹ"

#: blocks/fixture/block.json
msgctxt "block description"
msgid "A heading and a paragraph, rendered with neutral class names. It is the reference block for the translation contract."
msgstr "Oríkì kan àti ìpínrọ̀ kan, tí a fi àwọn orúkọ kíláàsì tí kò ní ẹ̀gbẹ́ hàn. Ó jẹ́ bálọ́ọ̀kù ìtọ́kasí fún àdéhùn ìtumọ̀ náà."

#: blocks/fixture/block.json
msgctxt "block keyword"
msgid "sample"
msgstr "àpẹẹrẹ"

