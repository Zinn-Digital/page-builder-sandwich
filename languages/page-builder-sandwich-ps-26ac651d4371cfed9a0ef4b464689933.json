            ],
            "(no title)": [
                "(\u0628\u06d0 \u0633\u0631\u0644\u06cc\u06a9\u0647)"
            ],
            "Disconnect": [
                "\u0627\u0693\u06cc\u06a9\u0647 \u067e\u0631\u06d0 \u06a9\u0693\u0626"
            ],
            "Previous": [
                "\u0634\u0627\u062a\u0647"
            ],
            "%d page could not be converted.": [
                "%d \u067e\u0627\u06bc\u0647 \u0648\u0646\u0647 \u062a\u0648\u0627\u0646\u06d0\u062f\u0647 \u0686\u06d0 \u0628\u062f\u0644\u0647 \u0634\u064a.",
                "%d \u067e\u0627\u06bc\u06d0 \u0628\u062f\u0644\u06d0 \u0646\u0634\u0648\u06d0."
            ],
            "Connected to Figma as %1$s (token ending %2$s).": [
                "\u0644\u0647 Figma \u0633\u0631\u0647 \u062f %1$s \u067e\u0647 \u062a\u0648\u06ab\u0647 \u0648\u0635\u0644 \u0634\u0648\u06cc (\u067c\u0648\u06a9\u0646 \u067e\u0647 %2$s \u067e\u0627\u06cc \u062a\u0647 \u0631\u0633\u06cc\u0696\u064a)."
            ],
            "Page": [
                "\u067e\u0627\u06bc\u0647"
            ],
            "Page %1$d of %2$d": [
                "\u0645\u062e %1$d \u0644\u0647 %2$d \u0685\u062e\u0647"
            ],
            "%1$d converted, %2$d approximated, %3$d not converted.": [
                "%1$d \u0628\u062f\u0644 \u0634\u0648\u0644\u060c %2$d \u062a\u0642\u0631\u064a\u0628\u064a \u0648\u067c\u0627\u06a9\u0644 \u0634\u0648\u0644\u060c %3$d \u0628\u062f\u0644 \u0646\u0647 \u0634\u0648\u0644."
            ],
            "Edit the new draft": [
                "\u0646\u0648\u06d0 \u0645\u0633\u0648\u062f\u0647 \u0633\u0645\u0648\u0644"
            ],
            "Not converted": [
                "\u0646\u0647 \u062f\u06cc \u0628\u062f\u0644 \u0634\u0648\u06cc"
            ],
            "Converted, but not exactly": [
                "\u0628\u062f\u0644 \u0634\u0648\u06cc\u060c \u062e\u0648 \u062f\u0642\u06cc\u0642 \u0646\u0647 \u062f\u06cc"
            ],
            "Converted %1$d of %2$d.": [
                "\u0644\u0647 %2$d \u0685\u062e\u0647 %1$d \u0648\u0627\u0693\u0648\u0644 \u0634\u0648\u0644."
            ],
            "Looking for pages\u2026": [
                "\u062f \u067e\u0627\u06bc\u0648 \u0644\u067c\u0648\u0646 \u0631\u0648\u0627\u0646 \u062f\u06cc\u2026"
            ],
            "No pages built with Elementor, Divi, Beaver Builder or WPBakery were found on this site.": [
                "\u067e\u0647 \u062f\u06d0 \u0633\u0627\u06cc\u067c \u06a9\u06d0 \u062f\u0627\u0633\u06d0 \u067e\u0627\u06bc\u06d0 \u0648\u0646\u0647 \u0645\u0648\u0646\u062f\u0644 \u0634\u0648\u06d0 \u0686\u06d0 \u067e\u0647 Elementor\u060c Divi\u060c Beaver Builder \u06cc\u0627 WPBakery \u062c\u0648\u0693\u06d0 \u0634\u0648\u06d0 \u0648\u064a."
            ],
            "%d page was built with another builder. Converting makes a new draft made of blocks; the original page is not changed.": [
                "%d \u067e\u0627\u06bc\u0647 \u062f \u0628\u0644 \u062c\u0648\u0693\u0648\u0648\u0646\u06a9\u064a \u0633\u0631\u0647 \u062c\u0648\u0693\u0647 \u0634\u0648\u06d0 \u0648\u0647. \u0628\u062f\u0644\u0648\u0644 \u062f \u0628\u0644\u0627\u06a9\u0648\u0646\u0648 \u0685\u062e\u0647 \u062c\u0648\u0693\u0647 \u0634\u0648\u06d0 \u06cc\u0648\u0647 \u0646\u0648\u06d0 \u0645\u0633\u0648\u062f\u0647 \u062c\u0648\u0693\u0648\u064a\u061b \u0627\u0635\u0644\u064a \u067e\u0627\u06bc\u0647 \u0646\u0647 \u0628\u062f\u0644\u06cc\u0696\u064a.",
                "%d \u067e\u0627\u06bc\u06d0 \u062f \u0628\u0644 \u062c\u0648\u0693\u0648\u0646\u06a9\u064a \u067e\u0647 \u0648\u0627\u0633\u0637\u0647 \u062c\u0648\u0693\u06d0 \u0634\u0648\u06d0 \u0648\u06d0. \u0627\u0693\u0648\u0644 \u062f \u0647\u0631\u06d0 \u06cc\u0648\u06d0 \u0644\u067e\u0627\u0631\u0647 \u062f \u0628\u0644\u0627\u06a9\u0648\u0646\u0648 \u0685\u062e\u0647 \u0646\u0648\u06d0 \u0645\u0633\u0648\u062f\u0647 \u062c\u0648\u0693\u0648\u064a\u061b \u0627\u0635\u0644\u064a \u0646\u0633\u062e\u06d0 \u0646\u0647 \u0628\u062f\u0644\u06cc\u0696\u064a."
            ],
            "Convert every page in this list": [
                "\u067e\u0647 \u062f\u06d0 \u0644\u0693\u0644\u064a\u06a9 \u06a9\u06d0 \u0647\u0631\u0647 \u067e\u0627\u06bc\u0647 \u0648\u0627\u0693\u0648\u0626"
            ],
            "Built with": [
                "\u062c\u0648\u0693 \u0634\u0648\u06cc \u0633\u0631\u0647 \u0644\u0647"
            ],
            "Converted before: edit the draft": [
                "\u0645\u062e\u06a9\u06d0 \u0628\u062f\u0644\u0648\u0646 \u0645\u0648\u0646\u062f\u0644\u06cc: \u0645\u0633\u0648\u062f\u0647 \u0627\u06cc\u0689\u06cc\u067c \u06a9\u0693\u0626"
            ],
            "Convert again": [
                "\u0628\u06cc\u0627 \u0628\u062f\u0644\u0648\u0646 \u0648\u0631\u06a9\u0693\u0626"
            ],
            "Convert": [
                "\u0628\u062f\u0644\u0648\u0644"
            ],
            "Exported from": [
                "\u0635\u0627\u062f\u0631 \u0634\u0648\u06cc \u0644\u0647"
            ],
            "Export file": [
                "\u062f\u0648\u062a\u0646\u0647 \u0635\u0627\u062f\u0631\u0648\u0644"
            ],
            "Or paste the export": [
                "\u06cc\u0627 \u0635\u0627\u062f\u0631\u0627\u062a \u0648\u067e\u06cc\u0633\u067c \u06a9\u0693\u0626"
            ],
            "Elementor: a template exported as .json. Divi: a layout exported from the Divi Library, or the page\u2019s shortcodes or blocks. WPBakery: the page\u2019s shortcodes (Classic mode). Beaver Builder: the page\u2019s saved data.": [
                "Elementor: \u0647\u063a\u0647 \u06a9\u064a\u0646\u0689\u06cd \u0686\u06d0 \u062f .json \u067e\u0647 \u0628\u06bc\u0647 \u0635\u0627\u062f\u0631 \u0634\u0648\u06d0 \u0648\u064a. Divi: \u0647\u063a\u0647 \u0628\u06bc\u0647 \u0686\u06d0 \u062f Divi Library \u0685\u062e\u0647 \u0635\u0627\u062f\u0631\u0647 \u0634\u0648\u06d0 \u0648\u064a\u060c \u06cc\u0627 \u062f \u067e\u0627\u06bc\u06d0 \u0644\u0646\u0689\u06a9\u0648\u0689\u0648\u0646\u0647 \u064a\u0627 \u0628\u0644\u0627\u06a9\u0648\u0646\u0647. WPBakery: \u062f \u067e\u0627\u06bc\u06d0 \u0644\u0646\u0689\u06a9\u0648\u0689\u0648\u0646\u0647 (Classic \u062d\u0627\u0644\u062a). Beaver Builder: \u062f \u067e\u0627\u06bc\u06d0 \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u064a \u0689\u0627\u067c\u0627."
            ],
            "Title of the new page": [
                "\u062f \u0646\u0648\u06d0 \u067e\u0627\u06bc\u06d0 \u0633\u0631\u0644\u06cc\u06a9"
            ],
            "Copy images from the other site into this site\u2019s media library": [
                "\u0644\u0647 \u0628\u0644 \u0633\u0627\u06cc\u067c \u0685\u062e\u0647 \u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0647 \u062f \u062f\u06d0 \u0633\u0627\u06cc\u067c \u0645\u06cc\u0689\u06cc\u0627 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u062a\u0647 \u06a9\u0627\u067e\u064a \u06a9\u0693\u0626"
            ],
            "Convert into a new page": [
                "\u0646\u0648\u06d0 \u067e\u0627\u06bc\u06d0 \u062a\u0647 \u0628\u062f\u0644\u0648\u0644"
            ],
            "Turn a Figma frame into an editable page: auto layout becomes rows, columns and grids, text keeps its fonts and sizes, and images are copied into your media library. The site talks to Figma with your own Figma account; nothing goes through us.": [
                "\u062f Figma \u0686\u0648\u06a9\u0627\u067c \u067e\u0647 \u06cc\u0648\u0647 \u062f \u0633\u0645\u0648\u0646 \u0648\u0693 \u067e\u0627\u06bc\u0647 \u0628\u062f\u0644 \u06a9\u0693\u0626: auto layout \u067e\u0647 \u0642\u0637\u0627\u0631\u0648\u0646\u0648\u060c \u06a9\u0627\u0644\u0645\u0648\u0646\u0648 \u0627\u0648 \u062c\u0627\u0644\u0648\u0646\u0648 \u0628\u062f\u0644\u06cc\u0696\u064a\u060c \u0645\u062a\u0646 \u062e\u067e\u0644 \u0641\u0648\u0646\u067c\u0648\u0646\u0647 \u0627\u0648 \u0627\u0646\u062f\u0627\u0632\u06d0 \u0633\u0627\u062a\u064a\u060c \u0627\u0648 \u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0647 \u0633\u062a\u0627\u0633\u0648 \u062f \u0631\u0633\u0646\u06cc\u0648 \u067e\u0647 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u06a9\u06d0 \u06a9\u0627\u067e\u064a \u06a9\u06cc\u0696\u064a. \u0648\u06d0\u0628\u067e\u0627\u06bc\u0647 \u0633\u062a\u0627\u0633\u0648 \u062f \u062e\u067e\u0644 Figma \u062d\u0633\u0627\u0628 \u0633\u0631\u0647 \u0644\u0647 Figma \u0633\u0631\u0647 \u0627\u0693\u06cc\u06a9\u0647 \u0646\u06cc\u0633\u064a\u061b \u0647\u06cc\u0685 \u0634\u06cc \u0632\u0645\u0648\u0696 \u0644\u0647 \u0644\u0627\u0631\u06d0 \u0646\u0647 \u062a\u06d0\u0631\u06cc\u0696\u064a."
            ],
            "Figma personal access token": [
                "\u062f Figma \u0634\u062e\u0635\u064a \u0644\u0627\u0633\u0631\u0633\u064a \u067c\u0648\u06a9\u0646"
            ],
            "In Figma: Settings, Security, Personal access tokens, Generate new token, with the \u201cFile content: read\u201d scope. It is stored encrypted and never shown again.": [
                "\u067e\u0647 Figma \u06a9\u06d0: Settings\u060c Security\u060c Personal access tokens\u060c Generate new token\u060c \u062f \u201cFile content: read\u201d \u0633\u0627\u062d\u06d0 \u0633\u0631\u0647. \u062f\u0627 \u067e\u0647 \u06a9\u0648\u0689 \u0634\u0648\u06d0 \u0628\u06bc\u0647 \u0633\u0627\u062a\u0644 \u06a9\u06d0\u0696\u064a \u0627\u0648 \u0647\u06cc\u0685\u06a9\u0644\u0647 \u0628\u0647 \u0628\u06cc\u0627 \u0648\u0646\u0647 \u069a\u0648\u062f\u0644 \u0634\u064a."
            ],
            "How to create a Figma token": [
                "\u062f Figma \u067c\u0648\u06a9\u0646 \u062c\u0648\u0693\u0648\u0644\u0648 \u0685\u0631\u0646\u06ab\u0648\u0627\u0644\u06cc"
            ],
            "Connect Figma": [
                "Figma \u0648\u0635\u0644 \u06a9\u0693\u0626"
            ],
            "Figma frame link": [
                "\u062f Figma \u0686\u0648\u06a9\u0627\u067c \u0644\u06d0\u0646\u06a9"
            ],
            "In Figma, select one frame, then right-click: Copy\/Paste as, Copy link to selection.": [
                "\u067e\u0647 Figma \u06a9\u06d0\u060c \u06cc\u0648 \u0686\u0648\u06a9\u0627\u067c \u0648\u067c\u0627\u06a9\u0626\u060c \u0628\u06cc\u0627 \u069a\u06cc \u06a9\u0644\u06cc\u06a9 \u0648\u06a9\u0693\u0626: Copy\/Paste as\u060c Copy link to selection."
            ],
            "Title of the new page (optional)": [
                "\u062f \u0646\u0648\u06d0 \u067e\u0627\u06bc\u06d0 \u0633\u0631\u0644\u06cc\u06a9 (\u0627\u062e\u062a\u06cc\u0627\u0631\u064a)"
            ],
            "Import the frame": [
                "\u0686\u0648\u06a9\u0627\u067c \u0648\u0627\u0631\u062f \u06a9\u0693\u0626"
            ],
            "Import from other builders and Figma": [
                "\u0644\u0647 \u0646\u0648\u0631\u0648 \u062c\u0648\u0693\u0648\u0646\u06a9\u0648 \u0627\u0648 Figma \u0685\u062e\u0647 \u0648\u0627\u0631\u062f \u06a9\u0693\u0626"
            ],
            "Pages built with Elementor, Divi, Beaver Builder or WPBakery": [
                "\u0647\u063a\u0647 \u067e\u0627\u06bc\u06d0 \u0686\u06d0 \u062f Elementor\u060c Divi\u060c Beaver Builder \u06cc\u0627 WPBakery \u0633\u0631\u0647 \u062c\u0648\u0693\u06d0 \u0634\u0648\u06d0 \u062f\u064a"
            ],
            "Import an export file": [
                "\u062f \u0635\u0627\u062f\u0631\u0627\u062a\u0648 \u0641\u0627\u06cc\u0644 \u0648\u0627\u0631\u062f \u06a9\u0693\u0626"
            ],
            "Import from Figma": [
                "\u0644\u0647 Figma \u0685\u062e\u0647 \u0648\u0627\u0631\u062f\u0648\u0644"
            ]
        }
    }
}
