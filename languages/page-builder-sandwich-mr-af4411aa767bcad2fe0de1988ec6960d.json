            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u092a\u094d\u0932\u0945\u0917\u0907\u0928 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0902\u0935\u0930 \u091b\u093e\u092a\u0924\u094b \u0924\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0935\u0930\u094d\u0917\u093e\u091a\u0947 \u0928\u093e\u0935 \u092f\u093e \u0909\u092a\u0938\u0930\u094d\u0917\u093e\u0928\u0947 \u0938\u0941\u0930\u0942 \u0939\u094b\u0924\u0947, \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u092a\u0943\u0937\u094d\u0920\u0947 \u0939\u0947 \u0909\u0918\u0921 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940\u0924 \u0915\u0940 \u0915\u094b\u0923\u0924\u0947 \u092a\u094d\u0932\u0945\u0917\u0907\u0928 \u0924\u092f\u093e\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947. \u0905\u0915\u094d\u0937\u0930\u093e\u0928\u0947 \u0938\u0941\u0930\u0942 \u0939\u094b\u0923\u093e\u0930\u0940, \u0967 \u0924\u0947 \u096e \u091b\u094b\u091f\u0940 \u0905\u0915\u094d\u0937\u0930\u0947 \u0915\u093f\u0902\u0935\u093e \u0905\u0902\u0915."
            ],
            "Save": [
                "\u091c\u0924\u0928 \u0915\u0930\u093e"
            ],
            "Beta updates": [
                "\u092c\u0940\u091f\u093e \u0905\u092a\u0921\u0947\u091f\u094d\u0938"
            ],
            "This site receives beta versions as updates.": [
                "\u092f\u093e \u0938\u093e\u0907\u091f\u0932\u093e \u0905\u092a\u0921\u0947\u091f\u094d\u0938 \u092e\u094d\u0939\u0923\u0942\u0928 \u092c\u0940\u091f\u093e \u0906\u0935\u0943\u0924\u094d\u0924\u094d\u092f\u093e \u092e\u093f\u0933\u0924\u093e\u0924."
            ],
            "This site receives stable versions only.": [
                "\u0939\u0947 \u0938\u093e\u0907\u091f \u092b\u0915\u094d\u0924 \u0938\u094d\u0925\u093f\u0930 \u0906\u0935\u0943\u0924\u094d\u0924\u094d\u092f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u0947."
            ],
            "Change this on the Account page": [
                "\u0939\u0947 \u0916\u093e\u0924\u0947 \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u092c\u0926\u0932\u093e"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u092c\u0947\u091f\u093e \u0906\u0935\u0943\u0924\u094d\u0924\u094d\u092f\u093e \u092a\u0930\u0935\u093e\u0928\u093e\u0927\u093e\u0930\u0915 \u092a\u094d\u0930\u094b \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932\u0947\u0936\u0928\u0928\u093e \u0911\u092b\u0930 \u0915\u0947\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924 \u091c\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0936\u0940 \u091c\u094b\u0921\u0932\u0947\u0932\u0947 \u0905\u0938\u0924\u093e\u0924. \u090f\u0915\u0926\u093e \u091c\u094b\u0921\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930, \u0924\u0941\u092e\u094d\u0939\u0940 \u0916\u093e\u0924\u0947 \u092a\u0947\u091c\u0935\u0930\u0942\u0928 \u0938\u093e\u092e\u0940\u0932 \u0939\u094b\u090a \u0936\u0915\u0924\u093e."
            ],
            "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here.": [
                "\u092f\u093e \u092a\u094b\u0938\u094d\u091f\u091a\u0947 \u0930\u0942\u092a\u093e\u0902\u0924\u0930\u0923 \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940\u091a \u0925\u093e\u0902\u092c\u0932\u0947 \u0939\u094b\u0924\u0947, \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0939\u0940 \u092a\u094b\u0938\u094d\u091f \u0935\u0917\u0933\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947. \u0924\u0940 \u0930\u0942\u092a\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u0918\u0921\u093e \u0915\u093f\u0902\u0935\u093e \u092f\u0947\u0925\u0942\u0928 \u0924\u0940 \u092a\u0941\u0928\u094d\u0939\u093e \u0930\u0942\u092a\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930\u093e."
            ],
            "There is no backup of this post to restore.": [
                "\u092a\u0941\u0928\u0930\u094d\u0938\u0902\u091a\u092f\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u093e \u092a\u094b\u0938\u094d\u091f\u091a\u093e \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092c\u0945\u0915\u0905\u092a \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940."
            ],
            "The converted content could not be saved.": [
                "\u0930\u0942\u092a\u093e\u0902\u0924\u0930\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u0947\u0935\u094d\u0939 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0932\u0940 \u0928\u093e\u0939\u0940."
            ],
            "Unknown error.": [
                "\u0905\u091c\u094d\u091e\u093e\u0924 \u0924\u094d\u0930\u0941\u091f\u0940."
            ],
            "No legacy content has been checked yet.": [
                "\u0905\u0926\u094d\u092f\u093e\u092a \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0932\u093f\u0917\u0947\u0938\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0924\u092a\u093e\u0938\u0932\u0940 \u0917\u0947\u0932\u0947\u0932\u0940 \u0928\u093e\u0939\u0940."
            ],
            "Restoring legacy content: %1$d of %2$d posts.": [
                "\u091c\u0941\u0928\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092a\u0941\u0928\u0930\u094d\u0938\u0902\u091a\u092f\u093f\u0924 \u0915\u0930\u0924 \u0906\u0939\u0947: %1$d \u092a\u0948\u0915\u0940 %2$d \u092a\u094b\u0938\u094d\u091f."
            ],
            "Converting legacy content: %1$d of %2$d posts.": [
                "\u091c\u0941\u0928\u094d\u092f\u093e \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u091a\u0947 \u0930\u0942\u092a\u093e\u0902\u0924\u0930\u0923 \u0915\u0930\u0924 \u0906\u0939\u0947: %1$d \u092a\u0948\u0915\u0940 %2$d \u092a\u094b\u0938\u094d\u091f."
            ],
            "Undo finished: %1$d restored, %2$d failed.": [
