                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0544\u056b\u0561\u0575\u0576 \u0561\u0575\u0576 \u0585\u0563\u057f\u0561\u057f\u0565\u0580\u0565\u0580\u0568, \u0578\u0580\u0578\u0576\u0584 \u056f\u0561\u0580\u0578\u0572 \u0565\u0576 \u0561\u057e\u0565\u056c\u0561\u0581\u0576\u0565\u056c \u0579\u0566\u057f\u057e\u0561\u056e HTML, \u056f\u0561\u0580\u0578\u0572 \u0565\u0576 \u0583\u0578\u056d\u0565\u056c \u0570\u0561\u0580\u0574\u0561\u0580\u0565\u0581\u057e\u0561\u056e CSS-\u0568:"
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "CSS-\u056b \u0561\u0575\u057d \u0574\u0561\u057d\u0568 \u0579\u056b \u0585\u0563\u057f\u0561\u0563\u0578\u0580\u056e\u057e\u056b. \u0561\u0576\u057e\u057f\u0561\u0576\u0563\u0578\u0582\u0569\u0575\u0561\u0576 \u0576\u056f\u0561\u057f\u0561\u057c\u0578\u0582\u0574\u0576\u0565\u0580\u056b\u0581 \u0565\u056c\u0576\u0565\u056c\u0578\u057e\u055d \u0570\u0565\u057c\u0561\u0581\u057e\u0578\u0582\u0574 \u0565\u0576 @import-\u0568, expression()-\u0568, javascript: URL-\u0576\u0565\u0580\u0568, \u00ab<\u00bb-\u0568 \u0587 \u0579\u0570\u0561\u057e\u0561\u057d\u0561\u0580\u0561\u056f\u0577\u057c\u057e\u0561\u056e \u0583\u0561\u056f\u0561\u0563\u056e\u0565\u0580\u0568:"
            ],
            "Page CSS": [
                "\u0537\u057b\u056b CSS"
            ],
            "Global classes": [
                "\u0533\u056c\u0578\u0562\u0561\u056c \u0564\u0561\u057d\u0565\u0580"
            ],
            "Classes": [
                "\u0534\u0561\u057d\u0565\u0580"
            ],
            "Create classes in Site design, then add them here.": [
                "\u054d\u057f\u0565\u0572\u056e\u0565\u0584 \u0564\u0561\u057d\u0565\u0580 \u053f\u0561\u0575\u0584\u056b \u0571\u0587\u0561\u057e\u0578\u0580\u0574\u0561\u0576 \u0574\u0565\u057b, \u0561\u0575\u0576\u0578\u0582\u0570\u0565\u057f\u0587 \u0561\u057e\u0565\u056c\u0561\u0581\u0580\u0565\u0584 \u0564\u0580\u0561\u0576\u0584 \u0561\u0575\u057d\u057f\u0565\u0572:"
            ],
            "Custom CSS": [
                "\u0540\u0561\u057f\u0578\u0582\u056f CSS"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u0533\u0580\u0565\u0584 \u056f\u0561\u0576\u0578\u0576\u0576\u0565\u0580 \u0561\u0575\u057d \u057f\u0561\u0580\u0580\u056b \u0570\u0561\u0574\u0561\u0580\u0589 \u00abselector\u00bb \u0576\u0577\u0561\u0576\u0561\u056f\u0578\u0582\u0574 \u0567 \u0561\u0575\u057d \u057f\u0561\u0580\u0580\u0568, \u0585\u0580\u056b\u0576\u0561\u056f\u055d selector:hover { opacity: .8 } \u2014 \u057a\u0561\u0580\u0566 \u0570\u0561\u0575\u057f\u0561\u0580\u0561\u0580\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0576\u0565\u0580\u0568 \u057e\u0565\u0580\u0561\u0562\u0565\u0580\u0578\u0582\u0574 \u0565\u0576 \u0570\u0565\u0576\u0581 \u057f\u0561\u0580\u0580\u056b\u0576:"
            ],
            "CSS for this page": [
                "CSS \u0561\u0575\u057d \u0567\u057b\u056b \u0570\u0561\u0574\u0561\u0580"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0532\u0565\u057c\u0576\u057e\u0578\u0582\u0574 \u0567 \u0574\u056b\u0561\u0575\u0576 \u0561\u0575\u057d \u0567\u057b\u0578\u0582\u0574\u055d \u056f\u0561\u0575\u0584\u056b \u0578\u0573\u0565\u0580\u056b\u0581 \u0570\u0565\u057f\u0578\u0589 \u054a\u0561\u0570\u057a\u0561\u0576\u057e\u0578\u0582\u0574 \u0567 \u0567\u057b\u056b \u0570\u0565\u057f \u0574\u056b\u0561\u057d\u056b\u0576:"
            ]
        }
