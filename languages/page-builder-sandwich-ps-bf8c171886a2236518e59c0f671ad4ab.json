            "Scripts, links and external references are removed before the icon is shown.": [
                "\u062f \u0627\u0646\u0681\u0648\u0631 \u0644\u0647 \u069a\u0648\u062f\u0644\u0648 \u0645\u062e\u06a9\u06d0 \u0633\u06a9\u0631\u06cc\u067e\u067c\u0648\u0646\u0647\u060c \u0644\u06cc\u0646\u06a9\u0648\u0646\u0647 \u0627\u0648 \u0628\u0647\u0631\u0646\u06cd \u062d\u0648\u0627\u0644\u06d0 \u0644\u0631\u06d0 \u06a9\u06cc\u0696\u064a."
            ],
            "Accessible label": [
                "\u062f \u0644\u0627\u0633\u0631\u0633\u064a \u0648\u0693 \u0646\u069a\u0647"
            ],
            "Leave empty for a decorative icon.": [
                "\u062f \u06cc\u0648\u06d0 \u069a\u0627\u06cc\u0633\u062a\u0647 \u0646\u069a\u06d0 \u0644\u067e\u0627\u0631\u0647 \u062a\u0634 \u067e\u0631\u06cc\u0696\u062f\u0626."
            ],
            "Paste SVG markup in the block settings.": [
                "\u062f \u0628\u0644\u0627\u06a9 \u067e\u0647 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a\u0648 \u06a9\u06d0 \u062f SVG \u0646\u069a\u0647 \u06a9\u0648\u0644 \u067e\u067c \u06a9\u0693\u0626."
            ],
            "New setting name": [
                "\u062f \u0646\u0648\u06d0 \u06a9\u0693\u0646\u0644\u0627\u0631\u06d0 \u0646\u0648\u0645"
            ],
            "For example: title or text": [
                "\u062f \u0628\u06d0\u0644\u06ab\u06d0 \u067e\u0647 \u062a\u0648\u06ab\u0647: \u0633\u0631\u0644\u06cc\u06a9 \u06cc\u0627 \u0645\u062a\u0646"
            ],
            "Add setting": [
                "\u062a\u0631\u062a\u06cc\u0628 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0648\u0644"
            ],
            "Widget": [
                "\u0648\u06cc\u0628 \u067e\u0627\u06bc\u0647"
            ],
            "Choose a widget": [
                "\u06cc\u0648 \u0648\u06cc\u062c\u06cc\u067c \u063a\u0648\u0631\u0647 \u06a9\u0693\u0626"
            ],
            "Widget area": [
                "\u062f \u0648\u06cc\u062c\u067c \u0633\u0627\u062d\u0647"
            ],
            "Choose a widget area": [
                "\u062f \u0648\u06d0\u062c\u06d0\u067c \u0633\u0627\u062d\u0647 \u0648\u067c\u0627\u06a9\u0626"
            ],
            "This image has no width and height, so the page will jump when it loads. Choose it from the Media Library, or set its width and height.": [
                "\u062f\u0627 \u0627\u0646\u0681\u0648\u0631 \u0633\u0648\u0631 \u0627\u0648 \u0644\u0648\u0693\u0648\u0627\u0644\u06cc \u0646\u0647 \u0644\u0631\u064a\u060c \u0646\u0648 \u062f \u067e\u0648\u0631\u062a\u0647 \u06a9\u06d0\u062f\u0648 \u067e\u0631 \u0645\u0647\u0627\u0644 \u0628\u0647 \u067e\u0627\u06bc\u0647 \u0648\u062e\u0648\u0681\u06d0\u0696\u064a. \u062f\u0627 \u062f \u0631\u0633\u0646\u06cc\u0648 \u0644\u0647 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u0685\u062e\u0647 \u0648\u067c\u0627\u06a9\u0626\u060c \u06cc\u0627 \u062f \u062f\u06d0 \u0633\u0648\u0631 \u0627\u0648 \u0644\u0648\u0693\u0648\u0627\u0644\u06cc \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0693\u0626."
            ],
            "This video is not from the Media Library, so its size is unknown and the page will jump when it loads. Upload it to the Media Library instead.": [
                "\u062f\u0627 \u0648\u06cc\u0689\u06cc\u0648 \u062f \u0631\u0633\u0646\u06cc\u0648 \u0644\u0647 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 (Media Library) \u0685\u062e\u0647 \u0646\u0647 \u062f\u0647\u060c \u0646\u0648 \u0627\u0646\u062f\u0627\u0632\u0647 \u06cc\u06d0 \u0646\u0627\u0685\u06a9\u062f\u0647 \u062f\u0647 \u0627\u0648 \u062f \u067e\u0648\u0631\u062a\u0647 \u06a9\u06d0\u062f\u0648 \u067e\u0631 \u0645\u0647\u0627\u0644 \u0628\u0647 \u067e\u0627\u06bc\u0647 \u0648\u067c\u0648\u067e\u064a. \u067e\u0631\u0681\u0627\u06cc \u06cc\u06d0 \u062f \u0631\u0633\u0646\u06cc\u0648 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u062a\u0647 \u067e\u0648\u0631\u062a\u0647 \u06a9\u0693\u0626."
            ],
            "An image, video or frame in this HTML has no width and height, so the page will jump when it loads. Add width and height attributes to it.": [
                "\u067e\u0647 \u062f\u06d0 HTML \u06a9\u06d0 \u06cc\u0648 \u0627\u0646\u0681\u0648\u0631\u060c \u0648\u06cc\u0689\u06cc\u0648 \u06cc\u0627 \u0686\u0648\u06a9\u0627\u067c \u067e\u0644\u0646\u0648\u0627\u0644\u06cc \u0627\u0648 \u0644\u0648\u0693\u0648\u0627\u0644\u06cc \u0646\u0644\u0631\u064a\u060c \u0646\u0648 \u067e\u0627\u06bc\u0647 \u0628\u0647 \u062f \u067e\u0648\u0631\u062a\u0647 \u06a9\u06d0\u062f\u0648 \u067e\u0631 \u0645\u0647\u0627\u0644 \u067c\u0648\u067e \u0648\u06a9\u0693\u064a. \u0648\u0631\u062a\u0647 \u062f \u067e\u0644\u0646\u0648\u0627\u0644\u064a \u0627\u0648 \u0644\u0648\u0693\u0648\u0627\u0644\u064a \u0681\u0627\u0646\u06ab\u0693\u062a\u06cc\u0627\u0648\u06d0 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626."
            ],
            "This embed resizes itself after it loads, which moves the content below it. Give it room or place it lower on the page.": [
                "\u062f\u0627 \u0681\u0627\u06cc \u067e\u0631 \u0681\u0627\u06cc \u0634\u0648\u06cc \u0645\u0646\u0681\u067e\u0627\u0646\u06ab\u0647 \u062f \u0628\u0627\u0631\u06d0\u062f\u0648 \u0648\u0631\u0648\u0633\u062a\u0647 \u062e\u067e\u0644 \u0627\u0646\u062f\u0627\u0632\u0647 \u0628\u062f\u0644\u0648\u064a\u060c \u06a9\u0648\u0645 \u0686\u06d0 \u062f \u062f\u06d0 \u0644\u0627\u0646\u062f\u06d0 \u0645\u0646\u0681\u067e\u0627\u0646\u06ab\u0647 \u062d\u0631\u06a9\u062a \u0648\u0631\u06a9\u0648\u064a. \u062f\u06d0 \u062a\u0647 \u0681\u0627\u06cc \u0648\u0631\u06a9\u0693\u0626 \u06cc\u0627 \u062f\u0627 \u067e\u0647 \u067e\u0627\u06bc\u0647 \u06a9\u06d0 \u067c\u06cc\u067c \u0681\u0627\u06cc \u067e\u0647 \u0681\u0627\u06cc \u06a9\u0693\u0626."
            ],
            "Layout shift": [
                "\u062f \u06a9\u062a\u0646\u06d0 \u0628\u062f\u0644\u0648\u0646"
            ]
        }
    }
