            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0421\u0430\u043c\u043e \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0438 \u0441 \u043f\u0440\u0430\u0432\u043e \u0434\u0430 \u0434\u043e\u0431\u0430\u0432\u044f\u0442 \u043d\u0435\u0444\u0438\u043b\u0442\u0440\u0438\u0440\u0430\u043d HTML \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u043f\u0440\u043e\u043c\u0435\u043d\u044f\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d\u0438\u044f CSS."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0427\u0430\u0441\u0442 \u043e\u0442 \u0442\u043e\u0437\u0438 CSS \u043d\u044f\u043c\u0430 \u0434\u0430 \u0441\u0435 \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430: @import, expression(), javascript: URL \u0430\u0434\u0440\u0435\u0441\u0438, \u201e<\u201c \u0438 \u043d\u0435\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u0430\u043d\u0438 \u0444\u0438\u0433\u0443\u0440\u043d\u0438 \u0441\u043a\u043e\u0431\u0438 \u0441\u0435 \u043f\u0440\u0435\u043c\u0430\u0445\u0432\u0430\u0442 \u043e\u0442 \u0441\u044a\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0437\u0430 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442."
            ],
            "Page CSS": [
                "CSS \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430"
            ],
            "Global classes": [
                "\u0413\u043b\u043e\u0431\u0430\u043b\u043d\u0438 \u043a\u043b\u0430\u0441\u043e\u0432\u0435"
            ],
            "Classes": [
                "\u041a\u043b\u0430\u0441\u043e\u0432\u0435"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0421\u044a\u0437\u0434\u0430\u0439\u0442\u0435 \u043a\u043b\u0430\u0441\u043e\u0432\u0435 \u0432 \u0414\u0438\u0437\u0430\u0439\u043d \u043d\u0430 \u0441\u0430\u0439\u0442\u0430, \u0441\u043b\u0435\u0434 \u043a\u043e\u0435\u0442\u043e \u0433\u0438 \u0434\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u0442\u0443\u043a."
            ],
            "Custom CSS": [
                "\u041f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043d CSS"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u041d\u0430\u043f\u0438\u0448\u0435\u0442\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0430 \u0442\u043e\u0437\u0438 \u0435\u043b\u0435\u043c\u0435\u043d\u0442. \u201eselector\u201c \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430 \u0442\u043e\u0437\u0438 \u0435\u043b\u0435\u043c\u0435\u043d\u0442, \u043d\u0430\u043f\u0440. selector:hover { opacity: .8 } \u2014 \u043e\u0431\u0438\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0442\u0435 \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u0438 \u0441\u0435 \u043f\u0440\u0438\u043b\u0430\u0433\u0430\u0442 \u043a\u044a\u043c \u0441\u0430\u043c\u0438\u044f \u0435\u043b\u0435\u043c\u0435\u043d\u0442."
            ],
            "CSS for this page": [
                "CSS \u0437\u0430 \u0442\u0430\u0437\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0417\u0430\u0440\u0435\u0436\u0434\u0430 \u0441\u0435 \u0441\u0430\u043c\u043e \u043d\u0430 \u0442\u0430\u0437\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430, \u0441\u043b\u0435\u0434 \u0441\u0442\u0438\u043b\u043e\u0432\u0435\u0442\u0435 \u043d\u0430 \u0441\u0430\u0439\u0442\u0430. \u0417\u0430\u043f\u0430\u0437\u0432\u0430 \u0441\u0435 \u0441\u044a\u0441 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430."
            ]
        }
    }
