            ],
            "Refreshed %1$s: %2$d reviews kept, rated %3$s from %4$d.": [
                "\u0dba\u0dcf\u0dc0\u0dad\u0dca\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dd3 %1$s: \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1 %2$d\u0d9a\u0dca \u0dad\u0db6\u0dcf \u0d87\u0dad, %4$d\u0d9a\u0dd2\u0db1 \u0dbd\u0dd0\u0db6\u0dd6 \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2\u0dba %3$s \u0d9a\u0dd2."
            ],
            "The last try, %1$s, failed and the reviews above were kept: %2$s": [
