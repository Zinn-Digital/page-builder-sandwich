            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u0421\u0430\u043d\u04b7\u0438\u0448\u0438 \u0445\u0443\u0434\u043a\u043e\u0440 \u043c\u0443\u0448\u043a\u0438\u043b\u043e\u0442\u0438 \u0437\u0438\u0451\u0434\u0435\u0440\u043e \u043e\u0448\u043a\u043e\u0440 \u043c\u0435\u043a\u0443\u043d\u0430\u0434, \u0430\u043c\u043c\u043e \u043d\u0430 \u04b3\u0430\u043c\u0430\u0438 \u043e\u043d\u04b3\u043e\u0440\u043e. \u04b2\u0430\u043c\u0447\u0443\u043d\u0438\u043d \u0441\u0430\u04b3\u0438\u0444\u0430\u0440\u043e \u0442\u0430\u043d\u04b3\u043e \u0431\u043e \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430 \u0432\u0430 \u0431\u043e \u0431\u0430\u0440\u043d\u043e\u043c\u0430\u0438 \u0445\u043e\u043d\u0430\u043d\u0434\u0430\u0438 \u044d\u043a\u0440\u0430\u043d \u0441\u0430\u043d\u04b7\u0438\u0434\u0430 \u0431\u0438\u043d\u0435\u0434."
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u0422\u0430\u0437\u043e\u0434\u0438 \u043c\u0430\u0442\u043d %1$s:1 \u0430\u0441\u0442; \u0431\u0430\u0440\u043e\u0438 \u0445\u043e\u043d\u043e \u0431\u0443\u0434\u0430\u043d \u043d\u0430 \u043a\u0430\u043c\u0442\u0430\u0440 \u0430\u0437 %2$s:1 \u043b\u043e\u0437\u0438\u043c \u0430\u0441\u0442."
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u0438\u043d\u04b7\u043e\u0440\u043e \u043f\u0430\u0445\u0448 \u043a\u0443\u043d\u0435\u0434,\u0438\u043d\u04b7\u043e,\u0431\u0435\u0448\u0442\u0430\u0440 \u0445\u043e\u043d\u0434\u0430\u043d,\u0431\u0435\u0448\u0442\u0430\u0440,\u043f\u0430\u0439\u0432\u0430\u043d\u0434,\u0438\u043d \u043f\u0430\u0439\u0432\u0430\u043d\u0434,\u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u0438 \u0431\u0435\u0448\u0442\u0430\u0440,\u0433\u0443\u0437\u0430\u0440\u0438\u0448"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u041f\u0430\u0439\u0432\u0430\u043d\u0434 \u044f\u0433\u043e\u043d \u043c\u0430\u0442\u043d \u043d\u0430\u0434\u043e\u0440\u0430\u0434, \u0431\u0438\u043d\u043e\u0431\u0430\u0440 \u0438\u043d \u0445\u043e\u043d\u0430\u043d\u0434\u0430\u0438 \u044d\u043a\u0440\u0430\u043d \u0442\u0430\u043d\u04b3\u043e \u00ab\u043f\u0430\u0439\u0432\u0430\u043d\u0434\u00bb \u044d\u044a\u043b\u043e\u043d \u043c\u0435\u043a\u0443\u043d\u0430\u0434. \u041c\u0430\u0442\u043d \u0451 \u0431\u0430\u0440\u0447\u0430\u0441\u043f \u0438\u043b\u043e\u0432\u0430 \u043a\u0443\u043d\u0435\u0434."
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\u041c\u0430\u0442\u043d\u0438 \u043f\u0430\u0439\u0432\u0430\u043d\u0434\u0438 \"%s\" \u043d\u0438\u0448\u043e\u043d \u043d\u0430\u043c\u0435\u0434\u0438\u04b3\u0430\u0434, \u043a\u0438 \u043e\u043d \u0431\u0430 \u043a\u0443\u04b7\u043e \u043c\u0435\u0431\u0430\u0440\u0430\u0434. \u0411\u0430 \u04b7\u043e\u0438 \u0438\u043d, \u043c\u0430\u043a\u043e\u043d\u0438 \u0442\u0430\u044a\u0438\u043d\u043e\u0442\u0440\u043e \u0442\u0430\u0432\u0441\u0438\u0444 \u043a\u0443\u043d\u0435\u0434."
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u042d\u043b\u0435\u043c\u0435\u043d\u0442 \u0434\u043e\u0440\u043e\u0438 tabindex-\u0438 \u043c\u0443\u0441\u0431\u0430\u0442 \u043c\u0435\u0431\u043e\u0448\u0430\u0434, \u043a\u0438 \u0442\u0430\u0440\u0442\u0438\u0431\u0438 \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430\u0440\u043e \u0430\u0437 \u0442\u0430\u0440\u0442\u0438\u0431\u0438 \u0445\u043e\u043d\u0438\u0448 \u0442\u0430\u0493\u0439\u0438\u0440 \u043c\u0435\u0434\u0438\u04b3\u0430\u0434. 0-\u0440\u043e \u0438\u0441\u0442\u0438\u0444\u043e\u0434\u0430 \u0431\u0430\u0440\u0435\u0434 \u0451 \u043e\u043d\u0440\u043e \u043d\u0435\u0441\u0442 \u043a\u0443\u043d\u0435\u0434."
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u0411\u0430 \u0443\u043d\u0441\u0443\u0440\u0438 \u043f\u0430\u0445\u0448\u0448\u0430\u0432\u0430\u043d\u0434\u0430 \u0442\u0430\u0432\u0430\u0441\u0441\u0443\u0442\u0438 \u0441\u0430\u0444\u04b3\u0430\u043a\u0430\u043b\u0438\u0434 \u0434\u0430\u0441\u0442\u0440\u0430\u0441\u04e3 \u043f\u0430\u0439\u0434\u043e \u043a\u0430\u0440\u0434\u0430\u043d \u0438\u043c\u043a\u043e\u043d\u043d\u043e\u043f\u0430\u0437\u0438\u0440 \u0430\u0441\u0442. \u0422\u0443\u0433\u043c\u0430 \u0451 \u043f\u0430\u0439\u0432\u0430\u043d\u0434\u0438 \u0432\u043e\u049b\u0435\u0438\u0440\u043e \u0438\u0441\u0442\u0438\u0444\u043e\u0434\u0430 \u0431\u0430\u0440\u0435\u0434."
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u0424\u0440\u0435\u0439\u043c\u0438 \u04b7\u043e\u0439\u0433\u0438\u0440\u0448\u0443\u0434\u0430 \u0441\u0430\u0440\u043b\u0430\u0432\u04b3\u0430 \u043d\u0430\u0434\u043e\u0440\u0430\u0434, \u0431\u0438\u043d\u043e\u0431\u0430\u0440 \u0438\u043d \u0431\u0430\u0440\u043d\u043e\u043c\u0430\u0438 \u0445\u043e\u043d\u0430\u043d\u0434\u0430\u0438 \u044d\u043a\u0440\u0430\u043d \u0433\u0443\u0444\u0442\u0430 \u043d\u0430\u043c\u0435\u0442\u0430\u0432\u043e\u043d\u0430\u0434, \u043a\u0438 \u043e\u043d \u0447\u0438\u0441\u0442."
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u041c\u0430\u0439\u0434\u043e\u043d\u0438 \u0448\u0430\u043a\u043b \u043d\u0438\u0448\u043e\u043d\u0430 \u043d\u0430\u0434\u043e\u0440\u0430\u0434, \u0431\u0438\u043d\u043e\u0431\u0430\u0440 \u0438\u043d \u043c\u0430\u049b\u0441\u0430\u0434\u0438 \u043e\u043d \u044d\u044a\u043b\u043e\u043d \u043d\u0430\u043c\u0435\u0448\u0430\u0432\u0430\u0434."
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u0418\u043d \u0441\u0430\u0440\u043b\u0430\u0432\u04b3\u0430 \u0445\u043e\u043b\u04e3 \u0430\u0441\u0442. \u0418\u0441\u0442\u0438\u0444\u043e\u0434\u0430\u0431\u0430\u0440\u0430\u043d\u0434\u0430\u0433\u043e\u043d\u0438 \u0431\u0430\u0440\u043d\u043e\u043c\u0430\u04b3\u043e\u0438 \u0445\u043e\u043d\u0438\u0448\u0438 \u044d\u043a\u0440\u0430\u043d \u0442\u0430\u0432\u0430\u0441\u0441\u0443\u0442\u0438 \u0441\u0430\u0440\u043b\u0430\u0432\u04b3\u0430\u04b3\u043e \u043f\u0430\u0439\u043c\u043e\u0438\u0448 \u043c\u0435\u043a\u0443\u043d\u0430\u043d\u0434; \u043e\u043d\u0440\u043e \u043d\u0435\u0441\u0442 \u043a\u0443\u043d\u0435\u0434 \u0451 \u043c\u0430\u0442\u043d \u0438\u043b\u043e\u0432\u0430 \u043d\u0430\u043c\u043e\u0435\u0434."
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
                "\u0423\u043d\u0432\u043e\u043d\u0438 \u0441\u0430\u04b3\u0438\u0444\u0430 \u0430\u043b\u043b\u0430\u043a\u0430\u0439 H1 \u0430\u0441\u0442; \u0431\u0430\u0440\u043e\u0438 \u0441\u0430\u0442\u04b3\u0438 \u0431\u043e\u043b\u043e\u0438\u0438 \u043c\u0443\u04b3\u0442\u0430\u0432\u043e H2-\u0440\u043e \u0438\u0441\u0442\u0438\u0444\u043e\u0434\u0430 \u0431\u0430\u0440\u0435\u0434."
            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u0418\u043d H%1$d \u044f\u043a \u0434\u0430\u0440\u0430\u04b7\u0430\u0440\u043e \u043d\u043e\u0434\u0438\u0434\u0430 \u043c\u0435\u0433\u0443\u0437\u0430\u0440\u0430\u0434; \u043f\u0435\u0448 \u0430\u0437 \u043e\u043d H%2$d \u0430\u0441\u0442. \u041e\u043d\u0440\u043e \u0431\u0430 H%3$d \u0442\u0430\u0493\u0439\u0438\u0440 \u0434\u0438\u04b3\u0435\u0434."
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u0418\u043d \u0442\u0430\u0441\u0432\u0438\u0440 \u043c\u0430\u0442\u043d\u0438 \u04b7\u043e\u0439\u0433\u0443\u0437\u0438\u043d (alt text) \u043d\u0430\u0434\u043e\u0440\u0430\u0434. \u041e\u043d\u0440\u043e \u0442\u0430\u0432\u0441\u0438\u0444 \u043a\u0443\u043d\u0435\u0434, \u0451 \u0430\u0433\u0430\u0440 \u043e\u043d \u044f\u0433\u043e\u043d \u043c\u0430\u044a\u043d\u043e \u0438\u043b\u043e\u0432\u0430 \u043d\u0430\u043a\u0443\u043d\u0430\u0434, \u043e\u043d\u0440\u043e \u04b3\u0430\u043c\u0447\u0443\u043d \u043e\u0440\u043e\u0438\u0448\u04e3 \u049b\u0430\u0439\u0434 \u043d\u0430\u043c\u043e\u0435\u0434."
            ],
            "Close panel": [
                "\u041f\u04ef\u0448\u0438\u0434\u0430\u043d\u0438 \u043f\u0430\u043d\u0435\u043b"
