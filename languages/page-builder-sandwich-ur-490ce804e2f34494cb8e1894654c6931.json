            ],
            "This image is decorative": [
                "\u06cc\u06c1 \u062a\u0635\u0648\u06cc\u0631 \u0635\u0631\u0641 \u0633\u062c\u0627\u0648\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u06d2"
