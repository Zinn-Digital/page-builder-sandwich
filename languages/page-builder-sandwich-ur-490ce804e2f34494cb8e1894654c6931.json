                "%d \u0645\u0633\u0627\u0626\u0644"
            ],
            "%d thing to check": [
                "\u0686\u06cc\u06a9 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 %d \u0686\u06cc\u0632",
                "\u062c\u0627\u0646\u0686\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 %d \u0686\u06cc\u0632\u06cc\u06ba"
            ],
            "Check again": [
                "\u062f\u0648\u0628\u0627\u0631\u06c1 \u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba"
            ],
            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u0627\u06cc\u06a9 \u062e\u0648\u062f\u06a9\u0627\u0631 \u062c\u0627\u0646\u0686 \u0628\u06c1\u062a \u0633\u06d2 \u0645\u0633\u0627\u0626\u0644 \u062a\u0644\u0627\u0634 \u06a9\u0631 \u0644\u06cc\u062a\u06cc \u06c1\u06d2 \u0644\u06cc\u06a9\u0646 \u0633\u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba\u06d4 \u0635\u0641\u062d\u06d2 \u06a9\u0648 \u0635\u0631\u0641 \u06a9\u06cc \u0628\u0648\u0631\u0688 \u0633\u06d2 \u0627\u0648\u0631 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0631\u06cc\u0688\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0628\u06be\u06cc \u0622\u0632\u0645\u0627 \u06a9\u0631 \u062f\u06cc\u06a9\u06be\u06cc\u06ba\u06d4"
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u0645\u062a\u0646 \u06a9\u0627 \u06a9\u0646\u0679\u0631\u0627\u0633\u0679 %1$s:1 \u06c1\u06d2\u061b \u0642\u0627\u0628\u0644\u0650 \u067e\u0691\u06be\u0627\u0626\u06cc \u06c1\u0648\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u06d2 \u06a9\u0645 \u0627\u0632 \u06a9\u0645 %2$s:1 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2\u06d4"
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u06cc\u06c1\u0627\u06ba \u06a9\u0644\u06a9 \u06a9\u0631\u06cc\u06ba,\u06cc\u06c1\u0627\u06ba,\u0645\u0632\u06cc\u062f \u067e\u0691\u06be\u06cc\u06ba,\u0645\u0632\u06cc\u062f,\u0631\u0628\u0637,\u06cc\u06c1 \u0631\u0628\u0637,\u0645\u0632\u06cc\u062f \u062c\u0627\u0646\u06cc\u06ba,\u062c\u0627\u0626\u06cc\u06ba"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u06a9\u0633\u06cc \u0644\u0646\u06a9 \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u0645\u062a\u0646 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0627\u0633 \u0644\u06cc\u06d2 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0631\u06cc\u0688\u0631 \u0635\u0631\u0641 \"\u0644\u0646\u06a9\" \u0628\u0648\u0644\u062a\u0627 \u06c1\u06d2\u06d4 \u0645\u062a\u0646 \u06cc\u0627 \u0644\u06cc\u0628\u0644 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\u0631\u0628\u0637 \u06a9\u0627 \u0645\u062a\u0646 \u201d%s\u201c \u06cc\u06c1 \u0646\u06c1\u06cc\u06ba \u0628\u062a\u0627\u062a\u0627 \u06a9\u06c1 \u06cc\u06c1 \u06a9\u06c1\u0627\u06ba \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u0627\u0633 \u06a9\u06d2 \u0628\u062c\u0627\u0626\u06d2 \u0645\u0646\u0632\u0644 \u06a9\u06cc \u0648\u0636\u0627\u062d\u062a \u0641\u0631\u0645\u0627\u0626\u06cc\u06ba\u06d4"
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u0627\u06cc\u06a9 \u0639\u0646\u0635\u0631 \u0645\u06cc\u06ba \u0645\u062b\u0628\u062a tabindex \u06c1\u06d2\u060c \u062c\u0648 \u06a9\u06cc \u0628\u0648\u0631\u0688 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628 \u06a9\u0648 \u067e\u0691\u06be\u0646\u06d2 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628 \u0633\u06d2 \u0628\u062f\u0644 \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u06d4 0 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba \u06cc\u0627 \u0627\u0633\u06d2 \u06c1\u0679\u0627 \u062f\u06cc\u06ba\u06d4"
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u06a9\u0644\u06a9 \u06a9\u06d2 \u0642\u0627\u0628\u0644 \u06a9\u0633\u06cc \u0639\u0646\u0635\u0631 \u062a\u06a9 \u06a9\u06cc \u0628\u0648\u0631\u0688 \u0633\u06d2 \u0646\u06c1\u06cc\u06ba \u067e\u06c1\u0646\u0686\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627\u06d4 \u06a9\u0648\u0626\u06cc \u0627\u0635\u0644 \u0628\u0679\u0646 \u06cc\u0627 \u0644\u0646\u06a9 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u0627\u06cc\u06a9 \u0627\u06cc\u0645\u0628\u06cc\u0688\u0688 \u0641\u0631\u06cc\u0645 \u06a9\u0627 \u06a9\u0648\u0626\u06cc \u0639\u0646\u0648\u0627\u0646 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0644\u06c1\u0630\u0627 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0631\u06cc\u0688\u0631 \u06cc\u06c1 \u0646\u06c1\u06cc\u06ba \u0628\u062a\u0627 \u0633\u06a9\u062a\u0627 \u06a9\u06c1 \u06cc\u06c1 \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4"
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u0641\u0627\u0631\u0645 \u06a9\u06d2 \u0641\u06cc\u0644\u0688 \u067e\u0631 \u06a9\u0648\u0626\u06cc \u0644\u06cc\u0628\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0644\u06c1\u0630\u0627 \u0627\u0633 \u06a9\u0627 \u0645\u0642\u0635\u062f \u0638\u0627\u06c1\u0631 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2\u06d4"
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u06cc\u06c1 \u0633\u0631\u062e\u06cc \u062e\u0627\u0644\u06cc \u06c1\u06d2\u06d4 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0631\u06cc\u0688\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0633\u0631\u062e\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be \u06a9\u0631 \u0646\u06cc\u0648\u06cc\u06af\u06cc\u0679 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u061b \u0627\u0633\u06d2 \u06c1\u0679\u0627 \u062f\u06cc\u06ba \u06cc\u0627 \u0645\u062a\u0646 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
                "\u0635\u0641\u062d\u06d2 \u06a9\u0627 \u0639\u0646\u0648\u0627\u0646 \u067e\u06c1\u0644\u06d2 \u06c1\u06cc H1 \u06c1\u06d2\u061b \u0645\u0648\u0627\u062f \u06a9\u06cc \u0627\u0648\u067e\u0631\u06cc \u0633\u0637\u062d \u06a9\u06d2 \u0644\u06cc\u06d2 H2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"
            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u06cc\u06c1 H%1$d \u0627\u06cc\u06a9 \u0633\u0637\u062d \u0686\u06be\u0648\u0691\u062a\u0627 \u06c1\u06d2\u061b \u0627\u0633 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0648\u0627\u0644\u0627 H%2$d \u06c1\u06d2\u06d4 \u0627\u0633\u06d2 H%3$d \u0628\u0646\u0627\u0626\u06cc\u06ba\u06d4"
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u0627\u0633 \u062a\u0635\u0648\u06cc\u0631 \u06a9\u0627 \u06a9\u0648\u0626\u06cc \u0645\u062a\u0628\u0627\u062f\u0644 \u0645\u062a\u0646 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u0627\u0633 \u06a9\u06cc \u0648\u0636\u0627\u062d\u062a \u06a9\u0631\u06cc\u06ba\u060c \u06cc\u0627 \u0627\u06af\u0631 \u06cc\u06c1 \u06a9\u0686\u06be \u0646\u06cc\u0627 \u0634\u0627\u0645\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u062a\u0648 \u0627\u0633\u06d2 \u0622\u0631\u0627\u0626\u0634\u06cc \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0646\u0634\u0627\u0646 \u0632\u062f \u06a9\u0631\u06cc\u06ba\u06d4"
            ],
            "Close panel": [
                "\u067e\u06cc\u0646\u0644 \u0628\u0646\u062f \u06a9\u0631\u06cc\u06ba"
            ]
        }
