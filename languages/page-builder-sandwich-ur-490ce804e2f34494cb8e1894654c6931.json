            "Checking\u2026": [
                "\u062c\u0627\u0646\u0686 \u067e\u0691\u062a\u0627\u0644 \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2\u2026"
            ],
            "No accessibility problems found on this page.": [
                "\u0627\u0633 \u0635\u0641\u062d\u06d2 \u067e\u0631 \u0631\u0633\u0627\u0626\u06cc \u06a9\u0627 \u06a9\u0648\u0626\u06cc \u0645\u0633\u0626\u0644\u06c1 \u0646\u06c1\u06cc\u06ba \u0645\u0644\u0627\u06d4"
            ],
