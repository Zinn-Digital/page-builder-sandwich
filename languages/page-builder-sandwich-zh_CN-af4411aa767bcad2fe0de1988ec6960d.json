            "Class name prefix": [
                "\u7c7b\u540d\u524d\u7f00"
            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u63d2\u4ef6\u5728\u60a8\u7684\u9875\u9762\u4e0a\u8f93\u51fa\u7684\u6bcf\u4e2a\u7c7b\u540d\u90fd\u4ee5\u6b64\u524d\u7f00\u5f00\u5934\uff0c\u8fd9\u6837\u9875\u9762\u5c31\u4e0d\u4f1a\u66b4\u9732\u662f\u54ea\u4e2a\u63d2\u4ef6\u6784\u5efa\u7684\u30021 \u5230 8 \u4e2a\u5c0f\u5199\u5b57\u6bcd\u6216\u6570\u5b57\uff0c\u4e14\u5fc5\u987b\u4ee5\u5b57\u6bcd\u5f00\u5934\u3002"
            ],
            "Save": [
                "\u4fdd\u5b58"
            ],
            "Beta updates": [
                "Beta \u66f4\u65b0"
            ],
            "This site receives beta versions as updates.": [
                "\u6b64\u7ad9\u70b9\u63a5\u6536\u6d4b\u8bd5\u7248\u4f5c\u4e3a\u66f4\u65b0\u3002"
            ],
            "This site receives stable versions only.": [
                "\u6b64\u7f51\u7ad9\u4ec5\u63a5\u6536\u7a33\u5b9a\u7248\u672c\u3002"
            ],
            "Change this on the Account page": [
                "\u8bf7\u5728\u201c\u8d26\u6237\u201d\u9875\u9762\u4e0a\u66f4\u6539\u6b64\u8bbe\u7f6e"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u6d4b\u8bd5\u7248\u4ec5\u5411\u4e0e\u5176\u8d26\u6237\u5173\u8054\u7684\u5df2\u6388\u6743 Pro \u5b89\u88c5\u63d0\u4f9b\u3002\u8fde\u63a5\u540e\uff0c\u60a8\u5373\u53ef\u4ece\u201c\u8d26\u6237\u201d\u9875\u9762\u52a0\u5165\u3002"
            ],
            "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here.": [
                "\u8f6c\u6362\u6b64\u6587\u7ae0\u7684\u8bf7\u6c42\u5728\u5b8c\u6210\u524d\u5df2\u505c\u6b62\uff0c\u56e0\u6b64\u8be5\u6587\u7ae0\u5df2\u88ab\u8df3\u8fc7\u3002\u6253\u5f00\u5b83\u4ee5\u8fdb\u884c\u8f6c\u6362\uff0c\u6216\u4ece\u6b64\u5904\u518d\u6b21\u8f6c\u6362\u3002"
            ],
            "There is no backup of this post to restore.": [
                "\u6ca1\u6709\u53ef\u6062\u590d\u7684\u6b64\u6587\u7ae0\u5907\u4efd\u3002"
            ],
            "The converted content could not be saved.": [
                "\u65e0\u6cd5\u4fdd\u5b58\u8f6c\u6362\u540e\u7684\u5185\u5bb9\u3002"
            ],
            "Unknown error.": [
                "\u672a\u77e5\u9519\u8bef\u3002"
            ],
            "No legacy content has been checked yet.": [
                "\u5c1a\u672a\u68c0\u67e5\u4efb\u4f55\u65e7\u7248\u5185\u5bb9\u3002"
            ],
            "Restoring legacy content: %1$d of %2$d posts.": [
                "\u6b63\u5728\u6062\u590d\u65e7\u5185\u5bb9\uff1a\u5171 %2$d \u7bc7\u4e2d\u7684\u7b2c %1$d \u7bc7\u3002"
            ],
            "Converting legacy content: %1$d of %2$d posts.": [
                "\u6b63\u5728\u8f6c\u6362\u65e7\u5185\u5bb9\uff1a%1$d\/%2$d \u7bc7\u53d1\u5e03\u3002"
            ],
            "Undo finished: %1$d restored, %2$d failed.": [
                "\u64a4\u9500\u5b8c\u6210\uff1a\u5df2\u6062\u590d %1$d \u4e2a\uff0c\u5931\u8d25 %2$d \u4e2a\u3002"
            ],
            "Conversion finished: %1$d converted, %2$d unchanged, %3$d failed.": [
                "\u8f6c\u6362\u5b8c\u6210\uff1a%1$d \u4e2a\u5df2\u8f6c\u6362\uff0c%2$d \u4e2a\u672a\u66f4\u6539\uff0c%3$d \u4e2a\u5931\u8d25\u3002"
            ],
            "Legacy content": [
                "\u65e7\u7248\u5185\u5bb9"
            ],
            "Pages made with earlier versions of Page Builder Sandwich are converted to blocks in the background. Every post is backed up first, so each conversion can be undone.": [
                "\u4f7f\u7528\u65e9\u671f\u7248\u672c\u7684 Page Builder Sandwich \u521b\u5efa\u7684\u9875\u9762\u4f1a\u5728\u540e\u53f0\u8f6c\u6362\u4e3a\u533a\u5757\u3002\u7cfb\u7edf\u4f1a\u5148\u5907\u4efd\u6bcf\u7bc7\u6587\u7ae0\uff0c\u56e0\u6b64\u6bcf\u9879\u8f6c\u6362\u90fd\u53ef\u4ee5\u64a4\u9500\u3002"
            ],
            "%d post still holds legacy content.": [
                "%d \u7bc7\u53d1\u5e03\u4ecd\u7136\u5305\u542b\u65e7\u7248\u5185\u5bb9\u3002"
            ],
            "%d post has a backup.": [
                "%d \u7bc7\u6587\u7ae0\u5df2\u6709\u5907\u4efd\u3002"
            ],
            "%d post could not be handled": [
                "\u65e0\u6cd5\u5904\u7406 %d \u7bc7\u6587\u7ae0"
            ],
            "Post %d": [
                "\u6587\u7ae0 %d"
            ],
            "Conversion started. It continues in the background; you can leave this page.": [
                "\u8f6c\u6362\u5df2\u5f00\u59cb\u3002\u5b83\u5c06\u5728\u540e\u53f0\u7ee7\u7eed\u8fd0\u884c\uff0c\u60a8\u53ef\u4ee5\u79bb\u5f00\u6b64\u9875\u9762\u3002"
            ],
            "Convert legacy content": [
                "\u8f6c\u6362\u65e7\u7248\u5185\u5bb9"
            ],
            "Restore every converted post to its legacy content? Changes made to those posts since they were converted will be lost.": [
                "\u8981\u5c06\u6240\u6709\u5df2\u8f6c\u6362\u7684\u6587\u7ae0\u6062\u590d\u4e3a\u65e7\u7248\u5185\u5bb9\u5417\uff1f\u81ea\u8f6c\u6362\u4ee5\u6765\u5bf9\u8fd9\u4e9b\u6587\u7ae0\u6240\u505a\u7684\u66f4\u6539\u5c06\u4f1a\u4e22\u5931\u3002"
            ],
            "Undo started. It continues in the background; you can leave this page.": [
                "\u64a4\u9500\u5df2\u5f00\u59cb\u3002\u5b83\u5c06\u7ee7\u7eed\u5728\u540e\u53f0\u8fd0\u884c\uff0c\u60a8\u53ef\u4ee5\u79bb\u5f00\u6b64\u9875\u9762\u3002"
            ],
            "Undo all conversions": [
                "\u64a4\u9500\u6240\u6709\u8f6c\u6362"
            ]
        }
