            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\ubca0\ud0c0 \ubc84\uc804\uc740 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub41c \ub77c\uc774\uc120\uc2a4 Pro \uc124\uce58\uc5d0 \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc5f0\uacb0\ub418\uba74 \uacc4\uc815 \ud398\uc774\uc9c0\uc5d0\uc11c \ucc38\uc5ec\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
            ],
            "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here.": [
                "\uc774 \uac8c\uc2dc\ubb3c\uc744 \ubcc0\ud658\ud558\ub294 \uc694\uccad\uc774 \uc644\ub8cc\ub418\uae30 \uc804\uc5d0 \uc911\ub2e8\ub418\uc5b4 \uac8c\uc2dc\ubb3c\uc774 \uac74\ub108\ub6f0\uc5b4\uc84c\uc2b5\ub2c8\ub2e4. \ubcc0\ud658\ud558\ub824\uba74 \uac8c\uc2dc\ubb3c\uc744 \uc5f4\uac70\ub098 \uc5ec\uae30\uc5d0\uc11c \ub2e4\uc2dc \ubcc0\ud658\ud558\uc138\uc694."
