            ],
            "This site receives beta versions as updates.": [
                "\u3053\u306e\u30b5\u30a4\u30c8\u306f\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3068\u3057\u3066\u30d9\u30fc\u30bf\u7248\u3092\u53d7\u4fe1\u3057\u307e\u3059\u3002"
            ],
            "This site receives stable versions only.": [
                "\u3053\u306e\u30b5\u30a4\u30c8\u306f\u5b89\u5b9a\u7248\u306e\u307f\u3092\u53d7\u4fe1\u3057\u307e\u3059\u3002"
            ],
            "Change this on the Account page": [
                "\u30a2\u30ab\u30a6\u30f3\u30c8\u30da\u30fc\u30b8\u3067\u3053\u308c\u3092\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u30d9\u30fc\u30bf\u7248\u306f\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u308b\u30e9\u30a4\u30bb\u30f3\u30b9\u7248\u306ePro\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3067\u3054\u5229\u7528\u3044\u305f\u3060\u3051\u307e\u3059\u3002\u63a5\u7d9a\u5f8c\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u30da\u30fc\u30b8\u304b\u3089\u53c2\u52a0\u3067\u304d\u307e\u3059\u3002"
            ],
            "Breakpoints saved. Pages pick up the new widths on their next view.": [
                "\u30d6\u30ec\u30fc\u30af\u30dd\u30a4\u30f3\u30c8\u304c\u4fdd\u5b58\u3055\u308c\u307e\u3057\u305f\u3002\u6b21\u56de\u8868\u793a\u6642\u306b\u3001\u30da\u30fc\u30b8\u306b\u65b0\u3057\u3044\u5e45\u304c\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
            ],
            "Breakpoints": [
                "\u30d6\u30ec\u30fc\u30af\u30dd\u30a4\u30f3\u30c8"
            ],
            "Styles set for Tablet apply up to the tablet width, and styles set for Mobile up to the mobile width. Desktop styles apply everywhere else.": [
                "\u30bf\u30d6\u30ec\u30c3\u30c8\u7528\u306b\u8a2d\u5b9a\u3055\u308c\u305f\u30b9\u30bf\u30a4\u30eb\u306f\u30bf\u30d6\u30ec\u30c3\u30c8\u5e45\u307e\u3067\u9069\u7528\u3055\u308c\u3001\u30e2\u30d0\u30a4\u30eb\u7528\u306b\u8a2d\u5b9a\u3055\u308c\u305f\u30b9\u30bf\u30a4\u30eb\u306f\u30e2\u30d0\u30a4\u30eb\u5e45\u307e\u3067\u9069\u7528\u3055\u308c\u307e\u3059\u3002\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u30b9\u30bf\u30a4\u30eb\u306f\u305d\u308c\u4ee5\u5916\u306e\u3059\u3079\u3066\u306e\u5834\u6240\u306b\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
            ],
            "Tablet: up to (px)": [
                "\u30bf\u30d6\u30ec\u30c3\u30c8\uff1a\u6700\u5927\uff08px\uff09"
            ],
            "Mobile: up to (px)": [
                "\u30e2\u30d0\u30a4\u30eb: \u6700\u5927 (px)"
            ],
            "Save breakpoints": [
                "\u30d6\u30ec\u30fc\u30af\u30dd\u30a4\u30f3\u30c8\u3092\u4fdd\u5b58"
            ],
            "Use the default widths": [
                "\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u5e45\u3092\u4f7f\u7528\u3059\u308b"
            ],
            "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here.": [
                "\u3053\u306e\u6295\u7a3f\u306e\u5909\u63db\u51e6\u7406\u304c\u5b8c\u4e86\u3059\u308b\u524d\u306b\u505c\u6b62\u3057\u305f\u305f\u3081\u3001\u6295\u7a3f\u306f\u30b9\u30ad\u30c3\u30d7\u3055\u308c\u307e\u3057\u305f\u3002\u958b\u3044\u3066\u5909\u63db\u3059\u308b\u304b\u3001\u3053\u3053\u304b\u3089\u518d\u5ea6\u5909\u63db\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
            ],
            "There is no backup of this post to restore.": [
                "\u5fa9\u5143\u3067\u304d\u308b\u3053\u306e\u6295\u7a3f\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
            ],
            "The converted content could not be saved.": [
                "\u5909\u63db\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u4fdd\u5b58\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
            ],
            "Unknown error.": [
                "\u4e0d\u660e\u306a\u30a8\u30e9\u30fc\u3067\u3059\u3002"
            ],
            "No legacy content has been checked yet.": [
                "\u30ec\u30ac\u30b7\u30fc\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u307e\u3060\u30c1\u30a7\u30c3\u30af\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
            ],
            "Restoring legacy content: %1$d of %2$d posts.": [
                "\u30ec\u30ac\u30b7\u30fc\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u5fa9\u5143\u4e2d\uff1a%1$d \/ %2$d \u4ef6\u306e\u6295\u7a3f"
            ],
            "Converting legacy content: %1$d of %2$d posts.": [
                "\u30ec\u30ac\u30b7\u30fc\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u5909\u63db\u4e2d\uff1a%1$d \/ %2$d \u4ef6\u306e\u8a18\u4e8b\u3002"
            ],
            "Undo finished: %1$d restored, %2$d failed.": [
                "\u53d6\u308a\u6d88\u3057\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f: \u5fa9\u5143\u6210\u529f %1$d\u4ef6\u3001\u5fa9\u5143\u5931\u6557 %2$d\u4ef6\u3002"
            ],
            "Conversion finished: %1$d converted, %2$d unchanged, %3$d failed.": [
                "\u5909\u63db\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f\uff1a%1$d\u4ef6\u5909\u63db\u3001%2$d\u4ef6\u5909\u66f4\u306a\u3057\u3001%3$d\u4ef6\u5931\u6557\u3057\u307e\u3057\u305f\u3002"
            ],
            "Legacy content": [
                "\u30ec\u30ac\u30b7\u30fc\u30b3\u30f3\u30c6\u30f3\u30c4"
            ],
            "Pages made with earlier versions of Page Builder Sandwich are converted to blocks in the background. Every post is backed up first, so each conversion can be undone.": [
                "Page Builder Sandwich\u306e\u4ee5\u524d\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u4f5c\u6210\u3055\u308c\u305f\u30da\u30fc\u30b8\u306f\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u30d6\u30ed\u30c3\u30af\u306b\u5909\u63db\u3055\u308c\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u6295\u7a3f\u304c\u4e8b\u524d\u306b\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3055\u308c\u308b\u305f\u3081\u3001\u305d\u308c\u305e\u308c\u306e\u5909\u63db\u3092\u3082\u3068\u306b\u623b\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"
            ],
            "%d post still holds legacy content.": [
                "%d \u4ef6\u306e\u6295\u7a3f\u306b\u30ec\u30ac\u30b7\u30fc\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u6b8b\u3063\u3066\u3044\u307e\u3059\u3002"
            ],
            "%d post has a backup.": [
                "%d\u4ef6\u306e\u6295\u7a3f\u306b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\u3002"
            ],
            "%d post could not be handled": [
                "%d\u4ef6\u306e\u6295\u7a3f\u3092\u51e6\u7406\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f"
            ],
            "Post %d": [
                "\u6295\u7a3f %d"
            ],
            "Conversion started. It continues in the background; you can leave this page.": [
                "\u5909\u63db\u304c\u958b\u59cb\u3055\u308c\u307e\u3057\u305f\u3002\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u51e6\u7406\u304c\u7d99\u7d9a\u3055\u308c\u308b\u305f\u3081\u3001\u3053\u306e\u30da\u30fc\u30b8\u3092\u96e2\u308c\u3066\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002"
            ],
            "Convert legacy content": [
                "\u30ec\u30ac\u30b7\u30fc\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u5909\u63db"
            ],
            "Restore every converted post to its legacy content? Changes made to those posts since they were converted will be lost.": [
                "\u5909\u63db\u3055\u308c\u305f\u3059\u3079\u3066\u306e\u6295\u7a3f\u3092\u4ee5\u524d\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u306b\u623b\u3057\u307e\u3059\u304b\uff1f\u5909\u63db\u5f8c\u306b\u884c\u308f\u308c\u305f\u5909\u66f4\u306f\u5931\u308f\u308c\u307e\u3059\u3002"
            ],
            "Undo started. It continues in the background; you can leave this page.": [
                "\u5143\u306b\u623b\u3059\u51e6\u7406\u3092\u958b\u59cb\u3057\u307e\u3057\u305f\u3002\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u7d9a\u884c\u3055\u308c\u308b\u305f\u3081\u3001\u3053\u306e\u30da\u30fc\u30b8\u3092\u96e2\u308c\u3066\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002"
            ],
            "Undo all conversions": [
                "\u3059\u3079\u3066\u306e\u5909\u63db\u3092\u5143\u306b\u623b\u3059"
            ]
        }
    }
