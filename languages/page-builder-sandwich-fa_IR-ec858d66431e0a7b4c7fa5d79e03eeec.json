    "locale_data": {
        "messages": {
            "": {
                "domain": "messages",
                "lang": "fa_IR",
                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Import and export": [
                "\u0648\u0627\u0631\u062f\u0627\u062a \u0648 \u0635\u0627\u062f\u0631\u0627\u062a"
            ],
            "%d new": [
                "%d \u062c\u062f\u06cc\u062f",
                "%d \u062c\u062f\u06cc\u062f"
            ],
            "%d replaced": [
                "%d \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u0634\u062f",
                "%d \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u0634\u062f"
            ],
            "%d kept as they were": [
                "%d \u0628\u062f\u0648\u0646 \u062a\u063a\u06cc\u06cc\u0631 \u0628\u0627\u0642\u06cc \u0645\u0627\u0646\u062f\u0646\u062f",
                "%d \u0628\u062f\u0648\u0646 \u062a\u063a\u06cc\u06cc\u0631 \u0628\u0627\u0642\u06cc \u0645\u0627\u0646\u062f\u0646\u062f"
            ],
            "%d setting": [
                "\u062a\u0646\u0638\u06cc\u0645 %d",
                "%d \u062a\u0646\u0638\u06cc\u0645\u0627\u062a"
            ],
            "Importing will give: %s.": [
                "\u062f\u0631\u0648\u0646\u200c\u0631\u06cc\u0632\u06cc \u0646\u062a\u06cc\u062c\u0647 \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f: %s."
            ],
            "Imported: %s.": [
                "\u0648\u0627\u0631\u062f \u0634\u062f: %s."
            ],
            "Exported %d item.": [
                "%d \u0645\u0648\u0631\u062f \u0635\u0627\u062f\u0631 \u0634\u062f.",
                "%d \u0645\u0648\u0631\u062f \u0635\u0627\u062f\u0631 \u0634\u062f."
            ],
            "That file could not be read as an export file.": [
                "\u0622\u0646 \u0641\u0627\u06cc\u0644 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u0641\u0627\u06cc\u0644 \u062e\u0631\u0648\u062c\u06cc \u0642\u0627\u0628\u0644 \u062e\u0648\u0627\u0646\u062f\u0646 \u0646\u0628\u0648\u062f."
            ],
            "Export": [
                "\u0628\u0631\u0648\u0646\u200c\u0628\u0631\u06cc"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0642\u0627\u0644\u0628\u200c\u0647\u0627\u060c \u0627\u0644\u06af\u0648\u0647\u0627 \u0648 \u0637\u0631\u0627\u062d\u06cc \u0633\u0627\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u0641\u0627\u06cc\u0644 \u0628\u0631\u0627\u06cc \u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646 \u062f\u0631 \u0633\u0627\u06cc\u062a\u06cc \u062f\u06cc\u06af\u0631 \u0628\u0627\u0631\u06af\u06cc\u0631\u06cc \u06a9\u0646\u06cc\u062f."
            ],
            "There are no templates or patterns to export yet.": [
                "\u0647\u0646\u0648\u0632 \u0647\u06cc\u0686 \u0642\u0627\u0644\u0628 \u06cc\u0627 \u0627\u0644\u06af\u0648\u06cc\u06cc \u0628\u0631\u0627\u06cc \u0635\u0627\u062f\u0631\u0627\u062a \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f."
            ],
            "Include the settings": [
                "\u0634\u0627\u0645\u0644 \u06a9\u0631\u062f\u0646 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a"
            ],
            "Download the export file": [
                "\u0628\u0627\u0631\u06af\u06cc\u0631\u06cc \u0641\u0627\u06cc\u0644 \u062e\u0631\u0648\u062c\u06cc"
            ],
            "Import": [
                "\u0648\u0627\u0631\u062f \u06a9\u0631\u062f\u0646"
            ],
            "Choose an export file": [
                "\u06cc\u06a9 \u0641\u0627\u06cc\u0644 \u062e\u0631\u0648\u062c\u06cc \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0627\u06cc\u0646 \u0641\u0627\u06cc\u0644 \u0634\u0627\u0645\u0644 %1$d \u0645\u0648\u0631\u062f \u0627\u0632 %2$s \u0627\u0633\u062a.",
                "\u0627\u06cc\u0646 \u067e\u0631\u0648\u0646\u062f\u0647 \u0634\u0627\u0645\u0644 %1$d \u0645\u0648\u0631\u062f \u0627\u0632 %2$s \u0627\u0633\u062a."
            ],
            "When an item with the same name already exists here": [
                "\u0648\u0642\u062a\u06cc \u0645\u0648\u0631\u062f\u06cc \u0628\u0627 \u0647\u0645\u06cc\u0646 \u0646\u0627\u0645 \u0627\u0632 \u0642\u0628\u0644 \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f"
            ],
            "Keep the one on this site": [
                "\u0645\u0648\u0631\u062f \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0627\u06cc\u0646 \u0633\u0627\u06cc\u062a \u0631\u0627 \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u062f"
            ],
            "Replace it with the imported one": [
                "\u0622\u0646 \u0631\u0627 \u0628\u0627 \u0645\u0648\u0627\u0631\u062f \u0648\u0627\u0631\u062f \u0634\u062f\u0647 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u06a9\u0646\u06cc\u062f"
            ],
            "Import a copy beside it": [
                "\u06cc\u06a9 \u06a9\u067e\u06cc \u062f\u0631 \u06a9\u0646\u0627\u0631 \u0622\u0646 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f"
            ],
            "Apply the settings in the file": [
                "\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0641\u0627\u06cc\u0644 \u0631\u0627 \u0627\u0639\u0645\u0627\u0644 \u06a9\u0646\u06cc\u062f"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u062a\u0635\u0627\u0648\u06cc\u0631 \u0631\u0627 \u062f\u0631 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0631\u0633\u0627\u0646\u0647 \u0627\u06cc\u0646 \u0648\u0628\u200c\u0633\u0627\u06cc\u062a \u06a9\u067e\u06cc \u06a9\u0646\u06cc\u062f"
            ],
            "Show what will happen": [
                "\u0646\u0645\u0627\u06cc\u0634 \u0622\u0646\u0686\u0647 \u0631\u062e \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f"
            ]
        }
    }
}
