            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u041b\u0438\u0448\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456, \u044f\u043a\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0434\u043e\u0434\u0430\u0432\u0430\u0442\u0438 \u043d\u0435\u0432\u0456\u0434\u0444\u0456\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0439 HTML, \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u043c\u0456\u043d\u044e\u0432\u0430\u0442\u0438 \u0432\u043b\u0430\u0441\u043d\u0456 CSS."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0427\u0430\u0441\u0442\u0438\u043d\u0430 \u0446\u044c\u043e\u0433\u043e CSS \u043d\u0435 \u0431\u0443\u0434\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044f: @import, expression(), URL-\u0430\u0434\u0440\u0435\u0441\u0438 javascript:, \"<\" \u0456 \u043d\u0435\u0437\u0431\u0430\u043b\u0430\u043d\u0441\u043e\u0432\u0430\u043d\u0456 \u0444\u0456\u0433\u0443\u0440\u043d\u0456 \u0434\u0443\u0436\u043a\u0438 \u0432\u0438\u0434\u0430\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0437 \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c \u0431\u0435\u0437\u043f\u0435\u043a\u0438."
            ],
            "Page CSS": [
                "CSS \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438"
            ],
            "Global classes": [
                "\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0456 \u043a\u043b\u0430\u0441\u0438"
            ],
            "Classes": [
                "\u041a\u043b\u0430\u0441\u0438"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043a\u043b\u0430\u0441\u0438 \u0432 \u0414\u0438\u0437\u0430\u0439\u043d\u0456 \u0441\u0430\u0439\u0442\u0443, \u0430 \u043f\u043e\u0442\u0456\u043c \u0434\u043e\u0434\u0430\u0439\u0442\u0435 \u0457\u0445 \u0441\u044e\u0434\u0438."
            ],
            "Custom CSS": [
                "\u0412\u043b\u0430\u0441\u043d\u0438\u0439 CSS"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430. \"selector\" \u043e\u0437\u043d\u0430\u0447\u0430\u0454 \u0446\u0435\u0439 \u0435\u043b\u0435\u043c\u0435\u043d\u0442, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 selector:hover { opacity: .8 } \u2014 \u043f\u0440\u043e\u0441\u0442\u0456 \u043e\u0433\u043e\u043b\u043e\u0448\u0435\u043d\u043d\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043e \u0441\u0430\u043c\u043e\u0433\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430."
            ],
            "CSS for this page": [
                "CSS \u0434\u043b\u044f \u0446\u0456\u0454\u0457 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u043d\u0430 \u0446\u0456\u0439 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456, \u043f\u0456\u0441\u043b\u044f \u0441\u0442\u0438\u043b\u0456\u0432 \u0441\u0430\u0439\u0442\u0443. \u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0440\u0430\u0437\u043e\u043c \u0437\u0456 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u043e\u044e."
            ]
        }
