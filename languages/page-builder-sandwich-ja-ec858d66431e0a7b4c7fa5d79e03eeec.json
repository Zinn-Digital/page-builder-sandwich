            ],
            "%d replaced": [
                "%d\u4ef6\u7f6e\u63db\u3055\u308c\u307e\u3057\u305f"
            ],
            "%d kept as they were": [
                "%d\u4ef6\u306f\u305d\u306e\u307e\u307e\u7dad\u6301\u3055\u308c\u307e\u3057\u305f"
            ],
            "%d setting": [
                "%d\u500b\u306e\u8a2d\u5b9a"
            ],
            "Importing will give: %s.": [
                "\u30a4\u30f3\u30dd\u30fc\u30c8\u3059\u308b\u3068\u6b21\u306e\u3088\u3046\u306b\u306a\u308a\u307e\u3059: %s\u3002"
            ],
            "Imported: %s.": [
                "\u30a4\u30f3\u30dd\u30fc\u30c8\u6e08\u307f\uff1a%s\u3002"
            ],
            "Exported %d item.": [
                "%d\u4ef6\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u3057\u307e\u3057\u305f\u3002"
            ],
            "That file could not be read as an export file.": [
                "\u305d\u306e\u30d5\u30a1\u30a4\u30eb\u3092\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u30d5\u30a1\u30a4\u30eb\u3068\u3057\u3066\u8aad\u307f\u8fbc\u3081\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
            ],
            "Import and export": [
                "\u30a4\u30f3\u30dd\u30fc\u30c8\u3068\u30a8\u30af\u30b9\u30dd\u30fc\u30c8"
            ],
            "Export": [
                "\u30a8\u30af\u30b9\u30dd\u30fc\u30c8"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3001\u30d1\u30bf\u30fc\u30f3\u3001\u304a\u3088\u3073\u30b5\u30a4\u30c8\u306e\u30c7\u30b6\u30a4\u30f3\u30921\u3064\u306e\u30d5\u30a1\u30a4\u30eb\u3068\u3057\u3066\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3001\u5225\u306e\u30b5\u30a4\u30c8\u306b\u30a4\u30f3\u30dd\u30fc\u30c8\u3057\u307e\u3059\u3002"
            ],
            "There are no templates or patterns to export yet.": [
                "\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u3067\u304d\u308b\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3084\u30d1\u30bf\u30fc\u30f3\u306f\u307e\u3060\u3042\u308a\u307e\u305b\u3093\u3002"
            ],
            "Include the settings": [
                "\u8a2d\u5b9a\u3092\u542b\u3081\u308b"
            ],
            "Download the export file": [
                "\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u30d5\u30a1\u30a4\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9"
            ],
            "Import": [
                "\u30a4\u30f3\u30dd\u30fc\u30c8"
            ],
            "Choose an export file": [
                "\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u30d5\u30a1\u30a4\u30eb\u306e\u9078\u629e"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u3053\u306e\u30d5\u30a1\u30a4\u30eb\u306b\u306f %2$s \u304b\u3089\u306e\u30a2\u30a4\u30c6\u30e0\u304c %1$d \u500b\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002"
            ],
            "When an item with the same name already exists here": [
                "\u540c\u540d\u306e\u30a2\u30a4\u30c6\u30e0\u304c\u3059\u3067\u306b\u3053\u3053\u306b\u5b58\u5728\u3059\u308b\u5834\u5408"
            ],
            "Keep the one on this site": [
                "\u3053\u306e\u30b5\u30a4\u30c8\u306e\u9805\u76ee\u3092\u6b8b\u3059"
            ],
            "Replace it with the imported one": [
                "\u30a4\u30f3\u30dd\u30fc\u30c8\u3057\u305f\u3082\u306e\u3067\u7f6e\u304d\u63db\u3048\u308b"
            ],
            "Import a copy beside it": [
                "\u96a3\u306b\u30b3\u30d4\u30fc\u3092\u30a4\u30f3\u30dd\u30fc\u30c8"
            ],
            "Apply the settings in the file": [
                "\u30d5\u30a1\u30a4\u30eb\u306e\u8a2d\u5b9a\u3092\u9069\u7528\u3059\u308b"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u3053\u306e\u30b5\u30a4\u30c8\u306e\u30e1\u30c7\u30a3\u30a2\u30e9\u30a4\u30d6\u30e9\u30ea\u306b\u753b\u50cf\u3092\u30b3\u30d4\u30fc\u3057\u307e\u3059"
            ],
            "Show what will happen": [
                "\u5b9f\u884c\u7d50\u679c\u3092\u8868\u793a\u3059\u308b"
            ]
        }
    }
