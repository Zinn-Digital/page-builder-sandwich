            ],
            "Turn a Figma frame into an editable page: auto layout becomes rows, columns and grids, text keeps its fonts and sizes, and images are copied into your media library. The site talks to Figma with your own Figma account; nothing goes through us.": [
                "\u0424\u0440\u0435\u0439\u043c\u0438 Figma-\u0440\u043e \u0431\u0430 \u0441\u0430\u04b3\u0438\u0444\u0430\u0438 \u049b\u043e\u0431\u0438\u043b\u0438 \u0442\u0430\u04b3\u0440\u0438\u0440 \u0442\u0430\u0431\u0434\u0438\u043b \u0434\u0438\u04b3\u0435\u0434: auto layout \u0431\u0430 \u0441\u0430\u0442\u0440\u04b3\u043e, \u0441\u0443\u0442\u0443\u043d\u04b3\u043e \u0432\u0430 \u0448\u0430\u0431\u0430\u043a\u0430\u04b3\u043e \u0442\u0430\u0431\u0434\u0438\u043b \u043c\u0435\u0451\u0431\u0430\u0434, \u043c\u0430\u0442\u043d \u04b3\u0443\u0440\u0443\u0444 \u0432\u0430 \u0430\u043d\u0434\u043e\u0437\u0430\u04b3\u043e\u0438 \u0445\u0443\u0434\u0440\u043e \u043d\u0438\u0433\u043e\u04b3 \u043c\u0435\u0434\u043e\u0440\u0430\u0434 \u0432\u0430 \u0442\u0430\u0441\u0432\u0438\u0440\u04b3\u043e \u0431\u0430 \u043a\u0438\u0442\u043e\u0431\u0445\u043e\u043d\u0430\u0438 \u0440\u0430\u0441\u043e\u043d\u0430\u0438\u0438 \u0448\u0443\u043c\u043e \u043d\u0443\u0441\u0445\u0430\u0431\u0430\u0440\u0434\u043e\u0440\u04e3 \u043c\u0435\u0448\u0430\u0432\u0430\u043d\u0434. \u0421\u043e\u043c\u043e\u043d\u0430 \u0431\u043e Figma \u0442\u0430\u0432\u0430\u0441\u0441\u0443\u0442\u0438 \u04b3\u0438\u0441\u043e\u0431\u0438 \u0445\u0443\u0434\u0438 \u0448\u0443\u043c\u043e \u0434\u0430\u0440 Figma \u043f\u0430\u0439\u0432\u0430\u0441\u0442 \u043c\u0435\u0448\u0430\u0432\u0430\u0434; \u04b3\u0435\u04b7 \u0447\u0438\u0437 \u0430\u0437 \u0442\u0430\u0440\u0438\u049b\u0438 \u043c\u043e \u043d\u0430\u043c\u0435\u0433\u0443\u0437\u0430\u0440\u0430\u0434."
            ],
