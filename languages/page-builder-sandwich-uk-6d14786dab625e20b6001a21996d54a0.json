                "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0446\u0456 \u043c\u0456\u0442\u043a\u0438 \u043d\u0430 \u043c\u043e\u0454\u043c\u0443 \u0441\u0430\u0439\u0442\u0456"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0412\u0438\u043c\u043a\u043d\u0456\u0442\u044c, \u044f\u043a\u0449\u043e \u0432\u0430\u0448\u0430 \u0442\u0435\u043c\u0430 \u0430\u0431\u043e \u0456\u043d\u0448\u0438\u0439 \u043f\u043b\u0430\u0433\u0456\u043d \u0443\u0436\u0435 \u0434\u043e\u0434\u0430\u044e\u0442\u044c \u0457\u0445; \u043f\u043e\u0434\u0456\u0457 \u0432\u0441\u0435 \u043e\u0434\u043d\u043e \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u0442\u0438\u043c\u0443\u0442\u044c\u0441\u044f."
            ],
            "Event name for form submissions": [
                "\u041d\u0430\u0437\u0432\u0430 \u043f\u043e\u0434\u0456\u0457 \u0434\u043b\u044f \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0444\u043e\u0440\u043c"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0411\u0430\u043d\u0435\u0440 \u2014 \u0446\u0435 \u0441\u043f\u043b\u0438\u0432\u0430\u044e\u0447\u0435 \u0432\u0456\u043a\u043d\u043e, \u044f\u043a\u0435 \u0432\u0438 \u0441\u0442\u0432\u043e\u0440\u044e\u0454\u0442\u0435 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0431\u043b\u043e\u043a\u0456\u0432. \u0419\u043e\u0433\u043e \u043a\u043d\u043e\u043f\u043a\u0438 \u0432\u0435\u0434\u0443\u0442\u044c \u043d\u0430 #consent-accept, #consent-reject \u0442\u0430 #consent-save (\u0437 \u043f\u0440\u0430\u043f\u043e\u0440\u0446\u044f\u043c\u0438 \u0437 \u043d\u0430\u0437\u0432\u0430\u043c\u0438 analytics \u0456 marketing \u0434\u043b\u044f \u00absave\u00bb); \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 #consent-open \u0443 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454 \u0439\u043e\u0433\u043e \u0437\u043d\u043e\u0432\u0443. \u041f\u043e\u043a\u0438 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447 \u043d\u0435 \u043f\u043e\u0433\u043e\u0434\u0438\u0442\u044c\u0441\u044f, \u0442\u0435\u0433\u0438 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u044e\u0442\u044c\u0441\u044f, Google Consent Mode \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u0441\u0442\u0430\u043d\u0456 \u00abdenied\u00bb, \u0430 \u0437\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0456 \u0432\u0430\u043c\u0438 \u0441\u043a\u0440\u0438\u043f\u0442\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0438\u043c\u0438."
            ],
            "Create a ready-made banner": [
                "\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0433\u043e\u0442\u043e\u0432\u0438\u0439 \u0431\u0430\u043d\u0435\u0440"
            ],
            "Show a cookie banner": [
                "\u041f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u0431\u0430\u043d\u0435\u0440 cookie"
            ],
            "Banner": [
                "\u0411\u0430\u043d\u0435\u0440"
            ],
            "Choose a popup\u2026": [
                "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0441\u043f\u043b\u0438\u0432\u0430\u044e\u0447\u0435 \u0432\u0456\u043a\u043d\u043e\u2026"
            ],
            "%s (draft)": [
                "%s (\u0447\u0435\u0440\u043d\u0435\u0442\u043a\u0430)"
            ],
            "Edit the banner": [
                "\u0420\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0431\u0430\u043d\u0435\u0440"
            ],
            "Remember the choice for (days)": [
                "\u0417\u0430\u043f\u0430\u043c'\u044f\u0442\u0430\u0442\u0438 \u0432\u0438\u0431\u0456\u0440 \u043d\u0430 (\u0434\u043d\u0456\u0432)"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u0417\u0430 \u043c\u0435\u0436\u0430\u043c\u0438 \u0404\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u044c\u043a\u043e\u0433\u043e \u0421\u043e\u044e\u0437\u0443, \u0404\u0415\u0417 \u0442\u0430 \u0412\u0435\u043b\u0438\u043a\u043e\u0457 \u0411\u0440\u0438\u0442\u0430\u043d\u0456\u0457: \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0432\u0430\u0442\u0438 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f, \u0434\u043e\u043a\u0438 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447 \u043d\u0435 \u0432\u0456\u0434\u043c\u043e\u0432\u0438\u0442\u044c\u0441\u044f"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043e: \u043a\u043e\u0436\u0435\u043d \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447 \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043d\u0430\u0434\u0430\u0442\u0438 \u0437\u0433\u043e\u0434\u0443 (\u043d\u0430\u0439\u0441\u0443\u0432\u043e\u0440\u0456\u0448\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0442\u0430 \u0442\u0438\u043f\u043e\u0432\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043d\u0442). \u0423\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e: \u043b\u0438\u0448\u0435 \u0442\u043e\u0434\u0456, \u043a\u043e\u043b\u0438 \u0432\u0430\u0448 \u0445\u043e\u0441\u0442\u0438\u043d\u0433 \u0430\u0431\u043e CDN \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454 \u043a\u0440\u0430\u0457\u043d\u0443 \u0432\u0456\u0434\u0432\u0456\u0434\u0443\u0432\u0430\u0447\u0430 (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a CF-IPCountry \u0432\u0456\u0434 Cloudflare) \u0456 \u0432\u043e\u043d\u0430 \u0440\u043e\u0437\u0442\u0430\u0448\u043e\u0432\u0430\u043d\u0430 \u0437\u0430 \u043c\u0435\u0436\u0430\u043c\u0438 EU, \u0404\u0415\u0417, \u0412\u0435\u043b\u0438\u043a\u043e\u0457 \u0411\u0440\u0438\u0442\u0430\u043d\u0456\u0457 \u0442\u0430 \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0456\u0457. \u0411\u0430\u043d\u0435\u0440 \u0443\u0441\u0435 \u043e\u0434\u043d\u043e \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u044c\u0441\u044f, \u0430 \u043d\u0435\u0432\u0456\u0434\u043e\u043c\u0430 \u043a\u0440\u0430\u0457\u043d\u0430 \u0432\u0432\u0430\u0436\u0430\u0454\u0442\u044c\u0441\u044f \u0442\u0430\u043a\u043e\u044e, \u0449\u043e \u043d\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0434\u043e EU."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0406\u043d\u0448\u0456 \u0441\u043a\u0440\u0438\u043f\u0442\u0438, \u044f\u043a\u0456 \u0441\u043b\u0456\u0434 \u0443\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u0434\u043e \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0437\u0433\u043e\u0434\u0438 (handle:analytics \u0430\u0431\u043e handle:marketing, \u0440\u043e\u0437\u0434\u0456\u043b\u0435\u043d\u0456 \u043a\u043e\u043c\u0430\u043c\u0438)"
            ],
            "Popups, slide-ins and bars": [
                "\u0421\u043f\u043b\u0438\u0432\u0430\u044e\u0447\u0456 \u0432\u0456\u043a\u043d\u0430, \u0432\u0438\u0441\u0443\u0432\u043d\u0456 \u043f\u0430\u043d\u0435\u043b\u0456 \u0442\u0430 \u0441\u043c\u0443\u0433\u0438"
            ],
            "A\/B test results": [
                "\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438 A\/B \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f"
