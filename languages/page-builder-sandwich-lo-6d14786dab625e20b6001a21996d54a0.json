            ],
            "Choose a popup\u2026": [
                "\u0ec0\u0ea5\u0eb7\u0ead\u0e81\u0e9b\u0eb1\u0ead\u0e9a\u0ead\u0eb1\u0e9a\u2026"
            ],
            "%s (draft)": [
