            ],
            "Load these tags on my site": [
                "\u0ec2\u0eab\u0ea5\u0e94\u0ec1\u0e97\u0eb1\u0e81\u0ec0\u0eab\u0ebc\u0ebb\u0ec8\u0eb2\u0e99\u0eb5\u0ec9\u0ec3\u0eaa\u0ec8\u0ec0\u0ea7\u0eb1\u0e9a\u0ec4\u0e8a\u0e82\u0ead\u0e87\u0e82\u0ec9\u0ead\u0e8d"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0e9b\u0eb4\u0e94\u0e81\u0eb2\u0e99\u0e99\u0eb3\u0ec3\u0e8a\u0ec9 \u0e96\u0ec9\u0eb2\u0eae\u0eb9\u0e9a\u0ec1\u0e9a\u0e9a\u0ec0\u0ea7\u0eb1\u0e9a\u0ec4\u0e8a \u0eab\u0ebc\u0eb7 \u0e9b\u0ea5\u0eb1\u0e81\u0ead\u0eb4\u0e99\u0ead\u0eb7\u0ec8\u0e99\u0e82\u0ead\u0e87\u0e97\u0ec8\u0eb2\u0e99\u0ec4\u0e94\u0ec9\u0ec0\u0e9e\u0eb5\u0ec8\u0ea1\u0e9e\u0ea7\u0e81\u0ea1\u0eb1\u0e99\u0ec1\u0ea5\u0ec9\u0ea7; \u0ec0\u0eab\u0e94\u0e81\u0eb2\u0e99\u0e95\u0ec8\u0eb2\u0e87\u0ec6 \u0e8d\u0eb1\u0e87\u0e88\u0eb0\u0e96\u0eb7\u0e81\u0eaa\u0ebb\u0ec8\u0e87\u0ea2\u0eb9\u0ec8."
            ],
            "Event name for form submissions": [
                "\u0e8a\u0eb7\u0ec8\u0ec0\u0eab\u0e94\u0e81\u0eb2\u0e99\u0eaa\u0eb3\u0ea5\u0eb1\u0e9a\u0e81\u0eb2\u0e99\u0eaa\u0ebb\u0ec8\u0e87\u0ec1\u0e9a\u0e9a\u0e9f\u0ead\u0ea1"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0ec1\u0e9a\u0e99\u0ec0\u0e99\u0eb5\u0ec1\u0ea1\u0ec8\u0e99\u0e9b\u0eb1\u0ead\u0e9a\u0ead\u0eb1\u0e9a\u0e97\u0eb5\u0ec8\u0e97\u0ec8\u0eb2\u0e99\u0ead\u0ead\u0e81\u0ec1\u0e9a\u0e9a\u0e94\u0ec9\u0ea7\u0e8d\u0e9a\u0ea5\u0eb1\u0ead\u0e81. \u0e9b\u0eb8\u0ec8\u0ea1\u0e95\u0ec8\u0eb2\u0e87\u0ec6 \u0e82\u0ead\u0e87\u0ea1\u0eb1\u0e99\u0ec0\u0e8a\u0eb7\u0ec8\u0ead\u0ea1\u0e95\u0ecd\u0ec8\u0ec4\u0e9b\u0eab\u0eb2 #consent-accept, #consent-reject \u0ec1\u0ea5\u0eb0 #consent-save (\u0e9e\u0ec9\u0ead\u0ea1\u0e94\u0ec9\u0ea7\u0e8d\u0e81\u0ec8\u0ead\u0e87\u0edd\u0eb2\u0e8d\u0ec0\u0ea5\u0eb7\u0ead\u0e81\u0e97\u0eb5\u0ec8\u0ea1\u0eb5\u0e8a\u0eb7\u0ec8\u0ea7\u0ec8\u0eb2 analytics \u0ec1\u0ea5\u0eb0 marketing \u0eaa\u0ecd\u0eb2\u0ea5\u0eb1\u0e9a \"save\"); \u0ea5\u0eb4\u0ec9\u0e87\u0ec4\u0e9b\u0eab\u0eb2 #consent-open \u0ea2\u0eb9\u0ec8\u0e9a\u0ec8\u0ead\u0e99\u0ec3\u0e94\u0e81\u0ecd\u0e95\u0eb2\u0ea1\u0e88\u0eb0\u0eaa\u0eb0\u0ec1\u0e94\u0e87\u0ea1\u0eb1\u0e99\u0e82\u0eb6\u0ec9\u0e99\u0ea1\u0eb2\u0ead\u0eb5\u0e81\u0e84\u0eb1\u0ec9\u0e87. \u0e88\u0ebb\u0e99\u0e81\u0ea7\u0ec8\u0eb2\u0e9c\u0eb9\u0ec9\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0e8a\u0ebb\u0ea1\u0e88\u0eb0\u0e8d\u0ead\u0ea1\u0eae\u0eb1\u0e9a, \u0ec1\u0e97\u0eb1\u0e81\u0e95\u0eb4\u0e94\u0e95\u0eb2\u0ea1\u0e88\u0eb0\u0e9a\u0ecd\u0ec8\u0ec2\u0eab\u0ea5\u0e94, Google Consent Mode \u0e8d\u0eb1\u0e87\u0e84\u0ebb\u0e87\u0ec0\u0e9b\u0eb1\u0e99 \"denied\", \u0ec1\u0ea5\u0eb0 \u0eaa\u0eb0\u0e84\u0ea3\u0eb4\u0e9a\u0e97\u0eb5\u0ec8\u0e97\u0ec8\u0eb2\u0e99\u0ea5\u0eb0\u0e9a\u0eb8\u0ec4\u0ea7\u0ec9\u0e88\u0eb0\u0e8d\u0eb1\u0e87\u0e84\u0ebb\u0e87\u0e9b\u0eb4\u0e94\u0ea2\u0eb9\u0ec8."
            ],
            "Create a ready-made banner": [
                "\u0eaa\u0ec9\u0eb2\u0e87\u0e9b\u0ec9\u0eb2\u0e8d\u0ec2\u0e84\u0eaa\u0eb0\u0e99\u0eb2\u0eaa\u0eb3\u0ec0\u0ea5\u0eb1\u0e94\u0eae\u0eb9\u0e9a"
            ],
            "Show a cookie banner": [
