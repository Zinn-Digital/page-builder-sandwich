            ],
            "Remember the choice for (days)": [
                "\u0e88\u0eb7\u0ec8\u0e81\u0eb2\u0e99\u0ec0\u0ea5\u0eb7\u0ead\u0e81\u0ec4\u0ea7\u0ec9\u0ec0\u0e9b\u0eb1\u0e99\u0ec0\u0ea7\u0ea5\u0eb2 (\u0ea1\u0eb7\u0ec9)"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u0ea2\u0eb9\u0ec8\u0e99\u0ead\u0e81\u0eaa\u0eb0\u0eab\u0eb0\u0e9e\u0eb2\u0e9a\u0ec0\u0ead\u0eb5\u0ea3\u0ebb\u0e9a, EEA \u0ec1\u0ea5\u0eb0 \u0eaa\u0eb0\u0eab\u0eb0\u0ea5\u0eb2\u0e8a\u0eb0\u0ead\u0eb2\u0e99\u0eb2\u0e88\u0eb1\u0e81: \u0ec2\u0eab\u0ebc\u0e94\u0e81\u0eb2\u0e99\u0e95\u0eb4\u0e94\u0e95\u0eb2\u0ea1\u0e88\u0ebb\u0e99\u0e81\u0ea7\u0ec8\u0eb2\u0e9c\u0eb9\u0ec9\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0e8a\u0ebb\u0ea1\u0e88\u0eb0\u0e9b\u0eb0\u0e95\u0eb4\u0ec0\u0eaa\u0e94"
