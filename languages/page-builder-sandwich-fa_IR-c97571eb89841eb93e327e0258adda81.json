            "Mark this up as a How-To for search engines.": [
                "\u0627\u06cc\u0646 \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 How-To \u0628\u0631\u0627\u06cc \u0645\u0648\u062a\u0648\u0631\u0647\u0627\u06cc \u062c\u0633\u062a\u062c\u0648 \u0646\u0634\u0627\u0646\u0647\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f."
            ],
            "Mark the plans up as a Product with offers for search engines.": [
                "\u067e\u0644\u0646\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u0645\u062d\u0635\u0648\u0644 \u062f\u0627\u0631\u0627\u06cc \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0647\u0627 \u0628\u0631\u0627\u06cc \u0645\u0648\u062a\u0648\u0631\u0647\u0627\u06cc \u062c\u0633\u062a\u062c\u0648 \u0646\u0634\u0627\u0646\u0647\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f."
            ],
            "Mark this up as a Review for search engines.": [
                "\u0627\u06cc\u0646 \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u0628\u0627\u0632\u0628\u06cc\u0646\u06cc \u0628\u0631\u0627\u06cc \u0645\u0648\u062a\u0648\u0631\u0647\u0627\u06cc \u062c\u0633\u062a\u062c\u0648 \u0646\u0634\u0627\u0646\u0647\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f."
            ],
            "Structured data": [
                "\u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u062e\u062a\u0627\u0631\u06cc\u0627\u0641\u062a\u0647"
            ],
            "Add schema.org structured data": [
                "\u0627\u0641\u0632\u0648\u062f\u0646 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u062e\u062a\u0627\u0631\u06cc\u0627\u0641\u062a\u0647 schema.org"
            ],
            "%s KB": [
                "%s \u06a9\u06cc\u0644\u0648\u0628\u0627\u06cc\u062a"
            ],
            "Performance": [
                "\u0639\u0645\u0644\u06a9\u0631\u062f"
            ],
            "Measure again": [
                "\u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u062f\u0648\u0628\u0627\u0631\u0647"
            ],
            "Measure this page": [
                "\u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u0627\u06cc\u0646 \u0628\u0631\u06af\u0647"
            ],
            "Page weight %1$s in %2$d requests": [
                "\u062d\u062c\u0645 \u0635\u0641\u062d\u0647 %1$s \u062f\u0631 %2$d \u062f\u0631\u062e\u0648\u0627\u0633\u062a"
            ],
            "Layout shift %s (good: under 0.1)": [
                "\u062a\u063a\u06cc\u06cc\u0631 \u0686\u06cc\u062f\u0645\u0627\u0646 %s (\u062e\u0648\u0628: \u0632\u06cc\u0631 0.1)"
            ],
            "Largest content shown after %d ms on this computer": [
                "\u0628\u0632\u0631\u06af\u200c\u062a\u0631\u06cc\u0646 \u0645\u062d\u062a\u0648\u0627 \u067e\u0633 \u0627\u0632 %d \u0645\u06cc\u0644\u06cc\u200c\u062b\u0627\u0646\u06cc\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0631\u0627\u06cc\u0627\u0646\u0647 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0634\u062f"
            ],
            "Images in the content: %1$s (%2$d)": [
                "\u062a\u0635\u0627\u0648\u06cc\u0631 \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0645\u062d\u062a\u0648\u0627: %1$s (%2$d)"
            ],
            "The largest image is lazy-loaded, which delays it.": [
                "\u0628\u0632\u0631\u06af\u200c\u062a\u0631\u06cc\u0646 \u062a\u0635\u0648\u06cc\u0631 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u062a\u0646\u0628\u0644 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f \u06a9\u0647 \u0628\u0627\u0639\u062b \u062a\u0627\u062e\u06cc\u0631 \u062f\u0631 \u0622\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f."
            ],
            "%d image(s) have no width and height, which can make the page jump.": [
                "%d \u062a\u0635\u0648\u06cc\u0631 \u0641\u0627\u0642\u062f \u0639\u0631\u0636 \u0648 \u0627\u0631\u062a\u0641\u0627\u0639 \u0647\u0633\u062a\u0646\u062f\u060c \u06a9\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u0627\u0639\u062b \u067e\u0631\u0634 \u0635\u0641\u062d\u0647 \u0634\u0648\u062f."
            ],
            "An image is larger than it is shown (%1$s). A smaller size saves %2$s.": [
                "\u0627\u0646\u062f\u0627\u0632\u0647 \u06cc\u06a9 \u062a\u0635\u0648\u06cc\u0631 \u0628\u0632\u0631\u06af\u200c\u062a\u0631 \u0627\u0632 \u0627\u0646\u062f\u0627\u0632\u0647 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0634\u062f\u0647 \u0622\u0646 \u0627\u0633\u062a (%1$s). \u0627\u0646\u062f\u0627\u0632\u0647 \u06a9\u0648\u0686\u06a9\u200c\u062a\u0631\u060c %2$s \u0635\u0631\u0641\u0647\u200c\u062c\u0648\u06cc\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f."
            ],
            "Use the smaller size": [
                "\u0627\u0632 \u0627\u0646\u062f\u0627\u0632\u0647 \u06a9\u0648\u0686\u06a9\u062a\u0631 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f"
            ],
            "%d fix(es) made; save the page, then measure again.": [
                "%d \u0627\u0635\u0644\u0627\u062d \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u061b \u0628\u0631\u06af\u0647 \u0631\u0627 \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0646\u06cc\u062f\u060c \u0633\u067e\u0633 \u062f\u0648\u0628\u0627\u0631\u0647 \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u0646\u0645\u0627\u06cc\u06cc\u062f."
            ]
