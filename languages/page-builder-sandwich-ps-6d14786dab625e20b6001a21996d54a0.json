        "messages": {
            "": {
                "domain": "messages",
                "lang": "ps",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Conversion tracking": [
                "\u062f \u062a\u0628\u0627\u062f\u0644\u06d0 \u062a\u0639\u0642\u06cc\u0628"
            ],
            "API key": [
                "\u062f API \u06a9\u064a\u0644\u064a"
            ],
            "Marketing": [
                "\u0645\u0627\u0631\u06a9\u067c\u06cc\u0646\u06ab"
            ],
            "Disconnect": [
                "\u0627\u0686\u0648\u0644"
            ],
            "Cookie banner": [
                "\u062f \u06a9\u0648\u06a9\u064a \u0628\u0646\u0631"
            ],
            "Form submissions": [
                "\u062f \u0641\u0648\u0631\u0645\u0647 \u0633\u067e\u0627\u0631\u0646\u06d0"
            ],
            "Save": [
                "\u062e\u0648\u0646\u062f\u064a \u06a9\u0648\u0644"
            ],
            "Saved.": [
                "\u062e\u0648\u0646\u062f\u064a \u0634\u0648."
            ],
            "Connected (key %s).": [
                "\u0648\u0635\u0644 \u0634\u0648 (\u06a9\u06cc\u0644\u064a %s)."
            ],
            "API URL": [
                "\u062f API \u067e\u062a\u0647"
            ],
            "Replace the API key": [
                "\u062f API \u06a9\u06cc\u0644\u064a \u0681\u0627\u06cc \u0646\u0627\u0633\u062a\u06d0 \u06a9\u0693\u0626"
            ],
            "Where to find your %s API key": [
                "\u062e\u067e\u0644 %s API \u06a9\u06cc\u0644\u064a \u0686\u06cc\u0631\u062a\u0647 \u0648\u0645\u0648\u0645\u0626"
            ],
            "Check and save": [
                "\u0686\u06cc\u06a9 \u0627\u0648 \u062e\u0648\u0646\u062f\u064a \u06a9\u0693\u0626"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u064a\u0648 \u0681\u0644 \u062f \u0644\u064a\u06a9\u0648\u0646\u0648 \u062f \u0627\u0633\u062a\u0648\u0644\u0648 \u064a\u0648 \u062e\u062f\u0645\u062a \u0648\u0635\u0644 \u06a9\u0693\u0626\u061b \u0648\u0631\u0648\u0633\u062a\u0647 \u0647\u0631 \u0641\u0627\u0631\u0645 \u06a9\u0648\u0644\u06cc \u0634\u064a \u0647\u063a\u0647 \u06a9\u0633\u0627\u0646 \u0686\u06d0 \u0647\u063a\u0647 \u0689\u06a9\u0648\u064a \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 \u064a\u0648 \u0644\u0633\u062a \u06a9\u06d0 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u064a (\u062f \u0641\u0627\u0631\u0645 \u0628\u0644\u0627\u06a9 \u0627\u0645\u0633\u0627\u062a\u0648\u0631\u0627\u062a \u2192 \u062a\u0631 \u0644\u06d0\u0696\u0644\u0648 \u0648\u0631\u0648\u0633\u062a\u0647). \u06a9\u0644\u064a\u06a9\u06d0 \u062f \u062e\u062f\u0645\u062a \u0633\u0631\u0647 \u06a9\u062a\u0644 \u06a9\u06d0\u0696\u064a\u060c \u067e\u0647 \u062f\u06d0 \u0633\u0627\u06cc\u067c \u06a9\u06d0 \u067e\u0647 \u067e\u067c\u0647 \u0628\u06bc\u0647 \u0633\u0627\u062a\u0644 \u06a9\u06d0\u0696\u064a \u0627\u0648 \u0646\u0648\u0631 \u0647\u064a\u0685\u06a9\u0644\u0647 \u0646\u0647 \u069a\u0648\u062f\u0644 \u06a9\u06d0\u0696\u064a."
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u062f \u0641\u0648\u0631\u0645 \u0633\u067e\u0627\u0631\u0644 \u0627\u0648 \u062f \u062a\u06bc\u06cd \u06a9\u0644\u06cc\u06a9\u0648\u0646\u0647 \u0644\u0647 \u06a9\u0648\u0645 \u06a9\u0648\u0689 \u067e\u0631\u062a\u0647 \u062e\u067e\u0644\u0648 \u062a\u062d\u0644\u06cc\u0644\u064a \u062a\u0648\u06a9\u0648 \u062a\u0647 \u0648\u0627\u0633\u062a\u0648\u0626. \u062f \u062f\u06d0 \u062e\u062f\u0645\u062a \u062f \u067e\u0631\u06cc\u069a\u0648\u062f\u0648 \u0644\u067e\u0627\u0631\u0647 \u06cc\u0648 \u0622\u06cc \u0689\u064a (ID) \u062e\u0627\u0644\u064a \u067e\u0631\u06cc\u0696\u062f\u0626. \u062a\u06bc\u06cd \u062f \u062f\u0648\u06cc \u067e\u0647 \u067e\u0631\u0645\u062e\u062a\u0644\u0644\u064a \u067e\u06cc\u0646\u0644 \u06a9\u06d0 \u062f \"\u062a\u0628\u0627\u062f\u0644\u06d0 \u067e\u06cc\u069a\u06d0\" (Conversion event) \u0633\u0627\u062d\u0647 \u062a\u0631\u0644\u0627\u0633\u0647 \u06a9\u0648\u064a. \u062f \u06a9\u0648\u06a9\u064a \u0628\u06cc\u0646\u0631 \u067e\u0647 \u0644\u06ab\u0648\u0644\u0648 \u0633\u0631\u0647\u060c \u062a\u0631 \u0647\u063a\u0647 \u0648\u062e\u062a\u0647 \u067e\u0648\u0631\u06d0 \u0647\u06cc\u0685 \u0634\u06cc \u0646\u0647 \u0628\u0627\u0631 \u06a9\u06cc\u0696\u064a \u0685\u0648 \u0686\u06d0 \u0644\u06cc\u062f\u0648\u0646\u06a9\u06cc \u0645\u0648\u0627\u0641\u0642 \u0646\u0647 \u0648\u064a."
            ],
            "Google Analytics 4 measurement ID": [
                "\u062f Google Analytics 4 \u062f \u0627\u0646\u062f\u0627\u0632\u06d0 \u06a9\u0648\u0644\u0648 ID"
            ],
            "Google Tag Manager container ID": [
                "\u062f Google Tag Manager \u06a9\u0627\u0646\u067c\u06cc\u0646\u0631 ID"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "\u062f \u0645\u06cc\u067c\u0627 \u067e\u06a9\u0633\u0644 \u0622\u06cc \u0689\u064a (\u0647\u063a\u0647 \u0634\u0645\u06cc\u0631\u0647 \u0686\u06d0 \u062f \u0645\u06cc\u067c\u0627 \u067e\u06cc\u069a\u0648 \u0645\u062f\u06cc\u0631 \u06a9\u06d0 \u069a\u0648\u062f\u0644 \u0634\u0648\u06d0)"
            ],
            "Load these tags on my site": [
                "\u062f\u0627 \u067c\u0627\u06ab\u0648\u0646\u0647 \u0632\u0645\u0627 \u067e\u0647 \u067e\u0627\u06bc\u0647 \u06a9\u06d0 \u0628\u0627\u0631 \u06a9\u0693\u0626"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u06a9\u0647 \u0633\u062a\u0627\u0633\u0648 \u0645\u0648\u0636\u0648\u0639 (\u067c\u06cc\u0645) \u06cc\u0627 \u0628\u0644 \u067e\u0644\u06af \u0627\u0646 \u062f\u0627 \u0645\u062e\u06a9\u06d0 \u0644\u0647 \u0645\u062e\u06a9\u06d0 \u0632\u06cc\u0627\u062a\u0648\u064a\u060c \u0646\u0648 \u062f\u0627 \u0628\u0646\u062f \u06a9\u0693\u0626\u061b \u067e\u06cc\u069a\u06d0 \u0644\u0627 \u0647\u0645 \u0644\u06cc\u0696\u0644 \u06a9\u06cc\u0696\u064a."
            ],
            "Event name for form submissions": [
                "\u062f \u0641\u0648\u0631\u0645 \u062f \u0633\u067e\u0627\u0631\u0644\u0648 \u0644\u067e\u0627\u0631\u0647 \u062f \u067e\u06cc\u069a\u06d0 \u0646\u0648\u0645"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0628\u06cc\u0646\u0631 \u06cc\u0648 \u067e\u0627\u067e \u0627\u067e \u062f\u06cc \u0686\u06d0 \u062a\u0627\u0633\u0648 \u06cc\u06d0 \u062f \u0628\u0644\u0627\u06a9\u0648\u0646\u0648 \u067e\u0647 \u0648\u0627\u0633\u0637\u0647 \u0689\u06cc\u0632\u0627\u06cc\u0646 \u06a9\u0648\u0626. \u062f \u062f\u06d0 \u062a\u06bc\u06cd #consent-accept\u060c #consent-reject \u0627\u0648 #consent-save \u062a\u0647 \u0644\u06cc\u0646\u06a9\u0648\u0646\u0647 \u0644\u0631\u064a (\u062f \"save\" \u0644\u067e\u0627\u0631\u0647 \u062f \u062a\u062d\u0644\u06cc\u0644\u064a \u0627\u0648 \u0628\u0627\u0632\u0627\u0631 \u0645\u0648\u0646\u062f\u0646\u06d0 \u067e\u0647 \u0646\u0648\u0645 \u062f \u067c\u06a9 \u0628\u06a9\u0633\u0648\u0646\u0648 \u0633\u0631\u0647)\u061b \u0647\u0631\u0686\u06cc\u0631\u06d0 \u0686\u06d0 #consent-open \u062a\u0647 \u0644\u06cc\u0646\u06a9 \u0648\u064a\u060c \u0647\u063a\u0647 \u0628\u06cc\u0627 \u069a\u064a\u064a. \u062a\u0631 \u0647\u063a\u0647 \u0648\u062e\u062a\u0647 \u0686\u06d0 \u0644\u06cc\u062f\u0648\u0646\u06a9\u06cc \u06cc\u06d0 \u0648\u0646\u0647 \u0645\u0646\u064a\u060c \u062f \u062a\u0639\u0642\u06cc\u0628 \u067c\u06ab\u0648\u0646\u0647 \u0646\u0647 \u0628\u0627\u0631 \u06a9\u06cc\u0696\u064a\u060c \u062f Google Consent Mode \"\u0631\u062f \u0634\u0648\u06cc\" \u067e\u0627\u062a\u06d0 \u06a9\u06cc\u0696\u064a\u060c \u0627\u0648 \u0647\u063a\u0647 \u0633\u06a9\u0631\u06cc\u067e\u067c\u0648\u0646\u0647 \u0686\u06d0 \u062a\u0627\u0633\u0648 \u06cc\u06d0 \u0644\u06cc\u0633\u062a \u06a9\u0648\u0626 \u0628\u0646\u062f \u067e\u0627\u062a\u06d0 \u06a9\u06cc\u0696\u064a."
            ],
            "Create a ready-made banner": [
                "\u064a\u0648 \u0622\u0645\u0627\u062f\u0647 \u0628\u0627\u0646\u0631 \u062c\u0648\u0693 \u06a9\u0693\u0626"
            ],
            "Show a cookie banner": [
                "\u062f \u06a9\u0648\u06a9\u064a \u0628\u06cc\u0646\u0631 \u0648\u069a\u0627\u06cc\u0627\u0633\u062a"
            ],
            "Banner": [
                "\u0628\u06cc\u0646\u0631"
            ],
            "Choose a popup\u2026": [
                "\u06cc\u0648 \u067e\u0627\u067e \u0627\u067e \u0648\u067c\u0627\u06a9\u0626\u2026"
            ],
            "%s (draft)": [
                "%s (\u0645\u0633\u0648\u062f\u0647)"
            ],
            "Edit the banner": [
                "\u0628\u0646\u0631 \u0627\u0689\u06d0\u067c \u06a9\u0693\u0626"
            ],
            "Remember the choice for (days)": [
                "\u062f (days) \u0644\u067e\u0627\u0631\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u067e\u0647 \u06cc\u0627\u062f \u0648\u0633\u0627\u062a\u0626"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u062f \u0627\u0631\u0648\u067e\u0627\u064a\u064a \u067c\u0648\u0644\u0646\u06d0\u060c EEA \u0627\u0648 \u0627\u0646\u06ab\u0644\u0633\u062a\u0627\u0646 \u0685\u062e\u0647 \u0628\u0647\u0631: \u062f \u0644\u06cc\u062f\u0648\u0646\u06a9\u064a \u062a\u0631 \u0681\u0648\u0627\u0628 \u0646\u0647 \u06a9\u0648\u0644\u0648 \u067e\u0648\u0631\u06d0 \u062f \u0628\u0627\u0631 \u062a\u0639\u0642\u06cc\u0628\u0648\u0644"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u0628\u0646\u062f: \u0647\u0631 \u0644\u06cc\u062f\u0648\u0646\u06a9\u06cc \u0628\u0627\u06cc\u062f \u0644\u0648\u0645\u0693\u06cc \u0645\u0648\u0627\u0641\u0642 \u0648\u064a (\u062a\u0631 \u067c\u0648\u0644\u0648 \u06a9\u0644\u06a9\u0647 \u0642\u0627\u0639\u062f\u0647\u060c \u0627\u0648 \u0689\u06cc\u0641\u0627\u0644\u067c). \u0641\u0639\u0627\u0644: \u06cc\u0648\u0627\u0632\u06d0 \u06a9\u0644\u0647 \u0686\u06d0 \u0633\u062a\u0627\u0633\u0648 \u06a9\u0648\u0631\u0628\u0647 \u06cc\u0627 CDN \u062f \u0644\u06cc\u062f\u0648\u0646\u06a9\u064a \u0647\u06d0\u0648\u0627\u062f \u0631\u0627\u067e\u0648\u0631 \u0648\u0631\u06a9\u0693\u064a (\u062f \u0645\u062b\u0627\u0644 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u062f Cloudflare \u062f CF-IPCountry \u0633\u0631\u0644\u06cc\u06a9) \u0627\u0648 \u062f\u0627 \u062f EU\u060c EEA\u060c UK \u0627\u0648 Switzerland \u0685\u062e\u0647 \u0628\u0647\u0631 \u0648\u064a. \u0628\u06cc\u0646\u0631 \u0644\u0627\u0647\u0645 \u069a\u0648\u062f\u0644 \u06a9\u06cc\u0696\u064a\u060c \u0627\u0648 \u06cc\u0648 \u0646\u0627\u0645\u0639\u0644\u0648\u0645 \u0647\u06d0\u0648\u0627\u062f \u062f EU \u062f\u0646\u0646\u0647 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u06ab\u06bc\u0644 \u06a9\u06cc\u0696\u064a."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0646\u0648\u0631 \u0633\u06a9\u0631\u06cc\u067e\u067c\u0648\u0646\u0647 \u062a\u0631 \u0631\u0636\u0627\u06cc\u062a \u067e\u0648\u0631\u06d0 \u062f \u0633\u0627\u062a\u0644\u0648 \u0644\u067e\u0627\u0631\u0647 (handle:analytics \u06cc\u0627 handle:marketing\u060c \u067e\u0647 \u06a9\u0627\u0645\u0647 \u0633\u0631\u0647 \u062c\u0644\u0627 \u0634\u0648\u064a)"
            ],
            "Popups, slide-ins and bars": [
                "\u067e\u0627\u067e \u0627\u067e\u0648\u0646\u0647\u060c \u0633\u0644\u0627\u06cc\u0689-\u0627\u0646\u0648\u0646\u0647 \u0627\u0648 \u067e\u067c\u06d0"
            ],
            "A\/B test results": [
                "\u062f A\/B \u0627\u0632\u0645\u0648\u06cc\u0646\u06d0 \u067e\u0627\u06cc\u0644\u06d0"
            ],
            "Mailing-list connections": [
                "\u062f \u0628\u0631\u06d0\u069a\u0646\u0627\u0644\u06cc\u06a9 \u0644\u06cc\u0633\u062a \u0627\u0693\u06cc\u06a9\u06d0"
            ]
        }
    }
}
