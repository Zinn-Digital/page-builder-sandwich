            "Change this on the Account page": [
                "\u0642\u0645 \u0628\u062a\u063a\u064a\u064a\u0631 \u0647\u0630\u0627 \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u062d\u0633\u0627\u0628"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u062a\u064f\u0648\u0641\u0631 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629 \u0644\u062a\u062b\u0628\u064a\u062a\u0627\u062a Pro \u0627\u0644\u0645\u0631\u062e\u0635\u0629 \u0627\u0644\u0645\u062a\u0635\u0644\u0629 \u0628\u062d\u0633\u0627\u0628\u0627\u062a \u0623\u0635\u062d\u0627\u0628\u0647\u0627. \u0628\u0645\u062c\u0631\u062f \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u060c \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0645\u0646 \u0635\u0641\u062d\u0629 \u0627\u0644\u062d\u0633\u0627\u0628."
            ],
            "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here.": [
                "\u062a\u0648\u0642\u0641 \u0637\u0644\u0628 \u062a\u062d\u0648\u064a\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u0634\u0648\u0631 \u0642\u0628\u0644 \u0625\u0646\u0647\u0627\u0621 \u0639\u0645\u0644\u0647\u060c \u0644\u0630\u0644\u0643 \u062a\u0645 \u062a\u062e\u0637\u064a \u0627\u0644\u0645\u0646\u0634\u0648\u0631. \u0627\u0641\u062a\u062d\u0647 \u0644\u062a\u062d\u0648\u064a\u0644\u0647\u060c \u0623\u0648 \u0642\u0645 \u0628\u062a\u062d\u0648\u064a\u0644\u0647 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0645\u0646 \u0647\u0646\u0627."
            ],
            "There is no backup of this post to restore.": [
