                "\u062a\u0639\u0630\u0631 \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0627\u062a",
                "\u062a\u0639\u0630\u0631 \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0627\u062a",
                "\u062a\u0639\u0630\u0631 \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0627\u062a",
                "\u062a\u0639\u0630\u0631 \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0627\u062a",
                "\u062a\u0639\u0630\u0631 \u0645\u0639\u0627\u0644\u062c\u0629 %d \u0645\u0646 \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0627\u062a"
            ],
            "Post %d": [
                "\u0645\u0646\u0634\u0648\u0631 %d"
            ],
            "Conversion started. It continues in the background; you can leave this page.": [
                "\u0628\u062f\u0623\u062a \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644. \u0648\u0647\u064a \u0645\u0633\u062a\u0645\u0631\u0629 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629\u061b \u064a\u0645\u0643\u0646\u0643 \u0645\u063a\u0627\u062f\u0631\u0629 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629."
            ],
            "Convert legacy content": [
                "\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0642\u062f\u064a\u0645"
            ],
            "Restore every converted post to its legacy content? Changes made to those posts since they were converted will be lost.": [
                "\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0643\u0644 \u0645\u0646\u0634\u0648\u0631 \u0645\u062d\u0648\u0644 \u0625\u0644\u0649 \u0645\u062d\u062a\u0648\u0627\u0647 \u0627\u0644\u0642\u062f\u064a\u0645\u061f \u0633\u062a\u0636\u064a\u0639 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u0623\u062c\u0631\u064a\u062a \u0639\u0644\u0649 \u062a\u0644\u0643 \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0627\u062a \u0645\u0646\u0630 \u062a\u062d\u0648\u064a\u0644\u0647\u0627."
            ],
            "Undo started. It continues in the background; you can leave this page.": [
                "\u0628\u062f\u0623\u062a \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u0631\u0627\u062c\u0639. \u0648\u0647\u064a \u0645\u0633\u062a\u0645\u0631\u0629 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629\u061b \u0648\u064a\u0645\u0643\u0646\u0643 \u0645\u063a\u0627\u062f\u0631\u0629 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629."
            ],
