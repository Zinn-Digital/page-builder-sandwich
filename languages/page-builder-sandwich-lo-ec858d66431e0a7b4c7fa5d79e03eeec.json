    "domain": "messages",
    "locale_data": {
        "messages": {
            "": {
                "domain": "messages",
                "lang": "lo",
                "plural-forms": "nplurals=1; plural=0;"
            },
            "Import and export": [
                "\u0e99\u0eb3\u0ec0\u0e82\u0ebb\u0ec9\u0eb2 \u0ec1\u0ea5\u0eb0 \u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81"
            ],
            "%d new": [
                "%d \u0ec3\u0eab\u0ea1\u0ec8"
            ],
            "%d replaced": [
                "\u0ec4\u0e94\u0ec9\u0e9b\u0ec8\u0ebd\u0e99\u0ec1\u0e97\u0e99 %d \u0ea5\u0eb2\u0e8d\u0e81\u0eb2\u0e99"
            ],
            "%d kept as they were": [
                "%d \u0e97\u0eb5\u0ec8\u0eae\u0eb1\u0e81\u0eaa\u0eb2\u0ec4\u0ea7\u0ec9\u0e95\u0eb2\u0ea1\u0ec0\u0e94\u0eb5\u0ea1"
            ],
            "%d setting": [
                "%d \u0e81\u0eb2\u0e99\u0e95\u0eb1\u0ec9\u0e87\u0e84\u0ec8\u0eb2"
            ],
            "Importing will give: %s.": [
                "\u0e81\u0eb2\u0e99\u0e99\u0ecd\u0eb2\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0e88\u0eb0\u0ec3\u0eab\u0ec9: %s."
            ],
            "Imported: %s.": [
                "\u0e99\u0eb3\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0ec1\u0ea5\u0ec9\u0ea7: %s."
            ],
            "Exported %d item.": [
                "\u0ec4\u0e94\u0ec9\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81 %d \u0ea5\u0eb2\u0e8d\u0e81\u0eb2\u0e99."
            ],
            "That file could not be read as an export file.": [
                "\u0e9a\u0ecd\u0ec8\u0eaa\u0eb2\u0ea1\u0eb2\u0e94\u0ead\u0ec8\u0eb2\u0e99\u0ec4\u0e9f\u0ea5\u0ecc\u0e99\u0eb1\u0ec9\u0e99\u0ec0\u0e9b\u0eb1\u0e99\u0ec4\u0e9f\u0ea5\u0ecc\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81\u0ec4\u0e94\u0ec9."
            ],
            "Export": [
                "\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0e94\u0eb2\u0ea7\u0ec2\u0eab\u0ebc\u0e94\u0ec1\u0ea1\u0ec8\u0ec1\u0e9a\u0e9a, \u0eae\u0eb9\u0e9a\u0ec1\u0e9a\u0e9a \u0ec1\u0ea5\u0eb0 \u0e81\u0eb2\u0e99\u0ead\u0ead\u0e81\u0ec1\u0e9a\u0e9a\u0ec0\u0ea7\u0eb1\u0e9a\u0ec4\u0e8a\u0e82\u0ead\u0e87\u0e97\u0ec8\u0eb2\u0e99\u0ec0\u0e9b\u0eb1\u0e99\u0ec4\u0e9f\u0ea5\u0ecc\u0e94\u0ebd\u0ea7, \u0ec0\u0e9e\u0eb7\u0ec8\u0ead\u0e99\u0eb3\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0ec3\u0e99\u0ec0\u0ea7\u0eb1\u0e9a\u0ec4\u0e8a\u0ead\u0eb7\u0ec8\u0e99."
            ],
            "There are no templates or patterns to export yet.": [
                "\u0e8d\u0eb1\u0e87\u0e9a\u0ecd\u0ec8\u0ea1\u0eb5\u0ec1\u0ea1\u0ec8\u0ec1\u0e9a\u0e9a \u0eab\u0ebc\u0eb7 \u0eae\u0eb9\u0e9a\u0ec1\u0e9a\u0e9a\u0eaa\u0eb3\u0ea5\u0eb1\u0e9a\u0e81\u0eb2\u0e99\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81\u0ec0\u0e97\u0eb7\u0ec8\u0ead."
            ],
            "Include the settings": [
                "\u0ea5\u0ea7\u0ea1\u0e81\u0eb2\u0e99\u0e95\u0eb1\u0ec9\u0e87\u0e84\u0ec8\u0eb2"
            ],
            "Download the export file": [
                "\u0e94\u0eb2\u0ea7\u0ec2\u0eab\u0ebc\u0e94\u0ec4\u0e9f\u0ea5\u0ecc\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81"
            ],
            "Import": [
                "\u0e99\u0eb3\u0ec0\u0e82\u0ebb\u0ec9\u0eb2"
            ],
            "Choose an export file": [
                "\u0ec0\u0ea5\u0eb7\u0ead\u0e81\u0ec4\u0e9f\u0ea5\u0ecc\u0eaa\u0ebb\u0ec8\u0e87\u0ead\u0ead\u0e81"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0ec4\u0e9f\u0ea5\u0ecc\u0e94\u0eb1\u0ec8\u0e87\u0e81\u0ec8\u0eb2\u0ea7\u0ea1\u0eb5 %1$d \u0ea5\u0eb2\u0e8d\u0e81\u0eb2\u0e99 \u0e88\u0eb2\u0e81 %2$s."
            ],
            "When an item with the same name already exists here": [
                "\u0ec0\u0ea1\u0eb7\u0ec8\u0ead\u0ea1\u0eb5\u0ea5\u0eb2\u0e8d\u0e81\u0eb2\u0e99\u0e97\u0eb5\u0ec8\u0ea1\u0eb5\u0e8a\u0eb7\u0ec8\u0e94\u0ebd\u0ea7\u0e81\u0eb1\u0e99\u0e99\u0eb5\u0ec9\u0ea2\u0eb9\u0ec8\u0ec1\u0ea5\u0ec9\u0ea7\u0ec3\u0e99\u0e9a\u0ec8\u0ead\u0e99\u0e99\u0eb5\u0ec9"
            ],
            "Keep the one on this site": [
                "\u0eae\u0eb1\u0e81\u0eaa\u0eb2\u0ead\u0eb1\u0e99\u0e97\u0eb5\u0ec8\u0ea2\u0eb9\u0ec8\u0ec3\u0e99\u0ec0\u0ea7\u0eb1\u0e9a\u0ec4\u0e8a\u0e99\u0eb5\u0ec9\u0ec4\u0ea7\u0ec9"
            ],
            "Replace it with the imported one": [
                "\u0e9b\u0ec8\u0ebd\u0e99\u0ec1\u0e97\u0e99\u0ea1\u0eb1\u0e99\u0e94\u0ec9\u0ea7\u0e8d\u0ead\u0eb1\u0e99\u0e97\u0eb5\u0ec8\u0e99\u0eb3\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0ec0\u0ea3\u0eb1\u0e94"
            ],
            "Import a copy beside it": [
                "\u0e99\u0ecd\u0eb2\u0ec0\u0e82\u0ebb\u0ec9\u0eb2\u0eaa\u0ecd\u0eb2\u0ec0\u0e99\u0ebb\u0eb2\u0ec4\u0ea7\u0ec9\u0e82\u0ec9\u0eb2\u0e87\u0ec6"
            ],
            "Apply the settings in the file": [
                "\u0e99\u0eb3\u0ec3\u0e8a\u0ec9\u0e81\u0eb2\u0e99\u0e95\u0eb1\u0ec9\u0e87\u0e84\u0ec8\u0eb2\u0ec3\u0e99\u0ec4\u0e9f\u0ea5\u0ecc"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u0e84\u0eb1\u0e94\u0ea5\u0ead\u0e81\u0eae\u0eb9\u0e9a\u0e9e\u0eb2\u0e9a\u0ec3\u0eaa\u0ec8\u0ec3\u0e99\u0e84\u0eb1\u0e87\u0ea1\u0eb5\u0ec0\u0e94\u0e8d\u0e82\u0ead\u0e87\u0ec0\u0ea7\u0eb1\u0e9a\u0ec4\u0e8a\u0e99\u0eb5\u0ec9"
            ],
            "Show what will happen": [
                "\u0eaa\u0eb0\u0ec1\u0e94\u0e87\u0eaa\u0eb4\u0ec8\u0e87\u0e97\u0eb5\u0ec8\u0e88\u0eb0\u0ec0\u0e81\u0eb5\u0e94\u0e82\u0eb6\u0ec9\u0e99"
            ]
        }
    }
}
