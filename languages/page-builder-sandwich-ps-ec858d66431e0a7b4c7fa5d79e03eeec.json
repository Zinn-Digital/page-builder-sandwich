    "domain": "messages",
    "locale_data": {
        "messages": {
            "": {
                "domain": "messages",
                "lang": "ps",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Import and export": [
                "\u0648\u0627\u0631\u062f\u0627\u062a \u0627\u0648 \u0635\u0627\u062f\u0631\u0627\u062a"
            ],
            "Import": [
                "\u0648\u0627\u0631\u062f\u0648\u0644"
            ],
            "%d new": [
                "%d \u0646\u0648\u064a",
                "%d \u0646\u0648\u064a"
            ],
            "%d replaced": [
                "%d \u0681\u0627\u06cc \u067e\u0647 \u0681\u0627\u06cc \u0634\u0648",
                "%d \u0681\u0627\u06cc \u067e\u0647 \u0681\u0627\u06cc \u0634\u0648"
            ],
            "%d kept as they were": [
                "%d \u0644\u06a9\u0647 \u0685\u0646\u06ab\u0647 \u0686\u06d0 \u0648\u0648 \u0633\u0627\u062a\u0644 \u0634\u0648\u0644",
                "%d \u0644\u06a9\u0647 \u0685\u0646\u06ab\u0647 \u0686\u06d0 \u0648\u0648 \u0633\u0627\u062a\u0644 \u0634\u0648\u0644"
            ],
            "%d setting": [
                "%d \u062a\u0631\u062a\u06cc\u0628",
                "%d \u062a\u0646\u0638\u06cc\u0645\u0648\u0646\u0647"
            ],
            "Importing will give: %s.": [
                "\u0648\u0627\u0631\u062f \u06a9\u0648\u0644 \u0628\u0647 \u062f\u0627 \u0648\u0631\u06a9\u0693\u064a: %s."
            ],
            "Imported: %s.": [
                "\u0648\u0627\u0631\u062f \u0634\u0648: %s."
            ],
            "Exported %d item.": [
                "%d \u062a\u0648\u06a9\u064a \u0635\u0627\u062f\u0631 \u0634\u0648.",
                "%d \u062a\u0648\u06a9\u064a \u0635\u0627\u062f\u0631 \u0634\u0648\u0644."
            ],
            "That file could not be read as an export file.": [
                "\u062f\u0627 \u0641\u0627\u06cc\u0644 \u062f \u0635\u0627\u062f\u0631\u0648\u0644\u0648 \u062f \u0641\u0627\u06cc\u0644 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u0646\u0634\u064a \u0644\u0648\u0633\u062a\u0644 \u06a9\u06d0\u062f\u06cc."
            ],
            "Export": [
                "\u0635\u0627\u062f\u0631\u0648\u0644"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u062e\u067e\u0644\u064a \u06a9\u064a\u0646\u0689\u06cd\u060c \u067e\u06d0\u067c\u0631\u0646\u0648\u0646\u0647 \u0627\u0648 \u062f \u0633\u0627\u06cc\u067c \u0689\u06cc\u0632\u0627\u06cc\u0646 \u062f \u06cc\u0648\u06d0 \u062f\u0627\u0633\u06d0 \u062f\u0648\u062a\u0646\u06d0 \u067e\u0647 \u062a\u0648\u06ab\u0647 \u0689\u0627\u0648\u0646\u0644\u0648\u0689 \u06a9\u0693\u0626\u060c \u062a\u0631\u0685\u0648 \u067e\u0647 \u0628\u0644 \u0633\u0627\u06cc\u067c \u06a9\u06d0 \u064a\u06d0 \u0648\u0627\u0631\u062f \u06a9\u0693\u0626."
            ],
            "There are no templates or patterns to export yet.": [
                "\u062a\u0631 \u0627\u0648\u0633\u0647 \u062f \u0635\u0627\u062f\u0631\u0648\u0644\u0648 \u0644\u067e\u0627\u0631\u0647 \u06a9\u0648\u0645\u06d0 \u06a9\u064a\u0646\u0689\u06cd \u06cc\u0627 \u0628\u06bc\u06d0 \u0634\u062a\u0648\u0646 \u0646\u0647 \u0644\u0631\u064a."
            ],
            "Include the settings": [
                "\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0634\u0627\u0645\u0644 \u06a9\u0693\u0626"
            ],
            "Download the export file": [
                "\u062f \u0635\u0627\u062f\u0631\u0648\u0644\u0648 \u0641\u0627\u06cc\u0644 \u0689\u0627\u0648\u0646\u0644\u0648\u0689 \u06a9\u0693\u0626"
            ],
            "Choose an export file": [
                "\u062f \u0635\u0627\u062f\u0631\u0627\u062a\u0648 \u06cc\u0648\u0647 \u062f\u0648\u062a\u0646\u0647 \u0648\u067c\u0627\u06a9\u0626"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u067e\u0647 \u062f\u063a\u0647 \u0641\u0627\u06cc\u0644 \u06a9\u06d0 \u0644\u0647 %2$s \u0685\u062e\u0647 %1$d \u062a\u0648\u06a9\u06cc \u062f\u06cc.",
                "\u067e\u0647 \u062f\u06d0 \u0641\u0627\u06cc\u0644 \u06a9\u06d0 \u062f %2$s \u0685\u062e\u0647 %1$d \u062a\u0648\u06a9\u064a \u062f\u064a."
            ],
            "When an item with the same name already exists here": [
                "\u06a9\u0644\u0647 \u0686\u06d0 \u062f\u0644\u062a\u0647 \u062f\u0645\u062e\u0647 \u067e\u0647 \u0647\u0645\u062f\u06d0 \u0646\u0648\u0645 \u06cc\u0648 \u062a\u0648\u06a9\u06cc \u0634\u062a\u0648\u0646 \u0648\u0644\u0631\u064a"
            ],
            "Keep the one on this site": [
                "\u067e\u0647 \u062f\u06d0 \u0633\u0627\u06cc\u067c \u06a9\u06d0 \u0633\u0627\u062a\u0644"
            ],
            "Replace it with the imported one": [
                "\u067e\u0647 \u0648\u0627\u0631\u062f \u0634\u0648\u064a \u06cc\u0648\u0647 \u06cc\u06d0 \u0628\u062f\u0644 \u06a9\u0693\u0626"
            ],
            "Import a copy beside it": [
                "\u062f \u0647\u063a\u06d0 \u062a\u0631 \u0685\u0646\u06ab \u06cc\u0648\u0647 \u06a9\u0627\u067e\u064a \u0648\u0627\u0631\u062f \u06a9\u0693\u0626"
            ],
            "Apply the settings in the file": [
                "\u067e\u0647 \u0641\u0627\u06cc\u0644 \u06a9\u06d0 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u067e\u0644\u064a \u06a9\u0693\u0626"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0647 \u062f \u062f\u06d0 \u0633\u0627\u06cc\u067c \u062f \u0631\u0633\u0646\u06cc\u0648 \u067e\u0647 \u06a9\u062a\u0627\u0628\u062a\u0648\u0646 \u06a9\u06d0 \u06a9\u0627\u067e\u064a \u06a9\u0693\u0626"
            ],
            "Show what will happen": [
                "\u0648\u069a\u0627\u06cc\u0627\u0633\u062a \u0686\u06d0 \u0685\u0647 \u0628\u0647 \u067e\u06d0\u069a \u0634\u064a"
            ]
        }
    }
}
