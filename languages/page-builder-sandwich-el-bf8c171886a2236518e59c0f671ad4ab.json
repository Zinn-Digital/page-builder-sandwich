                "\u0395\u03c0\u03b9\u03ba\u03bf\u03bb\u03bb\u03ae\u03c3\u03c4\u03b5 \u03ba\u03ce\u03b4\u03b9\u03ba\u03b1 SVG \u03c3\u03c4\u03b9\u03c2 \u03c1\u03c5\u03b8\u03bc\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf\u03c5 \u03bc\u03c0\u03bb\u03bf\u03ba."
            ],
            "New setting name": [
                "\u039d\u03ad\u03bf \u03cc\u03bd\u03bf\u03bc\u03b1 \u03c1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7\u03c2"
