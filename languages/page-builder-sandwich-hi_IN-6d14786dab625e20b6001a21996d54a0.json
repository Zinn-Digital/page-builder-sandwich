            "Check and save": [
                "\u091c\u093e\u0902\u091a\u0947\u0902 \u0914\u0930 \u0938\u0939\u0947\u091c\u0947\u0902"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u090f\u0915 \u092c\u093e\u0930 \u092e\u0947\u0932\u093f\u0902\u0917-\u0938\u0942\u091a\u0940 \u0938\u0947\u0935\u093e \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902; \u092b\u093f\u0930 \u0915\u094b\u0908 \u092d\u0940 \u092b\u093c\u0949\u0930\u094d\u092e \u0907\u0938\u0947 \u092d\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u0906\u092a\u0915\u0940 \u0938\u0942\u091a\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0915\u093f\u0938\u0940 \u090f\u0915 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c \u0938\u0915\u0924\u093e \u0939\u0948 (\u092b\u093c\u0949\u0930\u094d\u092e \u092c\u094d\u0932\u0949\u0915 \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u2192 \u092d\u0947\u091c\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926)\u0964 \u0915\u0941\u0902\u091c\u093f\u092f\u094b\u0902 \u0915\u0940 \u0938\u0947\u0935\u093e \u0915\u0947 \u0938\u093e\u0925 \u091c\u093e\u0901\u091a \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948, \u0907\u0938 \u0938\u093e\u0907\u091f \u092a\u0930 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u0930\u0915\u0947 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u092b\u093f\u0930 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u0915\u094b\u0921 \u0915\u0947 \u0905\u092a\u0928\u0947 \u090f\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938 \u092a\u0930 \u092b\u0949\u0930\u094d\u092e \u0938\u092c\u092e\u093f\u0936\u0928 \u0914\u0930 \u092c\u091f\u0928 \u0915\u094d\u0932\u093f\u0915 \u092d\u0947\u091c\u0947\u0902\u0964 \u0909\u0938 \u0938\u0947\u0935\u093e \u0915\u094b \u091b\u094b\u0921\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0906\u0908\u0921\u0940 \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c \u0926\u0947\u0902\u0964 \u090f\u0921\u0935\u093e\u0902\u0938 \u092a\u0948\u0928\u0932 \u092e\u0947\u0902 \u092c\u091f\u0928 \u0915\u094b \"\u0915\u0928\u094d\u0935\u0930\u094d\u091c\u093c\u0928 \u0907\u0935\u0947\u0902\u091f\" \u092b\u093c\u0940\u0932\u094d\u0921 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0915\u0941\u0915\u0940 \u092c\u0948\u0928\u0930 \u091a\u093e\u0932\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930, \u0935\u093f\u091c\u093c\u093f\u091f\u0930 \u0915\u0940 \u0938\u0939\u092e\u0924\u093f \u092e\u093f\u0932\u0928\u0947 \u0924\u0915 \u0915\u0941\u091b \u092d\u0940 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
            ],
            "Google Analytics 4 measurement ID": [
                "Google Analytics 4 \u092e\u093e\u092a \u0906\u0908\u0921\u0940"
            ],
            "Google Tag Manager container ID": [
                "Google \u091f\u0948\u0917 \u092e\u0948\u0928\u0947\u091c\u0930 \u0915\u0902\u091f\u0947\u0928\u0930 ID"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "\u092e\u0947\u091f\u093e \u092a\u093f\u0915\u094d\u0938\u0947\u0932 \u0906\u0908\u0921\u0940 (\u092e\u0947\u091f\u093e \u0907\u0935\u0947\u0902\u091f\u094d\u0938 \u092e\u0948\u0928\u0947\u091c\u0930 \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u0908 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u0902\u0916\u094d\u092f\u093e)"
