            "Load these tags on my site": [
                "\u0907\u0928 \u091f\u0948\u0917\u094d\u0938 \u0915\u094b \u092e\u0947\u0930\u0940 \u0938\u093e\u0907\u091f \u092a\u0930 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0907\u0938\u0947 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0902 \u092f\u0926\u093f \u0906\u092a\u0915\u0940 \u0925\u0940\u092e \u092f\u093e \u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u092a\u094d\u0932\u0917\u0907\u0928 \u0909\u0928\u094d\u0939\u0947\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948; \u0907\u0935\u0947\u0902\u091f \u0905\u092d\u0940 \u092d\u0940 \u092d\u0947\u091c\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
            ],
            "Event name for form submissions": [
                "\u092b\u093c\u0949\u0930\u094d\u092e \u0938\u092c\u092e\u093f\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0907\u0935\u0947\u0902\u091f \u0915\u093e \u0928\u093e\u092e"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u092f\u0939 \u092c\u0948\u0928\u0930 \u090f\u0915 \u0910\u0938\u093e \u092a\u0949\u092a\u0905\u092a \u0939\u0948 \u091c\u093f\u0938\u0947 \u0906\u092a \u092c\u094d\u0932\u0949\u0915 \u0915\u0940 \u092e\u0926\u0926 \u0938\u0947 \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0915\u0947 \u092c\u091f\u0928 #consent-accept, #consent-reject \u0914\u0930 #consent-save \u0938\u0947 \u0932\u093f\u0902\u0915 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 (\"\u0938\u0947\u0935\" \u0915\u0947 \u0932\u093f\u090f analytics \u0914\u0930 marketing \u0928\u093e\u092e \u0915\u0947 \u091f\u093f\u0915 \u092c\u0949\u0915\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925); \u0915\u0939\u0940\u0902 \u092d\u0940 #consent-open \u0915\u093e \u0932\u093f\u0902\u0915 \u0907\u0938\u0947 \u092b\u093f\u0930 \u0938\u0947 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u091c\u092c \u0924\u0915 \u0915\u094b\u0908 \u0935\u093f\u091c\u093c\u093f\u091f\u0930\u094d\u0938 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e, \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u091f\u0948\u0917 \u0932\u094b\u0921 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0947, Google Consent Mode \"denied\" \u0930\u0939\u0924\u093e \u0939\u0948, \u0914\u0930 \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0942\u091a\u0940\u092c\u0926\u094d\u0927 \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u092c\u0902\u0926 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964"
            ],
            "Create a ready-made banner": [
                "\u090f\u0915 \u0924\u0948\u092f\u093e\u0930 \u092c\u0948\u0928\u0930 \u092c\u0928\u093e\u090f\u0901"
            ],
            "Show a cookie banner": [
                "\u0915\u0941\u0915\u0940 \u092c\u0948\u0928\u0930 \u0926\u093f\u0916\u093e\u090f\u0901"
            ],
            "Banner": [
                "\u092c\u0948\u0928\u0930"
            ],
            "Choose a popup\u2026": [
                "\u090f\u0915 \u092a\u0949\u092a\u0905\u092a \u091a\u0941\u0928\u0947\u0902\u2026"
            ],
            "%s (draft)": [
                "%s (\u0921\u094d\u0930\u093e\u092b\u094d\u091f)"
            ],
            "Edit the banner": [
                "\u092c\u0948\u0928\u0930 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902"
            ],
            "Remember the choice for (days)": [
                "(\u0926\u093f\u0928\u094b\u0902) \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0915\u0932\u094d\u092a \u092f\u093e\u0926 \u0930\u0916\u0947\u0902"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u092f\u0942\u0930\u094b\u092a\u0940\u092f \u0938\u0902\u0918, \u0908\u0908\u090f \u0914\u0930 \u092f\u0942\u0915\u0947 \u0938\u0947 \u092c\u093e\u0939\u0930: \u0935\u093f\u095b\u093f\u091f\u0930 \u0915\u0947 \u092e\u0928\u093e \u0915\u0930\u0928\u0947 \u0924\u0915 \u0932\u094b\u0921 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u092c\u0902\u0926: \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0906\u0917\u0902\u0924\u0941\u0915 \u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u0939\u092e\u0924\u093f \u0926\u0947\u0928\u0940 \u0939\u094b\u0917\u0940 (\u0938\u092c\u0938\u0947 \u0915\u0921\u093c\u093e \u0928\u093f\u092f\u092e, \u0914\u0930 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f)\u0964 \u091a\u093e\u0932\u0942: \u0915\u0947\u0935\u0932 \u0924\u092d\u0940 \u091c\u092c \u0906\u092a\u0915\u093e \u0939\u094b\u0938\u094d\u091f \u092f\u093e CDN \u0906\u0917\u0902\u0924\u0941\u0915 \u0915\u0947 \u0926\u0947\u0936 \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0924\u093e \u0939\u0948 (\u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f Cloudflare \u0915\u093e CF-IPCountry \u0939\u0947\u0921\u0930) \u0914\u0930 \u092f\u0939 EU, EEA, UK \u0914\u0930 Switzerland \u0938\u0947 \u092c\u093e\u0939\u0930 \u0939\u0948\u0964 \u092c\u0948\u0928\u0930 \u0905\u092d\u0940 \u092d\u0940 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0914\u0930 \u0905\u091c\u094d\u091e\u093e\u0924 \u0926\u0947\u0936 \u0915\u094b EU \u0915\u0947 \u092d\u0940\u0924\u0930 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0905\u0928\u094d\u092f \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u094d\u0938 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0938\u0939\u092e\u0924\u093f \u092e\u093f\u0932\u0928\u0947 \u0924\u0915 \u0930\u094b\u0915 \u0915\u0930 \u0930\u0916\u0928\u093e \u0939\u0948 (\u0939\u0948\u0902\u0921\u0932: analytics \u092f\u093e \u0939\u0948\u0902\u0921\u0932: marketing, \u0905\u0932\u094d\u092a\u0935\u093f\u0930\u093e\u092e \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0932\u0917 \u0915\u093f\u090f \u0917\u090f)"
            ],
            "Popups, slide-ins and bars": [
                "\u092a\u0949\u092a\u0905\u092a, \u0938\u094d\u0932\u093e\u0907\u0921-\u0907\u0928 \u0914\u0930 \u092c\u093e\u0930"
            ],
            "A\/B test results": [
                "A\/B \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092a\u0930\u093f\u0923\u093e\u092e"
            ],
            "Mailing-list connections": [
                "\u092e\u0947\u0932\u093f\u0902\u0917-\u0932\u093f\u0938\u094d\u091f \u0915\u0928\u0947\u0915\u094d\u0936\u0928"
            ]
        }
    }
