            "Rename the builder and hide our branding on this site": [
                "\u0411\u04af\u0442\u044d\u044d\u0433\u0447\u0438\u0439\u043d \u043d\u044d\u0440\u0438\u0439\u0433 \u04e9\u04e9\u0440\u0447\u0438\u043b\u0436, \u044d\u043d\u044d \u0441\u0430\u0439\u0442 \u0434\u044d\u044d\u0440\u0445 \u043c\u0430\u043d\u0430\u0439 \u0431\u0440\u044d\u043d\u0434\u0438\u0439\u0433 \u043d\u0443\u0443\u043d\u0430 \u0443\u0443"
            ],
            "Shown everywhere the product name appears: menus, the editor, notices.": [
                "\u0411\u04af\u0442\u044d\u044d\u0433\u0434\u044d\u0445\u04af\u04af\u043d\u0438\u0439 \u043d\u044d\u0440 \u0445\u0430\u0440\u0430\u0433\u0434\u0430\u0445 \u0431\u04af\u0445 \u0433\u0430\u0437\u0430\u0440\u0442 \u0445\u0430\u0440\u0430\u0433\u0434\u0430\u043d\u0430: \u0446\u044d\u0441\u04af\u04af\u0434, \u0437\u0430\u0441\u0432\u0430\u0440\u043b\u0430\u0433\u0447, \u043c\u044d\u0434\u044d\u0433\u0434\u043b\u04af\u04af\u0434."
            ],
            "Leave empty to use the builder name.": [
                "\u0411\u04af\u0442\u044d\u044d\u0433\u0447\u0438\u0439\u043d \u043d\u044d\u0440\u0438\u0439\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u0445\u044b\u043d \u0442\u0443\u043b\u0434 \u0445\u043e\u043e\u0441\u043e\u043d \u04af\u043b\u0434\u044d\u044d\u043d\u044d \u04af\u04af."
            ],
            "Description on the Plugins screen": [
                "\u0417\u0430\u043b\u0433\u0430\u0430\u0441\u0443\u0443\u0434 \u0434\u044d\u043b\u0433\u044d\u0446 \u0434\u044d\u044d\u0440\u0445 \u0442\u0430\u0439\u043b\u0431\u0430\u0440"
            ],
            "A Dashicons name (for example dashicons-admin-customizer) or an https:\/\/ image address.": [
