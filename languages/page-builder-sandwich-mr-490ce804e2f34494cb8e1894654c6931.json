            ],
            "Show block": [
                "\u092c\u094d\u0932\u0949\u0915 \u0926\u093e\u0916\u0935\u093e"
            ],
            "Use a readable theme colour": [
                "\u0935\u093e\u091a\u093e\u092f\u0932\u093e \u0938\u094b\u092a\u093e \u0905\u0938\u0932\u0947\u0932\u093e \u0925\u0940\u092e \u0930\u0902\u0917 \u0935\u093e\u092a\u0930"
            ],
            "Make it H%d": [
                "\u092f\u093e\u0932\u093e H%d \u092c\u0928\u0935\u093e"
            ],
            "Alt text": [
                "\u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092e\u091c\u0915\u0942\u0930"
            ],
            "Save alt text": [
                "\u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092e\u091c\u0915\u0942\u0930 \u091c\u0924\u0928 \u0915\u0930\u093e"
            ],
            "This image is decorative": [
                "\u0939\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0938\u091c\u093e\u0935\u091f\u0940 \u0906\u0939\u0947"
            ],
            "Checking\u2026": [
                "\u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u0947..."
            ],
            "No accessibility problems found on this page.": [
                "\u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092a\u094d\u0930\u0935\u0947\u0936\u092f\u094b\u0917\u094d\u092f\u0924\u093e \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0922\u0933\u0932\u0940 \u0928\u093e\u0939\u0940."
            ],
            "%1$s, %2$s.": [
                "%1$s, %2$s."
            ],
            "%d problem": [
                "%d \u0938\u092e\u0938\u094d\u092f\u093e",
                "%d \u0938\u092e\u0938\u094d\u092f\u093e"
            ],
            "%d thing to check": [
                "\u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 %d \u0917\u094b\u0937\u094d\u091f",
                "\u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 %d \u0917\u094b\u0937\u094d\u091f\u0940"
            ],
            "Check again": [
                "\u092a\u0941\u0928\u094d\u0939\u093e \u0924\u092a\u093e\u0938\u093e"
            ],
            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u0938\u094d\u0935\u092f\u0902\u091a\u0932\u093f\u0924 \u0924\u092a\u093e\u0938\u0923\u0940 \u0905\u0928\u0947\u0915 \u0938\u092e\u0938\u094d\u092f\u093e \u0936\u094b\u0927\u0924\u0947 \u092a\u0930\u0902\u0924\u0941 \u0938\u0930\u094d\u0935\u091a \u0928\u093e\u0939\u0940. \u0924\u0938\u0947\u091a \u092b\u0915\u094d\u0924 \u0915\u0940\u092c\u094b\u0930\u094d\u0921\u0938\u0939 \u0906\u0923\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930\u0938\u0939 \u092a\u0947\u091c \u0935\u093e\u092a\u0930\u0942\u0928 \u092a\u0939\u093e."
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u092e\u091c\u0915\u0942\u0930\u093e\u091a\u093e \u0915\u0949\u0928\u094d\u091f\u094d\u0930\u093e\u0938\u094d\u091f %1$s:1 \u0906\u0939\u0947; \u0935\u093e\u091a\u0928\u0940\u092f \u0939\u094b\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093f\u092e\u093e\u0928 %2$s:1 \u0905\u0938\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947."
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e, \u092f\u0947\u0925\u0947, \u0905\u0927\u093f\u0915 \u0935\u093e\u091a\u093e, \u0905\u0927\u093f\u0915, \u0926\u0941\u0935\u093e, \u0939\u093e \u0926\u0941\u0935\u093e, \u0905\u0927\u093f\u0915 \u091c\u093e\u0923\u0942\u0928 \u0918\u094d\u092f\u093e, \u091c\u093e"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u090f\u0915\u093e \u0932\u093f\u0902\u0915\u092e\u0927\u094d\u092f\u0947 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u092e\u091c\u0915\u0942\u0930 \u0928\u093e\u0939\u0940, \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u092b\u0915\u094d\u0924 \"\u0932\u093f\u0902\u0915\" \u0905\u0938\u0947 \u0918\u094b\u0937\u093f\u0924 \u0915\u0930\u0924\u094b. \u092e\u091c\u0915\u0942\u0930 \u0915\u093f\u0902\u0935\u093e \u0932\u0947\u092c\u0932 \u091c\u094b\u0921\u093e."
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\u201c%s\u201d \u0939\u0940 \u0932\u093f\u0902\u0915 \u0915\u0941\u0920\u0947 \u091c\u093e\u0924\u0947 \u0939\u0947 \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940. \u0924\u094d\u092f\u093e\u0910\u0935\u091c\u0940 \u0917\u0902\u0924\u0935\u094d\u092f\u0938\u094d\u0925\u093e\u0928\u093e\u091a\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u093e."
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u090f\u0915\u093e \u0918\u091f\u0915\u093e\u091a\u093e tabindex \u092a\u0949\u091d\u093f\u091f\u093f\u0935\u094d\u0939 \u0906\u0939\u0947, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0915\u0940\u092c\u094b\u0930\u094d\u0921\u091a\u093e \u0915\u094d\u0930\u092e \u0935\u093e\u091a\u0928\u093e\u091a\u094d\u092f\u093e \u0915\u094d\u0930\u092e\u093e\u0928\u0947 \u0930\u093e\u0939\u0924 \u0928\u093e\u0939\u0940. 0 \u0935\u093e\u092a\u0930\u093e \u0915\u093f\u0902\u0935\u093e \u0924\u094b \u0915\u093e\u0922\u093e."
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u0918\u091f\u0915\u093e\u0935\u0930 \u0915\u0940\u092c\u094b\u0930\u094d\u0921\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u094b\u0939\u094b\u091a\u0924\u093e \u092f\u0947\u0924 \u0928\u093e\u0939\u0940. \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092c\u091f\u0923 \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u0935\u094d\u092f\u093e\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u093e."
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u090f\u092e\u094d\u092c\u0947\u0921 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092b\u094d\u0930\u0947\u092e\u0932\u093e \u0936\u0940\u0930\u094d\u0937\u0915 \u0928\u093e\u0939\u0940, \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0924\u0947 \u0915\u093e\u092f \u0906\u0939\u0947 \u0939\u0947 \u0938\u093e\u0902\u0917\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940."
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u090f\u0915\u093e \u092b\u0949\u0930\u094d\u092e \u092b\u0940\u0932\u094d\u0921\u0932\u093e \u0932\u0947\u092c\u0932 \u0928\u093e\u0939\u0940, \u0924\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0924\u094d\u092f\u093e\u091a\u093e \u0909\u0926\u094d\u0926\u0947\u0936 \u0918\u094b\u0937\u093f\u0924 \u0915\u0947\u0932\u093e \u091c\u093e\u0924 \u0928\u093e\u0939\u0940."
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u0939\u0947 \u0936\u0940\u0930\u094d\u0937\u0915 \u0930\u093f\u0915\u093e\u092e\u0947 \u0906\u0939\u0947. \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u0947 \u0936\u0940\u0930\u094d\u0937\u0915\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u0928\u0947\u0935\u094d\u0939\u093f\u0917\u0947\u091f \u0915\u0930\u0924\u093e\u0924; \u0924\u0947 \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u092e\u091c\u0915\u0942\u0930 \u091c\u094b\u0921\u093e."
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
                "\u092a\u0943\u0937\u094d\u0920 \u0936\u0940\u0930\u094d\u0937\u0915 \u0906\u0927\u0940\u092a\u093e\u0938\u0942\u0928\u091a H1 \u0906\u0939\u0947; \u0938\u093e\u092e\u0917\u094d\u0930\u0940\u091a\u094d\u092f\u093e \u0936\u0940\u0930\u094d\u0937 \u0938\u094d\u0924\u0930\u093e\u0938\u093e\u0920\u0940 H2 \u0935\u093e\u092a\u0930\u093e."
            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u0939\u093e H%1$d \u090f\u0915 \u0938\u094d\u0924\u0930 \u0935\u0917\u0933\u0924\u094b; \u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940\u091a\u093e H%2$d \u0906\u0939\u0947. \u0924\u0947 H%3$d \u092c\u0928\u0935\u093e."
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u092f\u093e \u092a\u094d\u0930\u0924\u093f\u092e\u0947\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 alt \u092e\u091c\u0915\u0942\u0930 \u0928\u093e\u0939\u0940. \u0924\u094d\u092f\u093e\u091a\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u093e, \u0915\u093f\u0902\u0935\u093e \u0915\u093e\u0939\u0940\u091a \u092d\u0930 \u092a\u0921\u0924 \u0928\u0938\u0947\u0932 \u0924\u0930 \u0924\u0940 \u0938\u091c\u093e\u0935\u091f\u0940\u091a\u0940 \u092e\u094d\u0939\u0923\u0942\u0928 \u091a\u093f\u0928\u094d\u0939\u093e\u0902\u0915\u093f\u0924 \u0915\u0930\u093e."
            ],
            "Close panel": [
                "\u092a\u091f\u0932 \u092c\u0902\u0926 \u0915\u0930\u093e"
            ]
        }
    }
}
