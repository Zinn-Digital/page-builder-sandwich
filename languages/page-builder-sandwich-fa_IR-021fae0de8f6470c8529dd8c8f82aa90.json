                "domain": "messages",
                "lang": "fa_IR",
                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u062a\u0646\u0647\u0627 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f HTML \u067e\u0627\u0644\u0627\u06cc\u0634\u200c\u0646\u0634\u062f\u0647 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u0646\u062f \u0627\u062c\u0627\u0632\u0647 \u062a\u063a\u06cc\u06cc\u0631 CSS \u0633\u0641\u0627\u0631\u0634\u06cc \u0631\u0627 \u062f\u0627\u0631\u0646\u062f."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0628\u062e\u0634\u06cc \u0627\u0632 \u0627\u06cc\u0646 CSS \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u0634\u062f: @import\u060c expression()\u060c \u0622\u062f\u0631\u0633\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u06cc javascript:\u060c \u00ab<\u00bb \u0648 \u0622\u06a9\u0648\u0644\u0627\u062f\u0647\u0627\u06cc \u0646\u0627\u0645\u062a\u0648\u0627\u0632\u0646 \u0628\u0646\u0627 \u0628\u0631 \u062f\u0644\u0627\u06cc\u0644 \u0627\u0645\u0646\u06cc\u062a\u06cc \u062d\u0630\u0641 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f."
            ],
            "Page CSS": [
                "CSS \u0635\u0641\u062d\u0647"
            ],
            "Global classes": [
                "\u06a9\u0644\u0627\u0633\u200c\u0647\u0627\u06cc \u0633\u0631\u0627\u0633\u0631\u06cc"
            ],
            "Classes": [
                "\u06a9\u0644\u0627\u0633\u200c\u0647\u0627"
            ],
            "Create classes in Site design, then add them here.": [
                "\u062f\u0631 \u0637\u0631\u0627\u062d\u06cc \u0633\u0627\u06cc\u062a \u06a9\u0644\u0627\u0633\u200c\u0647\u0627 \u0631\u0627 \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f\u060c \u0633\u067e\u0633 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0627\u0636\u0627\u0641\u0647 \u0646\u0645\u0627\u06cc\u06cc\u062f."
            ],
            "Custom CSS": [
                "CSS \u0633\u0641\u0627\u0631\u0634\u06cc"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u0642\u0648\u0627\u0646\u06cc\u0646 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0639\u0646\u0635\u0631 \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f. \"selector\" \u0628\u0647 \u0645\u0639\u0646\u0627\u06cc \u0627\u06cc\u0646 \u0639\u0646\u0635\u0631 \u0627\u0633\u062a\u060c \u0645\u0627\u0646\u0646\u062f selector:hover { opacity: .8 } \u2014 \u0627\u0639\u0644\u0627\u0646\u200c\u0647\u0627\u06cc \u0633\u0627\u062f\u0647 \u0628\u0631\u0627\u06cc \u062e\u0648\u062f \u0639\u0646\u0635\u0631 \u0627\u0639\u0645\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f."
            ],
            "CSS for this page": [
                "CSS \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0628\u0631\u06af\u0647"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0641\u0642\u0637 \u062f\u0631 \u0627\u06cc\u0646 \u0628\u0631\u06af\u0647 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \u067e\u0633 \u0627\u0632 \u0634\u06cc\u0648\u0647\u200c\u0647\u0627\u06cc \u0633\u0627\u06cc\u062a. \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0628\u0631\u06af\u0647 \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f."
            ]
        }
    }
}
