            ],
            "Anyone with the link can see this page, even before it is published, and leave comments. No account is needed.": [
                "\u0932\u093f\u0902\u0915 \u0935\u093e\u0932\u093e \u0915\u094b\u0908 \u092d\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u0915\u094b \u0926\u0947\u0916 \u0938\u0915\u0924\u093e \u0939\u0948, \u092f\u0939\u093e\u0901 \u0924\u0915 \u0915\u093f \u0907\u0938\u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092d\u0940, \u0914\u0930 \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0915\u093f\u0938\u0940 \u0916\u093e\u0924\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
            ],
