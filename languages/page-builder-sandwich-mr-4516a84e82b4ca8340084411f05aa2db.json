            ],
            "%1$d heavy images (%2$s).": [
                "%1$d \u0905\u0935\u091c\u0921 \u092a\u094d\u0930\u0924\u093f\u092e\u093e (%2$s)."
            ],
            "Make lighter copies (originals kept)": [
                "\u0939\u0932\u0915\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u0940 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e (\u092e\u0942\u0933 \u092b\u093e\u092f\u0932\u0940 \u0924\u0936\u093e\u091a \u0920\u0947\u0935\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u0940\u0932)"
            ],
            "%d design class is not used.": [
                "%d \u0921\u093f\u091d\u093e\u0907\u0928 \u0915\u094d\u0932\u093e\u0938 \u0935\u093e\u092a\u0930\u0932\u093e \u0917\u0947\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940.",
                "%d \u0921\u093f\u091d\u093e\u0907\u0928 \u0915\u094d\u0932\u093e\u0938\u0947\u0938 \u0935\u093e\u092a\u0930\u0932\u0947 \u0917\u0947\u0932\u0947 \u0928\u093e\u0939\u0940\u0924."
