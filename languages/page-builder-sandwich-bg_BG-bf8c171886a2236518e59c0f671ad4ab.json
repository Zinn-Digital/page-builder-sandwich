            "This video is not from the Media Library, so its size is unknown and the page will jump when it loads. Upload it to the Media Library instead.": [
                "\u0422\u043e\u0432\u0430 \u0432\u0438\u0434\u0435\u043e \u043d\u0435 \u0435 \u043e\u0442 \u041c\u0435\u0434\u0438\u0439\u043d\u0430\u0442\u0430 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430, \u0442\u0430\u043a\u0430 \u0447\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u044a\u0442 \u043c\u0443 \u0435 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430 \u0449\u0435 \u043f\u0440\u0435\u043c\u0438\u0433\u043d\u0435 \u043f\u0440\u0438 \u0437\u0430\u0440\u0435\u0436\u0434\u0430\u043d\u0435\u0442\u043e \u043c\u0443. \u0412\u043c\u0435\u0441\u0442\u043e \u0442\u043e\u0432\u0430 \u0433\u043e \u043a\u0430\u0447\u0435\u0442\u0435 \u0432 \u041c\u0435\u0434\u0438\u0439\u043d\u0430\u0442\u0430 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0430."
            ],
            "An image, video or frame in this HTML has no width and height, so the page will jump when it loads. Add width and height attributes to it.": [
                "\u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u0432\u0438\u0434\u0435\u043e \u0438\u043b\u0438 \u043a\u0430\u0434\u044a\u0440 \u0432 \u0442\u043e\u0437\u0438 HTML \u043a\u043e\u0434 \u043d\u044f\u043c\u0430 \u0437\u0430\u0434\u0430\u0434\u0435\u043d\u0438 \u0448\u0438\u0440\u0438\u043d\u0430 \u0438 \u0432\u0438\u0441\u043e\u0447\u0438\u043d\u0430, \u043f\u043e\u0440\u0430\u0434\u0438 \u043a\u043e\u0435\u0442\u043e \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430 \u0449\u0435 \u043f\u0440\u0435\u0441\u043a\u043e\u0447\u0438 \u043f\u0440\u0438 \u0437\u0430\u0440\u0435\u0436\u0434\u0430\u043d\u0435. \u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u0430\u0442\u0440\u0438\u0431\u0443\u0442\u0438 \u0437\u0430 \u0448\u0438\u0440\u0438\u043d\u0430 \u0438 \u0432\u0438\u0441\u043e\u0447\u0438\u043d\u0430 \u043a\u044a\u043c \u043d\u0435\u0433\u043e."
            ],
            "This embed resizes itself after it loads, which moves the content below it. Give it room or place it lower on the page.": [
                "\u0422\u043e\u0437\u0438 \u043e\u0431\u0435\u043a\u0442 \u0437\u0430 \u0432\u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0435 \u043f\u0440\u0435\u043e\u0440\u0430\u0437\u043c\u0435\u0440\u044f\u0432\u0430 \u0441\u0435\u0431\u0435 \u0441\u0438 \u0441\u043b\u0435\u0434 \u0437\u0430\u0440\u0435\u0436\u0434\u0430\u043d\u0435, \u043a\u043e\u0435\u0442\u043e \u0438\u0437\u043c\u0435\u0441\u0442\u0432\u0430 \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435\u0442\u043e \u043f\u043e\u0434 \u043d\u0435\u0433\u043e. \u041e\u0441\u0438\u0433\u0443\u0440\u0435\u0442\u0435 \u043c\u0443 \u043c\u044f\u0441\u0442\u043e \u0438\u043b\u0438 \u0433\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u0435\u0442\u0435 \u043f\u043e-\u043d\u0430\u0434\u043e\u043b\u0443 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430."
