            ],
            "Measure again": [
                "\u092a\u0941\u0928\u094d\u0939\u093e \u092e\u094b\u091c\u093e"
            ],
            "Measure this page": [
                "\u0939\u0947 \u092a\u0943\u0937\u094d\u0920 \u092e\u094b\u091c\u093e"
            ],
            "Page weight %1$s in %2$d requests": [
                "%2$d \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u092a\u0943\u0937\u094d\u0920\u093e\u091a\u093e \u0906\u0915\u093e\u0930 %1$s"
            ],
            "Layout shift %s (good: under 0.1)": [
