            ],
            "Mark the plans up as a Product with offers for search engines.": [
                "\u0936\u094b\u0927 \u0907\u0902\u091c\u093f\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u092f\u094b\u091c\u0928\u093e\u0902\u0928\u093e \u0911\u092b\u0930\u094d\u0938\u0938\u0939 \u0909\u0924\u094d\u092a\u093e\u0926\u0928 \u092e\u094d\u0939\u0923\u0942\u0928 \u091a\u093f\u0928\u094d\u0939\u093e\u0902\u0915\u093f\u0924 \u0915\u0930\u093e."
            ],
            "Mark this up as a Review for search engines.": [
                "\u0936\u094b\u0927 \u0907\u0902\u091c\u093f\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0939\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u092e\u094d\u0939\u0923\u0942\u0928 \u091a\u093f\u0928\u094d\u0939\u093e\u0902\u0915\u093f\u0924 \u0915\u0930\u093e."
            ],
            "Structured data": [
