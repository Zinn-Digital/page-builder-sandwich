            ],
            "Largest content shown after %d ms on this computer": [
                "\u092f\u093e \u0938\u0902\u0917\u0923\u0915\u093e\u0935\u0930 %d \u092e\u093f\u0932\u0940\u0938\u0947\u0915\u0902\u0926\u093e\u0902\u0928\u0902\u0924\u0930 \u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u094b\u0920\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0926\u093e\u0916\u0935\u0932\u0940 \u0917\u0947\u0932\u0940"
            ],
            "Images in the content: %1$s (%2$d)": [
                "\u092e\u0938\u0941\u0926\u094d\u092f\u093e\u092e\u0927\u0940\u0932 \u092a\u094d\u0930\u0924\u093f\u092e\u093e: %1$s (%2$d)"
            ],
            "The largest image is lazy-loaded, which delays it.": [
                "\u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u094b\u0920\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0932\u0947\u091d\u0940-\u0932\u094b\u0921 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0924\u093f\u0932\u093e \u0909\u0936\u0940\u0930 \u0939\u094b\u0924\u094b."
            ],
            "%d image(s) have no width and height, which can make the page jump.": [
                "%d \u092a\u094d\u0930\u0924\u093f\u092e\u0947\u0932\u093e\/\u092a\u094d\u0930\u0924\u093f\u092e\u093e\u0902\u0928\u093e \u0930\u0941\u0902\u0926\u0940 \u0906\u0923\u093f \u0909\u0902\u091a\u0940 \u0928\u093e\u0939\u0940, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u092a\u0943\u0937\u094d\u0920 \u0909\u0921\u0940 \u092e\u093e\u0930\u0942 \u0936\u0915\u0924\u0947."
            ],
            "An image is larger than it is shown (%1$s). A smaller size saves %2$s.": [
                "\u090f\u0915 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0926\u0930\u094d\u0936\u0935\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u0906\u0915\u093e\u0930\u093e\u092a\u0947\u0915\u094d\u0937\u093e (%1$s) \u092e\u094b\u0920\u0940 \u0906\u0939\u0947. \u0932\u0939\u093e\u0928 \u0906\u0915\u093e\u0930 %2$s \u0935\u093e\u091a\u0935\u0924\u094b."
            ],
            "Use the smaller size": [
                "\u0932\u0939\u093e\u0928 \u0906\u0915\u093e\u0930 \u0935\u093e\u092a\u0930\u093e"
            ],
            "%d fix(es) made; save the page, then measure again.": [
                "%d \u0938\u0941\u0927\u093e\u0930\u0923\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u094d\u092f\u093e; \u092a\u0943\u0937\u094d\u0920 \u091c\u0924\u0928 \u0915\u0930\u093e, \u0928\u0902\u0924\u0930 \u092a\u0941\u0928\u094d\u0939\u093e \u092e\u094b\u091c\u093e."
            ]
