#. translators: 1: number of items in the file, 2: the site it came from.
#: src/workflow/TransferPanel.js:219
#, js-format
msgid "The file holds %1$d item from %2$s."
msgid_plural "The file holds %1$d items from %2$s."
msgstr[0] "ഈ ഫയലിൽ %2$s-ൽ നിന്നുള്ള %1$d ഇനം അടങ്ങിയിരിക്കുന്നു."
msgstr[1] "ഈ ഫയലിൽ %2$s-ൽ നിന്നുള്ള %1$d ഇനങ്ങൾ അടങ്ങിയിരിക്കുന്നു."

#: src/workflow/TransferPanel.js:230
msgid "When an item with the same name already exists here"
msgstr "ഇതേ പേരിലുള്ള ഒരു ഇനം ഇവിടെ ഇതിനകം നിലവിലുണ്ടെങ്കിൽ"

#: src/workflow/TransferPanel.js:238
msgid "Keep the one on this site"
msgstr "ഈ സൈറ്റിലുള്ളത് സൂക്ഷിക്കുക"

#: src/workflow/TransferPanel.js:245
msgid "Replace it with the imported one"
msgstr "ഇറക്കുമതി ചെയ്തത് ഉപയോഗിച്ച് ഇത് മാറ്റിസ്ഥാപിക്കുക"

#: src/workflow/TransferPanel.js:252
msgid "Import a copy beside it"
msgstr "അതിന് അടുത്തായി ഒരു പകർപ്പ് ഇറക്കുമതി ചെയ്യുക"

#: src/workflow/TransferPanel.js:262
msgid "Apply the settings in the file"
msgstr "ഫയലിലെ ക്രമീകരണങ്ങൾ പ്രയോഗിക്കുക"

#: src/workflow/TransferPanel.js:271
msgid "Copy the images into this site’s media library"
msgstr "ഈ ചിത്രങ്ങൾ ഈ സൈറ്റിന്റെ മീഡിയ ലൈബ്രറിയിലേക്ക് പകർത്തുക"

