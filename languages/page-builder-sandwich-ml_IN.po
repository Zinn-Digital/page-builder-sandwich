msgstr "%1$d-ാം ഘട്ടം (%2$d-ൽ): %3$s"

#: src/admin-kit/Wizard.js:119
msgid "Finish"
msgstr "പൂർത്തിയാക്കുക"

#: src/admin-kit/Wizard.js:131
