#: blocks/fixture-switcher/block.json
msgctxt "block title"
msgid "Language switcher (sample)"
msgstr "ലാംഗ്വേജ് സ്വിച്ചർ (സാമ്പിൾ)"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Lists the site's languages from the translation plugin, when one is active. It renders nothing otherwise."
msgstr "ഒരു പരിഭാഷാ പ്ലഗിൻ സജീവമായിരിക്കുമ്പോൾ, അതിൽ നിന്നുള്ള സൈറ്റിന്റെ ഭാഷകൾ ലിസ്റ്റ് ചെയ്യുന്നു. ഇല്ലെങ്കിൽ ഇത് ഒന്നും റെൻഡർ ചെയ്യുകയില്ല."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "ഭാഷ"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "സ്വിച്ചർ"

#: blocks/fixture/block.json
msgctxt "block title"
msgid "Sample content"
msgstr "സാമ്പിൾ ഉള്ളടക്കം"

#: blocks/fixture/block.json
msgctxt "block description"
msgid "A heading and a paragraph, rendered with neutral class names. It is the reference block for the translation contract."
msgstr "ഒരു ശീർഷകവും ഒരു പാരഗ്രാഫും, നിഷ്പക്ഷ ക്ലാസ് നാമങ്ങൾ ഉപയോഗിച്ച് റെൻഡർ ചെയ്‌തു. വിവർത്തന കരാറിനായുള്ള റഫറൻസ് ബ്ലോക്കാണിത്."

#: blocks/fixture/block.json
msgctxt "block keyword"
msgid "sample"
msgstr "മാതൃക"

