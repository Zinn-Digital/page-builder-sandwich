#: src/admin/App.js:158
msgid "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page."
msgstr "ലൈസൻസുള്ളതും അക്കൗണ്ടുമായി ബന്ധിപ്പിച്ചിട്ടുള്ളതുമായ പ്രോ ഇൻസ്റ്റാളേഷനുകൾക്കാണ് ബീറ്റ പതിപ്പുകൾ നൽകുന്നത്. ബന്ധിപ്പിച്ചുകഴിഞ്ഞാൽ, അക്കൗണ്ട് പേജിൽ നിന്ന് നിങ്ങൾക്ക് ചേരാം."

#: src/admin/Breakpoints.js:58
msgid "Breakpoints saved. Pages pick up the new widths on their next view."
msgstr "ബ്രേക്ക്‌പോയിന്റുകൾ സേവ് ചെയ്തു. പേജുകൾ അവയുടെ അടുത്ത വ്യൂവിൽ പുതിയ വീതികൾ സ്വീകരിക്കും."

#: src/admin/Breakpoints.js:79
msgid "Breakpoints"
msgstr "ബ്രേക്ക്‌പോയിന്റുകൾ"

#: src/admin/Breakpoints.js:94
msgid "Styles set for Tablet apply up to the tablet width, and styles set for Mobile up to the mobile width. Desktop styles apply everywhere else."
msgstr "ടാബ്‌ലെറ്റിനായി സജ്ജീകരിച്ച ശൈലികൾ ടാബ്‌ലെറ്റ് വീതി വരെയും മൊബൈലിനായി സജ്ജീകരിച്ചവ മൊബൈൽ വീതി വരെയും ബാധകമാണ്. ഡെസ്‌ക്‌ടോപ്പ് ശൈലികൾ മറ്റെല്ലാ സ്ഥലങ്ങളിലും ബാധകമാണ്."

#: src/admin/Breakpoints.js:102
msgid "Tablet: up to (px)"
msgstr "ടാബ്‌ലെറ്റ്: പരമാവധി (px)"

#: src/admin/Breakpoints.js:115
msgid "Mobile: up to (px)"
msgstr "മൊബൈൽ: പരമാവധി (px) വരെ"

#: src/admin/Breakpoints.js:146
msgid "Save breakpoints"
msgstr "ബ്രേക്ക്പോയിന്റുകൾ സേവ് ചെയ്യുക"

#: src/admin/Breakpoints.js:162
msgid "Use the default widths"
msgstr "സ്വതസ്സിദ്ധമായ വീതികൾ ഉപയോഗിക്കുക"

#: src/admin/index.js:25
#: src/admin/index.js:32
msgid "Settings"
msgstr "ക്രമീകരണങ്ങൾ"

#: src/admin/LegacyContent.js:21
msgid "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here."
msgstr "ഈ പോസ്റ്റ് കൺവെർട്ട് ചെയ്യാനുള്ള അഭ്യർത്ഥന പൂർത്തിയാകുന്നതിന് മുമ്പ് നിലച്ചതിനാൽ, ആ പോസ്റ്റ് ഒഴിവാക്കിയിരിക്കുന്നു. ഇത് കൺവെർട്ട് ചെയ്യാൻ തുറക്കുക അല്ലെങ്കിൽ ഇവിടെനിന്ന് വീണ്ടും കൺവെർട്ട് ചെയ്യുക."

