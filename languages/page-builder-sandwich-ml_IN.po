msgstr "“%s” ഇറക്കുമതി ചെയ്തിട്ടില്ല: അത്തരം ഇനം സൃഷ്ടിക്കാൻ നിങ്ങൾക്ക് അനുവാദമില്ല."

#. translators: %s: item name from the export file.
#: includes/workflow/class-transfer.php:354
#, php-format
msgid "“%s” was not replaced: you are not allowed to edit the one on this site."
msgstr "“%s” മാറ്റിസ്ഥാപിച്ചില്ല: ഈ സൈറ്റിലുള്ളത് എഡിറ്റ് ചെയ്യാൻ നിങ്ങൾക്ക് അനുവാദമില്ല."

