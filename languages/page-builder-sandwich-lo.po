msgstr "ຄັດລອກຮູບແບບແລ້ວ. ວາງໃສ່ບລັອກໃດກໍໄດ້, ໃນເວັບໄຊນີ້ ຫຼື ເວັບໄຊອື່ນ."

#: src/studio/components/style-clipboard.js:111
#: src/studio/components/style-clipboard.js:134
msgid "The browser refused to copy."
msgstr "ເບຣົາເຊີປະຕິເສດການສຳເນົາ."

#: src/studio/components/style-clipboard.js:130
msgid "Section copied. Paste it into any page, on this site or another."
msgstr "ຄັດລອກພາກສ່ວນແລ້ວ. ວາງມັນລົງໃນໜ້າໃດກໍໄດ້, ຢູ່ເວັບໄຊນີ້ ຫຼື ເວັບໄຊອື່ນ."

#: src/studio/components/style-clipboard.js:148
msgid "The clipboard does not hold a style copied from Sandwich Studio."
msgstr "ຕູ້ຄລິບປອດບໍ່ມີຮູບແບບທີ່ຄັດລອກມາຈາກ Sandwich Studio."

#. translators: %d: number of blocks.
#: src/studio/components/style-clipboard.js:172
#, js-format
msgid "Style pasted onto %d block."
msgid_plural "Style pasted onto %d blocks."
msgstr[0] "ຮູບແບບທີ່ໄດ້ວາງໃສ່ໃນ %d ບ໋ອກ."

#: src/studio/components/style-clipboard.js:180
msgid "That style does not fit the selected block."
msgstr "ຮູບແບບນັ້ນບໍ່ເໝາະສົມກັບບລັອກທີ່ເລືອກໄວ້."

#: src/studio/components/style-clipboard.js:200
msgid "The clipboard does not hold a copied section."
msgstr "ຄລິບບອດບໍ່ມີສ່ວນທີ່ໄດ້ສຳເນົາໄວ້."

#: src/studio/components/style-clipboard.js:216
msgid "Section pasted."
msgstr "ພາກສ່ວນທີ່ວາງລົງແລ້ວ."

#: src/studio/components/style-clipboard.js:277
#: src/studio/components/style-clipboard.js:333
msgid "Paste style"
msgstr "ວາງຮູບແບບ"

#: src/studio/components/style-clipboard.js:278
#: src/studio/components/style-clipboard.js:349
msgid "Paste section"
msgstr "ວາງພາກສ່ວນ"

#: src/studio/components/style-clipboard.js:285
msgid "Press Ctrl+V (or Cmd+V on a Mac) here to paste"
msgstr "ກົດ Ctrl+V (ຫຼື Cmd+V ຢູ່ໃນ Mac) ທີ່ນີ້ເພື່ອວາງ"

#: src/studio/components/style-clipboard.js:325
msgid "Copy style"
msgstr "ຄັດລອກຮູບແບບ"

#: src/studio/components/style-clipboard.js:341
msgid "Copy section"
msgstr "ສຳເນົາພາກສ່ວນ"

#: src/studio/editor-button/index.js:33
msgid "Edit in Sandwich Studio"
msgstr "ແກ້ໄຂໃນ Sandwich Studio"

#: src/studio/hooks/use-save.js:73
msgid "Saving failed. Check your connection and try again; your changes are kept in this browser."
msgstr "ການບັນທຶກບໍ່ສຳເລັດ. ກະລຸນາ ກວດສອບການເຊື່ອມຕໍ່ຂອງທ່ານ ແລ້ວລອງໃໝ່ອີກຄັ້ງ; ການປ່ຽນແປງຂອງທ່ານຖືກເກັບຮັກສາໄວ້ໃນໂປຣແກຣມທ່ອງເວັບນີ້ແລ້ວ."

#: src/studio/hooks/use-save.js:87
msgid "Published."
msgstr "ຈັດພິມແລ້ວ."

#: src/studio/hooks/use-save.js:88
msgid "Saved."
msgstr "ບັນທຶກແລ້ວ."

#: blocks/button/block.json
msgctxt "block title"
msgid "Button link"
msgstr "ລິ້ງປຸ່ມ"

#: blocks/button/block.json
msgctxt "block description"
msgid "A link styled as a button."
msgstr "ລາຍການເຊື່ອມຕໍ່ທີ່ຕົກແຕ່ງເປັນປຸ່ມ."

#: blocks/button/block.json
msgctxt "block keyword"
msgid "button"
msgstr "ປຸ່ມ"

#: blocks/button/block.json
msgctxt "block keyword"
msgid "link"
msgstr "ລິ້ງ"

#: blocks/button/block.json
msgctxt "block keyword"
msgid "call to action"
msgstr "ການຮຽກຮ້ອງໃຫ້ລົງມືປະຕິບັດ"

#: blocks/column/block.json
msgctxt "block title"
msgid "Column"
msgstr "ຖັນ"

#: blocks/column/block.json
msgctxt "block description"
msgid "A column inside a row. It can hold any block."
msgstr "ຄໍລຳພາຍໃນແຖວ. ມັນສາມາດບັນຈຸບລັອກໃດກໍໄດ້."

#: blocks/column/block.json
msgctxt "block keyword"
msgid "column"
msgstr "ຖັນ"

#: blocks/column/block.json
#: blocks/row/block.json
msgctxt "block keyword"
msgid "layout"
msgstr "ຮູບແບບໜ້າເວັບ"

#: blocks/fixture-switcher/block.json
msgctxt "block title"
msgid "Language switcher (sample)"
msgstr "ຕົວປ່ຽນພາສາ (ຕົວຢ່າງ)"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Lists the site's languages from the translation plugin, when one is active. It renders nothing otherwise."
msgstr "ສະແດງລາຍການພາສາຂອງເວັບໄຊຈາກປລັກອິນແປພາສາ, ເມື່ອມີການເປີດໃຊ້ງານ. ຖ້າບໍ່ມີແມ່ນຈະບໍ່ສະແດງຫຍັງເລີຍ."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "ພາສາ"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "ຕົວສະຫຼັບ"

#: blocks/fixture/block.json
msgctxt "block title"
msgid "Sample content"
msgstr "ເນື້ອຫາຕົວຢ່າງ"

#: blocks/fixture/block.json
msgctxt "block description"
msgid "A heading and a paragraph, rendered with neutral class names. It is the reference block for the translation contract."
msgstr "ຫົວຂໍ້ ແລະ ວັກໜຶ່ງ, ສະແດງຜົນດ້ວຍຊື່ຄາສ໌ແບບກາງ. ມັນແມ່ນບ໋ອກອ້າງອີງສຳລັບສັນຍາການແປ."

#: blocks/fixture/block.json
msgctxt "block keyword"
msgid "sample"
msgstr "ຕົວຢ່າງ"

#: blocks/fixture/block.json
msgctxt "block keyword"
msgid "text"
msgstr "ຂໍ້ຄວາມ"

#: blocks/icon/block.json
msgctxt "block title"
msgid "Icon"
msgstr "ໄອຄອນ"

#: blocks/icon/block.json
msgctxt "block description"
msgid "An SVG icon. The markup is cleaned before it is shown."
msgstr "ໄອຄອນ SVG. ໂຄງສ້າງມາກອັບຖືກອະນາໄມກ່ອນທີ່ມັນຈະຖືກສະແດງ."

#: blocks/icon/block.json
msgctxt "block keyword"
msgid "icon"
msgstr "ໄອຄອນ"

#: blocks/icon/block.json
msgctxt "block keyword"
msgid "svg"
msgstr "svg"

#: blocks/row/block.json
msgctxt "block title"
msgid "Row"
msgstr "ແຖວ"

#: blocks/row/block.json
msgctxt "block description"
msgid "A row of columns. Stays readable if the plugin is ever turned off."
msgstr "ແຖວຂອງຖັນ. ຍັງຄົງອ່ານໄດ້ຫາກປລັກອິນຖືກປິດໃຊ້ງານ."

#: blocks/row/block.json
msgctxt "block keyword"
msgid "row"
msgstr "ແຖວ"

#: blocks/row/block.json
msgctxt "block keyword"
msgid "columns"
msgstr "ຖັນ"

#: blocks/shortcode/block.json
msgctxt "block title"
msgid "Shortcode (add-on)"
msgstr "ລະຫັດຫຍໍ້ (ສ່ວນເສີມ)"

#: blocks/shortcode/block.json
msgctxt "block description"
msgid "A shortcode from an add-on written for the classic Page Builder Sandwich editor, with the settings the add-on declared."
msgstr "ຊ໋ອດໂຄດຈາກສ່ວນເສີມທີ່ຂຽນຂຶ້ນສຳລັບຕົວແກ້ໄຂ Page Builder Sandwich ແບບຄລາສສິກ, ພ້ອມດ້ວຍການຕັ້ງຄ່າທີ່ສ່ວນເສີມດັ່ງກ່າວໄດ້ປະກາດໄວ້."

#: blocks/shortcode/block.json
msgctxt "block keyword"
msgid "shortcode"
msgstr "ລະຫັດຫຍໍ້"

#: blocks/shortcode/block.json
msgctxt "block keyword"
msgid "add-on"
msgstr "ສ່ວນເສີມ"

#: blocks/sidebar/block.json
msgctxt "block title"
msgid "Widget area"
msgstr "ພື້ນທີ່ວິດເຈັດ"

#: blocks/sidebar/block.json
msgctxt "block description"
msgid "Shows the widgets in one of the theme's widget areas."
msgstr "ສະແດງວິດເຈັດໃນໜຶ່ງໃນພື້ນທີ່ວິດເຈັດຂອງຮູບແບບສີສັນ."

#: blocks/sidebar/block.json
msgctxt "block keyword"
msgid "sidebar"
msgstr "ແຖບຂ້າງ"

#: blocks/sidebar/block.json
msgctxt "block keyword"
msgid "widget area"
msgstr "ພື້ນທີ່ວິດເຈັດ"

#: blocks/widget/block.json
msgctxt "block title"
msgid "Widget"
msgstr "ວິດເຈັດ"

#: blocks/widget/block.json
msgctxt "block description"
msgid "Shows one of the site's registered classic widgets."
msgstr "ສະແດງໜຶ່ງໃນວິດເຈັດແບບຄລາສສິກທີ່ລົງທະບຽນຂອງເວັບໄຊ."

#: blocks/widget/block.json
msgctxt "block keyword"
msgid "widget"
msgstr "ວິດເຈັດ"
