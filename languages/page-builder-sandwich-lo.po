#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "ເຄື່ອງມືປ່ຽນພາສາ"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another language, styled to match your page. Needs the Tranzly plugin for the languages."
msgstr "ອະນຸຍາດໃຫ້ຜູ້ເຂົ້າຊົມອ່ານໜ້ານີ້ເປັນພາສາອື່ນ, ຈັດຮູບແບບໃຫ້ກົງກັບໜ້າຂອງທ່ານ. ຕ້ອງການປລັກອິນ Tranzly ສຳລັບພາສາຕ່າງໆ."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "ການແປ"

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "ຫຼາຍພາສາ"

#: blocks/row/block.json
msgctxt "block title"
msgid "Row"
msgstr "ແຖວ"

#: blocks/row/block.json
msgctxt "block description"
