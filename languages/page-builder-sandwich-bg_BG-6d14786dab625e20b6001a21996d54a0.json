            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u0442\u0435, \u0430\u043a\u043e \u0432\u0430\u0448\u0430\u0442\u0430 \u0442\u0435\u043c\u0430 \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u043e \u0440\u0430\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0432\u0435\u0447\u0435 \u0433\u0438 \u0434\u043e\u0431\u0430\u0432\u044f; \u0441\u044a\u0431\u0438\u0442\u0438\u044f\u0442\u0430 \u0432\u0441\u0435 \u043e\u0449\u0435 \u0441\u0435 \u0438\u0437\u043f\u0440\u0430\u0449\u0430\u0442."
            ],
            "Event name for form submissions": [
                "\u0418\u043c\u0435 \u043d\u0430 \u0441\u044a\u0431\u0438\u0442\u0438\u0435\u0442\u043e \u0437\u0430 \u043f\u043e\u0434\u0430\u0434\u0435\u043d\u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u044f\u0440\u0438"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0411\u0430\u043d\u0435\u0440\u044a\u0442 \u0435 \u0438\u0437\u0441\u043a\u0430\u0447\u0430\u0449 \u043f\u0440\u043e\u0437\u043e\u0440\u0435\u0446, \u043a\u043e\u0439\u0442\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0438\u0440\u0430\u0442\u0435 \u0441 \u0431\u043b\u043e\u043a\u043e\u0432\u0435. \u0411\u0443\u0442\u043e\u043d\u0438\u0442\u0435 \u043c\u0443 \u0432\u043e\u0434\u044f\u0442 \u043a\u044a\u043c #consent-accept, #consent-reject \u0438 #consent-save (\u0441 \u043e\u0442\u043c\u0435\u0442\u043a\u0438 \u0441 \u0438\u043c\u0435\u043d\u0430 analytics \u0438 marketing \u0437\u0430 \u201esave\u201c); \u0432\u0440\u044a\u0437\u043a\u0430 \u043a\u044a\u043c #consent-open \u043a\u044a\u0434\u0435\u0442\u043e \u0438 \u0434\u0430 \u0435 \u0433\u043e \u043f\u043e\u043a\u0430\u0437\u0432\u0430 \u043e\u0442\u043d\u043e\u0432\u043e. \u0414\u043e\u043a\u0430\u0442\u043e \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044f\u0442 \u043d\u0435 \u043f\u0440\u0438\u0435\u043c\u0435, \u043f\u0440\u043e\u0441\u043b\u0435\u0434\u044f\u0432\u0430\u0449\u0438\u0442\u0435 \u043c\u0430\u0440\u043a\u0435\u0440\u0438 \u043d\u0435 \u0441\u0435 \u0437\u0430\u0440\u0435\u0436\u0434\u0430\u0442, Google Consent Mode \u043e\u0441\u0442\u0430\u0432\u0430 \u201edenied\u201c, \u0430 \u0441\u043a\u0440\u0438\u043f\u0442\u043e\u0432\u0435\u0442\u0435, \u043a\u043e\u0438\u0442\u043e \u043f\u043e\u0441\u043e\u0447\u0432\u0430\u0442\u0435, \u043e\u0441\u0442\u0430\u0432\u0430\u0442 \u0438\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u0438."
            ],
            "Create a ready-made banner": [
                "\u0421\u044a\u0437\u0434\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0433\u043e\u0442\u043e\u0432 \u0431\u0430\u043d\u0435\u0440"
            ],
            "Show a cookie banner": [
                "\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0431\u0430\u043d\u0435\u0440 \u0437\u0430 \u0431\u0438\u0441\u043a\u0432\u0438\u0442\u043a\u0438"
            ],
            "Banner": [
