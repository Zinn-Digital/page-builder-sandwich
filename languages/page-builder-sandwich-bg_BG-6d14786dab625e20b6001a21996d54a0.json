            "Popups, slide-ins and bars": [
                "\u0418\u0437\u0441\u043a\u0430\u0447\u0430\u0449\u0438 \u043f\u0440\u043e\u0437\u043e\u0440\u0446\u0438, \u043f\u043b\u044a\u0437\u0433\u0430\u0449\u0438 \u0441\u0435 \u043f\u0430\u043d\u0435\u043b\u0438 \u0438 \u043b\u0435\u043d\u0442\u0438"
