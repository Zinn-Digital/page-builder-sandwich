            ],
            "Install Yoast SEO, Rank Math, SEOPress or All in One SEO to save a meta title and description.": [
                "\u0418\u043d\u0441\u0442\u0430\u043b\u0438\u0440\u0430\u0439\u0442\u0435 Yoast SEO, Rank Math, SEOPress \u0438\u043b\u0438 All in One SEO, \u0437\u0430 \u0434\u0430 \u0437\u0430\u043f\u0430\u0437\u0438\u0442\u0435 \u043c\u0435\u0442\u0430 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0438 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435."
