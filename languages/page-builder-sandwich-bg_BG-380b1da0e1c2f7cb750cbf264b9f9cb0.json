            ],
            "For example: \"make the hero shorter and friendlier\", \"add an FAQ about delivery after the pricing\", \"translate this section into Spanish\". Select a block first to point at it.": [
                "\u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440: \u201e\u043d\u0430\u043f\u0440\u0430\u0432\u0435\u0442\u0435 \u0437\u0430\u0433\u043b\u0430\u0432\u043d\u0438\u044f \u0431\u043b\u043e\u043a \u043f\u043e-\u043a\u0440\u0430\u0442\u044a\u043a \u0438 \u043f\u043e-\u043f\u0440\u0438\u0432\u0435\u0442\u043b\u0438\u0432\u201c, \u201e\u0434\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u0427\u0417\u0412 \u0437\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430\u0442\u0430 \u0441\u043b\u0435\u0434 \u0446\u0435\u043d\u0438\u0442\u0435\u201c, \u201e\u043f\u0440\u0435\u0432\u0435\u0434\u0435\u0442\u0435 \u0442\u043e\u0437\u0438 \u0440\u0430\u0437\u0434\u0435\u043b \u043d\u0430 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u201c. \u041f\u044a\u0440\u0432\u043e \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u0431\u043b\u043e\u043a, \u0437\u0430 \u0434\u0430 \u0433\u043e \u043f\u043e\u0441\u043e\u0447\u0438\u0442\u0435."
            ],
            "Ask": [
