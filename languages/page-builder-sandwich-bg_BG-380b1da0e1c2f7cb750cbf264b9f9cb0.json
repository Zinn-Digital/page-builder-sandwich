            ],
            "Describe a component (\"a team member card with photo, name, role and a short bio\"). It is saved to My patterns, with its texts editable on every page that uses it.": [
                "\u041e\u043f\u0438\u0448\u0435\u0442\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 (\u201e\u043a\u0430\u0440\u0442\u0430 \u043d\u0430 \u0447\u043b\u0435\u043d \u043d\u0430 \u0435\u043a\u0438\u043f\u0430 \u0441\u044a\u0441 \u0441\u043d\u0438\u043c\u043a\u0430, \u0438\u043c\u0435, \u0434\u043b\u044a\u0436\u043d\u043e\u0441\u0442 \u0438 \u043a\u0440\u0430\u0442\u043a\u0430 \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u201c). \u0422\u043e\u0439 \u0441\u0435 \u0437\u0430\u043f\u0430\u0437\u0432\u0430 \u0432 \u201e\u041c\u043e\u0438\u0442\u0435 \u0448\u0430\u0431\u043b\u043e\u043d\u0438\u201c, \u043a\u0430\u0442\u043e \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0435\u0442\u0435 \u043c\u0443 \u043c\u043e\u0433\u0430\u0442 \u0434\u0430 \u0441\u0435 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0430\u0442 \u043d\u0430 \u0432\u0441\u044f\u043a\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430, \u043a\u043e\u044f\u0442\u043e \u0433\u043e \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430."
            ],
            "Block created and added to the page.": [
                "\u0411\u043b\u043e\u043a\u044a\u0442 \u0435 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d \u0438 \u0434\u043e\u0431\u0430\u0432\u0435\u043d \u043a\u044a\u043c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0442\u0430."
            ],
            "Edit the block": [
