            ],
            "Edit the block": [
                "\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u0643\u0648\u0651\u0646"
            ],
            "Create block": [
                "\u0625\u0646\u0634\u0627\u0621 \u0643\u062a\u0644\u0629"
            ],
            "Design a page from a screenshot or a website address: AI recreates its layout as editable blocks in a new draft.": [
                "\u0635\u0645\u0645 \u0635\u0641\u062d\u0629 \u0645\u0646 \u0644\u0642\u0637\u0629 \u0634\u0627\u0634\u0629 \u0623\u0648 \u0639\u0646\u0648\u0627\u0646 \u0645\u0648\u0642\u0639 \u0648\u064a\u0628: \u064a\u0639\u064a\u062f \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0625\u0646\u0634\u0627\u0621 \u062a\u062e\u0637\u064a\u0637\u0647\u0627 \u0643\u0645\u0643\u0648\u0646\u0627\u062a \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u062d\u0631\u064a\u0631 \u0641\u064a \u0645\u0633\u0648\u062f\u0629 \u062c\u062f\u064a\u062f\u0629."
            ],
            "Draft page created.": [
