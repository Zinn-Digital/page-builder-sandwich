            ],
            "%1$d fixed, %2$d left for you. The page was saved; its previous version is in the revisions.": [
                "\u062a\u0645 \u0625\u0635\u0644\u0627\u062d %1$d\u060c \u0648\u062a\u0628\u0642\u0649 %2$d \u0644\u0643. \u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0635\u0641\u062d\u0629\u061b \u0646\u0633\u062e\u062a\u0647\u0627 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0627\u062a."
