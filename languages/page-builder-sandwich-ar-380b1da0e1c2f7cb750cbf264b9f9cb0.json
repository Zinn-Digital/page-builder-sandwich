            ],
            "Not done (%1$s): %2$s": [
                "\u0644\u0645 \u064a\u0646\u062a\u0647\u0650 (%1$s): %2$s"
            ],
            "Undo this change": [
                "\u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u062a\u063a\u064a\u064a\u0631"
            ],
            "What should change?": [
                "\u0645\u0627 \u0627\u0644\u0630\u064a \u064a\u062c\u0628 \u062a\u063a\u064a\u064a\u0631\u0647\u061f"
            ],
            "For example: \"make the hero shorter and friendlier\", \"add an FAQ about delivery after the pricing\", \"translate this section into Spanish\". Select a block first to point at it.": [
                "\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644: \"\u0627\u062c\u0639\u0644 \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0623\u0642\u0635\u0631 \u0648\u0623\u0643\u062b\u0631 \u0648\u062f\u064a\u0629\"\u060c \"\u0623\u0636\u0641 \u0642\u0633\u0645\u0627\u064b \u0644\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u062d\u0648\u0644 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0628\u0639\u062f \u0627\u0644\u0623\u0633\u0639\u0627\u0631\"\u060c \"\u062a\u0631\u062c\u0645 \u0647\u0630\u0627 \u0627\u0644\u0642\u0633\u0645 \u0625\u0644\u0649 \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629\". \u062d\u062f\u062f \u0643\u062a\u0644\u0629 \u0623\u0648\u0644\u0627\u064b \u0644\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u064a\u0647\u0627."
            ],
            "Ask": [
                "\u0627\u0633\u0623\u0644"
            ],
            "Build a website": [
                "\u0625\u0646\u0634\u0627\u0621 \u0645\u0648\u0642\u0639 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
            ],
            "Describe the business": [
                "\u0635\u0641 \u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
            ],
            "Plan the pages": [
