            "AI uses your own AI provider account. Connect one to start.": [
                "\u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u062d\u0633\u0627\u0628 \u0645\u0632\u0648\u062f \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0627\u0644\u062e\u0627\u0635 \u0628\u0643. \u0627\u0631\u0628\u0637 \u062d\u0633\u0627\u0628\u0627\u064b \u0644\u0644\u0628\u062f\u0621."
            ],
            "Set up AI": [
