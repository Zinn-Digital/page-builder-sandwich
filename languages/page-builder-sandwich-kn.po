msgstr "“%s” ಕುರಿತು ಹೊಸ ವಿಮರ್ಶೆ ಕಾಮೆಂಟ್"

#. translators: 1: commenter name, 2: comment, 3: editor link.
#: includes/pro__premium_only/workflow/class-review.php:387
#, php-format
msgid ""
"%1$s wrote:\n"
"\n"
"%2$s\n"
"\n"
