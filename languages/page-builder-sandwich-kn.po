#: src/admin/LegacyContent.js:150
msgid "Legacy content"
msgstr "ಹಳೆಯ ವಿಷಯಗಳು"

#: src/admin/LegacyContent.js:162
msgid "Pages made with earlier versions of Page Builder Sandwich are converted to blocks in the background. Every post is backed up first, so each conversion can be undone."
msgstr "ಹಿಂದಿನ ಆವೃತ್ತಿಯ Page Builder Sandwich ಬಳಸಿ ರಚಿಸಲಾದ ಪುಟಗಳನ್ನು ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಬ್ಲಾಕ್‌ಗಳಾಗಿ ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ. ಪ್ರತಿ ಪೋಸ್ಟ್‌ನ ಬ್ಯಾಕಪ್ ಅನ್ನು ಮೊತ್ತಮೊದಲಿಗೆ ಮಾಡಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಪ್ರತಿ ಪರಿವರ್ತನೆಯನ್ನು ರದ್ದುಗೊಳಿಸಬಹುದು."

