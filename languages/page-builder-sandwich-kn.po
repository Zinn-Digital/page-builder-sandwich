msgstr "ಬದಲಾಯಿಸಲು ಯಾವುದೇ ಭಾಷೆಗಳಿಲ್ಲ. ಅನುವಾದ ಪ್ಲಗಿನ್ ಎರಡು ಅಥವಾ ಹೆಚ್ಚಿನ ಭಾಷೆಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡಿದಾಗ ಸ್ವಿಚರ್ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ."

#: src/editor/index.js:78
msgid "Switcher"
msgstr "ಸ್ವಿಚರ್"

#: src/editor/index.js:81
msgid "Accessible label"
msgstr "ಪ್ರವೇಶಿಸಬಹುದಾದ ಲೇಬಲ್"

#: src/editor/index.js:89
msgid "Show the current language"
msgstr "ಪ್ರಸ್ತುತ ಭಾಷೆಯನ್ನು ತೋರಿಸಿ"

#: blocks/fixture-switcher/block.json
msgctxt "block title"
msgid "Language switcher (sample)"
msgstr "ಭಾಷಾ ಬದಲಾಯಿಸುವ ಸಾಧನ (ಮಾದರಿ)"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Lists the site's languages from the translation plugin, when one is active. It renders nothing otherwise."
msgstr "ಅನುವಾದ ಪ್ಲಗಿನ್ ಸಕ್ರಿಯವಾಗಿದ್ದಾಗ, ಸೈಟ್‌ನ ಭಾಷೆಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುತ್ತದೆ. ಇಲ್ಲದಿದ್ದರೆ ಏನನ್ನೂ ಪ್ರದರ್ಶಿಸುವುದಿಲ್ಲ."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "ಭಾಷೆ"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "ಸ್ವಿಚರ್"

#: blocks/fixture/block.json
msgctxt "block title"
msgid "Sample content"
msgstr "ಮಾದರಿ ವಿಷಯ"

#: blocks/fixture/block.json
msgctxt "block description"
msgid "A heading and a paragraph, rendered with neutral class names. It is the reference block for the translation contract."
msgstr "ತಟಸ್ಥ ವರ್ಗದ ಹೆಸರುಗಳೊಂದಿಗೆ ಪ್ರದರ್ಶಿಸಲಾದ ಶೀರ್ಷಿಕೆ ಮತ್ತು ಪ್ಯಾರಾಗ್ರಾಫ್. ಇದು ಅನುವಾದ ಒಪ್ಪಂದಕ್ಕಾಗಿ ಉಲ್ಲೇಖ ಬ್ಲಾಕ್ ಆಗಿದೆ."

#: blocks/fixture/block.json
msgctxt "block keyword"
msgid "sample"
msgstr "ಮಾದರಿ"

#: blocks/fixture/block.json
msgctxt "block keyword"
msgid "text"
msgstr "ಪಠ್ಯ"
