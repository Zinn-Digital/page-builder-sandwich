msgstr "ಬೀಟಾ ನವೀಕರಣಗಳು"

#: src/admin/App.js:136
msgid "This site receives beta versions as updates."
msgstr "ಈ ಸೈಟ್‌ಗೆ ನವೀಕರಣಗಳಾಗಿ ಬೀಟಾ ಆವೃತ್ತಿಗಳು ದೊರೆಯುತ್ತವೆ."

#: src/admin/App.js:140
msgid "This site receives stable versions only."
msgstr "ಈ ಸೈಟ್ ಸ್ಥಿರ ಆವೃತ್ತಿಗಳನ್ನು ಮಾತ್ರ ಸ್ವೀಕರಿಸುತ್ತದೆ."

#: src/admin/App.js:149
msgid "Change this on the Account page"
msgstr "ಇದನ್ನು ಖಾತೆ ಪುಟದಲ್ಲಿ ಬದಲಾಯಿಸಿ"

#: src/admin/App.js:158
msgid "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page."
msgstr "ಬೀಟಾ ಆವೃತ್ತಿಗಳನ್ನು ತಮ್ಮ ಖಾತೆಗೆ ಸಂಪರ್ಕಗೊಂಡಿರುವ ಪರವಾನಗಿ ಪಡೆದ ಪ್ರೊ ಅನುಸ್ಥಾಪನೆಗಳಿಗೆ ನೀಡಲಾಗುತ್ತದೆ. ಒಮ್ಮೆ ಸಂಪರ್ಕಗೊಂಡ ನಂತರ, ನೀವು ಖಾತೆ ಪುಟದಿಂದ ಸೇರಬಹುದು."

#: src/admin/Breakpoints.js:58
msgid "Breakpoints saved. Pages pick up the new widths on their next view."
msgstr "ಬ್ರೇಕ್‌ಪಾಯಿಂಟ್‌ಗಳನ್ನು ಉಳಿಸಲಾಗಿದೆ. ಪುಟಗಳು ತಮ್ಮ ಮುಂದಿನ ವೀಕ್ಷಣೆಯಲ್ಲಿ ಹೊಸ ಅಗಲಗಳನ್ನು ಅಳವಡಿಸಿಕೊಳ್ಳುತ್ತವೆ."

#: src/admin/Breakpoints.js:79
msgid "Breakpoints"
msgstr "ಬ್ರೇಕ್‌ಪಾಯಿಂಟ್‌ಗಳು"

#: src/admin/Breakpoints.js:94
msgid "Styles set for Tablet apply up to the tablet width, and styles set for Mobile up to the mobile width. Desktop styles apply everywhere else."
msgstr "ಟ್ಯಾಬ್ಲೆಟ್‌ಗಾಗಿ ಹೊಂದಿಸಲಾದ ಶೈಲಿಗಳು ಟ್ಯಾಬ್ಲೆಟ್ ಅಗಲದವರೆಗೆ ಅನ್ವಯಿಸುತ್ತವೆ ಮತ್ತು ಮೊಬೈಲ್‌ಗಾಗಿ ಹೊಂದಿಸಲಾದ ಶೈಲಿಗಳು ಮೊಬೈಲ್ ಅಗಲದವರೆಗೆ ಅನ್ವಯಿಸುತ್ತವೆ. ಡೆಸ್ಕ್‌ಟಾಪ್ ಶೈಲಿಗಳು ಉಳಿದ ಎಲ್ಲೆಡೆ ಅನ್ವಯಿಸುತ್ತವೆ."

#: src/admin/Breakpoints.js:102
msgid "Tablet: up to (px)"
msgstr "ಟ್ಯಾಬ್ಲೆಟ್: ವರೆಗೆ (px)"

#: src/admin/Breakpoints.js:115
msgid "Mobile: up to (px)"
msgstr "ಮೊಬೈಲ್: ವರೆಗೆ (px)"

#: src/admin/Breakpoints.js:146
msgid "Save breakpoints"
msgstr "ಬ್ರೇಕ್‌ಪಾಯಿಂಟ್‌ಗಳನ್ನು ಉಳಿಸಿ"

#: src/admin/Breakpoints.js:162
msgid "Use the default widths"
msgstr "ಪೂರ್ವನಿಯೋಜಿತ ಅಗಲಗಳನ್ನು ಬಳಸಿ"

#: src/admin/index.js:25
#: src/admin/index.js:32
msgid "Settings"
msgstr "ಸೆಟ್ಟಿಂಗ್‌ಗಳು"

#: src/admin/LegacyContent.js:21
msgid "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here."
msgstr "ಈ ಪೋಸ್ಟ್ ಅನ್ನು ಪರಿವರ್ತಿಸುವ ವಿನಂತಿಯು ಮುಗಿಯುವ ಮೊದಲೇ ನಿಂತುಹೋಗಿದೆ, ಆದ್ದರಿಂದ ಪೋಸ್ಟ್ ಅನ್ನು ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ. ಇದನ್ನು ಪರಿವರ್ತಿಸಲು ತೆರೆಯಿರಿ, ಅಥವಾ ಇಲ್ಲಿಂದ ಮತ್ತೆ ಪರಿವರ್ತಿಸಿ."

#: src/admin/LegacyContent.js:26
msgid "There is no backup of this post to restore."
msgstr "ಪುನಃಸ್ಥಾಪಿಸಲು ಈ ಪೋಸ್ಟ್‌ನ ಯಾವುದೇ ಬ್ಯಾಕಪ್ ಇಲ್ಲ."

#: src/admin/LegacyContent.js:31
msgid "The converted content could not be saved."
msgstr "ಮತಾಂತರಿಸಲಾದ ವಿಷಯವನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#: src/admin/LegacyContent.js:36
msgid "Unknown error."
msgstr "ಅಜ್ಞಾತ ದೋಷ."

#: src/admin/LegacyContent.js:50
msgid "No legacy content has been checked yet."
msgstr "ಯಾವುದೇ ಹಳೆಯ ವಿಷಯವನ್ನು ಇನ್ನೂ ಪರಿಶೀಲಿಸಲಾಗಿಲ್ಲ."

#. translators: 1: posts handled so far, 2: posts to handle.
#: src/admin/LegacyContent.js:59
#, js-format
msgid "Restoring legacy content: %1$d of %2$d posts."
msgstr "ಹಳೆಯ ವಿಷಯವನ್ನು ಮರುಸ್ಥಾಪಿಸಲಾಗುತ್ತಿದೆ: %1$d ರಲ್ಲಿ %2$d ಪೋಸ್ಟ್‌ಗಳು."

#. translators: 1: posts handled so far, 2: posts to handle.
#: src/admin/LegacyContent.js:68
#, js-format
msgid "Converting legacy content: %1$d of %2$d posts."
msgstr "ಹಳೆಯ ವಿಷಯವನ್ನು ಪರಿವರ್ತಿಸಲಾಗುತ್ತಿದೆ: %1$d ರಲ್ಲಿ %2$d ಪೋಸ್ಟ್‌ಗಳು."

#. translators: 1: posts restored, 2: posts that failed.
#: src/admin/LegacyContent.js:79
#, js-format
msgid "Undo finished: %1$d restored, %2$d failed."
msgstr "ರದ್ದುಗೊಳಿಸುವಿಕೆ ಮುಗಿದಿದೆ: %1$d ಮರುಸ್ಥಾಪಿಸಲಾಗಿದೆ, %2$d ವಿಫಲಗೊಂಡಿವೆ."

#. translators: 1: posts converted, 2: posts left as they were, 3: posts that failed.
#: src/admin/LegacyContent.js:88
#, js-format
msgid "Conversion finished: %1$d converted, %2$d unchanged, %3$d failed."
msgstr "ರೂಪಾಂತರ ಪೂರ್ಣಗೊಂಡಿದೆ: %1$d ರೂಪಾಂತರಿಸಲಾಗಿದೆ, %2$d ಬದಲಾಗಿಲ್ಲ, %3$d ವಿಫಲವಾಗಿದೆ."

#: src/admin/LegacyContent.js:150
msgid "Legacy content"
msgstr "ಹಳೆಯ ವಿಷಯಗಳು"

#: src/admin/LegacyContent.js:162
msgid "Pages made with earlier versions of Page Builder Sandwich are converted to blocks in the background. Every post is backed up first, so each conversion can be undone."
msgstr "ಹಿಂದಿನ ಆವೃತ್ತಿಯ Page Builder Sandwich ಬಳಸಿ ರಚಿಸಲಾದ ಪುಟಗಳನ್ನು ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಬ್ಲಾಕ್‌ಗಳಾಗಿ ಪರಿವರ್ತಿಸಲಾಗುತ್ತದೆ. ಪ್ರತಿ ಪೋಸ್ಟ್‌ನ ಬ್ಯಾಕಪ್ ಅನ್ನು ಮೊತ್ತಮೊದಲಿಗೆ ಮಾಡಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಪ್ರತಿ ಪರಿವರ್ತನೆಯನ್ನು ರದ್ದುಗೊಳಿಸಬಹುದು."

#. translators: %d: number of posts that still hold legacy content.
#: src/admin/LegacyContent.js:182
#, js-format
msgid "%d post still holds legacy content."
msgid_plural "%d posts still hold legacy content."
msgstr[0] "%d ಪೋಸ್ಟ್ ಇನ್ನೂ ಹಳೆಯ ವಿಷಯವನ್ನು ಹೊಂದಿದೆ."
msgstr[1] "%d ಪೋಸ್ಟ್‌ಗಳು ಇನ್ನೂ ಹಳೆಯದಾದ ವಿಷಯವನ್ನು ಹೊಂದಿವೆ."

#. translators: %d: number of posts with a backup.
#: src/admin/LegacyContent.js:192
#, js-format
msgid "%d post has a backup."
msgid_plural "%d posts have a backup."
msgstr[0] "%d ಪೋಸ್ಟ್ ಬ್ಯಾಕಪ್ ಹೊಂದಿದೆ."
msgstr[1] "%d ಪೋಸ್ಟ್‌ಗಳ ಬ್ಯಾಕಪ್ ಇದೆ."

#. translators: %d: number of posts that failed.
#: src/admin/LegacyContent.js:206
#, js-format
msgid "%d post could not be handled"
