msgstr ""
"%1$s ಬರೆದಿದ್ದಾರೆ:\n"
"\n"
"%2$s\n"
"\n"
"ಉತ್ತರಿಸಲು ಅಥವಾ ಪರಿಹರಿಸಲು ಪುಟವನ್ನು ಎಡಿಟರ್‌ನಲ್ಲಿ ತೆರೆಯಿರಿ:\n"
"%3$s"

#: includes/pro__premium_only/workflow/class-review.php:430
msgid "This review link is not valid any more. Ask for a new one."
msgstr "ಈ ವಿಮರ್ಶೆ ಲಿಂಕ್ ಇನ್ನು ಮುಂದೆ ಮಾನ್ಯವಾಗಿಲ್ಲ. ಹೊಸದೊಂದನ್ನು ಕೇಳಿ."

#: includes/pro__premium_only/workflow/class-review.php:436
msgid "Too many comments from this link in the last hour. Try again later."
msgstr "ಈ ಲಿಂಕ್‌ನಿಂದ ಕಳೆದ ಒಂದು ಗಂಟೆಯಲ್ಲಿ ಅತಿಯಾದ ಕಾಮೆಂಟ್‌ಗಳು ಬಂದಿವೆ. ಸ್ವಲ್ಪ ಸಮಯದ ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

#: includes/pro__premium_only/workflow/class-roles.php:234
msgid "Your role cannot create templates or patterns."
msgstr "ನಿಮ್ಮ ಪಾತ್ರವು ಟೆಂಪ್ಲೇಟ್‌ಗಳು ಅಥವಾ ಮಾದರಿಗಳನ್ನು ರಚಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."

#: includes/pro__premium_only/workflow/class-roles.php:312
msgid "You can change the text and images on this page, but not its layout or design. Your change was not saved."
msgstr "ನೀವು ಈ ಪುಟದಲ್ಲಿರುವ ಪಠ್ಯ ಮತ್ತು ಚಿತ್ರಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು, ಆದರೆ ಇದರ ವಿನ್ಯಾಸ ಅಥವಾ ರಚನೆಯನ್ನಲ್ಲ. ನಿಮ್ಮ ಬದಲಾವಣೆಯನ್ನು ಉಳಿಸಲಾಗಿಲ್ಲ."

#: includes/pro__premium_only/workflow/class-roles.php:317
msgid "Your role cannot change styles. Undo the style changes and save again."
msgstr "ನಿಮ್ಮ ಪಾತ್ರವು ಶೈಲಿಗಳನ್ನು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಶೈಲಿ ಬದಲಾವಣೆಗಳನ್ನು ಪೂರ್ವಸ್ಥಿತಿಗೆ ತಂದು (ಅಂಡೋ ಮಾಡಿ) ಮರುಸಂಗ್ರಹಿಸಿ."

#: includes/pro__premium_only/workflow/class-roles.php:320
msgid "Your role cannot add or change custom code (custom CSS or HTML blocks). Undo those changes and save again."
msgstr "ನಿಮ್ಮ ಪಾತ್ರವು ಕಸ್ಟಮ್ ಕೋಡ್ ಅನ್ನು (ಕಸ್ಟಮ್ CSS ಅಥವಾ HTML ಬ್ಲಾಕ್‌ಗಳು) ಸೇರಿಸಲು ಅಥವಾ ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಆ ಬದಲಾವಣೆಗಳನ್ನು ರದ್ದುಗೊಳಿಸಿ ಮತ್ತು ಮತ್ತೆ ಉಳಿಸಿ."

#: includes/workflow/class-transfer-routes.php:137
#: includes/workflow/class-transfer.php:282
msgid "This is not an export file from this plugin."
msgstr "ಇದು ಈ ಪ್ಲಗ್‌ಇನ್‌ನಿಂದ ರಫ್ತು ಮಾಡಿದ ಫೈಲ್ ಅಲ್ಲ."

#: includes/workflow/class-transfer.php:286
msgid "This export file was made by a newer version of the plugin. Update the plugin on this site, then import it again."
msgstr "ಈ ಎಕ್ಸ್‌ಪೋರ್ಟ್ ಫೈಲ್ ಪ್ಲಗಿನ್‌ನ ಹೊಸ ಆವೃತ್ತಿಯಿಂದ ಮಾಡಲ್ಪಟ್ಟಿದೆ. ಈ ಸೈಟ್‌ನಲ್ಲಿ ಪ್ಲಗಿನ್ ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ, ನಂತರ ಅದನ್ನು ಮತ್ತೆ ಇಂಪೋರ್ಟ್ ಮಾಡಿ."

#: includes/workflow/class-transfer.php:289
msgid "The export file is damaged: its list of items is missing."
msgstr "ರಫ್ತು ಫೈಲ್ ಹಾನಿಗೊಳಗಾಗಿದೆ: ಅದರ ಐಟಂಗಳ ಪಟ್ಟಿ ಕಾಣೆಯಾಗಿದೆ."

#: includes/workflow/class-transfer.php:292
msgid "The export file is damaged or was edited after it was made (its checksum does not match). Export it again from the other site."
msgstr "ರಫ್ತು ಫೈಲ್ ಹಾನಿಗೊಳಗಾಗಿದೆ ಅಥವಾ ಅದನ್ನು ರಚಿಸಿದ ನಂತರ ಸಂಪಾದಿಸಲಾಗಿದೆ (ಅದರ ಚೆಕ್‌ಸಮ್ ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ). ಇತರ ಸೈಟ್‌ನಿಂದ ಅದನ್ನು ಮತ್ತೆ ರಫ್ತು ಮಾಡಿ."

#. translators: %s: item name from the export file.
#: includes/workflow/class-transfer.php:337
#, php-format
msgid "“%s” was not imported: this site does not have that kind of item."
msgstr "“%s” ಆಮದು ಮಾಡಿಕೊಳ್ಳಲಾಗಿಲ್ಲ: ಈ ಸೈಟ್‌ನಲ್ಲಿ ಆ ರೀತಿಯ ಐಟಂ ಇಲ್ಲ."

#. translators: %s: item name from the export file.
#: includes/workflow/class-transfer.php:343
#, php-format
msgid "“%s” was not imported: you are not allowed to create that kind of item."
msgstr "“%s” ಆಮದು ಮಾಡಿಕೊಳ್ಳಲಾಗಿಲ್ಲ: ಆ ರೀತಿಯ ಐಟಂ ಅನ್ನು ರಚಿಸಲು ನಿಮಗೆ ಅನುಮತಿ ಇಲ್ಲ."

#. translators: %s: item name from the export file.
#: includes/workflow/class-transfer.php:354
#, php-format
msgid "“%s” was not replaced: you are not allowed to edit the one on this site."
msgstr "“%s” ಬದಲಾಯಿಸಲಾಗಿಲ್ಲ: ಈ ಸೈಟ್‌ನಲ್ಲಿರುವದನ್ನು ಸಂಪಾದಿಸಲು ನಿಮಗೆ ಅನುಮತಿಯಿಲ್ಲ."

#. translators: 1: item name from the export file, 2: the reason.
#: includes/workflow/class-transfer.php:374
#, php-format
msgid "“%1$s” was not imported: %2$s"
msgstr "“%1$s” ಅನ್ನು ಆಮದು ಮಾಡಿಕೊಳ್ಳಲಾಗಿಲ್ಲ: %2$s"

#: includes/workflow/class-transfer.php:382
msgid "Settings were not imported: only an administrator can change them."
msgstr "ಸಂಯೋಜನೆಗಳನ್ನು ಆಮದು ಮಾಡಲಾಗಿಲ್ಲ: ಒಬ್ಬ ನಿರ್ವಾಹಕರು ಮಾತ್ರ ಅವುಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು."

#. translators: 1: image address, 2: the reason.
#: includes/workflow/class-transfer.php:555
#, php-format
msgid "The image %1$s was not copied: %2$s"
msgstr "ಚಿತ್ರ %1$s ಅನ್ನು ನಕಲು ಮಾಡಲಾಗಿಲ್ಲ: %2$s"

