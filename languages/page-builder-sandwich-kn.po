msgstr "ಈ ಪೋಸ್ಟ್ ಅನ್ನು ಪರಿವರ್ತಿಸುವ ವಿನಂತಿಯು ಮುಗಿಯುವ ಮೊದಲೇ ನಿಂತುಹೋಗಿದೆ, ಆದ್ದರಿಂದ ಪೋಸ್ಟ್ ಅನ್ನು ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ. ಇದನ್ನು ಪರಿವರ್ತಿಸಲು ತೆರೆಯಿರಿ, ಅಥವಾ ಇಲ್ಲಿಂದ ಮತ್ತೆ ಪರಿವರ್ತಿಸಿ."

#: src/admin/LegacyContent.js:26
msgid "There is no backup of this post to restore."
msgstr "ಪುನಃಸ್ಥಾಪಿಸಲು ಈ ಪೋಸ್ಟ್‌ನ ಯಾವುದೇ ಬ್ಯಾಕಪ್ ಇಲ್ಲ."

#: src/admin/LegacyContent.js:31
msgid "The converted content could not be saved."
msgstr "ಮತಾಂತರಿಸಲಾದ ವಿಷಯವನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."

#: src/admin/LegacyContent.js:36
msgid "Unknown error."
msgstr "ಅಜ್ಞಾತ ದೋಷ."

#: src/admin/LegacyContent.js:50
msgid "No legacy content has been checked yet."
msgstr "ಯಾವುದೇ ಹಳೆಯ ವಿಷಯವನ್ನು ಇನ್ನೂ ಪರಿಶೀಲಿಸಲಾಗಿಲ್ಲ."

#. translators: 1: posts handled so far, 2: posts to handle.
#: src/admin/LegacyContent.js:59
#, js-format
msgid "Restoring legacy content: %1$d of %2$d posts."
msgstr "ಹಳೆಯ ವಿಷಯವನ್ನು ಮರುಸ್ಥಾಪಿಸಲಾಗುತ್ತಿದೆ: %1$d ರಲ್ಲಿ %2$d ಪೋಸ್ಟ್‌ಗಳು."

#. translators: 1: posts handled so far, 2: posts to handle.
#: src/admin/LegacyContent.js:68
#, js-format
msgid "Converting legacy content: %1$d of %2$d posts."
msgstr "ಹಳೆಯ ವಿಷಯವನ್ನು ಪರಿವರ್ತಿಸಲಾಗುತ್ತಿದೆ: %1$d ರಲ್ಲಿ %2$d ಪೋಸ್ಟ್‌ಗಳು."

