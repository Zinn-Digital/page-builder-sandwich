msgstr[1] "%d ಪೋಸ್ಟ್‌ಗಳು ಇನ್ನೂ ಹಳೆಯದಾದ ವಿಷಯವನ್ನು ಹೊಂದಿವೆ."

#. translators: %d: number of posts with a backup.
#: src/admin/LegacyContent.js:192
#, js-format
msgid "%d post has a backup."
msgid_plural "%d posts have a backup."
msgstr[0] "%d ಪೋಸ್ಟ್ ಬ್ಯಾಕಪ್ ಹೊಂದಿದೆ."
msgstr[1] "%d ಪೋಸ್ಟ್‌ಗಳ ಬ್ಯಾಕಪ್ ಇದೆ."

