msgstr "Polje forme nema oznaku, tako da njegova svrha nije najavljena."

#: src/design/a11y/checks.js:585
msgid "This heading is empty. Screen reader users navigate by headings; remove it or add text."
msgstr "Ovaj naslov je prazan. Korisnici čitača ekrana navigiraju pomoću naslova; uklonite ga ili dodajte tekst."

#: src/design/a11y/checks.js:599
msgid "The page title is already the H1; use H2 for the top level of the content."
msgstr "Naslov stranice je već H1; koristite H2 za najviši nivo sadržaja."

