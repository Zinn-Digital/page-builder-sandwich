msgstr "Importimi do të japë: %s."

#. translators: %s: a list such as "2 new, 1 replaced".
#: src/workflow/transfer-lib.js:101
#, js-format
msgid "Imported: %s."
msgstr "Importuar: %s."

#. translators: %d: number of items exported.
#: src/workflow/TransferPanel.js:72
#, js-format
msgid "Exported %d item."
msgid_plural "Exported %d items."
msgstr[0] "U eksportua %d artikull."
msgstr[1] "U eksportuan %d artikuj."

#: src/workflow/TransferPanel.js:129
msgid "That file could not be read as an export file."
msgstr "Ky skedar nuk mund të lexohej si një skedar eksporti."

#: src/workflow/TransferPanel.js:139
msgid "Import and export"
msgstr "Importo dhe eksporto"

#: src/workflow/TransferPanel.js:157
msgid "Export"
msgstr "Eksporto"

#: src/workflow/TransferPanel.js:159
msgid "Download your templates, patterns and site design as one file, to import on another site."
msgstr "Shkarkoni shabllonet, modelet dhe dizajnin e faqes tuaj si një skedar i vetëm, për ta importuar në një faqe tjetër."

#: src/workflow/TransferPanel.js:167
msgid "There are no templates or patterns to export yet."
msgstr "Nuk ka ende shabllone ose modele për të eksportuar."

#: src/workflow/TransferPanel.js:187
msgid "Include the settings"
msgstr "Përfshi cilësimet"

#: src/workflow/TransferPanel.js:197
msgid "Download the export file"
msgstr "Shkarko skedarin e eksportit"

#: src/workflow/TransferPanel.js:200
#: src/workflow/TransferPanel.js:296
msgid "Import"
msgstr "Importo"

#: src/workflow/TransferPanel.js:207
msgid "Choose an export file"
msgstr "Zgjidhni një skedar eksporti"

#. translators: 1: number of items in the file, 2: the site it came from.
#: src/workflow/TransferPanel.js:219
#, js-format
msgid "The file holds %1$d item from %2$s."
msgid_plural "The file holds %1$d items from %2$s."
msgstr[0] "Skedari përmban %1$d element nga %2$s."
msgstr[1] "Skedari përmban %1$d elemente nga %2$s."

#: src/workflow/TransferPanel.js:230
msgid "When an item with the same name already exists here"
msgstr "Kur një artikull me të njëjtin emër ekziston tashmë këtu"

#: src/workflow/TransferPanel.js:238
msgid "Keep the one on this site"
msgstr "Mbajeni atë në këtë sajt"

#: src/workflow/TransferPanel.js:245
msgid "Replace it with the imported one"
msgstr "Zëvendësoje me atë të importuarën"

#: src/workflow/TransferPanel.js:252
msgid "Import a copy beside it"
msgstr "Importo një kopje pranë tij"

#: src/workflow/TransferPanel.js:262
msgid "Apply the settings in the file"
msgstr "Zbato cilësimet në skedar"

#: src/workflow/TransferPanel.js:271
msgid "Copy the images into this site’s media library"
msgstr "Kopjoni imazhet në bibliotekën mediatike të kësaj faqeje"

#: src/workflow/TransferPanel.js:285
msgid "Show what will happen"
msgstr "Trego çfarë do të ndodhë"

