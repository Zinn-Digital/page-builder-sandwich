            "Replace the API key": [
                "\u66ff\u6362 API \u5bc6\u94a5"
            ],
            "Where to find your %s API key": [
                "\u4f55\u5904\u67e5\u627e\u60a8\u7684 %s API \u5bc6\u94a5"
            ],
            "Check and save": [
                "\u68c0\u67e5\u5e76\u4fdd\u5b58"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u53ea\u9700\u8fde\u63a5\u4e00\u6b21\u90ae\u4ef6\u5217\u8868\u670d\u52a1\uff1b\u4e4b\u540e\u4efb\u4f55\u8868\u5355\u90fd\u53ef\u4ee5\u5c06\u586b\u5199\u8be5\u8868\u5355\u7684\u7528\u6237\u6dfb\u52a0\u5230\u60a8\u7684\u67d0\u4e2a\u5217\u8868\u4e2d\uff08\u8868\u5355\u533a\u5757\u8bbe\u7f6e \u2192 \u53d1\u9001\u540e\uff09\u3002\u5bc6\u94a5\u5df2\u7531\u8be5\u670d\u52a1\u9a8c\u8bc1\uff0c\u52a0\u5bc6\u5b58\u50a8\u5728\u6b64\u7f51\u7ad9\u4e0a\uff0c\u4e14\u7edd\u4e0d\u4f1a\u518d\u6b21\u663e\u793a\u3002"
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u65e0\u9700\u4ee3\u7801\u5373\u53ef\u5c06\u8868\u5355\u63d0\u4ea4\u548c\u6309\u94ae\u70b9\u51fb\u53d1\u9001\u5230\u60a8\u7684\u5206\u6790\u4e2d\u3002\u5c06 ID \u7559\u7a7a\u53ef\u8df3\u8fc7\u8be5\u670d\u52a1\u3002\u6309\u94ae\u5728\u5176\u201c\u9ad8\u7ea7\u201d\u9762\u677f\u4e2d\u4f1a\u83b7\u5f97\u4e00\u4e2a\u201c\u8f6c\u5316\u4e8b\u4ef6\u201d\u5b57\u6bb5\u3002\u5728 Cookie \u6a2a\u5e45\u5f00\u542f\u7684\u60c5\u51b5\u4e0b\uff0c\u5728\u8bbf\u95ee\u8005\u540c\u610f\u4e4b\u524d\u4e0d\u4f1a\u52a0\u8f7d\u4efb\u4f55\u5185\u5bb9\u3002"
            ],
            "Google Analytics 4 measurement ID": [
                "Google Analytics 4 \u8861\u91cf ID"
            ],
            "Google Tag Manager container ID": [
                "Google Tag Manager \u5bb9\u5668 ID"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "Meta Pixel ID\uff08Meta \u4e8b\u4ef6\u7ba1\u7406\u5de5\u5177\u4e2d\u663e\u793a\u7684\u7f16\u53f7\uff09"
            ],
            "Load these tags on my site": [
                "\u5728\u6211\u7684\u7ad9\u70b9\u4e0a\u52a0\u8f7d\u8fd9\u4e9b\u6807\u7b7e"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u5982\u679c\u60a8\u7684\u4e3b\u9898\u6216\u5176\u4ed6\u63d2\u4ef6\u5df2\u6dfb\u52a0\u5b83\u4eec\uff0c\u8bf7\u5c06\u5176\u5173\u95ed\uff1b\u4e8b\u4ef6\u4ecd\u4f1a\u53d1\u9001\u3002"
            ],
            "Event name for form submissions": [
                "\u8868\u5355\u63d0\u4ea4\u7684\u4e8b\u4ef6\u540d\u79f0"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u6a2a\u5e45\u662f\u60a8\u4f7f\u7528\u533a\u5757\u8bbe\u8ba1\u7684\u5f39\u51fa\u7a97\u53e3\u3002\u5176\u6309\u94ae\u94fe\u63a5\u81f3 #consent-accept\u3001#consent-reject \u548c #consent-save\uff08\u9488\u5bf9\u201csave\u201d\u63d0\u4f9b\u540d\u4e3a analytics \u548c marketing \u7684\u590d\u9009\u6846\uff09\uff1b\u4efb\u4f55\u4f4d\u7f6e\u6307\u5411 #consent-open \u7684\u94fe\u63a5\u90fd\u4f1a\u518d\u6b21\u663e\u793a\u8be5\u6a2a\u5e45\u3002\u5728\u8bbf\u5ba2\u63a5\u53d7\u4e4b\u524d\uff0c\u8ddf\u8e2a\u4ee3\u7801\u4e0d\u4f1a\u52a0\u8f7d\uff0cGoogle Consent Mode \u4fdd\u6301\u4e3a\u201cdenied\u201d\uff0c\u5e76\u4e14\u60a8\u5217\u51fa\u7684\u811a\u672c\u4fdd\u6301\u5173\u95ed\u72b6\u6001\u3002"
            ],
            "Create a ready-made banner": [
                "\u521b\u5efa\u73b0\u6210\u6a2a\u5e45"
            ],
            "Show a cookie banner": [
                "\u663e\u793a Cookie \u6a2a\u5e45"
            ],
            "Banner": [
                "\u6a2a\u5e45"
            ],
            "Choose a popup\u2026": [
                "\u9009\u62e9\u4e00\u4e2a\u5f39\u51fa\u7a97\u53e3\u2026"
            ],
            "%s (draft)": [
                "%s (\u8349\u7a3f)"
            ],
            "Edit the banner": [
                "\u7f16\u8f91\u6a2a\u5e45"
            ],
            "Remember the choice for (days)": [
                "\u8bb0\u4f4f\u9009\u62e9 (\u5929)"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u6b27\u76df\u3001\u6b27\u6d32\u7ecf\u6d4e\u533a\u548c\u82f1\u56fd\u5883\u5916\uff1a\u52a0\u8f7d\u8ddf\u8e2a\uff0c\u76f4\u81f3\u8bbf\u95ee\u8005\u62d2\u7edd"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u5173\u95ed\uff1a\u6bcf\u4f4d\u8bbf\u5ba2\u5fc5\u987b\u9996\u5148\u540c\u610f\uff08\u6700\u4e25\u683c\u7684\u89c4\u5219\uff0c\u4e5f\u662f\u9ed8\u8ba4\u8bbe\u7f6e\uff09\u3002\u5f00\u542f\uff1a\u4ec5\u5f53\u60a8\u7684\u4e3b\u673a\u6216 CDN \u62a5\u544a\u8bbf\u5ba2\u7684\u56fd\u5bb6\/\u5730\u533a\uff08\u4f8b\u5982 Cloudflare \u7684 CF-IPCountry \u6807\u5934\uff09\u4e14\u8be5\u56fd\u5bb6\/\u5730\u533a\u4f4d\u4e8e EU\u3001EEA\u3001\u82f1\u56fd\u548c\u745e\u58eb\u5883\u5916\u65f6\u3002\u6a2a\u5e45\u4ecd\u4f1a\u663e\u793a\uff0c\u672a\u77e5\u56fd\u5bb6\/\u5730\u533a\u5c06\u88ab\u89c6\u4e3a\u4f4d\u4e8e EU \u5883\u5185\u3002"
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u5728\u83b7\u5f97\u540c\u610f\u524d\u4fdd\u7559\u7684\u5176\u4ed6\u811a\u672c\uff08handle:analytics \u6216 handle:marketing\uff0c\u4ee5\u9017\u53f7\u5206\u9694\uff09"
            ],
            "Popups, slide-ins and bars": [
                "\u5f39\u7a97\u3001\u6d6e\u7a97\u548c\u6a2a\u5e45\u680f"
            ],
            "A\/B test results": [
                "A\/B \u6d4b\u8bd5\u7ed3\u679c"
            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u6307\u5357\uff1a\u8868\u5355\u3001\u5f39\u51fa\u7a97\u53e3\u3001\u52a8\u6001\u6548\u679c\u3001\u8ddf\u8e2a\u3001A\/B \u6d4b\u8bd5\u548c Cookie \u6a2a\u5e45"
            ],
            "Mailing-list connections": [
                "\u90ae\u4ef6\u5217\u8868\u8fde\u63a5"
            ]
        }
    }
