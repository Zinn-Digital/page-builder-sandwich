            ],
            "Your theme\u2019s palette. A change here is saved as your site\u2019s version of the colour, the same way the Site Editor saves it, and applies everywhere the colour is used.": [
                "\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca5\u0cc0\u0cae\u0ccd\u200c\u0ca8 \u0caa\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd. \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0ca6 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0caf\u0cc1 \u0cb8\u0cc8\u0c9f\u0ccd \u0c8e\u0ca1\u0cbf\u0c9f\u0cb0\u0ccd \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5 \u0cb0\u0cc0\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cc7 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cc8\u0c9f\u0ccd\u200c\u0ca8 \u0cac\u0ca3\u0ccd\u0ca3\u0ca6 \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0ccd\u0caa\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cac\u0ca3\u0ccd\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0cb5 \u0c8e\u0cb2\u0ccd\u0cb2\u0cc6\u0ca1\u0cc6 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6."
            ],
