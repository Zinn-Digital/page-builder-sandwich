#: src/design/a11y/Checker.js:76
#, js-format
msgid "Make it H%d"
msgstr "H%d ஆக மாற்றுங்கள்"

#: src/design/a11y/Checker.js:89
msgid "Alt text"
msgstr "மாற்று உரை"

#: src/design/a11y/Checker.js:103
msgid "Save alt text"
msgstr "மாற்று உரையைச் சேமிக்கவும்"

#: src/design/a11y/Checker.js:107
msgid "This image is decorative"
msgstr "இந்த படம் அலங்காரமானது"

#: src/design/a11y/Checker.js:163
msgid "Checking…"
msgstr "சரிபார்க்கிறது…"

#: src/design/a11y/Checker.js:173
msgid "No accessibility problems found on this page."
msgstr "இந்தப் பக்கத்தில் எந்த அணுக்கத்தன்மை சிக்கல்களும் கண்டறியப்படவில்லை."

#. translators: 1: number of problems, 2: number of things to check.
#: src/design/a11y/Checker.js:179
#, js-format
msgid "%1$s, %2$s."
msgstr "%1$s, %2$s."

#. translators: %d: number of problems.
#: src/design/a11y/Checker.js:182
#, js-format
msgid "%d problem"
msgid_plural "%d problems"
msgstr[0] "%d சிக்கல்"
msgstr[1] "%d சிக்கல்கள்"

#. translators: %d: number of things to check.
#: src/design/a11y/Checker.js:192
#, js-format
msgid "%d thing to check"
msgid_plural "%d things to check"
msgstr[0] "%d சரிபார்க்க வேண்டிய விஷயம்"
msgstr[1] "சோதிக்க வேண்டிய %d விஷயங்கள்"

#: src/design/a11y/Checker.js:203
msgid "Check again"
msgstr "மீண்டும் சரிபார்க்கவும்"

#: src/design/a11y/Checker.js:226
msgid "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader."
msgstr "தானியங்கி சோதனை பல சிக்கல்களைக் கண்டறிகிறது, ஆனால் அனைத்தையுமல்ல. விசைப்பலகையை மட்டும் கொண்டும், திரை வாசிப்பானைக் கொண்டும் பக்கத்தைச் சோதித்துப் பார்க்கவும்."

#. translators: 1: measured contrast ratio, 2: required ratio.
#: src/design/a11y/checks.js:340
#, js-format
msgid "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable."
msgstr "உரையின் மாறுபாடு %1$s:1 ஆகும்; படிக்கக்கூடியதாக இருக்கக் குறைந்தது %2$s:1 தேவைப்படுகிறது."

#: src/design/a11y/checks.js:354
msgid "click here,here,read more,more,link,this link,learn more,go"
msgstr "இங்கே சொடுக்கவும்,இங்கே,மேலும் வாசிக்க,மேலும்,இணைப்பு,இந்த இணைப்பு,மேலும் அறிய,செல்"

#: src/design/a11y/checks.js:386
msgid "A link has no text, so a screen reader announces only “link”. Add text or a label."
msgstr "ஒரு இணைப்பில் உரை இல்லை, எனவே திரை வாசிப்பான் \"link\" என்று மட்டுமே அறிவிக்கும். உரையை அல்லது லேபிளைச் சேர்க்கவும்."

#. translators: %s: the link text.
#: src/design/a11y/checks.js:401
#, js-format
msgid "The link text “%s” does not say where it goes. Describe the destination instead."
msgstr "\"%s\" என்ற இணைப்பு உரை அது எங்கு செல்கிறது என்பதைக் கூறவில்லை. அதற்குப் பதிலாக இலக்கைத் விவரிக்கவும்."

#: src/design/a11y/checks.js:440
msgid "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it."
msgstr "ஒரு உறுப்பு நேர்மறையான tabindex-ஐக் கொண்டுள்ளது, இது விசைப்பலகை வரிசையை வாசிப்பு வரிசையிலிருந்து மாற்றுகிறது. 0 ஐப் பயன்படுத்தவும் அல்லது அதை அகற்றவும்."

#: src/design/a11y/checks.js:456
msgid "Something clickable cannot be reached with the keyboard. Use a real button or link."
msgstr "கிளிக் செய்யக்கூடிய ஒன்றை விசைப்பலகை மூலம் அடைய முடியாது. உண்மையான பொத்தான் அல்லது இணைப்பைப் பயன்படுத்தவும்."

#: src/design/a11y/checks.js:474
msgid "An embedded frame has no title, so a screen reader cannot say what it is."
msgstr "உட்பொதிக்கப்பட்ட சட்டத்திற்கு தலைப்பு இல்லை, எனவே ஸ்கிரீன் ரீடரால் அது என்ன என்பதைச் சொல்ல முடியாது."

#: src/design/a11y/checks.js:527
msgid "A form field has no label, so its purpose is not announced."
msgstr "படிவப் புலத்தில் லேபிள் இல்லை, எனவே அதன் நோக்கம் அறிவிக்கப்படவில்லை."

#: src/design/a11y/checks.js:585
msgid "This heading is empty. Screen reader users navigate by headings; remove it or add text."
msgstr "இந்தத் தலைப்பு காலியாக உள்ளது. திரை வாசகப் பயனர்கள் தலைப்புகள் மூலம் உலாவுவார்கள்; அதை அகற்றவும் அல்லது உரையையும் சேர்க்கவும்."

#: src/design/a11y/checks.js:599
msgid "The page title is already the H1; use H2 for the top level of the content."
msgstr "பக்கத் தலைப்பு ஏற்கனவே H1 ஆகும்; உள்ளடக்கத்தின் மேல் மட்டத்திற்கு H2 ஐப் பயன்படுத்தவும்."

#. translators: 1: this heading's level, 2: the level before it, 3: the level it should be.
#: src/design/a11y/checks.js:617
#, js-format
msgid "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d."
msgstr "இந்த H%1$d ஒரு நிலையைத் தவிர்க்கிறது; அதற்கு முந்தையது H%2$d ஆகும். இதை H%3$d ஆக மாற்றவும்."

#: src/design/a11y/checks.js:656
msgid "This image has no alt text. Describe it, or mark it as decorative if it adds nothing."
msgstr "இந்தப் படத்திற்கு ஆல்ட் உரை இல்லை. இதை விவரிக்கவும், அல்லது இது எதையும் சேர்க்கவில்லை என்றால் அலங்காரமானதாகக் குறிக்கவும்."

