            ],
            "Where to find your %s API key": [
                "\u0e27\u0e34\u0e18\u0e35\u0e04\u0e49\u0e19\u0e2b\u0e32\u0e04\u0e35\u0e22\u0e4c API %s \u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13"
            ],
            "Check and save": [
                "\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e41\u0e25\u0e30\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e23\u0e32\u0e22\u0e0a\u0e37\u0e48\u0e2d\u0e2d\u0e35\u0e40\u0e21\u0e25\u0e40\u0e1e\u0e35\u0e22\u0e07\u0e04\u0e23\u0e31\u0e49\u0e07\u0e40\u0e14\u0e35\u0e22\u0e27 \u0e08\u0e32\u0e01\u0e19\u0e31\u0e49\u0e19\u0e41\u0e1a\u0e1a\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e43\u0e14\u0e01\u0e47\u0e44\u0e14\u0e49\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1c\u0e39\u0e49\u0e04\u0e19\u0e17\u0e35\u0e48\u0e01\u0e23\u0e2d\u0e01\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e25\u0e07\u0e43\u0e19\u0e23\u0e32\u0e22\u0e0a\u0e37\u0e48\u0e2d\u0e43\u0e14\u0e23\u0e32\u0e22\u0e0a\u0e37\u0e48\u0e2d\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e44\u0e14\u0e49 (\u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e1a\u0e25\u0e47\u0e2d\u0e01\u0e41\u0e1a\u0e1a\u0e1f\u0e2d\u0e23\u0e4c\u0e21 \u2192 \u0e2b\u0e25\u0e31\u0e07\u0e01\u0e32\u0e23\u0e2a\u0e48\u0e07) \u0e04\u0e35\u0e22\u0e4c\u0e08\u0e30\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e01\u0e31\u0e1a\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23 \u0e08\u0e31\u0e14\u0e40\u0e01\u0e47\u0e1a\u0e41\u0e1a\u0e1a\u0e40\u0e02\u0e49\u0e32\u0e23\u0e2b\u0e31\u0e2a\u0e1a\u0e19\u0e40\u0e27\u0e47\u0e1a\u0e44\u0e0b\u0e15\u0e4c\u0e19\u0e35\u0e49 \u0e41\u0e25\u0e30\u0e08\u0e30\u0e44\u0e21\u0e48\u0e41\u0e2a\u0e14\u0e07\u0e2d\u0e35\u0e01\u0e40\u0e25\u0e22"
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u0e2a\u0e48\u0e07\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e17\u0e35\u0e48\u0e2a\u0e48\u0e07\u0e41\u0e25\u0e30\u0e04\u0e25\u0e34\u0e01\u0e1b\u0e38\u0e48\u0e21\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e21\u0e37\u0e2d\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e42\u0e14\u0e22\u0e44\u0e21\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e40\u0e02\u0e35\u0e22\u0e19\u0e42\u0e04\u0e49\u0e14 \u0e40\u0e27\u0e49\u0e19 ID \u0e27\u0e48\u0e32\u0e07\u0e44\u0e27\u0e49\u0e2b\u0e32\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e02\u0e49\u0e32\u0e21\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23\u0e19\u0e31\u0e49\u0e19 \u0e1b\u0e38\u0e48\u0e21\u0e08\u0e30\u0e21\u0e35\u0e1f\u0e34\u0e25\u0e14\u0e4c \"Conversion event\" \u0e43\u0e19\u0e1e\u0e32\u0e40\u0e19\u0e25 Advanced \u0e40\u0e21\u0e37\u0e48\u0e2d\u0e40\u0e1b\u0e34\u0e14\u0e41\u0e1a\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c\u0e04\u0e38\u0e01\u0e01\u0e35\u0e49 \u0e08\u0e30\u0e44\u0e21\u0e48\u0e21\u0e35\u0e01\u0e32\u0e23\u0e42\u0e2b\u0e25\u0e14\u0e2a\u0e34\u0e48\u0e07\u0e43\u0e14\u0e08\u0e19\u0e01\u0e27\u0e48\u0e32\u0e1c\u0e39\u0e49\u0e40\u0e22\u0e35\u0e48\u0e22\u0e21\u0e0a\u0e21\u0e08\u0e30\u0e22\u0e34\u0e19\u0e22\u0e2d\u0e21"
            ],
            "Google Analytics 4 measurement ID": [
                "\u0e23\u0e2b\u0e31\u0e2a\u0e01\u0e32\u0e23\u0e27\u0e31\u0e14\u0e1c\u0e25 Google Analytics 4"
            ],
            "Google Tag Manager container ID": [
                "ID \u0e04\u0e2d\u0e19\u0e40\u0e17\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c Google Tag Manager"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "Meta Pixel ID (\u0e15\u0e31\u0e27\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48\u0e41\u0e2a\u0e14\u0e07\u0e43\u0e19 Meta Events Manager)"
            ],
            "Load these tags on my site": [
                "\u0e42\u0e2b\u0e25\u0e14\u0e41\u0e17\u0e47\u0e01\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49\u0e1a\u0e19\u0e40\u0e27\u0e47\u0e1a\u0e44\u0e0b\u0e15\u0e4c\u0e02\u0e2d\u0e07\u0e09\u0e31\u0e19"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e2b\u0e32\u0e01\u0e18\u0e35\u0e21\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e2b\u0e23\u0e37\u0e2d\u0e1b\u0e25\u0e31\u0e4a\u0e01\u0e2d\u0e34\u0e19\u0e2d\u0e37\u0e48\u0e19\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2a\u0e34\u0e48\u0e07\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49\u0e2d\u0e22\u0e39\u0e48\u0e41\u0e25\u0e49\u0e27 \u0e40\u0e2b\u0e15\u0e38\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e15\u0e48\u0e32\u0e07\u0e46 \u0e08\u0e30\u0e22\u0e31\u0e07\u0e04\u0e07\u0e16\u0e39\u0e01\u0e2a\u0e48\u0e07\u0e44\u0e1b"
            ],
            "Event name for form submissions": [
                "\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e2b\u0e15\u0e38\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e2a\u0e48\u0e07\u0e1f\u0e2d\u0e23\u0e4c\u0e21"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0e41\u0e1a\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c\u0e04\u0e37\u0e2d\u0e1b\u0e4a\u0e2d\u0e1b\u0e2d\u0e31\u0e1b\u0e17\u0e35\u0e48\u0e04\u0e38\u0e13\u0e2d\u0e2d\u0e01\u0e41\u0e1a\u0e1a\u0e14\u0e49\u0e27\u0e22\u0e1a\u0e25\u0e47\u0e2d\u0e01 \u0e1b\u0e38\u0e48\u0e21\u0e15\u0e48\u0e32\u0e07\u0e46 \u0e08\u0e30\u0e25\u0e34\u0e07\u0e01\u0e4c\u0e44\u0e1b\u0e17\u0e35\u0e48 #consent-accept, #consent-reject \u0e41\u0e25\u0e30 #consent-save (\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e0a\u0e48\u0e2d\u0e07\u0e17\u0e33\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e2b\u0e21\u0e32\u0e22\u0e0a\u0e37\u0e48\u0e2d analytics \u0e41\u0e25\u0e30 marketing \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a \"save\") \u0e2a\u0e48\u0e27\u0e19\u0e25\u0e34\u0e07\u0e01\u0e4c\u0e44\u0e1b\u0e17\u0e35\u0e48 #consent-open \u0e17\u0e35\u0e48\u0e43\u0e14\u0e01\u0e47\u0e15\u0e32\u0e21\u0e08\u0e30\u0e41\u0e2a\u0e14\u0e07\u0e41\u0e1a\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c\u0e19\u0e31\u0e49\u0e19\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07 \u0e08\u0e19\u0e01\u0e27\u0e48\u0e32\u0e1c\u0e39\u0e49\u0e40\u0e22\u0e35\u0e48\u0e22\u0e21\u0e0a\u0e21\u0e08\u0e30\u0e22\u0e2d\u0e21\u0e23\u0e31\u0e1a \u0e41\u0e17\u0e47\u0e01\u0e01\u0e32\u0e23\u0e15\u0e34\u0e14\u0e15\u0e32\u0e21\u0e08\u0e30\u0e44\u0e21\u0e48\u0e42\u0e2b\u0e25\u0e14 \u0e42\u0e2b\u0e21\u0e14\u0e04\u0e27\u0e32\u0e21\u0e22\u0e34\u0e19\u0e22\u0e2d\u0e21\u0e02\u0e2d\u0e07 Google \u0e08\u0e30\u0e22\u0e31\u0e07\u0e04\u0e07\u0e40\u0e1b\u0e47\u0e19 \"\u0e1b\u0e0f\u0e34\u0e40\u0e2a\u0e18\" \u0e41\u0e25\u0e30\u0e2a\u0e04\u0e23\u0e34\u0e1b\u0e15\u0e4c\u0e17\u0e35\u0e48\u0e04\u0e38\u0e13\u0e23\u0e30\u0e1a\u0e38\u0e44\u0e27\u0e49\u0e08\u0e30\u0e22\u0e31\u0e07\u0e04\u0e07\u0e1b\u0e34\u0e14\u0e2d\u0e22\u0e39\u0e48"
            ],
            "Create a ready-made banner": [
                "\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e41\u0e1a\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08\u0e23\u0e39\u0e1b"
            ],
            "Show a cookie banner": [
                "\u0e41\u0e2a\u0e14\u0e07\u0e41\u0e1a\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c\u0e04\u0e38\u0e01\u0e01\u0e35\u0e49"
            ],
            "Banner": [
                "\u0e41\u0e1a\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c"
            ],
            "Choose a popup\u2026": [
                "\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e1b\u0e4a\u0e2d\u0e1b\u0e2d\u0e31\u0e1b\u2026"
            ],
            "%s (draft)": [
                "%s (\u0e09\u0e1a\u0e31\u0e1a\u0e23\u0e48\u0e32\u0e07)"
            ],
            "Edit the banner": [
                "\u0e41\u0e01\u0e49\u0e44\u0e02\u0e41\u0e1a\u0e19\u0e40\u0e19\u0e2d\u0e23\u0e4c"
            ],
            "Remember the choice for (days)": [
                "\u0e08\u0e14\u0e08\u0e33\u0e15\u0e31\u0e27\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e44\u0e27\u0e49\u0e40\u0e1b\u0e47\u0e19\u0e40\u0e27\u0e25\u0e32 (days) \u0e27\u0e31\u0e19"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u0e19\u0e2d\u0e01\u0e2a\u0e2b\u0e20\u0e32\u0e1e\u0e22\u0e38\u0e42\u0e23\u0e1b EEA \u0e41\u0e25\u0e30\u0e2a\u0e2b\u0e23\u0e32\u0e0a\u0e2d\u0e32\u0e13\u0e32\u0e08\u0e31\u0e01\u0e23: \u0e15\u0e34\u0e14\u0e15\u0e32\u0e21\u0e01\u0e32\u0e23\u0e42\u0e2b\u0e25\u0e14\u0e08\u0e19\u0e01\u0e27\u0e48\u0e32\u0e1c\u0e39\u0e49\u0e40\u0e02\u0e49\u0e32\u0e0a\u0e21\u0e08\u0e30\u0e1b\u0e0f\u0e34\u0e40\u0e2a\u0e18"
