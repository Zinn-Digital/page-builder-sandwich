            ],
            "Connected (key %s).": [
                "\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e41\u0e25\u0e49\u0e27 (\u0e04\u0e35\u0e22\u0e4c %s)"
            ],
            "API URL": [
                "URL \u0e02\u0e2d\u0e07 API"
            ],
            "Replace the API key": [
