            ],
            "Amazon S3 uses virtual-hosted addresses: switch off \u201cPath-style addresses\u201d. Most other services use path-style.": [
                "Amazon S3 \u043d\u044c \u0432\u0438\u0440\u0442\u0443\u0430\u043b \u0431\u0430\u0439\u0440\u0448\u0443\u0443\u043b\u0441\u0430\u043d \u0445\u0430\u044f\u0433\u0443\u0443\u0434\u044b\u0433 \u0430\u0448\u0438\u0433\u043b\u0430\u0434\u0430\u0433: \u201cPath-style addresses\u201d-\u0438\u0439\u0433 \u0443\u043d\u0442\u0440\u0430\u0430. \u0411\u0443\u0441\u0430\u0434 \u0438\u0445\u044d\u043d\u0445 \u04af\u0439\u043b\u0447\u0438\u043b\u0433\u044d\u044d \u043d\u044c path-style \u0430\u0448\u0438\u0433\u043b\u0430\u0434\u0430\u0433."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d.": [
                "\u0414\u043e\u043e\u0440\u0445 \u0443\u0442\u0433\u0443\u0443\u0434\u044b\u0433 \u0431\u0443\u0443\u043b\u0433\u0430\u0436 \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0430\u0434, \u201c\u0425\u043e\u043b\u0431\u043e\u043b\u0442\u044b\u0433 \u0448\u0430\u043b\u0433\u0430\u0445\u201d \u0442\u043e\u0432\u0447\u0438\u0439\u0433 \u0434\u0430\u0440\u043d\u0430 \u0443\u0443."
            ],
            "Storage settings saved.": [
                "\u0425\u0434\u04e9\u0445 \u0441\u0430\u043d\u0433\u0438\u0439\u043d \u0442\u043e\u0445\u0438\u0440\u0433\u043e\u043e\u0433 \u0445\u0430\u0434\u0447\u0438\u0445\u0430\u0432."
