msgstr "ይህ አልተሳካም። እንደገና ይሞክሩ።"

#: src/admin-kit/Support.js:204
msgid "Zinn Digital® support disconnected this site."
msgstr "Zinn Digital® ድጋፍ ይህንንድ ጣቢያ አቋርጦታል።"

#: src/admin-kit/Support.js:208
msgid "Zinn Digital® support no longer recognises this site."
msgstr "Zinn Digital® ድጋፍ ይህንን ጣቢያ ከእንግዲህ አይገነዘበውም።"

#: src/admin-kit/Support.js:212
msgid "You disconnected this site."
msgstr "ይህንን ድር ጣቢያ አቋርጠውታል።"

#: src/admin-kit/Support.js:219
msgid "Connect this site to support"
msgstr "ይህንን ድረ-ገጽ ከድጋፍ አገልግሎት ጋር ያገናኙት"

#. translators: %s: e-mail address.
#: src/admin-kit/Support.js:234
#, js-format
msgid "Connected. Replies go to %s."
msgstr "ተገናኝቷል። መልሶች ወደ %s ይሄዳሉ።"

#: src/admin-kit/Support.js:261
msgid "Not connected. You can still send a request with your e-mail address below; connecting saves typing it each time."
msgstr "አልተገናኘም። ከዚህ በታች ባለው የኢሜይል አድራሻዎ ጥያቄ መላክ ይችላሉ፤ ማገናኘት እያንዳንዱን ጊዜ መፃፍን ያስቀራል።"

#: src/admin-kit/Support.js:269
msgid "E-mail address"
msgstr "የኢሜይል አድራሻ"

#: src/admin-kit/Support.js:275
#: src/admin-kit/Support.js:479
msgid "Your name (optional)"
msgstr "የእርስዎ ስም (አማራጭ)"

#: src/admin-kit/Support.js:283
msgid "I agree to connect this site to Zinn Digital® support. It sends this site’s address, WordPress and PHP versions and the plugin version, and can be disconnected at any time from here or by Zinn Digital®."
msgstr "ይህንን ድረ-ገጽ ከ Zinn Digital® ድጋፍ ጋር ለማገናኘት እስማማለሁ። ይህ የድረ-ገጹን አድራሻ፣ የ WordPress እና PHP ስሪቶችን እንዲሁም የፕለጊን ስሪት ይልካል፣ እና በማንኛውም ጊዜ ከዚህ ወይም በ Zinn Digital® ሊቋረጥ ይችላል።"

#: src/admin-kit/Support.js:303
msgid "Connect"
msgstr "አገናኝ"

#: src/admin-kit/Support.js:332
msgid "I need help"
msgstr "እርዳታ እፈልጋለሁ"

#: src/admin-kit/Support.js:333
msgid "Report a bug"
msgstr "ሳንካ ሪፖርት ያድርጉ"

#: src/admin-kit/Support.js:338
msgid "Send feedback"
msgstr "feedback ላክ"

#: src/admin-kit/Support.js:342
msgid "Request a feature"
msgstr "አዲስ ባህሪ ይጠይቁ"

#: src/admin-kit/Support.js:364
msgid "The site details could not be read."
msgstr "የጣቢያው ዝርዝሮች ሊነበቡ አልቻሉም።"

#: src/admin-kit/Support.js:407
msgid "Your request could not be sent. Try again in a few minutes."
msgstr "ጥያቄዎ ሊላክ አልቻለም። ከጥቂት ደቂቃዎች በኋላ እንደገና ይሞክሩ።"

#: src/admin-kit/Support.js:418
msgid "WordPress admin"
msgstr "የWordPress አስተዳዳሪ"

#: src/admin-kit/Support.js:421
msgid "File manager"
msgstr "የፋይል አስተዳዳሪ"

#: src/admin-kit/Support.js:423
msgid "cPanel"
msgstr "cPanel"

#: src/admin-kit/Support.js:424
msgid "FTP / SFTP"
msgstr "ኤፍቲፒ / ኤስኤፍቲፒ"

#: src/admin-kit/Support.js:434
msgid "Feedback and feature requests"
msgstr "ግብረ መልስ እና የባህሪ ጥያቄዎች"

#. translators: %s: request reference, e.g. ZT-ABC234.
#: src/admin-kit/Support.js:445
#, js-format
msgid "Sent. Your reference is %s, and our reply will come by e-mail."
msgstr "ተልኳል። የእርስዎ ማጣቀሻ %s ነው፣ እና መልሳችን በኢሜይል ይመጣል።"

#: src/admin-kit/Support.js:465
msgid "What is it about?"
msgstr "ስለ ምን ጉዳይ ነው?"

#: src/admin-kit/Support.js:473
msgid "Reply to (e-mail)"
msgstr "ለ(ኢሜይል) መልስ ይስጡ"

#: src/admin-kit/Support.js:485
msgid "Subject"
msgstr "ርዕሰ ጉዳይ"

#: src/admin-kit/Support.js:493
msgid "What did you do, what did you expect, and what happened instead?"
msgstr "ምን አደረጉ፣ ምንስ ጠበቁ፣ በምትኩስ ምን ተፈጠረ?"

#: src/admin-kit/Support.js:506
msgid "Include site details (versions, theme, plugins, error log excerpt)"
msgstr "የድር ጣቢያ ዝርዝሮችን አካትት (ስሪቶች፣ ገጽታ፣ ተሰኪዎች፣ የስህተት ምዝግብ ማስታወሻ ቅንጭብጭብ)"

#: src/admin-kit/Support.js:523
msgid "See exactly what is sent"
msgstr "ምን በትክክል እንደሚላክ ይመልከቱ"

#: src/admin-kit/Support.js:530
msgid "Loading…"
msgstr "በመጫን ላይ…"

#: src/admin-kit/Support.js:536
msgid "Logins for support (optional, stored encrypted)"
msgstr "ለድጋፍ የሚደረጉ መግቢያዎች ( አማራጭ፣ በተመሰጠረ መልኩ የተቀመጡ)"

#: src/admin-kit/Support.js:542
msgid "A login is only sent with its password. Leave a row out rather than half-filled."
msgstr "የመግቢያ ስም የሚላከው ከየይለፍ ቃሉ ጋር ብቻ ነው። ግማሹን ከመሙላት ይልቅ ረድፉን ባዶ ይተዉት።"

#: src/admin-kit/Support.js:560
msgid "Login address"
msgstr "የግባ አድራሻ"

#: src/admin-kit/Support.js:571
msgid "Username"
msgstr "የተጠቃሚ ስም"

#: src/admin-kit/Support.js:584
msgid "Password"
msgstr "የሚስጥር ቃል"

#: src/admin-kit/Support.js:619
msgid "Add a login"
msgstr "መግቢያ ጨምር"

#: src/admin-kit/Support.js:626
msgid "Create a temporary support login"
msgstr "ጊዜያዊ የድጋፍ መግቢያ ይፍጠሩ"

#: src/admin-kit/Support.js:630
msgid "A separate user for our support team, without access to users, plugins installation or code editing. It is deleted automatically when it expires, or whenever you revoke it below."
msgstr "ለድጋፍ ቡድናችን የተለየ ተጠቃሚ፣ የተጠቃሚዎች፣ የፕለጊኖች ጭነት ወይም የኮድ ማስተካከያ መዳረሻ የሌለው። ጊዜው ሲያልፍ ወይም ከዚህ በታች በሰረዙት ቁጥር በራስ-ሰር ይጠፋል።"

#. translators: %d: number of days.
#: src/admin-kit/Support.js:645
#, js-format
msgid "Yes, for %d day"
msgid_plural "Yes, for %d days"
msgstr[0] "አዎ፣ ለ%d ቀን"
msgstr[1] "አዎ፣ ለ%d ቀናት"

#: src/admin-kit/Support.js:669
msgid "Send"
msgstr "ላክ"

#: src/admin-kit/Support.js:694
msgid "The list could not be loaded."
msgstr "ዝርዝሩን መጫን አልተቻለም።"

#: src/admin-kit/Support.js:709
msgid "That login could not be removed."
msgstr "የዚያን መግቢያ ማስወገድ አልተቻለም።"

#: src/admin-kit/Support.js:721
msgid "Temporary support logins"
msgstr "ጊዜያዊ የድጋፍ መግቢያዎች"

#: src/admin-kit/Support.js:733
msgid "None. Support can only log in to this site if you create a login here."
msgstr "ምንም የለም። እዚህ መግቢያ (ሎጊን) ከፈጠሩ ብቻ የድጋፍ ሰጪ ቡድኑ ወደዚህ ሳይት መግባት ይችላሉ።"

#: src/admin-kit/Support.js:745
msgid "expired, being removed"
msgstr "ጊዜው ያለፈበት፣ እየተወገደ ነው።"

#. translators: %s: date and time.
#: src/admin-kit/Support.js:751
#, js-format
msgid "expires %s"
msgstr "እ.ኤ.አ. %s ይጸናል"

#: src/admin-kit/Support.js:764
msgid "Revoke now"
msgstr "አሁን ሰርዝ"

#. translators: 1: this step, 2: number of steps.
#: src/admin-kit/Tour.js:98
#, js-format
msgid "Step %1$d of %2$d"
msgstr "እርምጃ %1$d ከ %2$d"

#: src/admin-kit/Tour.js:109
msgid "Close the tour"
msgstr "ጉብኝቱን ዝጋ"

#: src/admin-kit/Tour.js:116
#: src/admin-kit/Wizard.js:114
msgid "Back"
msgstr "ወደ ኋላ"

#: src/admin-kit/tours.js:13
msgid "Everything in one place"
msgstr "ሁሉም ነገር በአንድ ቦታ ላይ"

#: src/admin-kit/tours.js:14
msgid "These tabs lead to every screen of the plugin: setup, settings, your licence, help and more."
msgstr "እነዚህ  ትሮች የሰኪውን እያንዳንዱ ማያ ገጽ ይመራሉ፡ ማዋቀር፣ ቅንብሮች፣ ፈቃድዎ፣ እርዳታ እና ሌሎችም።"

#: src/admin-kit/tours.js:21
msgid "Help on every screen"
msgstr "በእያንዳንዱ ስክሪን ላይ እገዛ"

#: src/admin-kit/tours.js:22
msgid "Open this menu for the guide to the screen you are on, this tour, or to ask us for help."
msgstr "በአሁኑ ጊዜ ባሉበት ማያ ገጽ ላይ የሚገኘውን መመሪያ፣ ይህንን ጉብኝት ለማግኘት ወይም እርዳታ ለመጠየቅ ይህንን ምናሌ ይክፈቱ።"

#: src/admin-kit/tours.js:29
msgid "Light or dark"
msgstr "ቀላል ወይም ጠቆር ያለ"

#: src/admin-kit/tours.js:30
msgid "Choose light, dark, or the same as your computer. Your choice is remembered for you only."
msgstr "ቀላል፣ ጨለማ፣ ወይም ከኮምፒውተርዎ ጋር ተመሳሳይ የሆነ ይምረጡ። የእርስዎ ምርጫ የሚታወሰው ለእርስዎ ብቻ ነው።"

#: src/admin-kit/tours.js:39
#: src/admin-kit/Wizard.js:41
msgid "Welcome"
msgstr "እንኳን ደህና መጡ"

#: src/admin-kit/tours.js:40
msgid "This short tour shows where things are. You can leave it at any time with Escape."
msgstr "ይህ አጭር ጉብኝት ነገሮች የት እንዳሉ ያሳያል። በማንኛውም ጊዜ በ Escape ሊተዉት ይችላሉ።"

#: src/admin-kit/tours.js:48
msgid "Your site at a glance"
msgstr "የእርስዎ ድር ጣቢያ በጨረፍታ"

#: src/admin-kit/tours.js:49
msgid "Setup progress and your plan are shown here, with the next thing worth doing."
msgstr "የማዋቀር ሂደትዎ እና ዕቅድዎ እዚህ ይታያሉ፣ ከቀጣዩ ሊሠሩት ከሚገባው ጠቃሚ ነገር ጋር።"

#: src/admin-kit/tours.js:61
msgid "Your plan, how many sites it covers, and whether this copy of the site counts toward that limit."
msgstr "የእርስዎ እቅድ፣ ምን ያህል ድር ጣቢያዎችን እንደሚሸፍን፣ እና የዚህ የድር ጣቢያ ቅጂ ለዚያ ገደብ ይቆጠር እንደሆነ።"

#: src/admin-kit/tours.js:68
msgid "Try Pro or upgrade"
msgstr "Pro ይሞክሩ ወይም ያሻሽሉ"

#: src/admin-kit/tours.js:69
msgid "Start a free trial without a card, upgrade, or renew, all from here."
msgstr "ያለ ካርድ ነፃ የሙከራ ጊዜ ይጀምሩ፣ ያሻሽሉ፣ ወይም ያድሱ፣ ሁሉም ከዚህ።"

#: src/admin-kit/tours.js:77
msgid "Every feature and the plan that includes it. Search for a feature or show one area at a time."
msgstr "ሁሉም ባህሪ እና ያንን የያዘው እቅድ። ባህሪ ይፈልጉ ወይም በአንድ ጊዜ አንድ አካባቢ ያሳዩ።"

#: src/admin-kit/tours.js:86
msgid "More from Zinn Digital®"
msgstr "ከ Zinn Digital® ተጨማሪ"

#: src/admin-kit/tours.js:87
msgid "Plugins that work with this one, and services from the same team. Cards you hid on other screens can be shown again here."
msgstr "ከዚህ ጋር የሚሰሩ ተሰኪዎች እና ከተመሳሳይ ቡድን የተገኙ አገልግሎቶች። በሌሎች ስክሪኖች ላይ የደበቁዋቸው ካርዶች እዚህ ሊታዩ ይችላሉ።"

#: src/admin-kit/tours.js:96
msgid "Connect for faster help"
msgstr "ለፈጣን እርዳታ ይገናኙ"

#: src/admin-kit/tours.js:97
msgid "Connecting is optional. It lets you send requests without typing your e-mail each time, and you can disconnect whenever you like."
msgstr "ግንኙነት መመስረት አማራጭ ነው። እያንዳንዱን ጊዜ ኢሜይልዎን ሳይተይቡ ጥያቄዎችን እንዲልኩ ያስችልዎታል፣ እና በሚፈልጉበት ጊዜ ማቋረጥ ይችላሉ።"

#: src/admin-kit/tours.js:104
msgid "Ask for help or report a bug"
msgstr "እርዳታ ይጠይቁ ወይም ጉድለት ሪፖርት ያድርጉ"

#: src/admin-kit/tours.js:105
msgid "Describe what happened. You choose whether to attach site information, and you can see exactly what it contains first."
msgstr "ምን እንደተፈጸመ ይግለጹ። የጣቢያ መረጃ ማያያዝ አለማያያዝ እርስዎ ይመርጣሉ፣ እና መጀመሪያ ምን እንደያዘ በትክክል ማየት ይችላሉ።"

#: src/admin-kit/tours.js:112
msgid "Temporary support access"
msgstr "ጊዜያዊ የድጋፍ መዳረሻ"

#: src/admin-kit/tours.js:113
msgid "If support needs to look inside your site, create a temporary login here. It deletes itself when it expires, and you can remove it at any time."
