    "locale_data": {
        "messages": {
            "": {
                "domain": "messages",
                "lang": "am",
                "plural-forms": "nplurals=2; plural=(n > 1);"
            },
            "Import and export": [
                "\u12a0\u1235\u1218\u1323 \u12a5\u1293 \u120b\u12ad"
            ],
            "Import": [
                "\u12a0\u1235\u1308\u1263"
            ],
            "%d new": [
                "%d \u12a0\u12f2\u1235",
                "%d \u12a0\u12f2\u1235"
            ],
            "%d replaced": [
                "%d \u1270\u1270\u12ad\u1277\u120d",
                "%d \u1270\u1270\u12ad\u1277\u120d"
            ],
            "%d kept as they were": [
                "%d \u12a5\u1295\u12f0\u1290\u1260\u1229 \u1270\u12ed\u12d8\u12cb\u120d",
                "%d \u12a5\u1295\u12f0\u1290\u1260\u1229 \u1270\u12ed\u12d8\u12cb\u120d"
            ],
            "%d setting": [
                "%d \u1245\u1295\u1265\u122d",
                "%d \u1245\u1295\u1265\u122e\u127d"
            ],
            "Importing will give: %s.": [
                "\u121b\u1235\u1308\u1263\u1275 \u12e8\u121a\u12a8\u1270\u1208\u12cd\u1295 \u12ed\u1230\u1323\u120d\u1361 %s\u1362"
            ],
            "Imported: %s.": [
                "\u12e8\u1308\u1263\u12cd\u1366 %s\u1362"
            ],
            "Exported %d item.": [
                "%d \u1295\u1325\u120d \u12c8\u12f0 \u12cd\u132d \u1270\u120d\u12b3\u120d\u1362",
                "%d \u12a5\u1243\u12ce\u127d \u1270\u120d\u12a8\u12cb\u120d\u1362"
            ],
            "That file could not be read as an export file.": [
                "\u12ed\u1205 \u134b\u12ed\u120d \u12a5\u1295\u12f0 \u1218\u120b\u12aa\u12eb (\u12a4\u12ad\u1235\u1356\u122d\u1275) \u134b\u12ed\u120d \u120a\u1290\u1260\u1265 \u12a0\u120d\u127b\u1208\u121d\u1362"
            ],
            "Export": [
                "\u120b\u12ad"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u12e8\u12a5\u122d\u1235\u12ce\u1295 \u12a0\u1265\u1290\u1276\u127d\u1363 \u1245\u122d\u133e\u127d \u12a5\u1293 \u12e8\u12f5\u122d \u1323\u1262\u12eb \u1295\u12f5\u134d \u1260\u120c\u120b \u1323\u1262\u12eb \u120b\u12ed \u1208\u121b\u1235\u1308\u1263\u1275 \u12a5\u1295\u12f0 \u12a0\u1295\u12f5 \u134b\u12ed\u120d \u12eb\u12cd\u122d\u12f1\u1362"
            ],
            "There are no templates or patterns to export yet.": [
                "\u12a5\u1235\u12ab\u1201\u1295 \u12e8\u121a\u12c8\u1321 \u12a0\u1265\u1290\u1276\u127d \u12c8\u12ed\u121d \u1245\u1326\u127d \u12e8\u1209\u121d\u1362"
            ],
            "Include the settings": [
                "\u1245\u1295\u1265\u122e\u127d\u1295 \u12a0\u12ab\u1275\u1275"
            ],
            "Download the export file": [
                "\u12e8\u121b\u1235\u1218\u1323\u1275 \u134b\u12ed\u1209\u1295 \u12eb\u12cd\u122d\u12f1"
            ],
            "Choose an export file": [
                "\u12e8\u12a4\u12ad\u1235\u1356\u122d\u1275 \u134b\u12ed\u120d \u12ed\u121d\u1228\u1321"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u134b\u12ed\u1209 \u12a8 %2$s %1$d \u1295\u1325\u120d \u12ed\u12df\u120d\u1362",
                "\u134b\u12ed\u1209 \u12a8 %2$s %1$d \u12a5\u1243\u12ce\u127d\u1295 \u12ed\u12ed\u12db\u120d\u1362"
            ],
            "When an item with the same name already exists here": [
                "\u12a5\u12da\u1205 \u120b\u12ed \u1270\u1218\u1233\u1233\u12ed \u1235\u121d \u12eb\u1208\u12cd \u1295\u1325\u120d \u1240\u12f5\u121e\u12cd\u1291 \u1232\u1296\u122d"
            ],
            "Keep the one on this site": [
                "\u1260\u12da\u1205 \u1323\u1262\u12eb \u120b\u12ed \u12eb\u1208\u12cd\u1295 \u12eb\u1235\u1240\u121d\u1321"
            ],
            "Replace it with the imported one": [
                "\u1260\u1308\u1261\u1275 \u1260\u1218\u1270\u12ab\u1275"
            ],
            "Import a copy beside it": [
                "\u1245\u1302\u12cd\u1295 \u12a8\u130e\u1291 \u12a0\u1235\u1218\u1323\u12cd"
            ],
            "Apply the settings in the file": [
                "\u1260\u134b\u12ed\u1209 \u12cd\u1235\u1325 \u12eb\u1209\u1275\u1295 \u1245\u1295\u1265\u122e\u127d \u12ed\u1270\u130d\u1265\u1229"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u121d\u1235\u120e\u1279\u1295 \u12c8\u12f0\u12da\u1205 \u12f5\u1228-\u1308\u133d \u12e8\u121a\u12f2\u12eb \u121b\u12d5\u12a8\u1208-\u1235\u12d5\u120b\u1275 \u1245\u12f3\u1278\u12cd"
            ],
            "Show what will happen": [
                "\u121d\u1295 \u12a5\u1295\u12f0\u121a\u1206\u1295 \u12a0\u1233\u12ed"
            ]
        }
    }
}
