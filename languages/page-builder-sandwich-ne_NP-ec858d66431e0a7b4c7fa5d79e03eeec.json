        "messages": {
            "": {
                "domain": "messages",
                "lang": "ne_NP",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Import and export": [
                "\u0906\u092f\u093e\u0924 \u0930 \u0928\u093f\u0930\u094d\u092f\u093e\u0924"
            ],
            "Import": [
                "\u0906\u092f\u093e\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "%d new": [
                "%d \u0928\u092f\u093e\u0901",
                "%d \u0928\u092f\u093e\u0901"
            ],
            "%d replaced": [
                "%d \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u0917\u0930\u093f\u092f\u094b",
                "%d \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u0928 \u0917\u0930\u093f\u092f\u094b"
            ],
            "%d kept as they were": [
                "%d \u091c\u0938\u094d\u0924\u093e\u0915\u094b \u0924\u0938\u094d\u0924\u0948 \u0930\u093e\u0916\u093f\u092f\u094b",
                "%d \u0935\u091f\u093e \u091c\u0938\u094d\u0924\u093e\u0915\u094b \u0924\u0938\u094d\u0924\u0948 \u0930\u093e\u0916\u093f\u092f\u094b"
            ],
            "%d setting": [
                "%d \u0938\u0947\u091f\u093f\u0919",
                "%d \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942"
            ],
            "Importing will give: %s.": [
                "\u0906\u092f\u093e\u0924 \u0917\u0930\u094d\u0926\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u0941\u0928\u0947\u091b: %s\u0964"
            ],
            "Imported: %s.": [
                "\u0906\u092f\u093e\u0924 \u0917\u0930\u093f\u092f\u094b: %s."
            ],
            "Exported %d item.": [
                "%d \u0935\u0938\u094d\u0924\u0941 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0917\u0930\u093f\u092f\u094b\u0964",
                "%d \u0935\u0938\u094d\u0924\u0941\u0939\u0930\u0942 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0917\u0930\u093f\u092f\u094b\u0964"
            ],
            "That file could not be read as an export file.": [
                "\u0924\u094d\u092f\u094b \u092b\u093e\u0907\u0932\u0932\u093e\u0908 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 (export) \u092b\u093e\u0907\u0932\u0915\u094b \u0930\u0942\u092a\u092e\u093e \u092a\u0922\u094d\u0928 \u0938\u0915\u093f\u090f\u0928\u0964"
            ],
            "Export": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0905\u0930\u094d\u0915\u094b \u0938\u093e\u0907\u091f\u092e\u093e \u0906\u092f\u093e\u0924 \u0917\u0930\u094d\u0928\u0915\u093e \u0932\u093e\u0917\u093f \u0906\u092b\u094d\u0928\u093e \u091f\u0947\u092e\u094d\u092a\u094d\u0932\u0947\u091f\u0939\u0930\u0942, \u0922\u093e\u0901\u091a\u093e\u0939\u0930\u0942 \u0930 \u0938\u093e\u0907\u091f\u0915\u094b \u0921\u093f\u091c\u093e\u0907\u0928\u0932\u093e\u0908 \u090f\u0909\u091f\u0948 \u092b\u093e\u0907\u0932\u0915\u094b \u0930\u0942\u092a\u092e\u093e \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"
            ],
            "There are no templates or patterns to export yet.": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0917\u0930\u094d\u0928\u0915\u093e \u0932\u093e\u0917\u093f \u0905\u0939\u093f\u0932\u0947\u0938\u092e\u094d\u092e \u0915\u0941\u0928\u0948 \u091f\u0947\u092e\u094d\u092a\u094d\u0932\u0947\u091f \u0935\u093e \u0922\u093e\u0901\u091a\u093e\u0939\u0930\u0942 \u091b\u0948\u0928\u0928\u094d\u0964"
            ],
            "Include the settings": [
                "\u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942 \u0938\u092e\u093e\u0935\u0947\u0936 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Download the export file": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093e\u0907\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Choose an export file": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093e\u0907\u0932 \u0930\u094b\u091c\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u092f\u0938 \u092b\u093e\u0907\u0932\u092e\u093e %2$s \u092c\u093e\u091f %1$d \u0935\u0938\u094d\u0924\u0941 \u091b\u0964",
                "\u092b\u093e\u0907\u0932\u092e\u093e %2$s \u092c\u093e\u091f %1$d \u0935\u091f\u093e \u0935\u0938\u094d\u0924\u0941\u0939\u0930\u0942 \u091b\u0928\u094d\u0964"
            ],
            "When an item with the same name already exists here": [
                "\u091c\u092c \u0909\u0939\u0940 \u0928\u093e\u092e\u0915\u094b \u0935\u0938\u094d\u0924\u0941 \u092f\u0939\u093e\u0901 \u092a\u0939\u093f\u0932\u0947 \u0928\u0948 \u0905\u0935\u0938\u094d\u0925\u093f\u0924 \u0939\u0941\u0928\u094d\u091b"
            ],
            "Keep the one on this site": [
                "\u092f\u094b \u0938\u093e\u0907\u091f\u092e\u093e \u0930\u0939\u0947\u0915\u094b \u0930\u093e\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Replace it with the imported one": [
                "\u092f\u0938\u0932\u093e\u0908 \u0906\u092f\u093e\u0924 \u0917\u0930\u093f\u090f\u0915\u094b\u0938\u0901\u0917 \u092c\u0926\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Import a copy beside it": [
                "\u092f\u0938\u0915\u094b \u091b\u0947\u0909\u092e\u093e \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u0906\u092f\u093e\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Apply the settings in the file": [
                "\u092b\u093e\u0907\u0932\u092e\u093e \u092d\u090f\u0915\u093e \u0938\u0947\u091f\u093f\u0919\u0939\u0930\u0942 \u0932\u093e\u0917\u0942 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u091b\u0935\u093f\u0939\u0930\u0942\u0932\u093e\u0908 \u092f\u094b \u0938\u093e\u0907\u091f\u0915\u094b \u092e\u093f\u0921\u093f\u092f\u093e \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940\u092e\u093e \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d"
            ],
            "Show what will happen": [
                "\u0915\u0947 \u0939\u0941\u0928\u0947\u091b \u0926\u0947\u0916\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d"
            ]
        }
    }
}
