                "\u0938\u092e\u094d\u092a\u093e\u0926\u0915\u092c\u093e\u091f \u0915\u0941\u0928\u0948 \u092a\u0928\u093f \u0916\u0923\u094d\u0921 \u0935\u093e \u092a\u0943\u0937\u094d\u0920 \u092c\u091a\u0924 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d: \u092c\u094d\u0932\u0915\u0915\u094b \u22ee \u092e\u0947\u0928\u0941 \u0916\u094b\u0932\u094d\u0928\u0941\u0939\u094b\u0938\u094d \u0930 \u201cSave to cloud library\u201d \u091a\u092f\u0928 \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \u0938\u092e\u094d\u092a\u093e\u0926\u0915\u0915\u094b Cloud library \u092a\u094d\u092f\u093e\u0928\u0932\u092c\u093e\u091f \u092c\u091a\u0924 \u0917\u0930\u093f\u090f\u0915\u093e \u0921\u093f\u091c\u093e\u0907\u0928\u0939\u0930\u0942 \u0906\u092b\u094d\u0928\u093e \u0915\u0941\u0928\u0948 \u092a\u0928\u093f \u0938\u093e\u0907\u091f\u0939\u0930\u0942\u092e\u093e \u0918\u0941\u0938\u093e\u0909\u0928\u0941\u0939\u094b\u0938\u094d\u0964"
