            "Load these tags on my site": [
                "\u092e\u093e\u091d\u094d\u092f\u093e \u0938\u093e\u0907\u091f\u0935\u0930 \u0939\u0947 \u091f\u0945\u0917\u094d\u091c \u0932\u094b\u0921 \u0915\u0930\u093e"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0924\u0941\u092e\u091a\u0940 \u0925\u0940\u092e \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u0938\u0930\u0947 \u092a\u094d\u0932\u0917\u0907\u0928 \u0906\u0927\u0940\u092a\u093e\u0938\u0942\u0928\u091a \u0924\u0947 \u091c\u094b\u0921\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u092c\u0902\u0926 \u0915\u0930\u093e; \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0924\u0930\u0940\u0939\u0940 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0924\u093e\u0924."
            ],
            "Event name for form submissions": [
                "\u092b\u0949\u0930\u094d\u092e \u0938\u092c\u092e\u093f\u0936\u0928\u0938\u093e\u0920\u0940 \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u091a\u0947 \u0928\u093e\u0935"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u092c\u0945\u0928\u0930 \u0939\u093e \u090f\u0915 \u092a\u0949\u092a\u0905\u092a \u0906\u0939\u0947 \u091c\u094b \u0906\u092a\u0923 \u092c\u094d\u0932\u0949\u0915\u094d\u0938 \u0935\u093e\u092a\u0930\u0942\u0928 \u0921\u093f\u091d\u093e\u0907\u0928 \u0915\u0930\u0924\u093e. \u0924\u094d\u092f\u093e\u091a\u0940 \u092c\u091f\u0923\u0947 #consent-accept, #consent-reject \u0906\u0923\u093f #consent-save \u0932\u093e \u0932\u093f\u0902\u0915 \u0915\u0930\u0924\u093e\u0924 (\"save\" \u0938\u093e\u0920\u0940 analytics \u0906\u0923\u093f marketing \u0928\u093e\u0935\u093e\u091a\u0940 \u091f\u093f\u0915 \u092c\u0949\u0915\u094d\u0938\u0947\u0938); \u0915\u0941\u0920\u0947\u0939\u0940 \u0905\u0938\u0932\u0947\u0932\u0940 #consent-open \u091a\u0940 \u0932\u093f\u0902\u0915 \u0924\u094b \u092a\u0941\u0928\u094d\u0939\u093e \u0926\u0930\u094d\u0936\u0935\u0924\u0947. \u091c\u094b\u092a\u0930\u094d\u092f\u0902\u0924 \u090f\u0916\u093e\u0926\u093e \u0905\u092d\u094d\u092f\u093e\u0917\u0924 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0924 \u0928\u093e\u0939\u0940, \u0924\u094b\u092a\u0930\u094d\u092f\u0902\u0924 \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u091f\u0945\u0917\u094d\u091c \u0932\u094b\u0921 \u0939\u094b\u0924 \u0928\u093e\u0939\u0940\u0924, Google Consent Mode \"denied\" \u0930\u093e\u0939\u0924\u0947 \u0906\u0923\u093f \u0906\u092a\u0923 \u0938\u0942\u091a\u0940\u092c\u0926\u094d\u0927 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u094d\u0938 \u092c\u0902\u0926 \u0930\u093e\u0939\u0924\u093e\u0924."
            ],
            "Create a ready-made banner": [
                "\u0924\u092f\u093e\u0930 \u092c\u0945\u0928\u0930 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"
            ],
            "Show a cookie banner": [
                "\u0915\u0941\u0915\u0940 \u092c\u0945\u0928\u0930 \u0926\u093e\u0916\u0935\u093e"
            ],
            "Banner": [
                "\u092c\u0945\u0928\u0930"
            ],
            "Choose a popup\u2026": [
                "\u092a\u0949\u092a\u0905\u092a \u0928\u093f\u0935\u0921\u093e\u2026"
            ],
            "%s (draft)": [
                "%s (\u092e\u0938\u0941\u0926\u093e)"
            ],
            "Edit the banner": [
                "\u092c\u0945\u0928\u0930 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e"
            ],
            "Remember the choice for (days)": [
                "\u0928\u093f\u0935\u0921 (\u0926\u093f\u0935\u0938\u093e\u0902\u0938\u093e\u0920\u0940) \u0932\u0915\u094d\u0937\u093e\u0924 \u0920\u0947\u0935\u093e"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u092f\u0941\u0930\u094b\u092a\u093f\u092f\u0928 \u092f\u0941\u0928\u093f\u092f\u0928, \u0908\u0908\u090f \u0906\u0923\u093f \u092f\u0941\u0928\u093e\u092f\u091f\u0947\u0921 \u0915\u093f\u0902\u0917\u0921\u092e\u091a\u094d\u092f\u093e \u092c\u093e\u0939\u0947\u0930: \u0905\u092d\u094d\u092f\u093e\u0917\u0924 \u0928\u0915\u093e\u0930 \u0926\u0947\u0908\u092a\u0930\u094d\u092f\u0902\u0924 \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0932\u094b\u0921 \u0915\u0930\u093e"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u092c\u0902\u0926: \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0905\u092d\u094d\u092f\u093e\u0917\u0924\u093e\u0928\u0947 \u092a\u094d\u0930\u0925\u092e \u0938\u0939\u092e\u0924\u0940 \u0926\u0930\u094d\u0936\u0935\u093f\u0932\u0940 \u092a\u093e\u0939\u093f\u091c\u0947 (\u0938\u0930\u094d\u0935\u093e\u0924 \u0915\u0920\u094b\u0930 \u0928\u093f\u092f\u092e \u0906\u0923\u093f \u0921\u0940\u092b\u0949\u0932\u094d\u091f). \u0938\u0941\u0930\u0942: \u091c\u0947\u0935\u094d\u0939\u093e \u0924\u0941\u092e\u091a\u093e \u0939\u094b\u0938\u094d\u091f \u0915\u093f\u0902\u0935\u093e CDN \u0905\u092d\u094d\u092f\u093e\u0917\u0924\u093e\u091a\u093e \u0926\u0947\u0936 \u0915\u0933\u0935\u0924\u094b (\u0909\u0926\u093e\u0939\u0930\u0923\u093e\u0930\u094d\u0925 Cloudflare \u091a\u0947 CF-IPCountry \u0939\u0947\u0921\u0930) \u0906\u0923\u093f \u0924\u094b EU, EEA, UK \u0906\u0923\u093f \u0938\u094d\u0935\u093f\u0924\u094d\u091d\u0930\u094d\u0932\u0902\u0921\u091a\u094d\u092f\u093e \u092c\u093e\u0939\u0947\u0930 \u0905\u0938\u0924\u094b \u0924\u0947\u0935\u094d\u0939\u093e\u091a. \u092c\u0945\u0928\u0930 \u0905\u091c\u0942\u0928\u0939\u0940 \u0926\u093e\u0916\u0935\u0932\u093e \u091c\u093e\u0924\u094b \u0906\u0923\u093f \u0905\u091c\u094d\u091e\u093e\u0924 \u0926\u0947\u0936 \u0939\u093e EU \u091a\u094d\u092f\u093e \u0906\u0924 \u092e\u093e\u0928\u0932\u093e \u091c\u093e\u0924\u094b."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0938\u0902\u092e\u0924\u0940 \u092e\u093f\u0933\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u0930\u094b\u0916\u0942\u0928 \u0920\u0947\u0935\u093e\u092f\u091a\u094d\u092f\u093e \u0907\u0924\u0930 \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u094d\u0938 (handle:analytics \u0915\u093f\u0902\u0935\u093e handle:marketing, \u0938\u094d\u0935\u0932\u094d\u092a\u0935\u093f\u0930\u093e\u092e\u093e\u0928\u0947 \u0935\u0947\u0917\u0933\u0947 \u0915\u0947\u0932\u0947\u0932\u0947)"
            ],
            "Popups, slide-ins and bars": [
                "\u092a\u0949\u092a\u0905\u092a\u094d\u0938, \u0938\u094d\u0932\u093e\u0908\u0921-\u0907\u0928\u094d\u0938 \u0906\u0923\u093f \u092a\u091f\u094d\u091f\u094d\u092f\u093e"
            ],
            "A\/B test results": [
                "A\/B \u091a\u093e\u091a\u0923\u0940 \u0928\u093f\u0915\u093e\u0932"
            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915: \u092b\u0949\u0930\u094d\u092e\u094d\u0938, \u092a\u0949\u092a\u0905\u092a\u094d\u0938, \u092e\u094b\u0936\u0928, \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917, A\/B \u091a\u093e\u091a\u0923\u094d\u092f\u093e \u0906\u0923\u093f \u0915\u0941\u0915\u0940 \u092c\u0945\u0928\u0930"
            ],
            "Mailing-list connections": [
                "\u092e\u0947\u0932\u093f\u0902\u0917-\u0938\u0942\u091a\u0940 \u091c\u094b\u0921\u0923\u094d\u092f\u093e"
            ]
        }
    }
