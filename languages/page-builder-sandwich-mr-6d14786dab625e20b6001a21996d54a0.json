            "Check and save": [
                "\u0924\u092a\u093e\u0938\u093e \u0906\u0923\u093f \u091c\u0924\u0928 \u0915\u0930\u093e"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u092e\u0947\u0932\u093f\u0902\u0917-\u0938\u0942\u091a\u0940 \u0938\u0947\u0935\u093e \u090f\u0915\u0926\u093e \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u093e; \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092b\u0949\u0930\u094d\u092e \u092d\u0930\u0923\u093e\u0931\u094d\u092f\u093e \u0932\u094b\u0915\u093e\u0902\u0928\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u090f\u0915\u093e \u0938\u0942\u091a\u0940\u092e\u0927\u094d\u092f\u0947 \u091c\u094b\u0921\u0942 \u0936\u0915\u0924\u094b (\u092b\u0949\u0930\u094d\u092e \u092c\u094d\u0932\u0949\u0915 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u2192 \u092a\u093e\u0920\u0935\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930). \u0915\u0940 \u0938\u0947\u0935\u0947\u0938\u0939 \u0924\u092a\u093e\u0938\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924, \u092f\u093e \u0938\u093e\u0907\u091f\u0935\u0930 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u0930\u0942\u0928 \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0915\u0947\u0932\u094d\u092f\u093e \u091c\u093e\u0924\u093e\u0924 \u0906\u0923\u093f \u092a\u0941\u0928\u094d\u0939\u093e \u0915\u0927\u0940\u0939\u0940 \u0926\u093e\u0916\u0935\u0932\u094d\u092f\u093e \u091c\u093e\u0924 \u0928\u093e\u0939\u0940\u0924."
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0915\u094b\u0921\u0936\u093f\u0935\u093e\u092f \u092b\u0949\u0930\u094d\u092e \u0938\u092c\u092e\u093f\u0936\u0928 \u0906\u0923\u093f \u092c\u091f\u0923 \u0915\u094d\u0932\u093f\u0915\u094d\u0938 \u0906\u092a\u0932\u094d\u092f\u093e \u0972\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938\u0935\u0930 \u092a\u093e\u0920\u0935\u093e. \u0924\u0940 \u0938\u0947\u0935\u093e \u0935\u0917\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 ID \u0930\u093f\u0915\u094d\u0924 \u0920\u0947\u0935\u093e. \u092c\u091f\u0923\u093e\u0902\u0928\u093e \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0917\u0924 \u092a\u0945\u0928\u0947\u0932\u092e\u0927\u094d\u092f\u0947 \"\u0930\u0942\u092a\u093e\u0902\u0924\u0930\u0923 \u0907\u0935\u094d\u0939\u0947\u0902\u091f\" \u092b\u0940\u0932\u094d\u0921 \u092e\u093f\u0933\u0924\u0947. \u0915\u0941\u0915\u0940 \u092c\u0945\u0928\u0930 \u0938\u0941\u0930\u0942 \u0905\u0938\u0924\u093e\u0928\u093e, \u0905\u092d\u094d\u092f\u093e\u0917\u0924 \u0938\u0939\u092e\u0924 \u0939\u094b\u0908\u092a\u0930\u094d\u092f\u0902\u0924 \u0915\u093e\u0939\u0940\u0939\u0940 \u0932\u094b\u0921 \u0939\u094b\u0924 \u0928\u093e\u0939\u0940."
            ],
            "Google Analytics 4 measurement ID": [
                "Google Analytics 4 \u092e\u093e\u092a\u0928 \u0906\u092f\u0921\u0940"
            ],
            "Google Tag Manager container ID": [
                "Google Tag Manager \u0915\u0902\u091f\u0947\u0928\u0930 \u0906\u092f\u0921\u0940"
