            ],
            "%d page was built with another builder. Converting makes a new draft made of blocks; the original page is not changed.": [
                "%d \u0635\u0641\u062d\u06c1 \u062f\u0648\u0633\u0631\u06d2 \u0628\u0644\u0688\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0628\u0646\u0627\u06cc\u0627 \u06af\u06cc\u0627 \u062a\u06be\u0627\u06d4 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0628\u0644\u0627\u06a9\u0633 \u067e\u0631 \u0645\u0634\u062a\u0645\u0644 \u0627\u06cc\u06a9 \u0646\u06cc\u0627 \u0645\u0633\u0648\u062f\u06c1 \u0628\u0646\u062a\u0627 \u06c1\u06d2\u061b \u0627\u0635\u0644 \u0635\u0641\u062d\u06c1 \u062a\u0628\u062f\u06cc\u0644 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4",
                "%d \u0635\u0641\u062d\u0627\u062a \u06a9\u0633\u06cc \u062f\u0648\u0633\u0631\u06d2 \u0628\u0644\u0688\u0631 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0628\u0646\u0627\u0626\u06d2 \u06af\u0626\u06d2 \u062a\u06be\u06d2\u06d4 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u06c1\u0631 \u0627\u06cc\u06a9 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u0644\u0627\u06a9\u0633 \u0633\u06d2 \u0628\u0646\u0627 \u06c1\u0648\u0627 \u0627\u06cc\u06a9 \u0646\u06cc\u0627 \u0688\u0631\u0627\u0641\u0679 \u0628\u0646 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u061b \u0627\u0635\u0644 \u0635\u0641\u062d\u0627\u062a \u0645\u06cc\u06ba \u06a9\u0648\u0626\u06cc \u062a\u0628\u062f\u06cc\u0644\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u06cc\u06d4"
