            ],
            "Styles set for Tablet apply up to the tablet width, and styles set for Mobile up to the mobile width. Desktop styles apply everywhere else.": [
                "\u0423\u0441\u043b\u0443\u0431\u04b3\u043e\u0438 \u0431\u0430\u0440\u043e\u0438 \u043f\u043b\u0430\u043d\u0448\u0435\u0442 \u0442\u0430\u043d\u0437\u0438\u043c\u0448\u0443\u0434\u0430 \u0442\u043e \u043f\u0430\u04b3\u043d\u043e\u0438 \u043f\u043b\u0430\u043d\u0448\u0435\u0442 \u0432\u0430 \u0443\u0441\u043b\u0443\u0431\u04b3\u043e\u0438 \u0431\u0430\u0440\u043e\u0438 \u043c\u043e\u0431\u0438\u043b\u04e3 \u0442\u0430\u043d\u0437\u0438\u043c\u0448\u0443\u0434\u0430 \u0442\u043e \u043f\u0430\u04b3\u043d\u043e\u0438 \u043c\u043e\u0431\u0438\u043b\u04e3 \u0442\u0430\u0442\u0431\u0438\u049b \u043c\u0435\u0448\u0430\u0432\u0430\u043d\u0434. \u0423\u0441\u043b\u0443\u0431\u04b3\u043e\u0438 \u043c\u0438\u0437\u0438 \u043a\u043e\u0440\u04e3 \u0434\u0430\u0440 \u04b3\u0430\u043c\u0430 \u04b7\u043e\u0438 \u0434\u0438\u0433\u0430\u0440 \u0442\u0430\u0442\u0431\u0438\u049b \u043c\u0435\u0448\u0430\u0432\u0430\u043d\u0434."
            ],
