            "Change this on the Account page": [
                "\u0418\u043d\u0440\u043e \u0434\u0430\u0440 \u0441\u0430\u04b3\u0438\u0444\u0430\u0438 \u04b2\u0438\u0441\u043e\u0431 \u0442\u0430\u0493\u0439\u0438\u0440 \u0434\u0438\u04b3\u0435\u0434"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u0412\u0435\u0440\u0441\u0438\u044f\u04b3\u043e\u0438 \u0431\u0435\u0442\u0430 \u0431\u0430 \u043d\u0430\u0441\u0431\u04b3\u043e\u0438 Pro-\u0438 \u043b\u0438\u0441\u0435\u043d\u0437\u0438\u044f\u0448\u0443\u0434\u0430, \u043a\u0438 \u0431\u0430 \u04b3\u0438\u0441\u043e\u0431\u0438 \u0445\u0443\u0434 \u043f\u0430\u0439\u0432\u0430\u0441\u0442\u0430\u0430\u043d\u0434, \u043f\u0435\u0448\u043d\u0438\u04b3\u043e\u0434 \u043a\u0430\u0440\u0434\u0430 \u043c\u0435\u0448\u0430\u0432\u0430\u043d\u0434. \u041f\u0430\u0441 \u0430\u0437 \u043f\u0430\u0439\u0432\u0430\u0441\u0442 \u0448\u0443\u0434\u0430\u043d, \u0448\u0443\u043c\u043e \u043c\u0435\u0442\u0430\u0432\u043e\u043d\u0435\u0434 \u0430\u0437 \u0441\u0430\u04b3\u0438\u0444\u0430\u0438 \u04b2\u0438\u0441\u043e\u0431 \u04b3\u0430\u043c\u0440\u043e\u04b3 \u0448\u0430\u0432\u0435\u0434."
            ],
            "Breakpoints saved. Pages pick up the new widths on their next view.": [
                "\u041d\u0443\u049b\u0442\u0430\u04b3\u043e\u0438 \u049b\u0430\u0442\u044a \u0437\u0430\u0445\u0438\u0440\u0430 \u0448\u0443\u0434\u0430\u043d\u0434. \u0421\u0430\u04b3\u0438\u0444\u0430\u04b3\u043e \u043f\u0430\u04b3\u043d\u043e\u0438 \u043d\u0430\u0432 \u0433\u0438\u0440\u0438\u0444\u0442\u0430\u0448\u0443\u0434\u0430\u0440\u043e \u04b3\u0430\u043d\u0433\u043e\u043c\u0438 \u0434\u0438\u0434\u0430\u043d\u0438 \u043d\u0430\u0432\u0431\u0430\u0442\u0438\u0438 \u0445\u0443\u0434 \u0438\u0441\u0442\u0438\u0444\u043e\u0434\u0430 \u043c\u0435\u0431\u0430\u0440\u0430\u043d\u0434."
