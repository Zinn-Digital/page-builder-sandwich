            ],
            "This site receives stable versions only.": [
                "\u0418\u043d \u0441\u0430\u0439\u0442 \u0442\u0430\u043d\u04b3\u043e \u0432\u0435\u0440\u0441\u0438\u044f\u04b3\u043e\u0438 \u0443\u0441\u0442\u0443\u0432\u043e\u0440\u0440\u043e \u049b\u0430\u0431\u0443\u043b \u043c\u0435\u043a\u0443\u043d\u0430\u0434."
