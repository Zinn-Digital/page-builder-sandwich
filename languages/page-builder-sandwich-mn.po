#: src/design/a11y/checks.js:617
#, js-format
msgid "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d."
msgstr "Энэ H%1$d нь нэг түвшинг алгасаж байна; үүний өмнөх нь H%2$d байна. Үүнийг H%3$d болгоно уу."

