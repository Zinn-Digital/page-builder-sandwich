            ],
            "%d replaced": [
                "%d \u0438\u0432\u0430\u0437 \u043a\u0430\u0440\u0434\u0430 \u0448\u0443\u0434"
            ],
            "%d kept as they were": [
                "%d \u043c\u0438\u0441\u043b\u0438 \u043f\u0435\u0448\u0442\u0430 \u043d\u0438\u0433\u043e\u04b3 \u0434\u043e\u0448\u0442\u0430 \u0448\u0443\u0434\u0430\u043d\u0434"
            ],
            "%d setting": [
                "%d \u0442\u0430\u043d\u0437\u0438\u043c\u043e\u0442"
            ],
            "Importing will give: %s.": [
                "\u0412\u043e\u0440\u0438\u0434\u043e\u0442 \u043c\u0435\u0434\u0438\u04b3\u0430\u0434: %s."
            ],
            "Imported: %s.": [
                "\u0412\u043e\u0440\u0438\u0434 \u043a\u0430\u0440\u0434\u0430 \u0448\u0443\u0434: %s."
            ],
            "Exported %d item.": [
                "%d \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0441\u043e\u0434\u0438\u0440 \u043a\u0430\u0440\u0434\u0430 \u0448\u0443\u0434."
            ],
            "That file could not be read as an export file.": [
                "\u041e\u043d \u0444\u0430\u0439\u043b \u04b3\u0430\u043c\u0447\u0443\u043d \u0444\u0430\u0439\u043b\u0438 \u0441\u043e\u0434\u0438\u0440\u043e\u0442\u04e3 \u0445\u043e\u043d\u0434\u0430 \u043d\u0430\u0448\u0443\u0434."
            ],
            "Import and export": [
                "\u0412\u043e\u0440\u0438\u0434\u043e\u0442 \u0432\u0430 \u0441\u043e\u0434\u0438\u0440\u043e\u0442"
            ],
            "Export": [
                "\u0421\u043e\u0434\u0438\u0440 \u043a\u0430\u0440\u0434\u0430\u043d"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0428\u0430\u0431\u043b\u043e\u043d\u04b3\u043e, \u043d\u0430\u049b\u0448\u0430\u04b3\u043e \u0432\u0430 \u0442\u0430\u0440\u04b3\u0438 \u0441\u0430\u0439\u0442\u0438 \u0445\u0443\u0434\u0440\u043e \u04b3\u0430\u043c\u0447\u0443\u043d \u044f\u043a \u0444\u0430\u0439\u043b \u0431\u043e\u0440\u0433\u0438\u0440\u04e3 \u043a\u0443\u043d\u0435\u0434, \u0442\u043e \u043e\u043d\u0440\u043e \u0434\u0430\u0440 \u0441\u0430\u0439ti \u0434\u0438\u0433\u0430\u0440 \u0432\u043e\u0440\u0438\u0434 \u043a\u0443\u043d\u0435\u0434."
            ],
            "There are no templates or patterns to export yet.": [
                "\u04b2\u0430\u043d\u04ef\u0437 \u044f\u0433\u043e\u043d \u049b\u043e\u043b\u0430\u0431 \u0451 \u043d\u0430\u043c\u0443\u043d\u0430 \u0431\u0430\u0440\u043e\u0438 \u0441\u043e\u0434\u0438\u0440 \u043a\u0430\u0440\u0434\u0430\u043d \u0432\u0443\u04b7\u0443\u0434 \u043d\u0430\u0434\u043e\u0440\u0430\u0434."
            ],
            "Include the settings": [
                "\u0414\u043e\u0445\u0438\u043b \u043a\u0430\u0440\u0434\u0430\u043d\u0438 \u0442\u0430\u043d\u0437\u0438\u043c\u043e\u0442"
            ],
            "Download the export file": [
                "\u0411\u043e\u0440 \u043a\u0430\u0440\u0434\u0430\u043d\u0438 \u0444\u0430\u0439\u043b\u0438 \u0441\u043e\u0434\u0438\u0440\u043e\u0442\u04e3"
            ],
            "Import": [
                "\u0412\u043e\u0440\u0438\u0434 \u043a\u0430\u0440\u0434\u0430\u043d"
            ],
            "Choose an export file": [
                "\u0418\u043d\u0442\u0438\u0445\u043e\u0431\u0438 \u0444\u0430\u0439\u043b\u0438 \u0441\u043e\u0434\u0438\u0440\u043e\u0442\u04e3"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0424\u0430\u0439\u043b %2$s \u0430\u0437 %1$d \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0438\u0431\u043e\u0440\u0430\u0442 \u0430\u0441\u0442."
            ],
            "When an item with the same name already exists here": [
                "\u0412\u0430\u049b\u0442\u0435 \u043a\u0438 \u0434\u0430\u0440 \u0438\u043d \u04b7\u043e \u0430\u043b\u043b\u0430\u043a\u0430\u0439 \u0443\u043d\u0441\u0443\u0440\u0435 \u0431\u043e \u04b3\u0430\u043c\u0438\u043d \u043d\u043e\u043c \u043c\u0430\u0432\u04b7\u0443\u0434 \u0430\u0441\u0442"
            ],
            "Keep the one on this site": [
                "\u0414\u0430\u0440 \u04b3\u0430\u043c\u0438\u043d \u0441\u0430\u0439\u0442 \u043d\u0438\u0433\u043e\u04b3 \u0434\u043e\u0440\u0435\u0434"
            ],
            "Replace it with the imported one": [
                "\u041e\u043d\u0440\u043e \u0431\u043e \u043d\u0443\u0441\u0445\u0430\u0438 \u0432\u043e\u0440\u0438\u0434\u0448\u0443\u0434\u0430 \u0438\u0432\u0430\u0437 \u043a\u0443\u043d\u0435\u0434"
            ],
            "Import a copy beside it": [
                "\u041dus\u0445\u0430\u0435\u0440\u043e \u0434\u0430\u0440 \u043f\u0430\u04b3\u043b\u04ef\u0438 \u043e\u043d \u0432\u043e\u0440\u0438\u0434 \u043a\u0443\u043d\u0435\u0434"
            ],
            "Apply the settings in the file": [
                "\u0422\u0430\u043d\u0437\u0438\u043c\u043e\u0442\u0440\u043e \u0430\u0437 \u0444\u0430\u0439\u043b \u0442\u0430\u0442\u0431\u0438\u049b \u043a\u0443\u043d\u0435\u0434"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u0422\u0430\u0441\u0432\u0438\u0440\u04b3\u043e\u0440\u043e \u0431\u0430 \u043a\u0438\u0442\u043e\u0431\u0445\u043e\u043d\u0430\u0438 \u043c\u0435\u0434\u0438\u0430\u0438 \u0438\u043d \u0441\u0430\u0439\u0442 \u043d\u0443\u0441\u0445\u0430\u0431\u0430\u0440\u0434\u043e\u0440\u04e3 \u043a\u0443\u043d\u0435\u0434"
            ],
            "Show what will happen": [
                "\u041d\u0438\u0448\u043e\u043d \u0434\u0438\u04b3\u0435\u0434, \u043a\u0438 \u0447\u04e3 \u043c\u0435\u0448\u0430\u0432\u0430\u0434"
            ]
        }
