            ],
            "Build these pages as drafts": [
                "\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0446\u0456 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u044f\u043a \u0447\u0435\u0440\u043d\u0435\u0442\u043a\u0438"
            ],
            "Create with AI": [
                "\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0428\u0406"
            ],
            "A custom block": [
                "\u041a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0446\u044c\u043a\u0438\u0439 \u0431\u043b\u043e\u043a"
            ],
            "Describe a component (\"a team member card with photo, name, role and a short bio\"). It is saved to My patterns, with its texts editable on every page that uses it.": [
                "\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 (\u00ab\u043a\u0430\u0440\u0442\u043a\u0430 \u0447\u043b\u0435\u043d\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u0437 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0456\u0454\u044e, \u0456\u043c'\u044f\u043c, \u043f\u043e\u0441\u0430\u0434\u043e\u044e \u0442\u0430 \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u044e \u0431\u0456\u043e\u0433\u0440\u0430\u0444\u0456\u0454\u044e\u00bb). \u0419\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0434\u043e \u0440\u043e\u0437\u0434\u0456\u043b\u0443 \u00ab\u041c\u043e\u0457 \u043f\u0430\u0442\u0435\u0440\u043d\u0438\u00bb, \u0430 \u0439\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0438 \u043c\u043e\u0436\u043d\u0430 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u043d\u0430 \u043a\u043e\u0436\u043d\u0456\u0439 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456, \u0434\u0435 \u0432\u0456\u043d \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f."
            ],
            "Block created and added to the page.": [
                "\u0411\u043b\u043e\u043a \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e \u0442\u0430 \u0434\u043e\u0434\u0430\u043d\u043e \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443."
            ],
            "Edit the block": [
