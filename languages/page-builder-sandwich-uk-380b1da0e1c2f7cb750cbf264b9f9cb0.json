            ],
            "Link text says nothing on its own": [
                "\u0422\u0435\u043a\u0441\u0442 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0441\u0430\u043c \u043f\u043e \u0441\u043e\u0431\u0456 \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u044f\u0454"
