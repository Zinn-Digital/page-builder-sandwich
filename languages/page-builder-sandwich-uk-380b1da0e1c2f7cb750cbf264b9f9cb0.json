            "For example: \"make the hero shorter and friendlier\", \"add an FAQ about delivery after the pricing\", \"translate this section into Spanish\". Select a block first to point at it.": [
                "\u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434: \"\u0437\u0440\u043e\u0431\u0456\u0442\u044c \u0433\u043e\u043b\u043e\u0432\u043d\u0438\u0439 \u0431\u043b\u043e\u043a \u043a\u043e\u0440\u043e\u0442\u0448\u0438\u043c \u0456 \u0431\u0456\u043b\u044c\u0448 \u0434\u0440\u0443\u0436\u043d\u0456\u043c\", \"\u0434\u043e\u0434\u0430\u0439\u0442\u0435 \u0447\u0430\u0441\u0442\u0456 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f \u043f\u0440\u043e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u043f\u0456\u0441\u043b\u044f \u0446\u0456\u043d\", \"\u043f\u0435\u0440\u0435\u043a\u043b\u0430\u0434\u0456\u0442\u044c \u0446\u0435\u0439 \u0440\u043e\u0437\u0434\u0456\u043b \u0456\u0441\u043f\u0430\u043d\u0441\u044c\u043a\u043e\u044e\". \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0431\u043b\u043e\u043a, \u0449\u043e\u0431 \u0432\u043a\u0430\u0437\u0430\u0442\u0438 \u043d\u0430 \u043d\u044c\u043e\u0433\u043e."
            ],
            "Ask": [
                "\u0417\u0430\u043f\u0438\u0442\u0430\u0442\u0438"
            ],
            "Build a website": [
