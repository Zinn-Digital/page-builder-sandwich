        "messages": {
            "": {
                "domain": "messages",
                "lang": "kk",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0420\u0435\u0442\u0442\u0435\u043b\u043c\u0435\u0433\u0435\u043d CSS \u0444\u0430\u0439\u043b\u044b\u043d \u0442\u0435\u043a \u0441\u04af\u0437\u0433\u0456\u0434\u0435\u043d \u04e9\u0442\u043f\u0435\u0433\u0435\u043d HTML \u049b\u043e\u0441\u0430 \u0430\u043b\u0430\u0442\u044b\u043d \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u0443\u0448\u044b\u043b\u0430\u0440 \u0493\u0430\u043d\u0430 \u04e9\u0437\u0433\u0435\u0440\u0442\u0435 \u0430\u043b\u0430\u0434\u044b."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0411\u04b1\u043b CSS-\u0442\u0456\u04a3 \u043a\u0435\u0439\u0431\u0456\u0440\u0456 \u043f\u0430\u0439\u0434\u0430\u043b\u0430\u043d\u044b\u043b\u043c\u0430\u0439\u0434\u044b: \u049b\u0430\u0443\u0456\u043f\u0441\u0456\u0437\u0434\u0456\u043a \u04af\u0448\u0456\u043d @import, expression(), javascript: URLs, \u00ab<\u00bb \u0436\u04d9\u043d\u0435 \u0442\u0435\u04a3\u0433\u0435\u0440\u0456\u043b\u043c\u0435\u0433\u0435\u043d \u0436\u04af\u0439\u0435\u043b\u0456 \u0436\u0430\u049b\u0448\u0430\u043b\u0430\u0440 \u0436\u043e\u0439\u044b\u043b\u0430\u0434\u044b."
            ],
            "Page CSS": [
                "\u0411\u0435\u0442 CSS-\u0456"
            ],
            "Global classes": [
                "\u0416\u0430\u04bb\u0430\u043d\u0434\u044b\u049b \u0441\u044b\u043d\u044b\u043f\u0442\u0430\u0440"
            ],
            "Classes": [
                "\u0421\u044b\u043d\u044b\u043f\u0442\u0430\u0440"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0421\u0430\u0439\u0442 \u0434\u0438\u0437\u0430\u0439\u043d\u044b\u043d\u0434\u0430 \u0441\u044b\u043d\u044b\u043f\u0442\u0430\u0440\u0434\u044b \u0436\u0430\u0441\u0430\u04a3\u044b\u0437, \u0441\u043e\u0434\u0430\u043d \u043a\u0435\u0439\u0456\u043d \u043e\u043b\u0430\u0440\u0434\u044b \u043c\u044b\u043d\u0434\u0430 \u049b\u043e\u0441\u044b\u04a3\u044b\u0437."
            ],
            "Custom CSS": [
                "\u0410\u0440\u043d\u0430\u0439\u044b CSS"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u0411\u04b1\u043b \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u04af\u0448\u0456\u043d \u0435\u0440\u0435\u0436\u0435\u043b\u0435\u0440 \u0436\u0430\u0437\u044b\u04a3\u044b\u0437. \u00abselector\u00bb \u043e\u0441\u044b \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0442\u0456 \u0431\u0456\u043b\u0434\u0456\u0440\u0435\u0434\u0456, \u043c\u044b\u0441\u0430\u043b\u044b selector:hover { opacity: .8 } \u2014 \u0436\u0430\u0439 \u043c\u04d9\u043b\u0456\u043c\u0434\u0435\u043c\u0435\u043b\u0435\u0440 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0442\u0456\u04a3 \u04e9\u0437\u0456\u043d\u0435 \u049b\u043e\u043b\u0434\u0430\u043d\u044b\u043b\u0430\u0434\u044b."
            ],
            "CSS for this page": [
                "\u0411\u04b1\u043b \u0431\u0435\u0442\u043a\u0435 \u0430\u0440\u043d\u0430\u043b\u0493\u0430\u043d CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0422\u0435\u043a \u043e\u0441\u044b \u0431\u0435\u0442\u0442\u0435 \u0441\u0430\u0439\u0442 \u043c\u04d9\u043d\u0435\u0440\u043b\u0435\u0440\u0456\u043d\u0435\u043d \u043a\u0435\u0439\u0456\u043d \u0436\u04af\u043a\u0442\u0435\u043b\u0435\u0434\u0456. \u0411\u0435\u0442\u043f\u0435\u043d \u0431\u0456\u0440\u0433\u0435 \u0441\u0430\u049b\u0442\u0430\u043b\u0430\u0434\u044b."
            ]
        }
    }
}
