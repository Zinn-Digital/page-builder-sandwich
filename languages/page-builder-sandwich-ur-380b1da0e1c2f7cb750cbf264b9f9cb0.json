            ],
            "Describe a component (\"a team member card with photo, name, role and a short bio\"). It is saved to My patterns, with its texts editable on every page that uses it.": [
                "\u06a9\u0633\u06cc \u062c\u0632 \u06a9\u06cc \u0648\u0636\u0627\u062d\u062a \u06a9\u0631\u06cc\u06ba (\"\u062a\u0635\u0648\u06cc\u0631\u060c \u0646\u0627\u0645\u060c \u06a9\u0631\u062f\u0627\u0631 \u0627\u0648\u0631 \u0645\u062e\u062a\u0635\u0631 \u062a\u0639\u0627\u0631\u0641 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0679\u06cc\u0645 \u06a9\u06d2 \u0631\u06a9\u0646 \u06a9\u0627 \u06a9\u0627\u0631\u0688\")\u06d4 \u06cc\u06c1 \u0645\u06cc\u0631\u06d2 \u067e\u06cc\u0679\u0631\u0646\u0632 \u0645\u06cc\u06ba \u0645\u062d\u0641\u0648\u0638 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u062c\u0633 \u0635\u0641\u062d\u06d2 \u067e\u0631 \u0628\u06be\u06cc \u0627\u0633 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0648\u06c1\u0627\u06ba \u0627\u0633 \u06a9\u06d2 \u0645\u062a\u0646 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4"
            ],
            "Block created and added to the page.": [
