            "Check and save": [
                "\u0686\u06cc\u06a9 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06cc\u06ba"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u0627\u06cc\u06a9 \u0628\u0627\u0631 \u0645\u06cc\u0644\u0646\u06af \u0644\u0633\u0679 \u0633\u0631\u0648\u0633 \u0645\u0646\u0633\u0644\u06a9 \u06a9\u0631\u06cc\u06ba\u061b \u067e\u06be\u0631 \u06a9\u0648\u0626\u06cc \u0628\u06be\u06cc \u0641\u0627\u0631\u0645 \u0627\u0633\u06d2 \u067e\u064f\u0631 \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0627\u0641\u0631\u0627\u062f \u06a9\u0648 \u0622\u067e \u06a9\u06cc \u06a9\u0633\u06cc \u0627\u06cc\u06a9 \u0644\u0633\u0679 \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06a9\u0631 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 (\u0641\u0627\u0631\u0645 \u0628\u0644\u0627\u06a9 \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af\u0632 \u2192 \u0628\u06be\u06cc\u062c\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f)\u06d4 \u0686\u0627\u0628\u06cc\u0627\u06ba \u0633\u0631\u0648\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0686\u06cc\u06a9 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u060c \u0627\u0633 \u0633\u0627\u0626\u06cc\u0679 \u067e\u0631 \u0645\u062d\u0641\u0648\u0638 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0628\u06be\u06cc \u0646\u06c1\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u06d4"
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u0628\u063a\u06cc\u0631 \u06a9\u0633\u06cc \u06a9\u0648\u0688 \u06a9\u06d2 \u0641\u0627\u0631\u0645 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06d2 \u0627\u0648\u0631 \u0628\u0679\u0646 \u06a9\u06d2 \u06a9\u0644\u06a9\u0633 \u06a9\u0648 \u0627\u067e\u0646\u06d2 \u0627\u06cc\u0646\u0627\u0644\u06cc\u0679\u06a9\u0633 \u067e\u0631 \u0628\u06be\u06cc\u062c\u06cc\u06ba\u06d4 \u06a9\u0633\u06cc \u0633\u0631\u0648\u0633 \u06a9\u0648 \u0686\u06be\u0648\u0691\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633 \u06a9\u06cc \u0622\u0626\u06cc \u0688\u06cc \u062e\u0627\u0644\u06cc \u0686\u06be\u0648\u0691 \u062f\u06cc\u06ba\u06d4 \u0628\u0679\u0646\u0648\u06ba \u06a9\u06d2 \u0627\u06cc\u0688\u0648\u0627\u0646\u0633\u0688 \u067e\u06cc\u0646\u0644 \u0645\u06cc\u06ba \u0627\u06cc\u06a9 \"Conversion event\" \u0641\u06cc\u0644\u0688 \u06c1\u0648\u062a\u06cc \u06c1\u06d2\u06d4 \u06a9\u0648\u06a9\u06cc \u0628\u06cc\u0646\u0688\u0631 \u0622\u0646 \u06c1\u0648\u0646\u06d2 \u06a9\u06d2 \u0633\u0627\u062a\u06be\u060c \u0648\u0632\u06cc\u0679\u0631 \u06a9\u06d2 \u0631\u0636\u0627\u0645\u0646\u062f \u06c1\u0648\u0646\u06d2 \u062a\u06a9 \u06a9\u0686\u06be \u0628\u06be\u06cc \u0644\u0648\u0688 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u0627\u06d4"
            ],
            "Google Analytics 4 measurement ID": [
                "Google Analytics 4 \u067e\u06cc\u0627\u0626\u0634 \u06a9\u06cc \u0634\u0646\u0627\u062e\u062a"
            ],
            "Google Tag Manager container ID": [
                "Google Tag Manager \u06a9\u0646\u0679\u06cc\u0646\u0631 ID"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "\u0645\u06cc\u0679\u0627 \u067e\u06a9\u0633\u0644 \u0622\u0626\u06cc \u0688\u06cc (\u0645\u06cc\u0679\u0627 \u0627\u06cc\u0648\u0646\u0679\u0633 \u0645\u06cc\u0646\u06cc\u062c\u0631 \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06cc \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0646\u0645\u0628\u0631)"
            ],
            "Load these tags on my site": [
                "\u0627\u0646 \u0679\u06cc\u06af\u0632 \u06a9\u0648 \u0645\u06cc\u0631\u06cc \u0633\u0627\u0626\u0679 \u067e\u0631 \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0627\u06af\u0631 \u0622\u067e \u06a9\u0627 \u062a\u06be\u06cc\u0645 \u06cc\u0627 \u06a9\u0648\u0626\u06cc \u0627\u0648\u0631 \u067e\u0644\u06af \u0627\u0646 \u0627\u0646\u06c1\u06cc\u06ba \u067e\u06c1\u0644\u06d2 \u06c1\u06cc \u0634\u0627\u0645\u0644 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u0628\u0646\u062f \u06a9\u0631 \u062f\u06cc\u06ba\u061b \u0627\u06cc\u0648\u0646\u0679\u0633 \u067e\u06be\u0631 \u0628\u06be\u06cc \u0628\u06be\u06cc\u062c\u06d2 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"
            ],
            "Event name for form submissions": [
                "\u0641\u0627\u0631\u0645 \u062c\u0645\u0639 \u06a9\u0631\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u0648\u0646\u0679 \u06a9\u0627 \u0646\u0627\u0645"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0628\u06cc\u0646\u0631 \u0627\u06cc\u06a9 \u067e\u0627\u067e \u0627\u067e \u06c1\u06d2 \u062c\u0633\u06d2 \u0622\u067e \u0628\u0644\u0627\u06a9\u0633 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0688\u06cc\u0632\u0627\u0626\u0646 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u0633 \u06a9\u06d2 \u0628\u0679\u0646 #consent-accept\u060c #consent-reject \u0627\u0648\u0631 #consent-save \u0633\u06d2 \u0644\u0646\u06a9 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba (\"save\" \u06a9\u06d2 \u0644\u06cc\u06d2 analytics \u0627\u0648\u0631 marketing \u0646\u0627\u0645\u06cc \u0679\u06a9 \u0628\u0627\u06a9\u0633\u0632 \u06a9\u06d2 \u0633\u0627\u062a\u06be)\u061b \u06a9\u06c1\u06cc\u06ba \u0628\u06be\u06cc #consent-open \u06a9\u0627 \u0644\u0646\u06a9 \u0627\u0633\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062f\u06a9\u06be\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u062c\u0628 \u062a\u06a9 \u06a9\u0648\u0626\u06cc \u0648\u0632\u06cc\u0679\u0631 \u0642\u0628\u0648\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u0627\u060c \u0679\u0631\u06cc\u06a9\u0646\u06af \u0679\u06cc\u06af\u0632 \u0644\u0648\u0688 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u06d2\u060c Google Consent Mode \"denied\" \u0631\u06c1\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u0622\u067e \u06a9\u06cc \u062f\u0631\u062c \u06a9\u0631\u062f\u06c1 \u0627\u0633\u06a9\u0631\u067e\u0679\u0633 \u0622\u0641 \u0631\u06c1\u062a\u06cc \u06c1\u06cc\u06ba\u06d4"
            ],
            "Create a ready-made banner": [
                "\u0627\u06cc\u06a9 \u062a\u06cc\u0627\u0631 \u0634\u062f\u06c1 \u0628\u06cc\u0646\u0631 \u0628\u0646\u0627\u0626\u06cc\u06ba"
            ],
            "Show a cookie banner": [
                "\u06a9\u0648\u06a9\u06cc \u0628\u06cc\u0646\u0631 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"
            ],
            "Banner": [
                "\u0628\u06cc\u0646\u0631"
            ],
            "Choose a popup\u2026": [
                "\u0627\u06cc\u06a9 \u067e\u0627\u067e \u0627\u067e \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u2026"
            ],
            "%s (draft)": [
                "%s (\u0688\u0631\u0627\u0641\u0679)"
            ],
            "Edit the banner": [
                "\u0628\u06cc\u0646\u0631 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba"
            ],
            "Remember the choice for (days)": [
                "(days) \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0646\u062a\u062e\u0627\u0628 \u06cc\u0627\u062f \u0631\u06a9\u06be\u06cc\u06ba"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u06cc\u0648\u0631\u0648\u067e\u06cc \u06cc\u0648\u0646\u06cc\u0646\u060c \u0627\u06cc \u0627\u06cc \u0627\u06d2 \u0627\u0648\u0631 \u06cc\u0648 \u06a9\u06d2 \u0633\u06d2 \u0628\u0627\u06c1\u0631: \u0648\u0632\u06cc\u0679\u0631 \u06a9\u06d2 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631\u0646\u06d2 \u062a\u06a9 \u0644\u0648\u0688 \u0679\u0631\u06cc\u06a9\u0646\u06af"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u0628\u0646\u062f: \u06c1\u0631 \u0632\u0627\u0626\u0631 \u06a9\u0648 \u067e\u06c1\u0644\u06d2 \u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062f\u06cc\u0646\u06cc \u06c1\u0648\u06af\u06cc (\u0633\u0628 \u0633\u06d2 \u0633\u062e\u062a \u0627\u0635\u0648\u0644\u060c \u0627\u0648\u0631 \u0637\u06d2 \u0634\u062f\u06c1)\u06d4 \u0686\u0627\u0644\u0648: \u0635\u0631\u0641 \u0627\u0633 \u0648\u0642\u062a \u062c\u0628 \u0622\u067e \u06a9\u0627 \u06c1\u0648\u0633\u0679 \u06cc\u0627 CDN \u0632\u0627\u0626\u0631 \u06a9\u06d2 \u0645\u0644\u06a9 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06d2 (\u0645\u062b\u0644\u0627\u064b Cloudflare \u06a9\u0627 CF-IPCountry \u06c1\u06cc\u0688\u0631) \u0627\u0648\u0631 \u0648\u06c1 EU\u060c EEA\u060c UK \u0627\u0648\u0631 \u0633\u0648\u0626\u0679\u0632\u0631 \u0644\u06cc\u0646\u0688 \u0633\u06d2 \u0628\u0627\u06c1\u0631 \u06c1\u0648\u06d4 \u0628\u06cc\u0646\u0631 \u0627\u0628 \u0628\u06be\u06cc \u062f\u06a9\u06be\u0627\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u0646\u0627\u0645\u0639\u0644\u0648\u0645 \u0645\u0644\u06a9 \u06a9\u0648 EU \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0645\u0627\u0646\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4"
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0631\u0636\u0627\u0645\u0646\u062f\u06cc \u062a\u06a9 \u0631\u0648\u06a9\u06d2 \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06cc \u062f\u06cc\u06af\u0631 \u0627\u0633\u06a9\u0631\u067e\u0679\u0633 (\u06c1\u06cc\u0646\u0688\u0644:analytics \u06cc\u0627 \u06c1\u06cc\u0646\u0688\u0644:marketing\u060c \u06a9\u0648\u0645\u0627 \u0633\u06d2 \u0627\u0644\u06af \u06a9\u0631\u062f\u06c1)"
            ],
            "Popups, slide-ins and bars": [
                "\u067e\u0627\u067e \u0627\u067e\u0633\u060c \u0633\u0644\u0627\u0626\u06cc\u0688 \u0627\u0646\u0632 \u0627\u0648\u0631 \u0628\u0627\u0631\u0632"
            ],
            "A\/B test results": [
                "A\/B \u0679\u06cc\u0633\u0679 \u06a9\u06d2 \u0646\u062a\u0627\u0626\u062c"
            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u0631\u06c1\u0646\u0645\u0627: \u0641\u0627\u0631\u0645\u0632\u060c \u067e\u0627\u067e \u0627\u067e\u060c \u0645\u0648\u0634\u0646\u060c \u0679\u0631\u06cc\u06a9\u0646\u06af\u060c \u0627\u06d2\/\u0628\u06cc \u0679\u06cc\u0633\u0679 \u0627\u0648\u0631 \u06a9\u0648\u06a9\u06cc \u0628\u06cc\u0646\u0631"
            ],
            "Mailing-list connections": [
                "\u0645\u06cc\u0644\u0646\u06af \u0644\u0633\u0679 \u06a9\u06d2 \u06a9\u0646\u06a9\u0634\u0646\u0632"
            ]
        }
    }
