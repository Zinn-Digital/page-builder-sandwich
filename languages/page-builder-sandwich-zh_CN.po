msgstr "将您的模板、图案和网站设计下载为一个文件，以便导入到另一个网站。"

#: src/workflow/TransferPanel.js:167
msgid "There are no templates or patterns to export yet."
msgstr "暂无可导出的模板或模式。"

#: src/workflow/TransferPanel.js:187
msgid "Include the settings"
msgstr "包含设置"

#: src/workflow/TransferPanel.js:197
msgid "Download the export file"
msgstr "下载导出文件"

#: src/workflow/TransferPanel.js:200
#: src/workflow/TransferPanel.js:296
msgid "Import"
msgstr "导入"

#: src/workflow/TransferPanel.js:207
msgid "Choose an export file"
msgstr "选择导出文件"

#. translators: 1: number of items in the file, 2: the site it came from.
#: src/workflow/TransferPanel.js:219
#, js-format
msgid "The file holds %1$d item from %2$s."
msgid_plural "The file holds %1$d items from %2$s."
msgstr[0] "该文件包含来自 %2$s 的 %1$d 个项目。"

#: src/workflow/TransferPanel.js:230
msgid "When an item with the same name already exists here"
msgstr "当这里已存在同名项目时"

#: src/workflow/TransferPanel.js:238
msgid "Keep the one on this site"
msgstr "保留此站点上的版本"

#: src/workflow/TransferPanel.js:245
msgid "Replace it with the imported one"
msgstr "将其替换为导入的"

#: src/workflow/TransferPanel.js:252
msgid "Import a copy beside it"
msgstr "就地导入副本"

#: src/workflow/TransferPanel.js:262
msgid "Apply the settings in the file"
msgstr "应用文件中的设置"

#: src/workflow/TransferPanel.js:271
msgid "Copy the images into this site’s media library"
msgstr "将图片复制到此网站的媒体库中"

#: src/workflow/TransferPanel.js:285
msgid "Show what will happen"
msgstr "预览操作结果"

