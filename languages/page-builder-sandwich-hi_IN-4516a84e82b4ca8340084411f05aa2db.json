            ],
            "Site health and clean-up": [
                "\u0938\u093e\u0907\u091f \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0914\u0930 \u0938\u092b\u093c\u093e\u0908"
            ],
            "Finds old revisions, synced patterns nothing uses, heavy original images and design classes no page uses, and cleans each up in one click.": [
                "\u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u0902\u0938\u094b\u0927\u0928\u094b\u0902, \u0905\u092a\u094d\u0930\u092f\u0941\u0915\u094d\u0924 \u0938\u093f\u0902\u0915 \u0915\u093f\u090f \u0917\u090f \u092a\u0948\u091f\u0930\u094d\u0928, \u092d\u093e\u0930\u0940 \u092e\u0942\u0932 \u091b\u0935\u093f\u092f\u094b\u0902 \u0914\u0930 \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0935\u0930\u094d\u0917\u094b\u0902 \u0915\u094b \u0922\u0942\u0901\u0922\u0924\u093e \u0939\u0948 \u091c\u093f\u0928\u0915\u093e \u0915\u094b\u0908 \u092d\u0940 \u092a\u0943\u0937\u094d\u0920 \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0939\u0948, \u0914\u0930 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0915\u094b \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902 \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
            ],
            "Run the report again": [
                "\u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u091a\u0932\u093e\u090f\u0902"
            ],
            "Run the report": [
                "\u0930\u093f\u092a\u094b\u0930\u094d\u091f \u091a\u0932\u093e\u090f\u0902"
            ],
            "%1$d old revisions on %2$d posts (the newest %3$d of each are kept).": [
                "%2$d \u092a\u094b\u0938\u094d\u091f\u094b\u0902 \u092a\u0930 %1$d \u092a\u0941\u0930\u093e\u0928\u0947 \u0938\u0902\u0936\u094b\u0927\u0928 (\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0915\u0947 \u0928\u0935\u0940\u0928\u0924\u092e %3$d \u0930\u0916\u0947 \u0917\u090f \u0939\u0948\u0902)\u0964"
            ],
            "Delete the old revisions? This cannot be undone.": [
                "\u092a\u0941\u0930\u093e\u0928\u0940 \u092a\u0941\u0928\u0930\u093e\u0935\u0943\u0924\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u094b \u0939\u091f\u093e\u090f\u0901? \u0907\u0938\u0947 \u0935\u093e\u092a\u0938 \u092a\u0939\u0932\u0947 \u091c\u0948\u0938\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
            ],
            "Delete old revisions": [
                "\u092a\u0941\u0930\u093e\u0928\u0940 \u0906\u0935\u0943\u0924\u094d\u0924\u093f\u092f\u093e\u0901 \u0939\u091f\u093e\u090f\u0902"
            ],
            "%d synced pattern is not used anywhere.": [
                "%d \u0938\u093f\u0902\u0915 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092a\u0948\u091f\u0930\u094d\u0928 \u0915\u0939\u0940\u0902 \u092d\u0940 \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964",
                "%d \u0938\u092e\u0928\u094d\u0935\u092f\u093f\u0924 \u092a\u0948\u091f\u0930\u094d\u0928 \u0915\u0939\u0940\u0902 \u092d\u0940 \u0909\u092a\u092f\u094b\u0917 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964"
            ],
            "Move them to the trash": [
                "\u0909\u0928\u094d\u0939\u0947\u0902 \u091f\u094d\u0930\u0948\u0936 \u092e\u0947\u0902 \u092d\u0947\u091c\u0947\u0902"
            ],
            "%1$d heavy images (%2$s).": [
                "%1$d \u092d\u093e\u0930\u0940 \u091b\u0935\u093f\u092f\u093e\u0902 (%2$s)\u0964"
            ],
            "Make lighter copies (originals kept)": [
                "\u0939\u0932\u094d\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u092f\u093e\u0902 \u092c\u0928\u093e\u090f\u0902 (\u092e\u0942\u0932 \u092a\u094d\u0930\u0924\u093f\u092f\u093e\u0902 \u0930\u0916\u0940 \u091c\u093e\u090f\u0902\u0917\u0940)"
            ],
            "%d design class is not used.": [
                "%d \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u094d\u0932\u093e\u0938 \u0909\u092a\u092f\u094b\u0917 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
                "%d \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u094d\u0932\u093e\u0938 \u0909\u092a\u092f\u094b\u0917 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964"
            ],
            "Remove unused classes": [
