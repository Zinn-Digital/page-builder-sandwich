            ],
            "Mark the plans up as a Product with offers for search engines.": [
                "\u0e21\u0e32\u0e23\u0e4c\u0e01\u0e2d\u0e31\u0e1b\u0e41\u0e1c\u0e19\u0e40\u0e1b\u0e47\u0e19\u0e1c\u0e25\u0e34\u0e15\u0e20\u0e31\u0e13\u0e11\u0e4c\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e02\u0e49\u0e2d\u0e40\u0e2a\u0e19\u0e2d\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e21\u0e37\u0e2d\u0e04\u0e49\u0e19\u0e2b\u0e32"
            ],
            "Mark this up as a Review for search engines.": [
                "\u0e21\u0e32\u0e23\u0e4c\u0e01\u0e2d\u0e31\u0e1b\u0e2a\u0e34\u0e48\u0e07\u0e19\u0e35\u0e49\u0e40\u0e1b\u0e47\u0e19\u0e1a\u0e17\u0e27\u0e34\u0e08\u0e32\u0e23\u0e13\u0e4c\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e21\u0e37\u0e2d\u0e04\u0e49\u0e19\u0e2b\u0e32"
            ],
            "Structured data": [
                "\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e17\u0e35\u0e48\u0e21\u0e35\u0e42\u0e04\u0e23\u0e07\u0e2a\u0e23\u0e49\u0e32\u0e07"
            ],
            "Add schema.org structured data": [
                "\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e42\u0e04\u0e23\u0e07\u0e2a\u0e23\u0e49\u0e32\u0e07 schema.org"
            ],
            "%s KB": [
                "%s KB"
            ],
            "Performance": [
                "\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e"
            ],
            "Measure again": [
                "\u0e27\u0e31\u0e14\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07"
            ],
            "Measure this page": [
                "\u0e27\u0e31\u0e14\u0e1c\u0e25\u0e2b\u0e19\u0e49\u0e32\u0e19\u0e35\u0e49"
            ],
            "Page weight %1$s in %2$d requests": [
                "\u0e02\u0e19\u0e32\u0e14\u0e2b\u0e19\u0e49\u0e32 %1$s \u0e43\u0e19 %2$d \u0e04\u0e33\u0e02\u0e2d"
            ],
            "Layout shift %s (good: under 0.1)": [
                "\u0e01\u0e32\u0e23\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e02\u0e2d\u0e07\u0e40\u0e25\u0e22\u0e4c\u0e40\u0e2d\u0e32\u0e15\u0e4c %s (\u0e14\u0e35: \u0e15\u0e48\u0e33\u0e01\u0e27\u0e48\u0e32 0.1)"
            ],
            "Largest content shown after %d ms on this computer": [
                "\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e17\u0e35\u0e48\u0e43\u0e2b\u0e0d\u0e48\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e41\u0e2a\u0e14\u0e07\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01 %d \u0e21\u0e34\u0e25\u0e25\u0e34\u0e27\u0e34\u0e19\u0e32\u0e17\u0e35\u0e1a\u0e19\u0e04\u0e2d\u0e21\u0e1e\u0e34\u0e27\u0e40\u0e15\u0e2d\u0e23\u0e4c\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e19\u0e35\u0e49"
            ],
            "Images in the content: %1$s (%2$d)": [
                "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e43\u0e19\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32: %1$s (%2$d)"
            ],
            "The largest image is lazy-loaded, which delays it.": [
                "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e17\u0e35\u0e48\u0e43\u0e2b\u0e0d\u0e48\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e16\u0e39\u0e01\u0e42\u0e2b\u0e25\u0e14\u0e41\u0e1a\u0e1a Lazy-load \u0e0b\u0e36\u0e48\u0e07\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e40\u0e01\u0e34\u0e14\u0e04\u0e27\u0e32\u0e21\u0e25\u0e48\u0e32\u0e0a\u0e49\u0e32"
            ],
            "%d image(s) have no width and height, which can make the page jump.": [
                "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e %d \u0e23\u0e39\u0e1b\u0e44\u0e21\u0e48\u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e01\u0e27\u0e49\u0e32\u0e07\u0e41\u0e25\u0e30\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e39\u0e07 \u0e0b\u0e36\u0e48\u0e07\u0e2d\u0e32\u0e08\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e2b\u0e19\u0e49\u0e32\u0e40\u0e27\u0e47\u0e1a\u0e01\u0e23\u0e30\u0e15\u0e38\u0e01\u0e44\u0e14\u0e49"
            ],
            "An image is larger than it is shown (%1$s). A smaller size saves %2$s.": [
                "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e21\u0e35\u0e02\u0e19\u0e32\u0e14\u0e43\u0e2b\u0e0d\u0e48\u0e01\u0e27\u0e48\u0e32\u0e17\u0e35\u0e48\u0e41\u0e2a\u0e14\u0e07\u0e1c\u0e25 (%1$s) \u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49\u0e02\u0e19\u0e32\u0e14\u0e17\u0e35\u0e48\u0e40\u0e25\u0e47\u0e01\u0e25\u0e07\u0e08\u0e30\u0e0a\u0e48\u0e27\u0e22\u0e1b\u0e23\u0e30\u0e2b\u0e22\u0e31\u0e14\u0e44\u0e14\u0e49 %2$s"
            ],
            "Use the smaller size": [
                "\u0e43\u0e0a\u0e49\u0e02\u0e19\u0e32\u0e14\u0e17\u0e35\u0e48\u0e40\u0e25\u0e47\u0e01\u0e25\u0e07"
            ],
            "%d fix(es) made; save the page, then measure again.": [
                "\u0e41\u0e01\u0e49\u0e44\u0e02\u0e41\u0e25\u0e49\u0e27 %d \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23; \u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e2b\u0e19\u0e49\u0e32\u0e40\u0e27\u0e47\u0e1a \u0e41\u0e25\u0e49\u0e27\u0e27\u0e31\u0e14\u0e04\u0e48\u0e32\u0e43\u0e2b\u0e21\u0e48\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07"
            ]
        }
    }
