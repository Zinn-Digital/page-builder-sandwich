            ],
            "Widget area": [
                "\u0dc0\u0dd2\u0da2\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba"
            ],
            "Choose a widget area": [
                "\u0dc0\u0dd2\u0da2\u0da7\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0d9a\u0dca \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1"
            ],
            "This image has no width and height, so the page will jump when it loads. Choose it from the Media Library, or set its width and height.": [
                "\u0db8\u0dd9\u0db8 \u0dbb\u0dd6\u0db4\u0dba\u0da7 \u0db4\u0dc5\u0dbd\u0d9a\u0dca \u0dc3\u0dc4 \u0d8b\u0dc3\u0d9a\u0dca \u0db1\u0ddc\u0db8\u0dd0\u0dad, \u0d91\u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0d91\u0dba \u0db4\u0dd6\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4\u0dd2\u0da7\u0dd4\u0dc0 \u0db4\u0dd0\u0db1 \u0dba\u0db1\u0dd4 \u0d87\u0dad. \u0d91\u0dba \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dd4\u0dc3\u0dca\u0dad\u0d9a\u0dcf\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0dad\u0ddd\u0dbb\u0db1\u0dca\u0db1, \u0db1\u0dd0\u0dad\u0dc4\u0ddc\u0dad\u0dca \u0d91\u0dc4\u0dd2 \u0db4\u0dc5\u0dbd \u0dc3\u0dc4 \u0d8b\u0dc3 \u0dc3\u0d9a\u0dc3\u0db1\u0dca\u0db1."
            ],
            "This video is not from the Media Library, so its size is unknown and the page will jump when it loads. Upload it to the Media Library instead.": [
                "\u0db8\u0dd9\u0db8 \u0dc0\u0dd3\u0da9\u0dd2\u0dba\u0ddd\u0dc0 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dd4\u0dc3\u0dca\u0dad\u0d9a\u0dcf\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0db1\u0ddc\u0dc0\u0db1 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca, \u0d91\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0db1\u0ddc\u0daf\u0db1\u0dca\u0db1\u0dcf \u0d85\u0dad\u0dbb \u0d91\u0dba \u0db4\u0dd6\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4\u0dd2\u0da7\u0dd4\u0dc0 \u0db4\u0dd0\u0db1\u0dd3\u0db8\u0d9a\u0da7 \u0dbd\u0d9a\u0dca \u0dc0\u0dda. \u0d92 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0d91\u0dba \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0db4\u0dd4\u0dc3\u0dca\u0dad\u0d9a\u0dcf\u0dbd\u0dba\u0da7 \u0d8b\u0da9\u0dd4\u0d9c\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1."
            ],
            "An image, video or frame in this HTML has no width and height, so the page will jump when it loads. Add width and height attributes to it.": [
                "\u0db8\u0dd9\u0db8 HTML \u0dc4\u0dd2 \u0d87\u0dad\u0dd2 \u0dbb\u0dd6\u0db4\u0dba\u0d9a\u0da7, \u0dc0\u0dd3\u0da9\u0dd2\u0dba\u0ddd\u0dc0\u0d9a\u0da7 \u0dc4\u0ddd \u0dbb\u0dcf\u0db8\u0dd4\u0dc0\u0d9a\u0da7 \u0db4\u0dc5\u0dbd \u0dc3\u0dc4 \u0d8b\u0dc3 \u0db1\u0ddc\u0db8\u0dd0\u0dad, \u0d91\u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0d91\u0dba \u0db4\u0dd6\u0dbb\u0dab\u0dba \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4\u0dd2\u0da7\u0dd4\u0dc0 \u0db4\u0db1\u0dd2\u0db1\u0dd4 \u0d87\u0dad. \u0d8a\u0da7 \u0db4\u0dc5\u0dbd \u0dc3\u0dc4 \u0d8b\u0dc3 \u0d9c\u0dd4\u0dab\u0dcf\u0d82\u0d9c \u0d91\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1."
            ],
            "This embed resizes itself after it loads, which moves the content below it. Give it room or place it lower on the page.": [
                "\u0db8\u0dd9\u0db8 \u0d87\u0dbd\u0dca\u0db6\u0da9\u0dba (embed) \u0db4\u0dd6\u0dbb\u0dab\u0dba \u0dc0\u0dd6 \u0db4\u0dc3\u0dd4 \u0d91\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0dca\u0dc0\u0dba\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dd3\u0dba\u0dc0 \u0dc0\u0dd9\u0db1\u0dc3\u0dca \u0dc0\u0db1 \u0d85\u0dad\u0dbb, \u0d91\u0db8\u0d9f\u0dd2\u0db1\u0dca \u0d8a\u0da7 \u0db4\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dca\u0d9c\u0dad\u0dba \u0da0\u0dbd\u0db1\u0dba \u0dc0\u0dda. \u0d8a\u0da7 \u0d89\u0da9 \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0dc4\u0ddd \u0d91\u0dba \u0db4\u0dd2\u0da7\u0dd4\u0dc0\u0dda \u0db4\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0dad\u0db6\u0db1\u0dca\u0db1."
            ],
            "Layout shift": [
                "\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dd0\u0dbd\u0dc3\u0dd4\u0db8\u0dca \u0dc0\u0dd9\u0db1\u0dc3\u0dca \u0dc0\u0dd3\u0db8"
            ]
        }
