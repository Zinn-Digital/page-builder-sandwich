                "domain": "messages",
                "lang": "mr",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Import and export": [
                "\u0906\u092f\u093e\u0924 \u0906\u0923\u093f \u0928\u093f\u0930\u094d\u092f\u093e\u0924"
            ],
            "Import": [
                "\u0906\u092f\u093e\u0924 \u0915\u0930\u093e"
            ],
            "%d new": [
                "%d \u0928\u0935\u0940\u0928",
                "%d \u0928\u0935\u0940\u0928"
            ],
            "%d replaced": [
                "%d \u092c\u0926\u0932\u0932\u0947",
                "%d \u092c\u0926\u0932\u0932\u0947"
            ],
            "%d kept as they were": [
                "%d \u091c\u0938\u0947\u091a\u094d\u092f\u093e \u0924\u0938\u0947 \u0920\u0947\u0935\u0932\u0947",
                "%d \u091c\u0938\u0947\u091a\u094d\u092f\u093e \u0924\u0938\u0947 \u0920\u0947\u0935\u0932\u0947"
            ],
            "%d setting": [
                "%d \u0938\u0947\u091f\u093f\u0902\u0917",
                "%d \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091d"
            ],
            "Importing will give: %s.": [
                "\u0906\u092f\u093e\u0924 \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930 \u092e\u093f\u0933\u0947\u0932: %s."
            ],
            "Imported: %s.": [
                "\u0906\u092f\u093e\u0924 \u0915\u0947\u0932\u0947: %s."
            ],
            "Exported %d item.": [
                "%d \u0906\u092f\u091f\u092e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0947\u0932\u093e.",
                "%d \u0906\u092f\u091f\u092e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0947\u0932\u0947."
            ],
            "That file could not be read as an export file.": [
                "\u0924\u0940 \u092b\u093e\u0907\u0932 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093e\u0907\u0932 \u092e\u094d\u0939\u0923\u0942\u0928 \u0935\u093e\u091a\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0932\u0940 \u0928\u093e\u0939\u0940."
            ],
            "Export": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u093e"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0924\u0941\u092e\u091a\u0947 \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f\u094d\u0938, \u092a\u0945\u091f\u0930\u094d\u0928\u094d\u0938 \u0906\u0923\u093f \u0938\u093e\u0907\u091f \u0921\u093f\u091d\u093e\u0907\u0928 \u0926\u0941\u0938\u0931\u094d\u092f\u093e \u0938\u093e\u0907\u091f\u0935\u0930 \u0906\u092f\u093e\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u092b\u093e\u0908\u0932 \u092e\u094d\u0939\u0923\u0942\u0928 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u093e."
            ],
            "There are no templates or patterns to export yet.": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0926\u094d\u092f\u093e\u092a \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f\u094d\u0938 \u0915\u093f\u0902\u0935\u093e \u092a\u0945\u091f\u0930\u094d\u0928\u094d\u0938 \u0928\u093e\u0939\u0940\u0924."
            ],
            "Include the settings": [
                "\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e"
            ],
            "Download the export file": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093e\u0907\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u093e"
            ],
            "Choose an export file": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093e\u0907\u0932 \u0928\u093f\u0935\u0921\u093e"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0939\u0940 \u092b\u093e\u0908\u0932 %2$s \u0915\u0921\u0942\u0928 %1$d \u0918\u091f\u0915 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0924\u0947.",
                "\u092b\u093e\u092f\u0932\u0940\u092e\u0927\u094d\u092f\u0947 %2$s \u0915\u0921\u0942\u0928 %1$d \u0918\u091f\u0915 \u0906\u0939\u0947\u0924."
            ],
            "When an item with the same name already exists here": [
                "\u091c\u0947\u0935\u094d\u0939\u093e \u092f\u0947\u0925\u0947 \u092f\u093e\u091a \u0928\u093e\u0935\u093e\u091a\u093e \u090f\u0915 \u0918\u091f\u0915 \u0906\u0927\u0940\u092a\u093e\u0938\u0942\u0928 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u093e\u0924 \u0906\u0939\u0947"
            ],
            "Keep the one on this site": [
                "\u092f\u093e \u0938\u093e\u0907\u091f\u0935\u0930\u0940\u0932 \u090f\u0915 \u0920\u0947\u0935\u093e"
            ],
            "Replace it with the imported one": [
                "\u092f\u093e\u0932\u093e \u0906\u092f\u093e\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u092c\u0926\u0932\u0942\u0928 \u091f\u093e\u0915\u093e"
            ],
            "Import a copy beside it": [
                "\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092c\u093e\u091c\u0942\u0932\u093e \u090f\u0915 \u092a\u094d\u0930\u0924 \u0906\u092f\u093e\u0924 \u0915\u0930\u093e"
            ],
            "Apply the settings in the file": [
                "\u092b\u093e\u0907\u0932\u092e\u0927\u0940\u0932 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0932\u093e\u0917\u0942 \u0915\u0930\u093e"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u092f\u093e \u0938\u093e\u0908\u091f\u091a\u094d\u092f\u093e \u092e\u0940\u0921\u093f\u092f\u093e \u0932\u093e\u092f\u092c\u094d\u0930\u0930\u0940\u0924 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0915\u0949\u092a\u0940 \u0915\u0930\u093e"
            ],
            "Show what will happen": [
                "\u0915\u093e\u092f \u0939\u094b\u0908\u0932 \u0924\u0947 \u0926\u093e\u0916\u0935\u093e"
            ]
        }
    }
