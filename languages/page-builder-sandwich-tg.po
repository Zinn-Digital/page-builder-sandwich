#: src/design/a11y/checks.js:340
#, js-format
msgid "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable."
msgstr "Контрасти матн %1$s:1 аст; барои хоно будан он камаш %2$s:1 лозим аст."

