                "%d \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440"
            ],
            "Importing will give: %s.": [
                "\u0418\u043c\u043f\u043e\u0440\u0442 \u043c\u044b\u043d\u0430\u043d\u044b \u0431\u0435\u0440\u0435\u0434\u0456: %s."
            ],
            "Imported: %s.": [
                "\u0418\u043c\u043f\u043e\u0440\u0442\u0442\u0430\u043b\u0434\u044b: %s."
            ],
            "Exported %d item.": [
                "%d \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0442\u0430\u043b\u0434\u044b.",
                "%d \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0442\u0430\u043b\u0434\u044b."
            ],
            "That file could not be read as an export file.": [
                "\u0411\u04b1\u043b \u0444\u0430\u0439\u043b \u044d\u043a\u0441\u043f\u043e\u0440\u0442 \u0444\u0430\u0439\u043b\u044b \u0440\u0435\u0442\u0456\u043d\u0434\u0435 \u043e\u049b\u044b\u043b\u0430 \u0430\u043b\u043c\u0430\u0434\u044b."
            ],
            "Export": [
                "\u042d\u043a\u0441\u043f\u043e\u0440\u0442\u0442\u0430\u0443"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0428\u0430ablon\u0434\u0435\u0440\u0434\u0456, \u04e9\u0440\u043d\u0435\u043a\u0442\u0435\u0440\u0434\u0456 \u0436\u04d9\u043d\u0435 \u0441\u0430\u0439\u0442 \u0434\u0438\u0437\u0430\u0439\u043d\u044b\u043d \u0431\u0430\u0441\u049b\u0430 \u0441\u0430\u0439\u0442\u049b\u0430 \u0438\u043c\u043f\u043e\u0440\u0442\u0442\u0430\u0443 \u04af\u0448\u0456\u043d \u0431\u0456\u0440 \u0444\u0430\u0439\u043b \u0440\u0435\u0442\u0456\u043d\u0434\u0435 \u0436\u04af\u043a\u0442\u0435\u043f \u0430\u043b\u044b\u04a3\u044b\u0437."
            ],
            "There are no templates or patterns to export yet.": [
                "\u04d8\u0437\u0456\u0440\u0433\u0435 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0442\u0430\u043b\u0430\u0442\u044b\u043d \u0448\u0430\u0431\u043b\u043e\u043d\u0434\u0430\u0440 \u043d\u0435\u043c\u0435\u0441\u0435 \u04af\u043b\u0433\u0456\u043b\u0435\u0440 \u0436\u043e\u049b."
            ],
            "Include the settings": [
                "\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043b\u0435\u0440\u0434\u0456 \u049b\u043e\u0441\u0443"
            ],
            "Download the export file": [
                "\u042d\u043a\u0441\u043f\u043e\u0440\u0442 \u0444\u0430\u0439\u043b\u044b\u043d \u0436\u04af\u043a\u0442\u0435\u043f \u0430\u043b\u0443"
            ],
            "Import": [
                "\u0418\u043c\u043f\u043e\u0440\u0442\u0442\u0430\u0443"
            ],
            "Choose an export file": [
                "\u042d\u043a\u0441\u043f\u043e\u0440\u0442 \u0444\u0430\u0439\u043b\u044b\u043d \u0442\u0430\u04a3\u0434\u0430\u04a3\u044b\u0437"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0424\u0430\u0439\u043b %2$s \u0456\u0448\u0456\u043d\u0435\u043d %1$d \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0442\u0456 \u049b\u0430\u043c\u0442\u0438\u0434\u044b.",
                "\u0411\u04b1\u043b \u0444\u0430\u0439\u043b\u0434\u0430 %2$s \u0436\u04af\u0439\u0435\u0441\u0456\u043d\u0435\u043d %1$d \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0431\u0430\u0440."
            ],
            "When an item with the same name already exists here": [
                "\u041c\u04b1\u043d\u0434\u0430 \u0441\u043e\u043b \u0430\u0442\u0430\u0443\u043c\u0435\u043d \u0431\u0430\u0441\u049b\u0430 \u044d\u043b\u0435\u043c\u0435\u043d\u0442 \u0431\u04b1\u0440\u044b\u043d\u043d\u0430\u043d \u0431\u0430\u0440 \u0431\u043e\u043b\u0493\u0430\u043d\u0434\u0430"
            ],
            "Keep the one on this site": [
                "\u041e\u0441\u044b \u0441\u0430\u0439\u0442\u0442\u0430\u0493\u044b\u0441\u044b\u043d \u0441\u0430\u049b\u0442\u0430\u0443"
            ],
            "Replace it with the imported one": [
                "\u041e\u043d\u044b \u0438\u043c\u043f\u043e\u0440\u0442\u0442\u0430\u043b\u0493\u0430\u043d \u043d\u04b1\u0441\u049b\u0430\u043c\u0435\u043d \u0430\u043b\u043c\u0430\u0441\u0442\u044b\u0440\u044b\u04a3\u044b\u0437"
            ],
            "Import a copy beside it": [
                "\u049a\u0430\u0441\u044b\u043d\u0430 \u043a\u04e9\u0448\u0456\u0440\u043c\u0435\u0441\u0456\u043d \u0438\u043c\u043f\u043e\u0440\u0442\u0442\u0430\u0443"
            ],
            "Apply the settings in the file": [
                "\u0424\u0430\u0439\u043b \u043a\u0435\u0437\u0456\u043d\u0434\u0435\u0433\u0456 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043b\u0435\u0440\u0434\u0456 \u049b\u043e\u043b\u0434\u0430\u043d\u0443"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u0421\u0443\u0440\u0435\u0442\u0442\u0435\u0440\u0434\u0456 \u043e\u0441\u044b \u0441\u0430\u0439\u0442\u0442\u044b\u04a3 \u043c\u0435\u0434\u0438\u0430 \u043a\u0456\u0442\u0430\u043f\u0445\u0430\u043d\u0430\u0441\u044b\u043d\u0430 \u043a\u04e9\u0448\u0456\u0440\u0456\u04a3\u0456\u0437"
            ],
            "Show what will happen": [
                "\u041d\u0435 \u0431\u043e\u043b\u0430\u0442\u044b\u043d\u044b\u043d \u043a\u04e9\u0440\u0441\u0435\u0442\u0443"
            ]
        }
    }
