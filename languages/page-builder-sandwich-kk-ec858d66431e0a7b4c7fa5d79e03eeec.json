                "%d \u0436\u0430\u04a3\u0430"
            ],
            "%d replaced": [
                "%d \u0430\u0443\u044b\u0441\u0442\u044b\u0440\u044b\u043b\u0434\u044b",
                "%d \u0430\u0443\u044b\u0441\u0442\u044b\u0440\u044b\u043b\u0434\u044b"
            ],
            "%d kept as they were": [
                "%d \u04e9\u0437\u0433\u0435\u0440\u0456\u0441\u0441\u0456\u0437 \u049b\u0430\u043b\u0434\u044b\u0440\u044b\u043b\u0434\u044b",
                "%d \u04e9\u0437\u0433\u0435\u0440\u0456\u0441\u0441\u0456\u0437 \u049b\u0430\u043b\u0434\u044b\u0440\u044b\u043b\u0434\u044b"
