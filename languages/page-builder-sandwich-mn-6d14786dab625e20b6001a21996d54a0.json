            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0425\u044d\u0440\u044d\u0432 \u0442\u0430\u043d\u044b \u0437\u0430\u0433\u0432\u0430\u0440 \u044d\u0441\u0432\u044d\u043b \u04e9\u04e9\u0440 \u0437\u0430\u043b\u0433\u0430\u0430\u0441 \u0442\u044d\u0434\u0433\u044d\u044d\u0440\u0438\u0439\u0433 \u0430\u043b\u044c \u0445\u044d\u0434\u0438\u0439\u043d \u043d\u044d\u043c\u0441\u044d\u043d \u0431\u043e\u043b \u0443\u043d\u0442\u0440\u0430\u0430\u043d\u0430 \u0443\u0443; \u04af\u0439\u043b \u044f\u0432\u0434\u043b\u0443\u0443\u0434 \u0438\u043b\u0433\u044d\u044d\u0433\u0434\u0441\u044d\u043d \u0445\u044d\u0432\u044d\u044d\u0440 \u0431\u0430\u0439\u0445 \u0431\u043e\u043b\u043d\u043e."
            ],
            "Event name for form submissions": [
                "\u041c\u0430\u044f\u0433\u0442 \u0438\u043b\u0433\u044d\u044d\u0445 \u04af\u0439\u043b \u044f\u0432\u0434\u043b\u044b\u043d \u043d\u044d\u0440"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0411\u0430\u043d\u043d\u0435\u0440 \u0431\u043e\u043b \u0442\u0430\u043d\u044b \u0431\u043b\u043e\u043a\u0443\u0443\u0434\u0430\u0430\u0440 \u0437\u0430\u0433\u0432\u0430\u0440\u0447\u0438\u043b\u0434\u0430\u0433 \u043f\u043e\u043f\u0430\u043f \u0446\u043e\u043d\u0445 \u044e\u043c. \u0422\u04af\u04af\u043d\u0438\u0439 \u0442\u043e\u0432\u0447\u043b\u0443\u0443\u0440\u0443\u0443\u0434 \u043d\u044c #consent-accept, #consent-reject \u0431\u043e\u043b\u043e\u043d #consent-save \u0445\u043e\u043b\u0431\u043e\u043e\u0441 \u0440\u0443\u0443 \u0447\u0438\u0433\u043b\u044d\u043d\u044d (\"save\"-\u0434 \u0437\u043e\u0440\u0438\u0443\u043b\u0441\u0430\u043d analytics \u0431\u043e\u043b\u043e\u043d marketing \u043d\u044d\u0440\u0442\u044d\u0439 \u0441\u043e\u043d\u0433\u043e\u0445 \u043d\u04af\u0434\u043d\u04af\u04af\u0434\u0442\u044d\u0439); \u0445\u0430\u0430\u043d\u0430 \u0447 \u0431\u0430\u0439\u0440\u043b\u0430\u0445 #consent-open \u0445\u043e\u043b\u0431\u043e\u043e\u0441 \u043d\u044c \u04af\u04af\u043d\u0438\u0439\u0433 \u0434\u0430\u0445\u0438\u043d \u0445\u0430\u0440\u0443\u0443\u043b\u043d\u0430. \u0417\u043e\u0447\u0438\u043d \u0437\u04e9\u0432\u0448\u04e9\u04e9\u0440\u04e9\u0445 \u0445\u04af\u0440\u0442\u044d\u043b \u043c\u04e9\u0440\u0434\u04e9\u0445 \u0448\u043e\u0448\u0433\u043e \u0430\u0447\u0430\u0430\u043b\u0430\u0433\u0434\u0430\u0445\u0433\u04af\u0439, Google Consent Mode \u043d\u044c \"denied\" \u0445\u044d\u0432\u044d\u044d\u0440 \u04af\u043b\u0434\u044d\u0436, \u0442\u0430\u043d\u044b \u0436\u0430\u0433\u0441\u0430\u0430\u0441\u0430\u043d \u0441\u043a\u0440\u0438\u043f\u0442\u04af\u04af\u0434 \u0443\u043d\u0442\u0430\u0440\u0441\u0430\u043d \u0445\u044d\u0432\u044d\u044d\u0440 \u0431\u0430\u0439\u043d\u0430."
            ],
            "Create a ready-made banner": [
                "\u0411\u044d\u043b\u044d\u043d \u0431\u0430\u043d\u043d\u0435\u0440 \u04af\u04af\u0441\u0433\u044d\u0445"
            ],
            "Show a cookie banner": [
                "\u041a\u04af\u04af\u043a\u0438 \u0431\u0430\u043d\u043d\u0435\u0440\u044b\u0433 \u0445\u0430\u0440\u0443\u0443\u043b\u0430\u0445"
            ],
            "Banner": [
