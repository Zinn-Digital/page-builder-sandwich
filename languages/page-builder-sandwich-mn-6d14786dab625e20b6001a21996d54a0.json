            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u0423\u0434\u0438\u0440\u0434\u0430\u043c\u0436\u0443\u0443\u0434: \u043c\u0430\u044f\u0433\u0442\u0443\u0443\u0434, \u043f\u043e\u043f-\u0430\u043f \u0446\u043e\u043d\u0445\u043d\u0443\u0443\u0434, \u0445\u04e9\u0434\u04e9\u043b\u0433\u04e9\u04e9\u043d, \u043c\u04e9\u0448\u0433\u0438\u0445 \u04af\u0439\u043b\u0434\u044d\u043b, A\/B \u0442\u0435\u0441\u0442\u04af\u04af\u0434 \u0431\u043e\u043b\u043e\u043d \u043a\u04af\u04af\u043a\u0438\u043d\u0438\u0439 \u0431\u0430\u043d\u043d\u0435\u0440"
