            ],
            "Remember the choice for (days)": [
                "\u0421\u043e\u043d\u0433\u043e\u043b\u0442\u044b\u0433 (\u04e9\u0434\u04e9\u0440)-\u0438\u0439\u043d \u0442\u0443\u0440\u0448 \u0441\u0430\u043d\u0430\u0445"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u0415\u0432\u0440\u043e\u043f\u044b\u043d \u0425\u043e\u043b\u0431\u043e\u043e, \u0415\u042d\u0411 \u0431\u043e\u043b\u043e\u043d \u0418\u0445 \u0411\u0440\u0438\u0442\u0430\u043d\u0438\u0430\u0441 \u0433\u0430\u0434\u0443\u0443\u0440: \u0437\u043e\u0447\u0438\u043d \u0442\u0430\u0442\u0433\u0430\u043b\u0437\u0430\u0445 \u0445\u04af\u0440\u0442\u044d\u043b \u043c\u04e9\u0440\u0434\u04e9\u043b\u0442\u0438\u0439\u0433 \u0430\u0447\u0430\u0430\u043b\u043d\u0430 \u0443\u0443"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u0423\u043d\u0442\u0440\u0430\u0430\u0445: \u0437\u043e\u0447\u0438\u043d \u0431\u04af\u0440 \u044d\u0445\u043b\u044d\u044d\u0434 \u0437\u04e9\u0432\u0448\u04e9\u04e9\u0440\u04e9\u0445 \u0451\u0441\u0442\u043e\u0439 (\u0445\u0430\u043c\u0433\u0438\u0439\u043d \u0445\u0430\u0442\u0443\u0443 \u0434\u04af\u0440\u044d\u043c \u0431\u04e9\u0433\u04e9\u04e9\u0434 \u0430\u043d\u0445\u0434\u0430\u0433\u0447 \u0442\u043e\u0445\u0438\u0440\u0433\u043e\u043e). \u0410\u0441\u0430\u0430\u0445: \u0437\u04e9\u0432\u0445\u04e9\u043d \u0442\u0430\u043d\u044b \u0445\u043e\u0441\u0442 \u044d\u0441\u0432\u044d\u043b CDN \u0437\u043e\u0447\u043d\u044b \u0443\u043b\u0441\u044b\u0433 \u043c\u044d\u0434\u044d\u044d\u043b\u0441\u044d\u043d \u04af\u0435\u0434 (\u0436\u0438\u0448\u044d\u044d\u043b\u0431\u044d\u043b Cloudflare-\u0438\u0439\u043d CF-IPCountry \u0442\u043e\u043b\u0433\u043e\u0439 \u0445\u044d\u0441\u044d\u0433) \u0431\u0430 \u044d\u043d\u044d \u043d\u044c EU, EEA, UK \u0431\u043e\u043b\u043e\u043d \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0430\u0430\u0441 \u0433\u0430\u0434\u0443\u0443\u0440 \u0431\u0430\u0439\u0445 \u0442\u043e\u0445\u0438\u043e\u043b\u0434\u043e\u043b\u0434 \u043b \u0445\u044d\u0440\u044d\u0433\u0436\u0438\u043d\u044d. \u0411\u0430\u043d\u043d\u0435\u0440 \u0445\u0430\u0440\u0430\u0433\u0434\u0441\u0430\u043d \u0445\u044d\u0432\u044d\u044d\u0440 \u0431\u0430\u0439\u0445 \u0431\u0430 \u0442\u043e\u0434\u043e\u0440\u0445\u043e\u0439\u0433\u04af\u0439 \u0443\u043b\u0441\u044b\u0433 EU \u0434\u043e\u0442\u043e\u0440 \u0431\u0430\u0439\u0433\u0430\u0430\u0434 \u0442\u043e\u043e\u0446\u043d\u043e."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0417\u04e9\u0432\u0448\u04e9\u04e9\u0440\u04e9\u043b \u04e9\u0433\u04e9\u0445 \u0445\u04af\u0440\u0442\u044d\u043b \u0431\u0430\u0440\u0438\u0445 \u0431\u0443\u0441\u0430\u0434 \u0441\u043a\u0440\u0438\u043f\u0442\u04af\u04af\u0434 (handle:analytics \u044d\u0441\u0432\u044d\u043b handle:marketing, \u0442\u0430\u0441\u043b\u0430\u043b\u0430\u0430\u0440 \u0442\u0443\u0441\u0433\u0430\u0430\u0440\u043b\u0430\u0433\u0434\u0441\u0430\u043d)"
            ],
            "Popups, slide-ins and bars": [
                "\u0425\u04e9\u0432\u04e9\u0433\u0447 \u0446\u043e\u043d\u0445, \u0433\u0443\u043b\u0441\u0430\u0436 \u0433\u0430\u0440\u0447 \u0438\u0440\u044d\u0445 \u0442\u0430\u043b\u0431\u0430\u0440 \u0431\u0430 \u043c\u04e9\u0440\u04af\u04af\u0434"
