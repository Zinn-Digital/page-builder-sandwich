            "Class name prefix": [
                "\u041f\u0440\u0435\u0444\u0456\u043a\u0441 \u0456\u043c\u0435\u043d\u0456 \u043a\u043b\u0430\u0441\u0443"
            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u041a\u043e\u0436\u043d\u0430 \u043d\u0430\u0437\u0432\u0430 \u043a\u043b\u0430\u0441\u0443, \u044f\u043a\u0443 \u043f\u043b\u0430\u0433\u0456\u043d \u0432\u0438\u0432\u043e\u0434\u0438\u0442\u044c \u043d\u0430 \u0432\u0430\u0448\u0438\u0445 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430\u0445, \u043f\u043e\u0447\u0438\u043d\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u0446\u044c\u043e\u0433\u043e \u043f\u0440\u0435\u0444\u0456\u043a\u0441\u0430, \u0449\u043e\u0431 \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u043d\u0435 \u0440\u043e\u0437\u043a\u0440\u0438\u0432\u0430\u043b\u0438, \u044f\u043a\u0438\u0439 \u043f\u043b\u0430\u0433\u0456\u043d \u0457\u0445 \u0441\u0442\u0432\u043e\u0440\u0438\u0432. \u0412\u0456\u0434 1 \u0434\u043e 8 \u043c\u0430\u043b\u0438\u0445 \u043b\u0456\u0442\u0435\u0440 \u0430\u0431\u043e \u0446\u0438\u0444\u0440, \u0449\u043e \u043f\u043e\u0447\u0438\u043d\u0430\u044e\u0442\u044c\u0441\u044f \u0437 \u043b\u0456\u0442\u0435\u0440\u0438."
            ],
            "Save": [
                "\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438"
            ],
            "Beta updates": [
                "\u0411\u0435\u0442\u0430-\u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
            ],
            "This site receives beta versions as updates.": [
                "\u0426\u0435\u0439 \u0441\u0430\u0439\u0442 \u043e\u0442\u0440\u0438\u043c\u0443\u0454 \u0431\u0435\u0442\u0430-\u0432\u0435\u0440\u0441\u0456\u0457 \u044f\u043a \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f."
            ],
            "This site receives stable versions only.": [
                "\u0426\u0435\u0439 \u0441\u0430\u0439\u0442 \u043e\u0442\u0440\u0438\u043c\u0443\u0454 \u043b\u0438\u0448\u0435 \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0456 \u0432\u0435\u0440\u0441\u0456\u0457."
            ],
            "Change this on the Account page": [
                "\u0417\u043c\u0456\u043d\u0456\u0442\u044c \u0446\u0435 \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u0411\u0435\u0442\u0430-\u0432\u0435\u0440\u0441\u0456\u0457 \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u043b\u0456\u0446\u0435\u043d\u0437\u043e\u0432\u0430\u043d\u0438\u0445 \u0456\u043d\u0441\u0442\u0430\u043b\u044f\u0446\u0456\u0439 Pro, \u044f\u043a\u0456 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0456 \u0434\u043e \u0441\u0432\u043e\u0433\u043e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443. \u041f\u0456\u0441\u043b\u044f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0434\u043e\u043b\u0443\u0447\u0438\u0442\u0438\u0441\u044f \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443."
