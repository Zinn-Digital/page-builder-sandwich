            ],
            "Restore every converted post to its legacy content? Changes made to those posts since they were converted will be lost.": [
                "\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043a\u043e\u0436\u043d\u0443 \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u043e\u0432\u0430\u043d\u0443 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u044e \u0434\u043e \u0457\u0457 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0432\u043c\u0456\u0441\u0442\u0443? \u0417\u043c\u0456\u043d\u0438, \u0432\u043d\u0435\u0441\u0435\u043d\u0456 \u0434\u043e \u0446\u0438\u0445 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0439 \u043f\u0456\u0441\u043b\u044f \u0457\u0445 \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u0430\u0446\u0456\u0457, \u0431\u0443\u0434\u0443\u0442\u044c \u0432\u0442\u0440\u0430\u0447\u0435\u043d\u0456."
            ],
            "Undo started. It continues in the background; you can leave this page.": [
                "\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u043e. \u0412\u043e\u043d\u043e \u0442\u0440\u0438\u0432\u0430\u0454 \u0443 \u0444\u043e\u043d\u043e\u0432\u043e\u043c\u0443 \u0440\u0435\u0436\u0438\u043c\u0456; \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u0430\u0442\u0438 \u0446\u044e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443."
            ],
            "Undo all conversions": [
                "\u0421\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0456 \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u0430\u0446\u0456\u0457"
            ]
        }
    }
}
