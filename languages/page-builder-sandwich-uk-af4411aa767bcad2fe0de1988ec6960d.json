                "%d \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0439 \u043c\u0430\u044e\u0442\u044c \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443 \u043a\u043e\u043f\u0456\u044e.",
                "%d \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0439 \u043c\u0430\u044e\u0442\u044c \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443 \u043a\u043e\u043f\u0456\u044e."
            ],
            "%d post could not be handled": [
                "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 %d \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u044e",
                "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 %d \u0434\u043e\u043f\u0438\u0441\u0456\u0432",
                "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 %d \u0434\u043e\u043f\u0438\u0441\u0456\u0432"
            ],
            "Post %d": [
                "\u0414\u043e\u043f\u0438\u0441 %d"
            ],
            "Conversion started. It continues in the background; you can leave this page.": [
                "\u041a\u043e\u043d\u0432\u0435\u0440\u0442\u0430\u0446\u0456\u044e \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u043e. \u0412\u043e\u043d\u0430 \u0442\u0440\u0438\u0432\u0430\u0454 \u0443 \u0444\u043e\u043d\u043e\u0432\u043e\u043c\u0443 \u0440\u0435\u0436\u0438\u043c\u0456; \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043b\u0438\u0448\u0430\u0442\u0438 \u0446\u044e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0443."
            ],
            "Convert legacy content": [
