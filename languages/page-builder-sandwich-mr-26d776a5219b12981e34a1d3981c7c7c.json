            ],
            "Your Google and Trustpilot details, for the Reviews block.": [
                "\u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u092c\u094d\u0932\u0949\u0915\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u0947 Google \u0906\u0923\u093f Trustpilot \u0924\u092a\u0936\u0940\u0932."
