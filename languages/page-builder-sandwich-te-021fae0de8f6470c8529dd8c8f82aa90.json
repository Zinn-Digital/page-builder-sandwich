            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0c2b\u0c3f\u0c32\u0c4d\u0c1f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c28\u0c3f HTML\u0c28\u0c41 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c17\u0c32 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c05\u0c28\u0c41\u0c15\u0c42\u0c32 CSS\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c17\u0c32\u0c30\u0c41."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0c08 CSS\u0c32\u0c4b \u0c15\u0c4a\u0c02\u0c24 \u0c2d\u0c3e\u0c17\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c26\u0c41: \u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c15\u0c4b\u0c38\u0c02 @import, expression(), javascript: URLs, \"<\" \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c28\u0c3f \u0c2c\u0c4d\u0c30\u0c3e\u0c15\u0c46\u0c1f\u0c4d\u200c\u0c32\u0c41 \u0c24\u0c40\u0c38\u0c3f\u0c35\u0c47\u0c2f\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f."
            ],
            "Page CSS": [
                "\u0c2a\u0c47\u0c1c\u0c40 CSS"
            ],
            "Global classes": [
                "\u0c17\u0c4d\u0c32\u0c4b\u0c2c\u0c32\u0c4d \u0c24\u0c30\u0c17\u0c24\u0c41\u0c32\u0c41"
            ],
            "Classes": [
                "\u0c24\u0c30\u0c17\u0c24\u0c41\u0c32\u0c41"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0c38\u0c48\u0c1f\u0c4d \u0c21\u0c3f\u0c1c\u0c48\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c24\u0c30\u0c17\u0c24\u0c41\u0c32\u0c28\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c06\u0c2a\u0c48 \u0c35\u0c3e\u0c1f\u0c3f\u0c28\u0c3f \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f."
            ],
            "Custom CSS": [
                "\u0c05\u0c28\u0c41\u0c15\u0c42\u0c32 CSS"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u0c08 \u0c2e\u0c42\u0c32\u0c15\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c28\u0c3f\u0c2f\u0c2e\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c4d\u0c30\u0c3e\u0c2f\u0c02\u0c21\u0c3f. \"selector\" \u0c05\u0c02\u0c1f\u0c47 \u0c08 \u0c2e\u0c42\u0c32\u0c15\u0c02 \u0c05\u0c28\u0c3f \u0c05\u0c30\u0c4d\u0c25\u0c02, \u0c09\u0c26\u0c3e. selector:hover { opacity: .8 } \u2014 \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c2a\u0c4d\u0c30\u0c15\u0c1f\u0c28\u0c32\u0c41 \u0c2e\u0c42\u0c32\u0c15\u0c3e\u0c28\u0c3f\u0c15\u0c47 \u0c35\u0c30\u0c4d\u0c24\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f."
            ],
            "CSS for this page": [
                "\u0c08 \u0c2a\u0c47\u0c1c\u0c40 \u0c15\u0c4b\u0c38\u0c02 CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0c38\u0c48\u0c1f\u0c4d \u0c36\u0c48\u0c32\u0c41\u0c32 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c08 \u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c4b \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c32\u0c4b\u0c21\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2a\u0c47\u0c1c\u0c40\u0c24\u0c4b \u0c2a\u0c3e\u0c1f\u0c41 \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f."
            ]
        }
    }
