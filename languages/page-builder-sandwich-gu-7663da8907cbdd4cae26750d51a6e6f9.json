            ],
            "Copy the Access Key ID and the Secret Access Key it shows (the secret is shown only once).": [
                "\u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2 Access Key ID \u0a85\u0aa8\u0ac7 Secret Access Key \u0aa8\u0ac0 \u0aa8\u0a95\u0ab2 \u0a95\u0ab0\u0acb (\u0a97\u0ac1\u0aaa\u0acd\u0aa4 \u0a95\u0ac0 \u0aab\u0a95\u0acd\u0aa4 \u0a8f\u0a95 \u0a9c \u0ab5\u0abe\u0ab0 \u0aac\u0aa4\u0abe\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7)."
