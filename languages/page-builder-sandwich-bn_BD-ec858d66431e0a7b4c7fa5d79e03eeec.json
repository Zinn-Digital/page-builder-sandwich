            },
            "Import and export": [
                "\u0986\u09ae\u09a6\u09be\u09a8\u09bf \u098f\u09ac\u0982 \u09b0\u09aa\u09cd\u09a4\u09be\u09a8\u09bf"
            ],
            "Import": [
                "\u0986\u09ae\u09a6\u09be\u09a8\u09bf \u0995\u09b0\u09c1\u09a8"
            ],
            "%d new": [
                "%d\u099f\u09bf \u09a8\u09a4\u09c1\u09a8",
                "%d\u099f\u09bf \u09a8\u09a4\u09c1\u09a8"
            ],
            "%d replaced": [
                "%d\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u09b8\u09cd\u09a5\u09be\u09aa\u09bf\u09a4 \u09b9\u09df\u09c7\u099b\u09c7",
                "%d\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u09b8\u09cd\u09a5\u09be\u09aa\u09bf\u09a4 \u09b9\u09df\u09c7\u099b\u09c7"
            ],
            "%d kept as they were": [
                "%d\u099f\u09bf \u0985\u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09bf\u09a4 \u09b0\u09be\u0996\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7",
                "%d\u099f\u09bf \u0986\u0997\u09c7\u09b0 \u09ae\u09a4\u09cb\u0987 \u09b0\u09be\u0996\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7"
            ],
            "%d setting": [
                "%d\u099f\u09bf \u09b8\u09c7\u099f\u09bf\u0982",
                "%d\u099f\u09bf \u09b8\u09c7\u099f\u09bf\u0982\u09b8"
            ],
            "Importing will give: %s.": [
                "\u0987\u09ae\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09b2\u09c7 \u09aa\u09be\u0993\u09df\u09be \u09af\u09be\u09ac\u09c7: %s."
            ],
            "Imported: %s.": [
                "\u0986\u09ae\u09a6\u09be\u09a8\u09bf \u0995\u09b0\u09be \u09b9\u09df\u09c7\u099b\u09c7: %s\u0964"
            ],
            "Exported %d item.": [
                "%d\u099f\u09bf \u0986\u0987\u099f\u09c7\u09ae \u098f\u0995\u09cd\u09b8\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09be \u09b9\u09df\u09c7\u099b\u09c7\u0964",
                "%d\u099f\u09bf \u0989\u09aa\u09be\u09a6\u09be\u09a8 \u09b0\u09aa\u09cd\u09a4\u09be\u09a8\u09bf \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964"
            ],
            "That file could not be read as an export file.": [
                "\u09ab\u09be\u0987\u09b2\u099f\u09bf \u098f\u0995\u09cd\u09b8\u09aa\u09cb\u09b0\u09cd\u099f \u09ab\u09be\u0987\u09b2 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09aa\u09dc\u09be \u09af\u09be\u09df\u09a8\u09bf\u0964"
            ],
            "Export": [
                "\u09b0\u09aa\u09cd\u09a4\u09be\u09a8\u09bf \u0995\u09b0\u09c1\u09a8"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0985\u09a8\u09cd\u09af \u09b8\u09be\u0987\u099f\u09c7 \u0986\u09ae\u09a6\u09be\u09a8\u09bf \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 \u099f\u09c7\u09ae\u09aa\u09cd\u09b2\u09c7\u099f, \u09aa\u09cd\u09af\u09be\u099f\u09be\u09b0\u09cd\u09a8 \u098f\u09ac\u0982 \u09b8\u09be\u0987\u099f\u09c7\u09b0 \u09a1\u09bf\u099c\u09be\u0987\u09a8 \u098f\u0995\u099f\u09bf \u09ab\u09be\u0987\u09b2 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8\u0964"
            ],
            "There are no templates or patterns to export yet.": [
                "\u09b0\u09aa\u09cd\u09a4\u09be\u09a8\u09bf \u0995\u09b0\u09be\u09b0 \u09ae\u09a4\u09cb \u098f\u0996\u09a8\u0993 \u0995\u09cb\u09a8\u09cb \u099f\u09c7\u09ae\u09aa\u09cd\u09b2\u09c7\u099f \u09ac\u09be \u09aa\u09cd\u09af\u09be\u099f\u09be\u09b0\u09cd\u09a8 \u09a8\u09c7\u0987\u0964"
            ],
            "Include the settings": [
                "\u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8"
            ],
            "Download the export file": [
                "\u09b0\u09aa\u09cd\u09a4\u09be\u09a8\u09bf \u09ab\u09be\u0987\u09b2\u099f\u09bf \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8"
            ],
            "Choose an export file": [
                "\u098f\u0995\u099f\u09bf \u098f\u0995\u09cd\u09b8\u09aa\u09cb\u09b0\u09cd\u099f \u09ab\u09be\u0987\u09b2 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u09ab\u09be\u0987\u09b2\u099f\u09bf\u09a4\u09c7 %2$s \u09a5\u09c7\u0995\u09c7 %1$d\u099f\u09bf \u0986\u0987\u099f\u09c7\u09ae \u09b0\u09df\u09c7\u099b\u09c7\u0964",
                "\u09ab\u09be\u0987\u09b2\u099f\u09bf\u09a4\u09c7 %2$s \u09a5\u09c7\u0995\u09c7 %1$d\u099f\u09bf \u0986\u0987\u099f\u09c7\u09ae \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964"
            ],
            "When an item with the same name already exists here": [
                "\u098f\u0995\u0987 \u09a8\u09be\u09ae\u09c7\u09b0 \u098f\u0995\u099f\u09bf \u0986\u0987\u099f\u09c7\u09ae \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u09ac\u09bf\u09a6\u09cd\u09af\u09ae\u09be\u09a8 \u09a5\u09be\u0995\u09b2\u09c7"
            ],
            "Keep the one on this site": [
                "\u098f\u0987 \u09b8\u09be\u0987\u099f\u09c7\u09b0\u099f\u09bf \u09b0\u09be\u0996\u09c1\u09a8"
            ],
            "Replace it with the imported one": [
                "\u0986\u09ae\u09a6\u09be\u09a8\u09bf \u0995\u09b0\u09be\u099f\u09bf \u09a6\u09bf\u09af\u09bc\u09c7 \u098f\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09c1\u09a8"
            ],
            "Import a copy beside it": [
                "\u098f\u09b0 \u09aa\u09be\u09b6\u09c7 \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b2\u09bf\u09aa\u09bf \u0986\u09ae\u09a6\u09be\u09a8\u09bf \u0995\u09b0\u09c1\u09a8"
            ],
            "Apply the settings in the file": [
                "\u09ab\u09be\u0987\u09b2\u09c7\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u0997 \u0995\u09b0\u09c1\u09a8"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u099b\u09ac\u09bf\u0997\u09c1\u09b2\u09cb \u098f\u0987 \u09b8\u09be\u0987\u099f\u09c7\u09b0 \u09ae\u09bf\u09a1\u09bf\u09af\u09bc\u09be \u09b2\u09be\u0987\u09ac\u09cd\u09b0\u09c7\u09b0\u09bf\u09a4\u09c7 \u0985\u09a8\u09c1\u09b2\u09bf\u09aa\u09bf \u0995\u09b0\u09c1\u09a8"
            ],
            "Show what will happen": [
                "\u0995\u09c0 \u0998\u099f\u09ac\u09c7 \u09a4\u09be \u09a6\u09c7\u0996\u09c1\u09a8"
            ]
        }
    }
