            ],
            "Every class name the plugin prints on your pages starts with this prefix, so the pages do not reveal which plugin built them. 1 to 8 lowercase letters or digits, starting with a letter.": [
                "\u05db\u05dc \u05e9\u05dd \u05de\u05d7\u05dc\u05e7\u05d4 \u05e9\u05d4\u05ea\u05d5\u05e1\u05e3 \u05de\u05d3\u05e4\u05d9\u05e1 \u05d1\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05e9\u05dc\u05da \u05de\u05ea\u05d7\u05d9\u05dc \u05d1\u05e7\u05d9\u05d3\u05d5\u05de\u05ea \u05d6\u05d5, \u05db\u05da \u05e9\u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05d7\u05d5\u05e9\u05e4\u05d9\u05dd \u05d0\u05d9\u05d6\u05d4 \u05ea\u05d5\u05e1\u05e3 \u05d1\u05e0\u05d4 \u05d0\u05d5\u05ea\u05dd. 1 \u05e2\u05d3 8 \u05d0\u05d5\u05ea\u05d9\u05d5\u05ea \u05e7\u05d8\u05e0\u05d5\u05ea \u05d0\u05d5 \u05e1\u05e4\u05e8\u05d5\u05ea, \u05d4\u05de\u05ea\u05d7\u05d9\u05dc\u05d5\u05ea \u05d1\u05d0\u05d5\u05ea."
            ],
            "Save": [
                "\u05e9\u05de\u05d5\u05e8"
            ],
            "Beta updates": [
                "\u05e2\u05d3\u05db\u05d5\u05e0\u05d9 \u05d1\u05d8\u05d0"
            ],
            "This site receives beta versions as updates.": [
                "\u05d0\u05ea\u05e8 \u05d6\u05d4 \u05de\u05e7\u05d1\u05dc \u05d2\u05e8\u05e1\u05d0\u05d5\u05ea \u05d1\u05d8\u05d0 \u05db\u05e2\u05d3\u05db\u05d5\u05e0\u05d9\u05dd."
            ],
            "This site receives stable versions only.": [
                "\u05d0\u05ea\u05e8 \u05d6\u05d4 \u05de\u05e7\u05d1\u05dc \u05d2\u05e8\u05e1\u05d0\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3."
            ],
            "Change this on the Account page": [
                "\u05e9\u05e0\u05d4 \u05d6\u05d0\u05ea \u05d1\u05d3\u05e3 \u05d4\u05d7\u05e9\u05d1\u05d5\u05df"
            ],
            "Beta versions are offered to licensed Pro installations that are connected to their account. Once connected, you can join from the Account page.": [
                "\u05d2\u05e8\u05e1\u05d0\u05d5\u05ea \u05d1\u05d8\u05d0 \u05de\u05d5\u05e6\u05e2\u05d5\u05ea \u05dc\u05d4\u05ea\u05e7\u05e0\u05d5\u05ea Pro \u05d1\u05e2\u05dc\u05d5\u05ea \u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05d4\u05de\u05d7\u05d5\u05d1\u05e8\u05d5\u05ea \u05dc\u05d7\u05e9\u05d1\u05d5\u05df \u05e9\u05dc\u05d4\u05df. \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8, \u05d1\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea\u05da \u05dc\u05d4\u05e6\u05d8\u05e8\u05e3 \u05de\u05e2\u05de\u05d5\u05d3 \u05d4\u05d7\u05e9\u05d1\u05d5\u05df."
            ],
            "The request converting this post stopped before it finished, so the post was skipped. Open it to convert it, or convert it again from here.": [
                "\u05d4\u05d1\u05e7\u05e9\u05d4 \u05dc\u05d4\u05de\u05e8\u05ea \u05e4\u05d5\u05e1\u05d8 \u05d6\u05d4 \u05e0\u05e2\u05e6\u05e8\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05d5\u05e9\u05dc\u05de\u05d4, \u05d5\u05dc\u05db\u05df \u05d4\u05e4\u05d5\u05e1\u05d8 \u05d3\u05d5\u05dc\u05d2. \u05e4\u05ea\u05d7 \u05d0\u05d5\u05ea\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d4\u05de\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d5, \u05d0\u05d5 \u05d4\u05de\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05e9\u05d5\u05d1 \u05de\u05db\u05d0\u05df."
            ],
            "There is no backup of this post to restore.": [
                "\u05d0\u05d9\u05df \u05d2\u05d9\u05d1\u05d5\u05d9 \u05e9\u05dc \u05e4\u05d5\u05e1\u05d8 \u05d6\u05d4 \u05dc\u05e9\u05d7\u05d6\u05d5\u05e8."
            ],
            "The converted content could not be saved.": [
                "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05d4\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d5\u05de\u05e8."
            ],
            "Unknown error.": [
