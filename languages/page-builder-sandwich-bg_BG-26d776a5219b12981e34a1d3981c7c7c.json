            ],
            "Your Google and Trustpilot details, for the Reviews block.": [
                "\u0412\u0430\u0448\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u0438 \u0437\u0430 Google \u0438 Trustpilot \u0437\u0430 \u0431\u043b\u043e\u043a\u0430 \u0441 \u043e\u0442\u0437\u0438\u0432\u0438."
