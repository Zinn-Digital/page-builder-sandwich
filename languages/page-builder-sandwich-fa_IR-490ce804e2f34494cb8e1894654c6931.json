            ],
            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u06cc\u06a9 \u0628\u0631\u0631\u0633\u06cc \u062e\u0648\u062f\u06a9\u0627\u0631 \u0645\u0634\u06a9\u0644\u0627\u062a \u0632\u06cc\u0627\u062f\u06cc \u0631\u0627 \u067e\u06cc\u062f\u0627 \u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0627\u0645\u0627 \u0646\u0647 \u0647\u0645\u0647 \u0622\u0646\u200c\u0647\u0627. \u0647\u0645\u0686\u0646\u06cc\u0646 \u0635\u0641\u062d\u0647 \u0631\u0627 \u0641\u0642\u0637 \u0628\u0627 \u0635\u0641\u062d\u0647 \u06a9\u0644\u06cc\u062f \u0648 \u0628\u0627 \u06cc\u06a9 \u0635\u0641\u062d\u0647 \u062e\u0648\u0627\u0646 \u0627\u0645\u062a\u062d\u0627\u0646 \u06a9\u0646\u06cc\u062f."
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u062a\u0636\u0627\u062f \u0631\u0646\u06af \u0645\u062a\u0646 %1$s:1 \u0627\u0633\u062a\u061b \u0628\u0631\u0627\u06cc \u062e\u0648\u0627\u0646\u0627 \u0628\u0648\u062f\u0646 \u062d\u062f\u0627\u0642\u0644 \u0628\u0647 %2$s:1 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u062f."
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u0627\u06cc\u0646\u062c\u0627 \u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f,\u0627\u06cc\u0646\u062c\u0627,\u0628\u06cc\u0634\u062a\u0631 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f,\u0628\u06cc\u0634\u062a\u0631,\u067e\u06cc\u0648\u0646\u062f,\u0627\u06cc\u0646 \u067e\u06cc\u0648\u0646\u062f,\u0628\u06cc\u0634\u062a\u0631 \u0628\u062f\u0627\u0646\u06cc\u062f,\u0628\u0631\u0648"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u06cc\u06a9 \u067e\u06cc\u0648\u0646\u062f \u0647\u06cc\u0686 \u0645\u062a\u0646\u06cc \u0646\u062f\u0627\u0631\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0635\u0641\u062d\u0647\u200c\u062e\u0648\u0627\u0646 \u0641\u0642\u0637 \u0639\u0628\u0627\u0631\u062a \u00ab\u067e\u06cc\u0648\u0646\u062f\u00bb \u0631\u0627 \u0627\u0639\u0644\u0627\u0645 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0645\u062a\u0646 \u06cc\u0627 \u0628\u0631\u0686\u0633\u0628\u06cc \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f."
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\u0645\u062a\u0646 \u0644\u06cc\u0646\u06a9 \u00ab%s\u00bb \u0645\u0642\u0635\u062f \u0622\u0646 \u0631\u0627 \u0645\u0634\u062e\u0635 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f. \u0628\u0647 \u062c\u0627\u06cc \u0622\u0646\u060c \u0645\u0642\u0635\u062f \u0631\u0627 \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0646\u06cc\u062f."
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u06cc\u06a9 \u0639\u0646\u0635\u0631 \u062f\u0627\u0631\u0627\u06cc \u06cc\u06a9 tabindex \u0645\u062b\u0628\u062a \u0627\u0633\u062a \u06a9\u0647 \u062a\u0631\u062a\u06cc\u0628 \u0635\u0641\u062d\u0647 \u06a9\u0644\u06cc\u062f \u0631\u0627 \u0627\u0632 \u062a\u0631\u062a\u06cc\u0628 \u062e\u0648\u0627\u0646\u062f\u0646 \u062a\u063a\u06cc\u06cc\u0631 \u0645\u06cc\u200c\u062f\u0647\u062f. \u0627\u0632 0 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f \u06cc\u0627 \u0622\u0646 \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f."
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646 \u0628\u0627 \u0635\u0641\u062d\u0647 \u06a9\u0644\u06cc\u062f \u0628\u0647 \u06cc\u06a9 \u0639\u0646\u0635\u0631 \u0642\u0627\u0628\u0644 \u06a9\u0644\u06cc\u06a9 \u062f\u0633\u062a\u0631\u0633\u06cc \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f. \u0627\u0632 \u06cc\u06a9 \u062f\u06a9\u0645\u0647 \u06cc\u0627 \u067e\u06cc\u0648\u0646\u062f \u0648\u0627\u0642\u0639\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f."
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u06cc\u06a9 \u0641\u0631\u06cc\u0645 \u062c\u0627\u0633\u0627\u0632\u06cc\u200c\u0634\u062f\u0647 \u0639\u0646\u0648\u0627\u0646\u06cc \u0646\u062f\u0627\u0631\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0635\u0641\u062d\u0647 \u062e\u0648\u0627\u0646 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u06af\u0648\u06cc\u062f \u0686\u06cc\u0633\u062a."
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u06cc\u06a9 \u0641\u06cc\u0644\u062f \u0641\u0631\u0645 \u0628\u0631\u0686\u0633\u0628 \u0646\u062f\u0627\u0631\u062f\u060c \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u0647\u062f\u0641 \u0622\u0646 \u0627\u0639\u0644\u0627\u0645 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f."
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u0627\u06cc\u0646 \u062a\u06cc\u062a\u0631 \u062e\u0627\u0644\u06cc \u0627\u0633\u062a. \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0635\u0641\u062d\u0647\u200c\u062e\u0648\u0627\u0646 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u06cc\u062a\u0631\u0647\u0627 \u062c\u0627\u0628\u0647\u200c\u062c\u0627 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u0622\u0646 \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f \u06cc\u0627 \u0645\u062a\u0646\u06cc \u0628\u0647 \u0622\u0646 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f."
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
                "\u0639\u0646\u0648\u0627\u0646 \u0635\u0641\u062d\u0647 \u0642\u0628\u0644\u0627\u064b \u0647\u0645\u0627\u0646 H1 \u0627\u0633\u062a\u061b \u0628\u0631\u0627\u06cc \u0628\u0627\u0644\u0627\u062a\u0631\u06cc\u0646 \u0633\u0637\u062d \u0645\u062d\u062a\u0648\u0627 \u0627\u0632 H2 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f."
            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u0627\u06cc\u0646 H%1$d \u06cc\u06a9 \u0633\u0637\u062d \u0631\u0627 \u0631\u062f \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u0633\u0637\u062d \u0642\u0628\u0644\u06cc H%2$d \u0627\u0633\u062a. \u0622\u0646 \u0631\u0627 \u0628\u0647 \u06cc\u06a9 H%3$d \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0646\u06cc\u062f."
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u0627\u06cc\u0646 \u062a\u0635\u0648\u06cc\u0631 \u0645\u062a\u0646 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u0646\u062f\u0627\u0631\u062f. \u0622\u0646 \u0631\u0627 \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0646\u06cc\u062f\u060c \u06cc\u0627 \u0627\u06af\u0631 \u0686\u06cc\u0632\u06cc \u0628\u0647 \u0622\u0646 \u0627\u0636\u0627\u0641\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0622\u0646 \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u062a\u0632\u0626\u06cc\u0646\u06cc \u0639\u0644\u0627\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f."
