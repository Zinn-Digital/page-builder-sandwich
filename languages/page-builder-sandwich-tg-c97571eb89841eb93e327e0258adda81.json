            ],
            "The largest image is lazy-loaded, which delays it.": [
                "\u0422\u0430\u0441\u0432\u0438\u0440\u0438 \u043a\u0430\u043b\u043e\u043d\u0442\u0430\u0440\u0438\u043d \u0434\u0435\u0440 \u0431\u043e\u0440\u0433\u0438\u0440\u04e3 \u043c\u0435\u0448\u0430\u0432\u0430\u0434 (lazy-loaded), \u043a\u0438 \u043e\u043d\u0440\u043e \u0431\u0430 \u0442\u0430\u044a\u0445\u0438\u0440 \u043c\u0435\u0430\u043d\u0434\u043e\u0437\u0430\u0434."
            ],
            "%d image(s) have no width and height, which can make the page jump.": [
