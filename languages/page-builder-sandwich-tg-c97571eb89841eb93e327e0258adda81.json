            ],
            "%d fix(es) made; save the page, then measure again.": [
                "%d \u0438\u0441\u043b\u043e\u04b3 \u0432\u043e\u0440\u0438\u0434 \u043a\u0430\u0440\u0434\u0430 \u0448\u0443\u0434; \u0441\u0430\u04b3\u0438\u0444\u0430\u0440\u043e \u0437\u0430\u0445\u0438\u0440\u0430 \u043a\u0443\u043d\u0435\u0434, \u0441\u0438\u043f\u0430\u0441 \u0434\u0443\u0431\u043e\u0440\u0430 \u0430\u043d\u0434\u043e\u0437\u0430\u0433\u0438\u0440\u04e3 \u043d\u0430\u043c\u043e\u0435\u0434."
