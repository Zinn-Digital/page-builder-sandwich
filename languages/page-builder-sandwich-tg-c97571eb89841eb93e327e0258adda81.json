            ],
            "An image is larger than it is shown (%1$s). A smaller size saves %2$s.": [
                "\u0410\u043d\u0434\u043e\u0437\u0430\u0438 \u0442\u0430\u0441\u0432\u0438\u0440 \u0430\u0437 \u043e\u043d \u0447\u0438\u0437\u0435, \u043a\u0438 \u043d\u0430\u043c\u043e\u0438\u0448 \u0434\u043e\u0434\u0430 \u043c\u0435\u0448\u0430\u0432\u0430\u0434 (%1$s), \u043a\u0430\u043b\u043e\u043d\u0442\u0430\u0440 \u0430\u0441\u0442. \u0410\u043d\u0434\u043e\u0437\u0430\u0438 \u0445\u0443\u0440\u0434\u0442\u0430\u0440 %2$s \u0441\u0430\u0440\u0444\u0430 \u043c\u0435\u043a\u0443\u043d\u0430\u0434."
            ],
            "Use the smaller size": [
