            ],
            "That font file is empty or larger than 10 MB.": [
                "\u062f\u063a\u0647 \u062f \u0641\u0648\u0646\u067c \u0641\u0627\u06cc\u0644 \u062e\u0627\u0644\u064a \u062f\u06cc \u0627\u0648 \u06a9\u0647 \u0644\u0647 \u06f1\u06f0 \u0645\u064a\u06ab\u0627\u0628\u0627\u064a\u067c\u0648 \u0685\u062e\u0647 \u0644\u0648\u06cc \u062f\u06cc."
            ],
            "Style once, reuse everywhere, change in one place.": [
