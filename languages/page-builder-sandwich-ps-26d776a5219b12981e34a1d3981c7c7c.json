            ],
            "Dark colours": [
                "\u062a\u0648\u0631 \u0631\u0646\u06ab\u0648\u0646\u0647"
            ],
            "Give each colour its dark version. Colours left empty stay the same in both schemes. Dark mode is on as soon as one colour has a dark value.": [
                "\u0647\u0631 \u0631\u0646\u06ab \u062a\u0647 \u062f \u0647\u063a\u0647 \u062a\u06cc\u0627\u0631\u0647 \u0628\u06bc\u0647 \u0648\u0631\u06a9\u0693\u0626. \u06a9\u0648\u0645 \u0631\u0646\u06ab\u0648\u0646\u0647 \u0686\u06d0 \u062a\u0634 \u067e\u0627\u062a\u06d0 \u0634\u064a \u067e\u0647 \u062f\u0648\u0627\u0693\u0648 \u0633\u06a9\u06cc\u0645\u0648\u0646\u0648 \u06a9\u06d0 \u0628\u0647 \u0647\u0645\u062f\u0627\u0633\u06d0 \u067e\u0627\u062a\u06d0 \u0634\u064a. \u062a\u06cc\u0627\u0631\u0647 \u0627\u0689\u0647 (\u0689\u0627\u0631\u06a9 \u0645\u0648\u0689) \u0633\u0645\u062f\u0644\u0627\u0633\u0647 \u0641\u0639\u0627\u0644\u0647 \u06a9\u06cc\u0696\u064a \u06a9\u0644\u0647 \u0686\u06d0 \u06cc\u0648 \u0631\u0646\u06ab \u062a\u06cc\u0627\u0631\u0647 \u0627\u0631\u0632\u069a\u062a \u0648\u0644\u0631\u064a."
            ],
            "Dark version of %s": [
                "\u062f %s \u062a\u0648\u0631\u06d0 \u0628\u06bc\u0647"
            ],
            "Dark mode saved.": [
                "\u062a\u0627\u0631\u06cc\u06a9 \u0627\u0648\u062f \u062b\u0628\u062a \u0634\u0648."
            ],
            "Page CSS": [
                "\u062f \u067e\u0627\u06bc\u06d0 CSS"
            ],
            "Classes": [
                "\u0635\u0646\u0641\u0648\u0646\u0647"
            ],
            "Font files must be %s.": [
