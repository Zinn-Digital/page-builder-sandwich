            ],
            "Adobe Fonts": [
                "Adobe Fonts"
            ],
            "Paste the kit id of your Adobe Fonts web project. Its fonts are then loaded from Adobe on your pages.": [
                "\u062e\u067e\u0644 \u062f Adobe Fonts \u0648\u06cc\u0628 \u067e\u0631\u0648\u0698\u06d0 \u06a9\u067c \u067e\u06cc\u0698\u0646\u062f (kit id) \u067e\u06cc\u0633\u067c \u06a9\u0693\u0626. \u0628\u06cc\u0627 \u062f \u062f\u06d0 \u0641\u0648\u0646\u067c\u0648\u0646\u0647 \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 \u067e\u0627\u06bc\u0648 \u06a9\u06d0 \u0644\u0647 Adobe \u0685\u062e\u0647 \u0628\u0627\u0631 \u06a9\u06cc\u0696\u064a."
            ],
            "Your web projects": [
                "\u0633\u062a\u0627\u0633\u0648 \u0648\u06d0\u0628 \u067e\u0631\u0648\u0698\u06d0"
            ],
            "Adobe Fonts connected.": [
                "\u062f \u0627\u0689\u0648\u0628 \u0641\u0648\u0646\u067c\u0648\u0646\u0647 \u0648\u0635\u0644 \u0634\u0648\u0644."
            ],
            "Adobe Fonts disconnected.": [
