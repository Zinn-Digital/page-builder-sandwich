            "No classes yet. Create one, style it, then add it to any element from its settings.": [
                "\u062a\u0631 \u0627\u0648\u0633\u0647 \u06a9\u0648\u0645 \u067c\u0648\u0644\u06ab\u064a \u0646\u0634\u062a\u0647. \u06cc\u0648 \u062c\u0648\u0693 \u06a9\u0693\u0626\u060c \u0633\u067c\u0627\u06cc\u0644 \u0648\u0631\u06a9\u0693\u0626\u060c \u0628\u06cc\u0627 \u06cc\u06d0 \u062f \u0647\u063a\u06d0 \u0644\u0647 \u0627\u0645\u0633\u062a\u0646\u0648 \u0685\u062e\u0647 \u0647\u0631 \u0639\u0646\u0635\u0631 \u062a\u0647 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626."
