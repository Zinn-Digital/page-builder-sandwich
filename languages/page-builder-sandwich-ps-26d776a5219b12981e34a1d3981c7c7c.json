            ],
            "Reset to the default scales": [
                "\u0627\u0635\u0644\u064a \u067e\u06cc\u0645\u0627\u0646\u0648 \u062a\u0647 \u06cc\u06d0 \u0628\u06d0\u0631\u062a\u0647 \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0693\u0626"
            ],
            "No variables yet. A variable holds one value \u2014 a width, a colour mix, a font size \u2014 that many elements share.": [
                "\u062a\u0631 \u0627\u0648\u0633\u0647 \u0647\u06cc\u0685 \u0645\u062a\u063a\u06cc\u0631\u0648\u0646\u0647 \u0646\u0634\u062a\u0647. \u06cc\u0648 \u0645\u062a\u063a\u06cc\u0631 \u06cc\u0648 \u0627\u0631\u0632\u069a\u062a \u0633\u0627\u062a\u064a \u2014 \u06cc\u0648 \u067e\u0644\u0646\u0648\u0627\u0644\u06cc\u060c \u062f \u0631\u0646\u06ab \u062a\u0631\u06a9\u06cc\u0628\u060c \u062f \u0641\u0648\u0646\u067c \u06a9\u0686\u0647 \u2014 \u0686\u06d0 \u0689\u06cc\u0631\u06cc \u0639\u0646\u0627\u0635\u0631 \u06cc\u06d0 \u0634\u0631\u06cc\u06a9\u0648\u064a."
            ],
            "Add variable": [
                "\u0645\u062a\u063a\u06cc\u0631 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626"
            ],
            "Variables saved.": [
                "\u0628\u062f\u0644\u0648\u0646 \u0645\u0648\u0646\u062f\u0648\u0646\u06a9\u064a \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u0644."
            ],
            "Place ID": [
                "\u062f \u0681\u0627\u06cc \u067e\u06d0\u0698\u0646\u062f"
            ],
            "Find it with Google\u2019s Place ID finder: search for your business and copy the ID.": [
                "\u062f\u0627 \u062f Google \u062f Place ID \u0645\u0648\u0646\u062f\u0648\u0646\u06a9\u064a \u0644\u0647 \u0644\u0627\u0631\u06d0 \u0648\u0645\u0648\u0645\u0626: \u062e\u067e\u0644 \u0633\u0648\u062f\u0627\u06ab\u0631\u064a \u0648\u067e\u0644\u067c\u0626 \u0627\u0648 ID \u06a9\u0627\u067e\u064a \u06a9\u0693\u0626."
            ],
            "An API key from your Google Cloud project with the Places API (New) enabled. Restrict it to that API.": [
                "\u0633\u062a\u0627\u0633\u0648 \u062f Google Cloud \u067e\u0631\u0648\u0698\u06d0 \u0685\u062e\u0647 \u062f API \u06a9\u0644\u064a \u0686\u06d0 Places API (New) \u067e\u0647 \u06a9\u06d0 \u0641\u0639\u0627\u0644 \u0634\u0648\u06cc \u0648\u064a. \u062f\u0627 \u06cc\u0648\u0627\u0632\u06d0 \u0647\u0645\u0627\u063a\u0647 API \u062a\u0647 \u0645\u062d\u062f\u0648\u062f\u0647 \u06a9\u0693\u0626."
            ],
            "Business unit ID": [
                "\u062f \u0633\u0648\u062f\u0627\u06ab\u0631\u06cc\u0632 \u0648\u0627\u062d\u062f \u067e\u06d0\u0698\u0646\u062f"
            ],
            "The 24-character ID of your business on Trustpilot, from your Trustpilot Business account (Integrations \u203a API).": [
                "\u067e\u0647 Trustpilot \u06a9\u06d0 \u0633\u062a\u0627\u0633\u0648 \u062f \u0633\u0648\u062f\u0627\u06ab\u0631\u06cd \u06f2\u06f4 \u062a\u0648\u0631\u064a \u0644\u0631\u0648\u0646\u06a9\u06cc ID\u060c \u0633\u062a\u0627\u0633\u0648 \u062f Trustpilot Business \u0644\u0647 \u062d\u0633\u0627\u0628 \u0685\u062e\u0647 (Integrations \u203a API)."
            ],
            "The API key of your Trustpilot Business account.": [
                "\u0633\u062a\u0627\u0633\u0648 \u062f Trustpilot Business \u062d\u0633\u0627\u0628 API \u06a9\u0644\u064a."
            ],
            "Not set up.": [
                "\u0646\u0647 \u062f\u06cc \u062a\u0646\u0638\u06cc\u0645 \u0634\u0648\u06cc."
            ],
            "The saved key can no longer be read (the site\u2019s security keys changed). Enter it again.": [
                "\u0633\u0627\u062a\u0644 \u0634\u0648\u06d0 \u06a9\u0644\u064a \u0646\u0648\u0631 \u0646\u0647 \u0634\u064a \u0644\u0648\u0633\u062a\u0644 \u06a9\u06d0\u062f\u06cc (\u062f \u0633\u0627\u06cc\u067c \u062f \u0627\u0645\u0646\u06cc\u062a \u06a9\u0644\u064a\u0627\u0646\u06d0 \u0628\u062f\u0644\u06d0 \u0634\u0648\u06d0). \u0645\u0647\u0631\u0628\u0627\u0646\u064a \u0648\u06a9\u0693\u0626 \u0647\u063a\u0647 \u0628\u064a\u0627 \u062f\u0646\u0646\u0647 \u06a9\u0693\u0626."
            ],
            "Needs both an ID and an API key.": [
                "\u062f\u0648\u0627\u0693\u0648\u060c \u064a\u0648 \u067e\u06d0\u0698\u0646\u062f (ID) \u0627\u0648 \u062f API \u06a9\u064a\u0644\u06cd\u060c \u062a\u0647 \u0627\u0693\u062a\u064a\u0627 \u0644\u0631\u064a."
            ],
            "Set up. Google reviews are loaded live each time a page with a Reviews block is viewed: one Place Details request on your own key per view, never stored (Google\u2019s terms do not allow keeping them).": [
                "\u062a\u0646\u0638\u06cc\u0645 \u06a9\u0693\u0626. \u062f Google \u06a9\u062a\u0646\u06d0 \u0647\u0631 \u0681\u0644 \u067e\u0647 \u0698\u0648\u0646\u062f\u06cd \u0628\u06bc\u0647 \u067e\u0648\u0631\u062a\u0647 \u06a9\u06d0\u0696\u064a \u06a9\u0644\u0647 \u0686\u06d0 \u062f \u06a9\u062a\u0646\u0648 \u0628\u0644\u0627\u06a9 \u0644\u0631\u0648\u0646\u06a9\u06d0 \u067e\u0627\u06bc\u0647 \u0648\u0644\u06cc\u062f\u0644 \u0634\u064a: \u067e\u0647 \u0647\u0631 \u0644\u06cc\u062f\u0646\u0647 \u06a9\u06d0 \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 \u062e\u067e\u0644 \u06a9\u0644\u064a \u0628\u0627\u0646\u062f\u06d0 \u062f Place Details \u06cc\u0648\u0647 \u063a\u0648\u069a\u062a\u0646\u0647\u060c \u0647\u06cc\u0685\u06a9\u0644\u0647 \u0646\u0647 \u0633\u0627\u062a\u0644 \u06a9\u06cc\u0696\u064a (\u062f Google \u0634\u0631\u0627\u06cc\u0637 \u062f \u062f\u0648\u06cc \u0633\u0627\u062a\u0644\u0648 \u0627\u062c\u0627\u0632\u0647 \u0646\u0647 \u0648\u0631\u06a9\u0648\u064a)."
            ],
            "The first refresh failed: %s": [
                "\u0644\u0648\u0645\u0693\u0646\u06cc \u062a\u0627\u0632\u0647 \u06a9\u0648\u0644 \u0646\u0627\u06a9\u0627\u0645 \u0634\u0648: %s"
            ],
            "Waiting for the first refresh (within a minute or two).": [
                "\u0644\u0648\u0645\u0693\u064a \u062a\u0627\u0632\u0647 \u06a9\u0648\u0644\u0648 \u062a\u0647 \u0627\u0646\u062a\u0638\u0627\u0631 \u06a9\u06cc\u0696\u064a (\u062f \u06cc\u0648\u06d0 \u06cc\u0627 \u062f\u0648\u0648 \u062f\u0642\u06cc\u0642\u0648 \u067e\u0647 \u062a\u0631\u0685 \u06a9\u06d0)."
            ],
            "Refreshed %1$s: %2$d reviews kept, rated %3$s from %4$d.": [
                "%1$s \u062a\u0627\u0632\u0647 \u0634\u0648: %2$d \u062a\u0628\u0635\u0631\u06d0 \u0648\u0633\u0627\u062a\u0644 \u0634\u0648\u06d0\u060c \u0644\u0647 %4$d \u0685\u062e\u0647 %3$s \u062f\u0631\u062c\u0647 \u0628\u0646\u062f\u064a \u0634\u0648\u06d0."
            ],
            "The last try, %1$s, failed and the reviews above were kept: %2$s": [
                "\u0648\u0631\u0648\u0633\u062a\u06cd \u0647\u0685\u0647\u060c %1$s\u060c \u0646\u0627\u06a9\u0627\u0645\u0647 \u0634\u0648\u0647 \u0627\u0648 \u067e\u0648\u0631\u062a\u0647 \u0628\u06cc\u0627\u06a9\u062a\u0646\u06d0 \u0648\u0633\u0627\u062a\u0644 \u0634\u0648\u06d0: %2$s"
            ],
            "Saved. Trustpilot reviews are fetched in the background within a minute or two; Google reviews load live on the page.": [
                "\u062e\u0648\u0646\u062f\u064a \u0634\u0648. \u062f Trustpilot \u0628\u06cc\u0627\u06a9\u062a\u0646\u06d0 \u067e\u0647 \u0634\u0627\u0644\u06cc\u062f \u06a9\u06d0 \u067e\u0647 \u06cc\u0648\u0647 \u06cc\u0627 \u062f\u0648\u0648 \u062f\u0642\u06cc\u0642\u0648 \u06a9\u06d0 \u062a\u0631\u0644\u0627\u0633\u0647 \u06a9\u06cc\u0696\u064a\u061b \u062f Google \u0628\u06cc\u0627\u06a9\u062a\u0646\u06d0 \u067e\u0647 \u067e\u0627\u06bc\u0647 \u06a9\u06d0 \u067e\u0647 \u0698\u0648\u0646\u062f\u06cd \u0628\u06bc\u0647 \u0628\u0627\u0631 \u06a9\u06cc\u0696\u064a."
            ],
            "Trustpilot reviews are fetched once a day in the background and kept on your site, so a busy page costs nothing extra on your Trustpilot account; if a refresh fails, the last reviews stay. Google does not allow its reviews to be stored, so they are loaded live when a visitor views the page: each view is one request on your own Google key, billed by Google.": [
                "\u062f Trustpilot \u06a9\u062a\u0646\u06d0 \u067e\u0647 \u0634\u0627\u0644\u06cc\u062f \u06a9\u06d0 \u067e\u0647 \u0648\u0631\u0681 \u06a9\u06d0 \u06cc\u0648 \u0681\u0644 \u0631\u0627\u0648\u0693\u0644 \u06a9\u06cc\u0696\u064a \u0627\u0648 \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 \u0633\u0627\u06cc\u067c \u06a9\u06d0 \u0633\u0627\u062a\u0644 \u06a9\u06cc\u0696\u064a\u060c \u0646\u0648 \u06cc\u0648\u0647 \u0628\u0648\u062e\u062a\u0647 \u067e\u0627\u06bc\u0647 \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 Trustpilot \u062d\u0633\u0627\u0628 \u06a9\u06d0 \u0627\u0636\u0627\u0641\u064a \u0644\u06ab\u069a\u062a \u0646\u0647 \u0644\u0631\u064a\u061b \u06a9\u0647 \u062a\u0627\u0632\u0647 \u06a9\u0648\u0644 \u0646\u0627\u06a9\u0627\u0645 \u0634\u064a\u060c \u0648\u0631\u0648\u0633\u062a\u06cd \u06a9\u062a\u0646\u06d0 \u067e\u0627\u062a\u06d0 \u06a9\u06cc\u0696\u064a. Google \u062f \u062e\u067e\u0644\u0648 \u06a9\u062a\u0646\u0648 \u062f \u062e\u0648\u0646\u062f\u064a \u06a9\u0648\u0644\u0648 \u0627\u062c\u0627\u0632\u0647 \u0646\u0647 \u0648\u0631\u06a9\u0648\u064a\u060c \u0646\u0648 \u062f\u0627 \u067e\u0647 \u0698\u0648\u0646\u062f\u06cd \u0628\u06bc\u0647 \u0647\u063a\u0647 \u0648\u062e\u062a \u0628\u0627\u0631 \u06a9\u06cc\u0696\u064a \u06a9\u0644\u0647 \u0686\u06d0 \u06cc\u0648 \u0644\u06cc\u062f\u0648\u0646\u06a9\u06cc \u067e\u0627\u06bc\u0647 \u06ab\u0648\u0631\u064a: \u0647\u0631 \u0644\u06cc\u062f \u0633\u062a\u0627\u0633\u0648 \u067e\u0647 \u062e\u067e\u0644 Google \u06a9\u06cc\u0644\u064a \u0628\u0627\u0646\u062f\u06d0 \u06cc\u0648\u0647 \u063a\u0648\u069a\u062a\u0646\u0647 \u062f\u0647\u060c \u0686\u06d0 \u0644\u06ab\u069a\u062a \u06cc\u06d0 \u062f Google \u0644\u062e\u0648\u0627 \u0627\u062e\u06cc\u0633\u062a\u0644 \u06a9\u06cc\u0696\u064a."
            ],
