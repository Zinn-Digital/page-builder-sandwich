            ],
            "Kit id": [
                "\u062f \u06a9\u067c \u067e\u06cc\u0698\u0646\u062f\u0646\u0647"
            ],
            "The dark value for \"%s\" is not a valid colour.": [
                "\u062f \"%s\" \u0644\u067e\u0627\u0631\u0647 \u062a\u0631\u0647\u063a\u0647 \u062a\u067e\u0647 \u0627\u0631\u0632\u069a\u062a \u06cc\u0648 \u0628\u0627\u0648\u0631\u064a \u0631\u0646\u06ab \u0646\u0647 \u062f\u06cc."
