            ],
            "Spacing, radius and shadows": [
                "\u0641\u0627\u0635\u0644\u0647\u060c \u0648\u0693\u0627\u0646\u06ab\u0647 \u0627\u0648 \u0633\u06cc\u0648\u0631\u064a"
            ],
            "The scales every spacing, corner and shadow picker offers.": [
                "\u0647\u063a\u0647 \u06a9\u0686\u06d0 \u0686\u06d0 \u062f \u0647\u0631 \u0648\u0627\u067c\u0646\u060c \u06a9\u0648\u0646\u062c \u0627\u0648 \u0633\u06cc\u0648\u0631\u064a \u067c\u0627\u06a9\u0648\u0646\u06a9\u06cc \u06cc\u06d0 \u0648\u0693\u0627\u0646\u062f\u06d0 \u06a9\u0648\u064a."
            ],
            "A dark version of your colours, for visitors who want it.": [
                "\u0633\u062a\u0627\u0633\u0648 \u062f \u0631\u0646\u06ab\u0648\u0646\u0648 \u06cc\u0648 \u062a\u06cc\u0627\u0631\u0647 \u0646\u0633\u062e\u0647\u060c \u062f \u0647\u063a\u0648 \u0644\u06cc\u062f\u0648\u0646\u06a9\u0648 \u0644\u067e\u0627\u0631\u0647 \u0686\u06d0 \u062f\u0627 \u063a\u0648\u0627\u0693\u064a."
            ],
            "Logo, colours, fonts and tone of voice, used by the AI and templates.": [
                "\u0644\u0648\u06ab\u0648\u060c \u0631\u0646\u06ab\u0648\u0646\u0647\u060c \u0641\u0648\u0646\u067c\u0648\u0646\u0647 \u0627\u0648 \u062f \u063a\u0696 \u0637\u0631\u0632\u060c \u0686\u06d0 \u062f AI \u0627\u0648 \u06a9\u064a\u0646\u0689\u064a\u0648 \u0644\u062e\u0648\u0627 \u06a9\u0627\u0631\u0648\u0644 \u06a9\u06d0\u0696\u064a."
            ],
            "Upload your own fonts or connect Adobe Fonts.": [
                "\u062e\u067e\u0644 \u0641\u0648\u0646\u067c\u0648\u0646\u0647 \u067e\u0648\u0631\u062a\u0647 \u06a9\u0693\u0626 \u06cc\u0627 Adobe Fonts \u0648\u0635\u0644 \u06a9\u0693\u0626."
            ],
            "CSS for this page only.": [
                "\u06cc\u0648\u0627\u0632\u06d0 \u062f \u062f\u06d0 \u067e\u0627\u06bc\u06d0 \u0644\u067e\u0627\u0631\u0647 CSS."
            ],
            "CSS for this page": [
                "\u062f \u062f\u06d0 \u067e\u0627\u06bc\u06d0 \u0644\u067e\u0627\u0631\u0647 CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u06cc\u0648\u0627\u0632\u06d0 \u067e\u0647 \u062f\u06d0 \u067e\u0627\u06bc\u0647 \u06a9\u06d0\u060c \u062f \u0648\u06cc\u0628 \u067e\u0627\u06bc\u06d0 \u062f \u0633\u067c\u0627\u06cc\u0644\u0648\u0646\u0648 \u0685\u062e\u0647 \u0648\u0631\u0648\u0633\u062a\u0647 \u0628\u0627\u0631\u06d0\u0696\u064a. \u062f \u067e\u0627\u06bc\u06d0 \u0633\u0631\u0647 \u06cc\u0648\u0681\u0627\u06cc \u062e\u0648\u0646\u062f\u064a \u06a9\u06d0\u0696\u064a."
            ],
            "Short name": [
                "\u0644\u0646\u0689 \u0646\u0648\u0645"
            ],
            "The short name \"%s\" is used twice.": [
                "\u0644\u0646\u0689 \u0646\u0648\u0645 \"%s\" \u062f\u0648\u0647 \u0681\u0644\u0647 \u06a9\u0627\u0631\u0648\u0644 \u0634\u0648\u06cc \u062f\u06cc."
            ],
            "\"%s\": short names use lowercase letters, digits and hyphens.": [
                "\"%s\": \u0644\u0646\u0689 \u0646\u0648\u0645\u0648\u0646\u0647 \u06a9\u0648\u0686\u0646\u064a \u062a\u0648\u0631\u064a\u060c \u0639\u062f\u062f\u0648\u0646\u0647 \u0627\u0648 \u0646\u069a\u0644\u0648\u0646\u06a9\u06d0 \u06a9\u0631\u069a\u06d0 (hyphens) \u06a9\u0627\u0631\u0648\u064a."
            ],
            "The value of \"%s\" is not one this setting accepts.": [
                "\u062f \"%s\" \u0627\u0631\u0632\u069a\u062a \u0644\u0647 \u0647\u063a\u0648 \u0685\u062e\u0647 \u0646\u0647 \u062f\u06cc \u0686\u06d0 \u062f\u0627 \u0627\u0645\u0633\u062a\u0646\u0647 \u06cc\u06d0 \u0645\u0646\u064a."
            ],
            "Radius": [
