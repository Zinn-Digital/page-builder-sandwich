            ],
            "A dark version of your colours, for visitors who want it.": [
                "\u062f \u0647\u063a\u0648 \u0644\u06cc\u062f\u0648\u0646\u06a9\u0648 \u0644\u067e\u0627\u0631\u0647 \u0686\u06d0 \u063a\u0648\u0627\u0693\u064a\u060c \u0633\u062a\u0627\u0633\u0648 \u062f \u0631\u0646\u06ab\u0648\u0646\u0648 \u06cc\u0648\u0647 \u062a\u06cc\u0627\u0631\u0647 \u0628\u06bc\u0647."
