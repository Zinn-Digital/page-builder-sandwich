            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u06cc\u0648\u0627\u0632\u06d0 \u067e\u0647 \u062f\u06d0 \u067e\u0627\u06bc\u0647 \u06a9\u06d0\u060c \u062f \u0633\u0627\u06cc\u067c \u062f \u0633\u067c\u0627\u06cc\u0644\u0648\u0646\u0648 \u0648\u0631\u0648\u0633\u062a\u0647 \u0628\u0627\u0631 \u0634\u0648\u06cc. \u062f \u067e\u0627\u06bc\u06d0 \u0633\u0631\u0647 \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u06cc."
            ],
            "Short name": [
                "\u0644\u0646\u0689 \u0646\u0648\u0645"
            ],
            "The short name \"%s\" is used twice.": [
