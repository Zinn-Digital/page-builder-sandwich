            ],
            "The style controls are not loaded. Reload the page; if this stays, reinstall the plugin.": [
                "\u062f \u0633\u067c\u0627\u06cc\u0644 \u06a9\u0646\u067c\u0631\u0648\u0644\u0648\u0646\u0647 \u0646\u0647 \u062f\u064a \u0628\u0627\u0631 \u0634\u0648\u064a. \u067e\u0627\u06bc\u0647 \u0628\u06cc\u0627 \u0648\u0685\u0627\u0631\u0626\u061b \u06a9\u0647 \u062f\u0627 \u0633\u062a\u0648\u0646\u0632\u0647 \u067e\u0627\u062a\u06d0 \u0648\u064a\u060c \u067e\u0644\u06ab \u0627\u0646 \u0628\u06cc\u0627 \u0646\u0635\u0628 \u06a9\u0693\u0626."
