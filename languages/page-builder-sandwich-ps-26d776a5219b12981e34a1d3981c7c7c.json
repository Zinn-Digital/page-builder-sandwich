            ],
            "That font file is empty or larger than 10 MB.": [
                "\u062f\u063a\u0647 \u0641\u0648\u0646\u067c \u0641\u0627\u06cc\u0644 \u062e\u0627\u0644\u064a \u062f\u06cc \u0627\u0648 \u06a9\u0647 \u0627\u0646\u062f\u0627\u0632\u0647 \u06cc\u06d0 \u0644\u0647 \u06f1\u06f0 \u0645\u06d0\u06ab\u0627\u0628\u0627\u06cc\u067c \u0685\u062e\u0647 \u0632\u06cc\u0627\u062a\u0647 \u062f\u0647."
            ],
            "Style once, reuse everywhere, change in one place.": [
                "\u06cc\u0648 \u0681\u0644 \u06cc\u06d0 \u0633\u067c\u0627\u06cc\u0644 \u06a9\u0693\u0626\u060c \u0647\u0631 \u0681\u0627\u06cc \u06cc\u06d0 \u0628\u06cc\u0627 \u0648\u06a9\u0627\u0631\u0648\u0626\u060c \u0627\u0648 \u067e\u0647 \u06cc\u0648 \u0681\u0627\u06cc \u06a9\u06d0 \u0628\u062f\u0644\u0648\u0646 \u0631\u0627\u0648\u0644\u0626."
            ],
            "Variables": [
