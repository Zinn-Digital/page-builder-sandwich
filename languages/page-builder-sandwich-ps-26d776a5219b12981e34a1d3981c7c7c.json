            "CSS for this page only.": [
                "\u062f \u062f\u06d0 \u067e\u0627\u06bc\u06d0 \u0644\u067e\u0627\u0631\u0647 \u064a\u0648\u0627\u0632\u06d0 CSS."
            ],
            "CSS for this page": [
