            ],
            "No variables yet. A variable holds one value \u2014 a width, a colour mix, a font size \u2014 that many elements share.": [
                "\u0644\u0627 \u062a\u0631 \u0627\u0648\u0633\u0647 \u067e\u0648\u0631\u06d0 \u0647\u06d0\u0685 \u0645\u062a\u063a\u06cc\u0631 \u0634\u062a\u0648\u0646 \u0646\u0647 \u0644\u0631\u064a. \u06cc\u0648 \u0645\u062a\u063a\u06cc\u0631 \u06cc\u0648 \u0627\u0631\u0632\u069a\u062a \u0644\u0631\u064a - \u0644\u06a9\u0647 \u0639\u0631\u0636\u060c \u062f \u0631\u0646\u06ab \u06ab\u0689\u0648\u0644\u06d0\u060c \u062f \u0641\u0648\u0646\u067c \u06a9\u0686\u0647 - \u0686\u06d0 \u0689\u06d0\u0631 \u062a\u0648\u06a9\u064a \u06cc\u06d0 \u0634\u0631\u06cc\u06a9\u0648\u064a."
            ],
            "Add variable": [
                "\u062a\u063a\u064a\u0631 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626"
