            ],
            "Delete": [
                "\u0693\u0646\u06ab\u0648\u0644"
            ],
            "Delete the class \"%s\"? Elements that use it keep their content and lose its styles.": [
                "\u0622\u06cc\u0627 \u063a\u0648\u0627\u0693\u0626 \u067c\u0648\u0644\u06ab\u06cc (class) \"%s\" \u0693\u0646\u06ab \u06a9\u0693\u0626\u061f \u0647\u063a\u0647 \u0639\u0646\u0627\u0635\u0631\u0648 \u0686\u06d0 \u062f\u0627 \u06a9\u0627\u0631\u0648\u064a \u062e\u067e\u0644 \u0645\u06cc\u0646\u0681\u067e\u0627\u0646\u06ab\u0647 \u0633\u0627\u062a\u064a \u0627\u0648 \u0633\u067c\u0627\u06cc\u0644\u0648\u0646\u0647 \u06cc\u06d0 \u0644\u0647 \u0644\u0627\u0633\u0647 \u0648\u0631\u06a9\u0648\u064a."
            ],
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u06cc\u0648\u0627\u0632\u06d0 \u0647\u063a\u0647 \u06a9\u0627\u0631\u0648\u0648\u0646\u06a9\u064a \u0686\u06d0 \u06a9\u0648\u0644\u06cc \u0634\u064a \u0641\u0644\u067c\u0631 \u0646\u0647 \u0634\u0648\u06d0 HTML \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u064a\u060c \u06a9\u0648\u0644\u06cc \u0634\u064a \u062f\u0648\u062f\u06cc\u0632 CSS \u0628\u062f\u0644 \u06a9\u0693\u064a."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u062f \u062f\u06d0 CSS \u0681\u06cc\u0646\u06d0 \u0628\u0631\u062e\u06d0 \u0628\u0647 \u0648\u0646\u0647 \u06a9\u0627\u0631\u0648\u0644 \u0634\u064a: \u062f \u062e\u0648\u0646\u062f\u06cc\u062a\u0648\u0628 \u0644\u067e\u0627\u0631\u0647 @import\u060c expression()\u060c \u062f javascript: URLs\u060c \"<\" \u0627\u0648 \u0646\u0627\u0633\u0645\u06d0 \u0642\u0648\u0633\u0648\u0646\u0647 \u0644\u0631\u06d0 \u0634\u0648\u064a \u062f\u064a."
            ],
            "Upload a font": [
                "\u0641\u0648\u0646\u067c \u067e\u0648\u0631\u062a\u0647 \u06a9\u0693\u0626"
            ],
            "Uploading fonts needs WordPress 6.5 or later.": [
                "\u062f \u0641\u0648\u0646\u067c\u0648\u0646\u0648 \u0627\u067e\u0644\u0648\u0689 \u06a9\u0648\u0644 WordPress 6.5 \u06cc\u0627 \u0648\u0631\u0648\u0633\u062a\u0647 \u0646\u0633\u062e\u0647 \u062a\u0647 \u0627\u0693\u062a\u06cc\u0627 \u0644\u0631\u064a."
            ],
            "Font name": [
