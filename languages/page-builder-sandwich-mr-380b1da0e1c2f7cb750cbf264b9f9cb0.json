            "Create block": [
                "\u092c\u094d\u0932\u0949\u0915 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"
            ],
            "Design a page from a screenshot or a website address: AI recreates its layout as editable blocks in a new draft.": [
                "\u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0915\u093f\u0902\u0935\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0935\u0930\u0942\u0928 \u092a\u0943\u0937\u094d\u0920 \u0921\u093f\u091d\u093e\u0907\u0928 \u0915\u0930\u093e: AI \u0928\u0935\u0940\u0928 \u092e\u0938\u0941\u0926\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0924\u094d\u092f\u093e\u091a\u0947 \u0932\u0947\u0906\u0909\u091f \u0938\u0902\u092a\u093e\u0926\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u092f\u094b\u0917\u094d\u092f \u092c\u094d\u0932\u0949\u0915\u094d\u0938 \u092e\u094d\u0939\u0923\u0942\u0928 \u092a\u0941\u0928\u094d\u0939\u093e \u0924\u092f\u093e\u0930 \u0915\u0930\u0924\u0947."
            ],
            "Draft page created.": [
                "\u092e\u0938\u0941\u0926\u093e \u092a\u0943\u0937\u094d\u0920 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0947."
            ],
            "Choose a screenshot": [
                "\u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0928\u093f\u0935\u0921\u093e"
            ],
            "Or a website address": [
                "\u0915\u093f\u0902\u0935\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u091a\u093e \u092a\u0924\u094d\u0924\u093e"
            ],
            "Design from the address": [
                "\u092a\u0924\u094d\u0924\u094d\u092f\u093e\u0935\u0930\u0942\u0928 \u0921\u093f\u091d\u093e\u0907\u0928 \u0915\u0930\u093e"
            ],
            "Generate an image": [
                "\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"
            ],
            "Describe the image": [
                "\u092a\u094d\u0930\u0924\u093f\u092e\u0947\u091a\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u093e"
            ],
            "Shape": [
                "\u0906\u0915\u093e\u0930"
            ],
            "Landscape": [
                "\u0932\u0901\u0921\u0938\u094d\u0915\u0947\u092a"
            ],
            "Square": [
                "\u091a\u094c\u0930\u0938"
            ],
            "Portrait": [
                "\u0909\u092d\u0947"
            ],
            "Generate and add": [
                "\u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u093e \u0906\u0923\u093f \u091c\u094b\u0921\u093e"
            ],
            "CSS helper": [
                "CSS \u092e\u0926\u0924\u0928\u0940\u0938"
            ],
            "Select a block to work on its custom CSS.": [
                "\u0924\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0915\u0938\u094d\u091f\u092e CSS \u0935\u0930 \u0915\u093e\u092e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u092c\u094d\u0932\u0949\u0915 \u0928\u093f\u0935\u0921\u093e."
            ],
            "What should the CSS do?": [
                "CSS \u0928\u0947 \u0915\u093e\u092f \u0915\u0947\u0932\u0947 \u092a\u093e\u0939\u093f\u091c\u0947?"
            ],
            "Write": [
                "\u0932\u093f\u0939\u093e"
            ],
            "Fix": [
                "\u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u093e"
            ],
            "Explain": [
                "\u0938\u094d\u092a\u0937\u094d\u091f\u0940\u0915\u0930\u0923 \u0926\u094d\u092f\u093e"
            ],
            "Use this CSS": [
                "\u0939\u0947 CSS \u0935\u093e\u092a\u0930\u093e"
            ],
            "Image without alt text": [
                "\u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092e\u091c\u0915\u0941\u0930\u093e\u0936\u093f\u0935\u093e\u092f \u092a\u094d\u0930\u0924\u093f\u092e\u093e"
            ],
            "Heading skips a level": [
                "\u0936\u0940\u0930\u094d\u0937\u0915 \u090f\u0915 \u0938\u094d\u0924\u0930 \u0935\u0917\u0933\u0924\u0947"
            ],
            "Link text says nothing on its own": [
                "\u0932\u093f\u0902\u0915\u091a\u093e \u092e\u091c\u0915\u0942\u0930 \u0938\u094d\u0935\u0924\u0903 \u0915\u093e\u0939\u0940\u0939\u0940 \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940"
            ],
            "Link with no text (fill it in yourself)": [
                "\u092e\u091c\u0915\u0942\u0930 \u0928\u0938\u0932\u0947\u0932\u0940 \u0932\u093f\u0902\u0915 (\u0924\u0940 \u0938\u094d\u0935\u0924\u0903 \u092d\u0930\u093e)"
            ],
            "Accessibility fixes": [
                "\u0905\u200d\u0945\u0915\u094d\u0938\u0947\u0938\u093f\u092c\u093f\u0932\u093f\u091f\u0940 \u0938\u0941\u0927\u093e\u0930\u0923\u093e"
            ],
            "Save the page first: the check reads the saved page.": [
                "\u092a\u094d\u0930\u0925\u092e \u092a\u0943\u0937\u094d\u0920 \u091c\u0924\u0928 \u0915\u0930\u093e: \u0924\u092a\u093e\u0938\u0923\u0940 \u091c\u0924\u0928 \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u0943\u0937\u094d\u0920 \u0935\u093e\u091a\u0924\u0947."
            ],
            "Check this page": [
                "\u0939\u0947 \u092a\u0943\u0937\u094d\u0920 \u0924\u092a\u093e\u0938\u093e"
            ],
            "No problems found.": [
                "\u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0922\u0933\u0932\u094d\u092f\u093e \u0928\u093e\u0939\u0940\u0924."
            ],
            "Fix what can be fixed": [
                "\u091c\u0947 \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u090a \u0936\u0915\u0924\u0947 \u0924\u0947 \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0930\u093e"
            ],
            "%1$d fixed, %2$d left for you. The page was saved; its previous version is in the revisions.": [
                "%1$d \u0926\u0941\u0930\u0941\u0938\u094d\u0924 \u0915\u0947\u0932\u0947, %2$d \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0936\u093f\u0932\u094d\u0932\u0915 \u0906\u0939\u0947\u0924. \u092a\u0943\u0937\u094d\u0920 \u091c\u0924\u0928 \u0915\u0947\u0932\u0947 \u0917\u0947\u0932\u0947; \u0924\u094d\u092f\u093e\u091a\u0940 \u092e\u093e\u0917\u0940\u0932 \u0906\u0935\u0943\u0924\u094d\u0924\u0940 \u092a\u0941\u0928\u0930\u093e\u0935\u0943\u0924\u094d\u0924\u0940\u0902\u092e\u0927\u094d\u092f\u0947 \u0906\u0939\u0947."
            ],
            "Add a section": [
                "\u0935\u093f\u092d\u093e\u0917 \u091c\u094b\u0921\u093e"
            ],
            "Describe the section": [
                "\u0935\u093f\u092d\u093e\u0917\u093e\u091a\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u093e"
            ],
            "For example: \"pricing with three plans for a dog-walking service\". It is built from the section library in your brand style.": [
                "\u0909\u0926\u093e\u0939\u0930\u0923\u093e\u0930\u094d\u0925: \"\u0915\u0941\u0924\u094d\u0930\u093e \u092b\u093f\u0930\u0935\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0938\u0947\u0935\u0947\u0938\u093e\u0920\u0940 \u0924\u0940\u0928 \u092f\u094b\u091c\u0928\u093e\u0902\u0938\u0939 \u0926\u0930 \u0938\u0942\u091a\u0940\". \u0939\u0947 \u0906\u092a\u0932\u094d\u092f\u093e \u092c\u094d\u0930\u0901\u0921 \u0936\u0948\u0932\u0940\u0924\u0940\u0932 \u0935\u093f\u092d\u093e\u0917 \u0932\u093e\u092f\u092c\u094d\u0930\u0930\u0940\u092e\u0927\u0942\u0928 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0947 \u0917\u0947\u0932\u0947 \u0906\u0939\u0947."
            ],
            "Generate section": [
                "\u0935\u093f\u092d\u093e\u0917 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"
            ],
            "SEO and alt text": [
                "SEO \u0906\u0923\u093f \u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u092e\u091c\u0915\u0942\u0930"
            ],
            "Install Yoast SEO, Rank Math, SEOPress or All in One SEO to save a meta title and description.": [
                "\u092e\u0947\u091f\u093e \u0936\u0940\u0930\u094d\u0937\u0915 \u0906\u0923\u093f \u0935\u0930\u094d\u0923\u0928 \u091c\u0924\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 Yoast SEO, Rank Math, SEOPress \u0915\u093f\u0902\u0935\u093e All in One SEO \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e."
            ],
            "Focus keyword (optional)": [
                "\u092b\u094b\u0915\u0938 \u0915\u0940\u0935\u0930\u094d\u0921 (\u092a\u0930\u094d\u092f\u093e\u092f\u0940)"
            ],
            "Suggest title and description": [
                "\u0936\u0940\u0930\u094d\u0937\u0915 \u0906\u0923\u093f \u0935\u0930\u094d\u0923\u0928\u093e\u091a\u0940 \u0936\u093f\u092b\u093e\u0930\u0938 \u0915\u0930\u093e"
            ],
            "Meta title": [
                "\u092e\u0947\u091f\u093e \u0936\u0940\u0930\u094d\u0937\u0915"
            ],
            "Meta description": [
                "\u092e\u0947\u091f\u093e \u0935\u0930\u094d\u0923\u0928"
            ],
            "Saved to: %s": [
                "\u092f\u0947\u0925\u0947 \u091c\u0924\u0928 \u0915\u0947\u0932\u0947: %s"
            ],
            "Save to my SEO plugin": [
                "\u092e\u093e\u091d\u094d\u092f\u093e SEO \u092a\u094d\u0932\u0917\u0907\u0928\u092e\u0927\u094d\u092f\u0947 \u091c\u0924\u0928 \u0915\u0930\u093e"
