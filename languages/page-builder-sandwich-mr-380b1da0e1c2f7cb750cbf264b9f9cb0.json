            "Undo this change": [
                "\u0939\u093e \u092c\u0926\u0932 \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0915\u0930\u093e"
            ],
            "What should change?": [
                "\u0915\u093e\u092f \u092c\u0926\u0932\u0932\u0947 \u092a\u093e\u0939\u093f\u091c\u0947?"
            ],
            "For example: \"make the hero shorter and friendlier\", \"add an FAQ about delivery after the pricing\", \"translate this section into Spanish\". Select a block first to point at it.": [
                "\u0909\u0926\u093e\u0939\u0930\u0923\u093e\u0930\u094d\u0925: \"\u0939\u093f\u0930\u094b \u0935\u093f\u092d\u093e\u0917 \u0905\u0927\u093f\u0915 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0906\u0923\u093f \u0905\u0928\u0941\u0915\u0942\u0932 \u092c\u0928\u0935\u093e\", \"\u0915\u093f\u092e\u0924\u0940\u0902\u0928\u0902\u0924\u0930 \u0935\u093f\u0924\u0930\u0923\u093e\u092c\u0926\u094d\u0926\u0932 \u0935\u093e\u0930\u0902\u0935\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u0932\u0947 \u091c\u093e\u0923\u093e\u0930\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 (FAQ) \u091c\u094b\u0921\u093e\", \"\u092f\u093e \u0935\u093f\u092d\u093e\u0917\u093e\u091a\u0947 \u0938\u094d\u092a\u0945\u0928\u093f\u0936\u092e\u0927\u094d\u092f\u0947 \u092d\u093e\u0937\u093e\u0902\u0924\u0930 \u0915\u0930\u093e\". \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u0925\u092e \u092c\u094d\u0932\u0949\u0915 \u0928\u093f\u0935\u0921\u093e."
            ],
            "Ask": [
                "\u0935\u093f\u091a\u093e\u0930\u093e"
            ],
            "Build a website": [
                "\u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"
            ],
            "Describe the business": [
                "\u0935\u094d\u092f\u0935\u0938\u093e\u092f\u093e\u091a\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u093e"
            ],
            "Plan the pages": [
                "\u092a\u0943\u0937\u094d\u0920\u093e\u0902\u091a\u0947 \u0928\u093f\u092f\u094b\u091c\u0928 \u0915\u0930\u093e"
            ],
            "Build these pages as drafts": [
                "\u0939\u0940 \u092a\u0943\u0937\u094d\u0920\u0947 \u092e\u0938\u0941\u0926\u0947 \u092e\u094d\u0939\u0923\u0942\u0928 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"
            ],
            "Create with AI": [
                "AI \u0938\u0939 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e"
            ],
            "A custom block": [
                "\u090f\u0915 \u0938\u093e\u0928\u0941\u0915\u0942\u0932 \u092c\u094d\u0932\u0949\u0915"
            ],
            "Describe a component (\"a team member card with photo, name, role and a short bio\"). It is saved to My patterns, with its texts editable on every page that uses it.": [
                "\u090f\u0916\u093e\u0926\u094d\u092f\u093e \u0918\u091f\u0915\u093e\u091a\u0947 \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u093e (\"\u092b\u094b\u091f\u094b, \u0928\u093e\u0935, \u092d\u0942\u092e\u093f\u0915\u093e \u0906\u0923\u093f \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u092e\u093e\u0939\u093f\u0924\u0940 \u0905\u0938\u0932\u0947\u0932\u0947 \u091f\u0940\u092e \u0938\u0926\u0938\u094d\u092f \u0915\u093e\u0930\u094d\u0921\"). \u0939\u0947 '\u092e\u093e\u091d\u0947 \u092a\u0945\u091f\u0930\u094d\u0928' \u092e\u0927\u094d\u092f\u0947 \u0938\u0947\u0935\u094d\u0939 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u0947 \u0906\u0923\u093f \u0924\u0947 \u0935\u093e\u092a\u0930\u0923\u093e\u0931\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u092a\u093e\u0928\u093e\u0935\u0930 \u0924\u094d\u092f\u093e\u091a\u0947 \u092e\u091c\u0915\u0942\u0930 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0924\u093e \u092f\u0947\u0924\u093e\u0924."
            ],
            "Block created and added to the page.": [
                "\u092c\u094d\u0932\u0949\u0915 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u093e \u0906\u0923\u093f \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u091c\u094b\u0921\u0932\u093e \u0917\u0947\u0932\u093e."
            ],
            "Edit the block": [
                "\u092c\u094d\u0932\u0949\u0915 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e"
