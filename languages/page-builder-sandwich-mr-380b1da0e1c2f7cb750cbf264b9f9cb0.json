            ],
            "AI uses your own AI provider account. Connect one to start.": [
                "AI \u0924\u0941\u092e\u091a\u0947 \u0938\u094d\u0935\u0924\u0903\u091a\u0947 AI \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u0916\u093e\u0924\u0947 \u0935\u093e\u092a\u0930\u0924\u0947. \u0938\u0941\u0930\u0942 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u093e."
            ],
            "Set up AI": [
                "AI \u0938\u0947\u091f \u0905\u092a \u0915\u0930\u093e"
            ],
            "This block has no text of its own.": [
                "\u092f\u093e \u092c\u094d\u0932\u0949\u0915\u091a\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u093e \u0905\u0938\u093e \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092e\u091c\u0915\u0942\u0930 \u0928\u093e\u0939\u0940."
            ],
            "Assistant": [
                "\u0938\u0939\u093e\u092f\u094d\u092f\u0915"
