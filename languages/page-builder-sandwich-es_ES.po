msgstr "Muestra los widgets en una de las áreas de widgets del tema."

#: blocks/sidebar/block.json
msgctxt "block keyword"
msgid "sidebar"
msgstr "barra lateral"

#: blocks/sidebar/block.json
msgctxt "block keyword"
msgid "widget area"
msgstr "área de widgets"

#: blocks/widget/block.json
msgctxt "block title"
