msgid "Language switcher"
msgstr "Selector de idioma"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another language, styled to match your page. Needs the Tranzly plugin for the languages."
msgstr "Permite que los visitantes lean esta página en otro idioma, con un diseño adaptado a su página. Requiere el plugin Tranzly para los idiomas."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "traducción"

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "multilingüe"

#: blocks/row/block.json
msgctxt "block title"
msgid "Row"
msgstr "Fila"

#: blocks/row/block.json
msgctxt "block description"
msgid "A row of columns. Stays readable if the plugin is ever turned off."
msgstr "Una fila de columnas. Permanece legible si el complemento llega a desactivarse."

#: blocks/row/block.json
msgctxt "block keyword"
msgid "row"
msgstr "fila"

#: blocks/row/block.json
msgctxt "block keyword"
msgid "columns"
msgstr "columnas"

#: blocks/shortcode/block.json
msgctxt "block title"
msgid "Shortcode (add-on)"
msgstr "Shortcode (complemento)"

#: blocks/shortcode/block.json
msgctxt "block description"
msgid "A shortcode from an add-on written for the classic Page Builder Sandwich editor, with the settings the add-on declared."
msgstr "Un código corto de un complemento escrito para el editor clásico Page Builder Sandwich, con la configuración que el complemento declaró."

#: blocks/shortcode/block.json
msgctxt "block keyword"
msgid "shortcode"
msgstr "código corto"

#: blocks/shortcode/block.json
msgctxt "block keyword"
msgid "add-on"
msgstr "complemento"

#: blocks/sidebar/block.json
