            ],
            "Conversion finished: %1$d converted, %2$d unchanged, %3$d failed.": [
                "\u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e: %1$d \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u043e, %2$d \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439, %3$d \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c."
            ],
            "Legacy content": [
                "\u0423\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442"
            ],
            "Pages made with earlier versions of Page Builder Sandwich are converted to blocks in the background. Every post is backed up first, so each conversion can be undone.": [
                "\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0432 \u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u043d\u043d\u0438\u0445 \u0432\u0435\u0440\u0441\u0438\u044f\u0445 Page Builder Sandwich, \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u044e\u0442\u0441\u044f \u0432 \u0431\u043b\u043e\u043a\u0438 \u0432 \u0444\u043e\u043d\u043e\u0432\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435. \u041f\u0435\u0440\u0435\u0434 \u044d\u0442\u0438\u043c \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438 \u0441\u043e\u0437\u0434\u0430\u0435\u0442\u0441\u044f \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043b\u044e\u0431\u043e\u0435 \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c."
            ],
            "%d post still holds legacy content.": [
                "%d \u0437\u0430\u043f\u0438\u0441\u044c \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442.",
                "%d \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442.",
                "%d \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442."
            ],
            "%d post has a backup.": [
                "\u0414\u043b\u044f %d \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f.",
                "\u0423 %d \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439 \u0435\u0441\u0442\u044c \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f.",
                "\u0423 %d \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0439 \u0435\u0441\u0442\u044c \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f."
