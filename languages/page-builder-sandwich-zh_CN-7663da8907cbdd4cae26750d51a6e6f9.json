            ],
            "Remove these settings": [
                "\u5220\u9664\u8fd9\u4e9b\u8bbe\u7f6e"
            ],
            "Keep my library in this storage": [
                "\u5c06\u6211\u7684\u5a92\u4f53\u5e93\u4fdd\u7559\u5728\u6b64\u5b58\u50a8\u7a7a\u95f4\u4e2d"
            ],
            "The connection test passed.": [
                "\u8fde\u63a5\u6d4b\u8bd5\u901a\u8fc7\u3002"
            ],
            "Run \u201cTest connection\u201d first.": [
                "\u8bf7\u5148\u8fd0\u884c\u201c\u6d4b\u8bd5\u8fde\u63a5\u201d\u3002"
            ],
            "Invite a site": [
                "\u9080\u8bf7\u7f51\u7ad9"
            ],
            "Who is it for? (optional)": [
                "\u9002\u5408\u8c01\uff1f\uff08\u53ef\u9009\uff09"
            ],
            "Access": [
                "\u8bbf\u95ee"
            ],
            "Use designs (read only)": [
                "\u4f7f\u7528\u8bbe\u8ba1\uff08\u53ea\u8bfb\uff09"
            ],
            "Use and save designs": [
                "\u4f7f\u7528\u5e76\u4fdd\u5b58\u8bbe\u8ba1"
