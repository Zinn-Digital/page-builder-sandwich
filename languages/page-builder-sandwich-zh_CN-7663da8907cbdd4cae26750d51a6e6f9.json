            ],
            "Type": [
                "\u7c7b\u578b"
            ],
            "Your licence has expired or was cancelled, so nothing new can be saved. Your saved designs are still here; renew to save again.": [
                "\u60a8\u7684\u8bb8\u53ef\u8bc1\u5df2\u8fc7\u671f\u6216\u5df2\u88ab\u53d6\u6d88\uff0c\u56e0\u6b64\u65e0\u6cd5\u4fdd\u5b58\u4efb\u4f55\u65b0\u5185\u5bb9\u3002\u60a8\u4fdd\u5b58\u7684\u8bbe\u8ba1\u4ecd\u7136\u5728\u8fd9\u91cc\uff1b\u5982\u9700\u518d\u6b21\u4fdd\u5b58\uff0c\u8bf7\u7eed\u8d39\u3002"
            ],
            "Pages": [
                "\u9875\u9762"
            ],
            "My library": [
                "\u6211\u7684\u5a92\u4f53\u5e93"
            ],
            "Team": [
                "\u56e2\u961f"
            ],
            "Storage": [
                "\u5b58\u50a8"
            ],
            "Your library is kept in your own storage bucket, so no Zinn Digital\u00ae quota applies.": [
                "\u60a8\u7684\u5a92\u4f53\u5e93\u4fdd\u5b58\u5728\u60a8\u81ea\u5df1\u7684\u5b58\u50a8\u6876\u4e2d\uff0c\u56e0\u6b64\u4e0d\u5360\u7528 Zinn Digital\u00ae \u914d\u989d\u3002"
            ],
            "%1$s of %2$s used (%3$d%%)": [
                "\u5df2\u4f7f\u7528 %1$s \/ %2$s\uff08%3$d%%\uff09"
            ],
            "%1$d of %2$d designs \u00b7 up to %3$s per design \u00b7 images are resized to 2560 px and stored once": [
                "%1$d \/ %2$d \u4e2a\u8bbe\u8ba1 \u00b7 \u6bcf\u4e2a\u8bbe\u8ba1\u6700\u591a %3$s \u00b7 \u56fe\u50cf\u5c06\u88ab\u8c03\u6574\u4e3a 2560 \u50cf\u7d20\u5e76\u4ec5\u5b58\u50a8\u4e00\u6b21"
            ],
            "Deleted from your library.": [
                "\u5df2\u4ece\u60a8\u7684\u5a92\u4f53\u5e93\u4e2d\u5220\u9664\u3002"
            ],
            "Save any section or page from the editor: open the block\u2019s \u22ee menu and choose \u201cSave to cloud library\u201d. Insert saved designs from the Cloud library panel in the editor, on any of your sites.": [
                "\u4ece\u7f16\u8f91\u5668\u4e2d\u4fdd\u5b58\u4efb\u610f\u5206\u533a\u6216\u9875\u9762\uff1a\u6253\u5f00\u533a\u5757\u7684 \u22ee \u83dc\u5355\u5e76\u9009\u62e9\u201c\u4fdd\u5b58\u5230\u4e91\u7aef\u5e93\u201d\u3002\u5728\u7f16\u8f91\u5668\u4e2d\u901a\u8fc7\u201c\u4e91\u7aef\u5e93\u201d\u9762\u677f\uff0c\u5c06\u4fdd\u5b58\u7684\u8bbe\u8ba1\u63d2\u5165\u5230\u60a8\u7684\u4efb\u610f\u7ad9\u70b9\u4e2d\u3002"
            ],
            "Show": [
                "\u663e\u793a"
            ],
            "Everything": [
                "\u5168\u90e8"
            ],
            "Sections": [
                "\u533a\u5757"
            ],
            "Styles": [
                "\u6837\u5f0f"
            ],
            "Size": [
                "\u5927\u5c0f"
            ],
            "Nothing saved yet.": [
                "\u5c1a\u672a\u4fdd\u5b58\u4efb\u4f55\u5185\u5bb9\u3002"
            ],
            "Delete": [
                "\u5220\u9664"
            ],
            "Write a test file": [
                "\u7f16\u5199\u6d4b\u8bd5\u6587\u4ef6"
            ],
            "Read it back": [
                "\u56de\u8bfb"
            ],
            "Delete it": [
                "\u5220\u9664\u5b83"
            ],
            "In your Cloudflare dashboard, open R2 Object Storage and create a bucket (for example \u201cmy-pbs-library\u201d). Keep it private: do not connect a public domain.": [
                "\u5728\u60a8\u7684 Cloudflare \u4eea\u8868\u677f\u4e2d\uff0c\u6253\u5f00 R2 Object Storage \u5e76\u521b\u5efa\u4e00\u4e2a\u5b58\u50a8\u6876\uff08\u4f8b\u5982\u201cmy-pbs-library\u201d\uff09\u3002\u5c06\u5176\u8bbe\u4e3a\u79c1\u6709\uff1a\u4e0d\u8981\u8fde\u63a5\u516c\u5171\u57df\u3002"
            ],
            "Open \u201cManage API tokens\u201d in R2 and create an API token with \u201cObject Read & Write\u201d permission, limited to that one bucket.": [
                "\u5728 R2 \u4e2d\u6253\u5f00\u201c\u7ba1\u7406 API \u4ee4\u724c\u201d\uff0c\u521b\u5efa\u4e00\u4e2a\u5177\u6709\u201c\u5bf9\u8c61\u8bfb\u5199\u201d\u6743\u9650\u4e14\u4ec5\u9650\u4e8e\u8be5\u5b58\u50a8\u6876\u7684 API \u4ee4\u724c\u3002"
            ],
            "Copy the Access Key ID and the Secret Access Key it shows (the secret is shown only once).": [
                "\u590d\u5236\u663e\u793a\u7684\u8bbf\u95ee\u5bc6\u94a5 ID \u548c\u79d8\u5bc6\u8bbf\u95ee\u5bc6\u94a5\uff08\u8be5\u5bc6\u94a5\u4ec5\u663e\u793a\u4e00\u6b21\uff09\u3002"
            ],
            "Copy the S3 endpoint for your account. It looks like https:\/\/<account-id>.r2.cloudflarestorage.com. Region is \u201cauto\u201d.": [
                "\u590d\u5236\u60a8\u8d26\u6237\u7684 S3 \u7aef\u70b9\u3002\u5b83\u770b\u8d77\u6765\u50cf https:\/\/<account-id>.r2.cloudflarestorage.com\u3002\u533a\u57df\u4e3a\u201cauto\u201d\u3002"
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d. Switch the library to your storage only when the test passes.": [
                "\u8bf7\u7c98\u8d34\u4ee5\u4e0b\u503c\u5e76\u4fdd\u5b58\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6d4b\u8bd5\u8fde\u63a5\u201d\u3002\u4ec5\u5728\u6d4b\u8bd5\u901a\u8fc7\u540e\uff0c\u518d\u5c06\u5e93\u5207\u6362\u81f3\u60a8\u7684\u5b58\u50a8\u3002"
            ],
            "Create a private bucket with your provider (Amazon S3, Backblaze B2, Wasabi, MinIO or any S3-compatible service).": [
                "\u4f7f\u7528\u60a8\u7684\u670d\u52a1\u63d0\u4f9b\u5546\uff08Amazon S3\u3001Backblaze B2\u3001Wasabi\u3001MinIO \u6216\u4efb\u4f55\u517c\u5bb9 S3 \u7684\u670d\u52a1\uff09\u521b\u5efa\u4e00\u4e2a\u79c1\u6709\u5b58\u50a8\u6876\u3002"
            ],
            "Create an access key that can read, write and delete objects in that bucket only.": [
                "\u521b\u5efa\u4e00\u4e2a\u53ea\u80fd\u8bfb\u53d6\u3001\u5199\u5165\u548c\u5220\u9664\u8be5\u5b58\u50a8\u6876\u4e2d\u5bf9\u8c61\u7684\u8bbf\u95ee\u5bc6\u94a5\u3002"
            ],
            "Find the S3 endpoint (for Amazon S3: https:\/\/s3.<region>.amazonaws.com) and the bucket\u2019s region.": [
                "\u67e5\u627e S3 \u7ec8\u7aef\u8282\u70b9\uff08\u5bf9\u4e8e Amazon S3\uff1ahttps:\/\/s3.<region>.amazonaws.com\uff09\u53ca\u5b58\u50a8\u6876\u7684\u533a\u57df\u3002"
            ],
            "Amazon S3 uses virtual-hosted addresses: switch off \u201cPath-style addresses\u201d. Most other services use path-style.": [
                "Amazon S3 \u4f7f\u7528\u865a\u62df\u6258\u7ba1\u5730\u5740\uff1a\u8bf7\u5173\u95ed\u201c\u8def\u5f84\u6837\u5f0f\u5730\u5740\u201d\u3002\u5927\u591a\u6570\u5176\u4ed6\u670d\u52a1\u4f7f\u7528\u8def\u5f84\u6837\u5f0f\u3002"
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d.": [
                "\u8bf7\u7c98\u8d34\u4ee5\u4e0b\u6570\u503c\uff0c\u4fdd\u5b58\uff0c\u7136\u540e\u70b9\u51fb\u201c\u6d4b\u8bd5\u8fde\u63a5\u201d\u3002"
            ],
            "Storage settings saved.": [
                "\u5b58\u50a8\u8bbe\u7f6e\u5df2\u4fdd\u5b58\u3002"
            ],
            "Your cloud library is kept in Zinn Digital\u00ae storage with the space your plan includes. You can keep it in your own Cloudflare R2 or S3-compatible bucket instead: then no Zinn Digital\u00ae quota applies, and every site you connect to the same bucket shares the library. Team libraries always use Zinn Digital\u00ae storage.": [
                "\u60a8\u7684\u4e91\u7aef\u5a92\u4f53\u5e93\u4fdd\u5b58\u5728 Zinn Digital\u00ae \u5b58\u50a8\u7a7a\u95f4\u4e2d\uff0c\u8be5\u7a7a\u95f4\u5305\u542b\u5728\u60a8\u7684\u5957\u9910\u5185\u3002\u60a8\u4e5f\u53ef\u4ee5\u5c06\u5176\u4fdd\u5b58\u5728\u60a8\u81ea\u5df1\u7684 Cloudflare R2 \u6216\u517c\u5bb9 S3 \u7684\u5b58\u50a8\u6876\u4e2d\uff1a\u8fd9\u6837\u5c06\u4e0d\u518d\u9002\u7528 Zinn Digital\u00ae \u914d\u989d\uff0c\u5e76\u4e14\u60a8\u8fde\u63a5\u5230\u540c\u4e00\u5b58\u50a8\u6876\u7684\u6bcf\u4e2a\u7ad9\u70b9\u90fd\u5c06\u5171\u4eab\u8be5\u5a92\u4f53\u5e93\u3002\u56e2\u961f\u5a92\u4f53\u5e93\u59cb\u7ec8\u4f7f\u7528 Zinn Digital\u00ae \u5b58\u50a8\u3002"
            ],
            "Connect your own storage: step by step": [
                "\u8fde\u63a5\u60a8\u81ea\u5df1\u7684\u5b58\u50a8\uff1a\u5206\u6b65\u6307\u5357"
            ],
            "Another S3-compatible service": [
                "\u5176\u4ed6\u517c\u5bb9 S3 \u7684\u670d\u52a1"
            ],
            "Read the full guide": [
                "\u9605\u8bfb\u5b8c\u6574\u6307\u5357"
            ],
            "S3 endpoint": [
                "S3 \u7aef\u70b9"
            ],
            "Bucket": [
                "\u5b58\u50a8\u6876"
            ],
            "Region": [
                "\u533a\u57df"
            ],
            "Cloudflare R2: auto.": [
                "Cloudflare R2\uff1a\u81ea\u52a8"
            ],
            "Access key ID": [
                "\u8bbf\u95ee\u5bc6\u94a5 ID"
            ],
            "Stored. Leave empty to keep it.": [
                "\u5df2\u4fdd\u5b58\u3002\u5982\u9700\u4fdd\u7559\u5f53\u524d\u5185\u5bb9\uff0c\u8bf7\u7559\u7a7a\u3002"
            ],
            "Secret access key": [
                "\u79d8\u5bc6\u8bbf\u95ee\u5bc6\u94a5"
            ],
            "Stored encrypted on this site and never shown again. Leave empty to keep it.": [
                "\u5b58\u50a8\u5728\u672c\u7f51\u7ad9\u4e0a\u5df2\u52a0\u5bc6\uff0c\u4e14\u4e0d\u4f1a\u518d\u6b21\u663e\u793a\u3002\u7559\u7a7a\u5219\u4fdd\u6301\u4e0d\u53d8\u3002"
            ],
            "Stored encrypted on this site. It is never sent to Zinn Digital\u00ae.": [
                "\u5df2\u5728\u6b64\u7ad9\u70b9\u4e0a\u52a0\u5bc6\u5b58\u50a8\u3002\u5b83\u7edd\u4e0d\u4f1a\u53d1\u9001\u7ed9 Zinn Digital\u00ae\u3002"
            ],
            "Path-style addresses": [
                "\u8def\u5f84\u6837\u5f0f\u5730\u5740"
            ],
            "Folder in the bucket": [
                "\u5b58\u50a8\u6876\u4e2d\u7684\u6587\u4ef6\u5939"
