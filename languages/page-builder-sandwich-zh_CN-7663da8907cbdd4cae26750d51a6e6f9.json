            ],
            "Give this code to the site owner. It works once, for 7 days, and is shown only now:": [
                "\u5c06\u6b64\u4ee3\u7801\u4ea4\u7ed9\u7f51\u7ad9\u6240\u6709\u8005\u3002\u6b64\u4ee3\u7801\u4ec5\u53ef\u4f7f\u7528\u4e00\u6b21\uff0c\u6709\u6548\u671f\u4e3a 7 \u5929\uff0c\u4e14\u4ec5\u5728\u6b64\u5904\u663e\u793a\u4e00\u6b21\uff1a"
            ],
            "Copy": [
                "\u590d\u5236"
            ],
            "Members": [
