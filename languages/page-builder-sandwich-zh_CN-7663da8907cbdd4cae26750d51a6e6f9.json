            ],
            "No site has joined yet.": [
                "\u5c1a\u65e0\u7f51\u7ad9\u52a0\u5165\u3002"
            ],
            "use and save": [
                "\u4f7f\u7528\u5e76\u4fdd\u5b58"
            ],
            "read only": [
                "\u53ea\u8bfb"
            ],
            "Delete team": [
                "\u5220\u9664\u56e2\u961f"
            ],
            "Delete this team and every design in its library?": [
                "\u5220\u9664\u6b64\u56e2\u961f\u53ca\u5176\u5e93\u4e2d\u7684\u6240\u6709\u8bbe\u8ba1\uff1f"
            ],
            "This site joined the team library.": [
                "\u6b64\u7f51\u7ad9\u5df2\u52a0\u5165\u56e2\u961f\u5171\u4eab\u5e93\u3002"
            ],
            "This site uses the team library:": [
                "\u672c\u7f51\u7ad9\u4f7f\u7528\u56e2\u961f\u5e93\uff1a"
            ],
            "Leave": [
                "\u79bb\u5f00"
            ],
            "Join a team with an invite code": [
                "\u4f7f\u7528\u9080\u8bf7\u7801\u52a0\u5165\u56e2\u961f"
            ],
            "Join": [
                "\u52a0\u5165"
            ],
            "Your teams": [
                "\u60a8\u7684\u56e2\u961f"
            ],
            "New team name": [
                "\u65b0\u56e2\u961f\u540d\u79f0"
            ],
            "Create team": [
                "\u521b\u5efa\u56e2\u961f"
            ],
            "Creating team libraries comes with the Agency plan.": [
                "\u521b\u5efa\u56e2\u961f\u5e93\u529f\u80fd\u5305\u542b\u5728\u673a\u6784\u7248\u65b9\u6848\u4e2d\u3002"
            ]
        }
