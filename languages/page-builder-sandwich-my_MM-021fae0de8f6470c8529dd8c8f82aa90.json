            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u1024\u1012\u103c\u1015\u103a\u1005\u1004\u103a\u1021\u1010\u103d\u1000\u103a \u1005\u100a\u103a\u1038\u1019\u103b\u1009\u103a\u1038\u1019\u103b\u102c\u1038 \u101b\u1031\u1038\u1015\u102b\u104b \"selector\" \u1006\u102d\u102f\u101e\u100a\u103a\u1019\u103e\u102c \u1024\u1012\u103c\u1015\u103a\u1005\u1004\u103a\u1000\u102d\u102f \u1006\u102d\u102f\u101c\u102d\u102f\u101e\u100a\u103a\u104a \u1025\u1015\u1019\u102c selector:hover { opacity: .8 } \u2014 \u101e\u102c\u1019\u1014\u103a\u1000\u103c\u1031\u100a\u102c\u1001\u103b\u1000\u103a\u1019\u103b\u102c\u1038\u101e\u100a\u103a \u1012\u103c\u1015\u103a\u1005\u1004\u103a\u1000\u102d\u102f\u101a\u103a\u1010\u102d\u102f\u1004\u103a\u1015\u1031\u102b\u103a\u1010\u103d\u1004\u103a \u101e\u1000\u103a\u101b\u1031\u102c\u1000\u103a\u101e\u100a\u103a\u104b"
