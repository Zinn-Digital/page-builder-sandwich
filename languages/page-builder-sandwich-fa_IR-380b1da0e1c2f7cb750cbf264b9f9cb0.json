            ],
            "AI uses your own AI provider account. Connect one to start.": [
                "\u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0627\u0632 \u062d\u0633\u0627\u0628 \u0627\u0631\u0627\u0626\u0647\u200c\u062f\u0647\u0646\u062f\u0647 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u062e\u0648\u062f\u062a\u0627\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0628\u0631\u0627\u06cc \u0634\u0631\u0648\u0639\u060c \u06cc\u06a9 \u062d\u0633\u0627\u0628 \u0645\u062a\u0635\u0644 \u06a9\u0646\u06cc\u062f."
            ],
            "Set up AI": [
                "\u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc"
            ],
            "This block has no text of its own.": [
                "\u0627\u06cc\u0646 \u0628\u0644\u0648\u06a9 \u0647\u06cc\u0686 \u0645\u062a\u0646\u06cc \u0627\u0632 \u062e\u0648\u062f \u0646\u062f\u0627\u0631\u062f."
            ],
            "Assistant": [
