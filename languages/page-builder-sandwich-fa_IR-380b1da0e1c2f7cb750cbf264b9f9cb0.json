            ],
            "Not done (%1$s): %2$s": [
                "\u0627\u0646\u062c\u0627\u0645 \u0646\u0634\u062f (%1$s): %2$s"
            ],
            "Undo this change": [
                "\u0648\u0627\u06af\u0631\u062f\u0627\u0646\u06cc \u0627\u06cc\u0646 \u062a\u063a\u06cc\u06cc\u0631"
            ],
            "What should change?": [
                "\u0686\u0647 \u0686\u06cc\u0632\u06cc \u0628\u0627\u06cc\u062f \u062a\u063a\u06cc\u06cc\u0631 \u06a9\u0646\u062f\u061f"
            ],
            "For example: \"make the hero shorter and friendlier\", \"add an FAQ about delivery after the pricing\", \"translate this section into Spanish\". Select a block first to point at it.": [
                "\u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0645\u062b\u0627\u0644: \u00ab\u0628\u062e\u0634 \u0627\u0635\u0644\u06cc \u0631\u0627 \u06a9\u0648\u062a\u0627\u0647\u200c\u062a\u0631 \u0648 \u062f\u0648\u0633\u062a\u0627\u0646\u0647\u200c\u062a\u0631 \u06a9\u0646\u06cc\u062f\u00bb\u060c \u00ab\u0628\u0639\u062f \u0627\u0632 \u0628\u062e\u0634 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc\u060c \u06cc\u06a9 \u0628\u062e\u0634 \u067e\u0631\u0633\u0634\u200c\u0647\u0627\u06cc \u0645\u062a\u062f\u0627\u0648\u0644 \u062f\u0631\u0628\u0627\u0631\u0647 \u062a\u062d\u0648\u06cc\u0644 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u06cc\u062f\u00bb\u060c \u00ab\u0627\u06cc\u0646 \u0628\u062e\u0634 \u0631\u0627 \u0628\u0647 \u0627\u0633\u067e\u0627\u0646\u06cc\u0627\u06cc\u06cc \u062a\u0631\u062c\u0645\u0647 \u06a9\u0646\u06cc\u062f\u00bb. \u0628\u0631\u0627\u06cc \u0627\u0634\u0627\u0631\u0647 \u0628\u0647 \u06cc\u06a9 \u0628\u0644\u0648\u06a9\u060c \u0627\u0628\u062a\u062f\u0627 \u0622\u0646 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f."
            ],
            "Ask": [
                "\u0628\u067e\u0631\u0633\u06cc\u062f"
            ],
            "Build a website": [
                "\u0627\u06cc\u062c\u0627\u062f \u06cc\u06a9 \u0648\u0628\u200c\u0633\u0627\u06cc\u062a"
            ],
            "Describe the business": [
                "\u06a9\u0633\u0628\u200c\u0648\u06a9\u0627\u0631 \u0631\u0627 \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0646\u06cc\u062f"
            ],
            "Plan the pages": [
                "\u0635\u0641\u062d\u0647\u200c\u0647\u0627 \u0631\u0627 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0631\u06cc\u0632\u06cc \u06a9\u0646\u06cc\u062f"
            ],
            "Build these pages as drafts": [
                "\u0627\u06cc\u0646 \u0628\u0631\u06af\u0647\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u067e\u06cc\u0634\u200c\u0646\u0648\u06cc\u0633 \u0628\u0633\u0627\u0632\u06cc\u062f"
            ],
            "Create with AI": [
                "\u0627\u06cc\u062c\u0627\u062f \u0628\u0627 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc"
            ],
            "A custom block": [
                "\u06cc\u06a9 \u0628\u0644\u0648\u06a9 \u0633\u0641\u0627\u0631\u0634\u06cc"
            ],
            "Describe a component (\"a team member card with photo, name, role and a short bio\"). It is saved to My patterns, with its texts editable on every page that uses it.": [
                "\u06cc\u06a9 \u0645\u0624\u0644\u0641\u0647 \u0631\u0627 \u0634\u0631\u062d \u062f\u0647\u06cc\u062f (\u00ab\u06cc\u06a9 \u06a9\u0627\u0631\u062a \u0639\u0636\u0648 \u062a\u06cc\u0645 \u0628\u0627 \u0639\u06a9\u0633\u060c \u0646\u0627\u0645\u060c \u0646\u0642\u0634 \u0648 \u06cc\u06a9 \u0632\u0646\u062f\u06af\u06cc\u200c\u0646\u0627\u0645\u0647 \u06a9\u0648\u062a\u0627\u0647\u00bb). \u0627\u06cc\u0646 \u0645\u0624\u0644\u0641\u0647 \u062f\u0631 \u00ab\u0627\u0644\u06af\u0648\u0647\u0627\u06cc \u0645\u0646\u00bb \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0645\u062a\u0646\u200c\u0647\u0627\u06cc \u0622\u0646 \u062f\u0631 \u0647\u0631 \u0635\u0641\u062d\u0647\u200c\u0627\u06cc \u06a9\u0647 \u0627\u0632 \u0622\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0642\u0627\u0628\u0644 \u0648\u06cc\u0631\u0627\u06cc\u0634 \u0627\u0633\u062a."
            ],
            "Block created and added to the page.": [
                "\u0628\u0644\u0648\u06a9 \u0627\u06cc\u062c\u0627\u062f \u0634\u062f \u0648 \u0628\u0647 \u0628\u0631\u06af\u0647 \u0627\u0636\u0627\u0641\u0647 \u0634\u062f."
            ],
            "Edit the block": [
                "\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0628\u0644\u0648\u06a9"
            ],
            "Create block": [
                "\u0627\u06cc\u062c\u0627\u062f \u0628\u0644\u0648\u06a9"
            ],
            "Design a page from a screenshot or a website address: AI recreates its layout as editable blocks in a new draft.": [
                "\u0637\u0631\u0627\u062d\u06cc \u06cc\u06a9 \u0628\u0631\u06af\u0647 \u0627\u0632 \u0631\u0648\u06cc \u062a\u0635\u0648\u06cc\u0631 \u0635\u0641\u062d\u0647\u200c\u0646\u0645\u0627\u06cc\u0634 \u06cc\u0627 \u0646\u0634\u0627\u0646\u06cc \u06cc\u06a9 \u0648\u0628\u200c\u0633\u0627\u06cc\u062a: \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0686\u06cc\u062f\u0645\u0627\u0646 \u0622\u0646 \u0631\u0627 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0628\u0644\u0648\u06a9\u200c\u0647\u0627\u06cc \u0642\u0627\u0628\u0644 \u0648\u06cc\u0631\u0627\u06cc\u0634 \u062f\u0631 \u06cc\u06a9 \u067e\u06cc\u0634\u200c\u0646\u0648\u06cc\u0633 \u062c\u062f\u06cc\u062f \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f."
            ],
            "Draft page created.": [
                "\u067e\u06cc\u0634\u200c\u0646\u0648\u06cc\u0633 \u0628\u0631\u06af\u0647 \u0627\u06cc\u062c\u0627\u062f \u0634\u062f."
            ],
            "Choose a screenshot": [
                "\u06cc\u06a9 \u0646\u0645\u0627\u06af\u0631\u0641\u062a \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f"
            ],
            "Or a website address": [
                "\u06cc\u0627 \u0646\u0634\u0627\u0646\u06cc \u0648\u0628\u200c\u0633\u0627\u06cc\u062a"
            ],
            "Design from the address": [
                "\u0637\u0631\u0627\u062d\u06cc \u0627\u0632 \u0646\u0634\u0627\u0646\u06cc"
            ],
            "Generate an image": [
                "\u0627\u06cc\u062c\u0627\u062f \u062a\u0635\u0648\u06cc\u0631"
            ],
            "Describe the image": [
                "\u062a\u0635\u0648\u06cc\u0631 \u0631\u0627 \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0646\u06cc\u062f"
            ],
            "Shape": [
                "\u0634\u06a9\u0644"
            ],
            "Landscape": [
                "\u0627\u0641\u0642\u06cc"
            ],
            "Square": [
                "\u0645\u0631\u0628\u0639"
            ],
            "Portrait": [
                "\u0639\u0645\u0648\u062f\u06cc"
            ],
            "Generate and add": [
                "\u062a\u0648\u0644\u06cc\u062f \u0648 \u0627\u0641\u0632\u0648\u062f\u0646"
            ],
            "CSS helper": [
                "\u06a9\u0645\u06a9\u200c\u06cc\u0627\u0631 CSS"
            ],
            "Select a block to work on its custom CSS.": [
                "\u0628\u0631\u0627\u06cc \u0648\u06cc\u0631\u0627\u06cc\u0634 CSS \u0633\u0641\u0627\u0631\u0634\u06cc\u060c \u06cc\u06a9 \u0628\u0644\u0648\u06a9 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f."
            ],
            "What should the CSS do?": [
                "CSS \u0686\u0647 \u06a9\u0627\u0631\u06cc \u0628\u0627\u06cc\u062f \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u062f\u061f"
            ],
            "Write": [
                "\u0628\u0646\u0648\u06cc\u0633\u06cc\u062f"
            ],
            "Fix": [
                "\u0631\u0641\u0639 \u0645\u0634\u06a9\u0644"
            ],
            "Explain": [
                "\u062a\u0648\u0636\u06cc\u062d \u062f\u0647\u06cc\u062f"
            ],
            "Use this CSS": [
                "\u0627\u0632 \u0627\u06cc\u0646 CSS \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f"
            ],
            "Image without alt text": [
                "\u062a\u0635\u0648\u06cc\u0631 \u0628\u062f\u0648\u0646 \u0645\u062a\u0646 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646"
            ],
            "Heading skips a level": [
                "\u0633\u0631\u0628\u0631\u06af \u06cc\u06a9 \u0633\u0637\u062d \u0631\u0627 \u0631\u062f \u0645\u06cc\u200c\u06a9\u0646\u062f"
            ],
            "Link text says nothing on its own": [
                "\u0645\u062a\u0646 \u067e\u06cc\u0648\u0646\u062f \u0628\u0647\u200c\u062a\u0646\u0647\u0627\u06cc\u06cc \u0647\u06cc\u0686 \u0645\u0641\u0647\u0648\u0645\u06cc \u0646\u062f\u0627\u0631\u062f"
            ],
            "Link with no text (fill it in yourself)": [
                "\u067e\u06cc\u0648\u0646\u062f \u0628\u062f\u0648\u0646 \u0645\u062a\u0646 (\u062e\u0648\u062f\u062a\u0627\u0646 \u0622\u0646 \u0631\u0627 \u067e\u0631 \u06a9\u0646\u06cc\u062f)"
            ],
            "Accessibility fixes": [
                "\u0627\u0635\u0644\u0627\u062d\u0627\u062a \u062f\u0633\u062a\u0631\u0633\u06cc\u200c\u067e\u0630\u06cc\u0631\u06cc"
            ],
            "Save the page first: the check reads the saved page.": [
                "\u0627\u0628\u062a\u062f\u0627 \u0628\u0631\u06af\u0647 \u0631\u0627 \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0646\u06cc\u062f: \u0628\u0631\u0631\u0633\u06cc\u060c \u0628\u0631\u06af\u0647\u0654 \u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647 \u0631\u0627 \u0645\u06cc\u200c\u062e\u0648\u0627\u0646\u062f."
            ],
            "Check this page": [
                "\u0627\u06cc\u0646 \u0628\u0631\u06af\u0647 \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f"
            ],
            "No problems found.": [
                "\u0647\u06cc\u0686 \u0645\u0634\u06a9\u0644\u06cc \u06cc\u0627\u0641\u062a \u0646\u0634\u062f."
            ],
            "Fix what can be fixed": [
                "\u0622\u0646\u0686\u0647 \u0631\u0627 \u06a9\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646 \u0628\u0631\u0637\u0631\u0641 \u06a9\u0631\u062f\u060c \u0628\u0631\u0637\u0631\u0641 \u06a9\u0646\u06cc\u062f"
            ],
            "%1$d fixed, %2$d left for you. The page was saved; its previous version is in the revisions.": [
                "%1$d \u0645\u0648\u0631\u062f \u0627\u0635\u0644\u0627\u062d \u0634\u062f\u060c %2$d \u0645\u0648\u0631\u062f \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0628\u0627\u0642\u06cc \u0645\u0627\u0646\u062f\u0647 \u0627\u0633\u062a. \u0628\u0631\u06af\u0647 \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f\u061b \u0646\u0633\u062e\u0647 \u0642\u0628\u0644\u06cc \u0622\u0646 \u062f\u0631 \u0631\u0648\u0646\u0648\u0634\u062a\u200c\u0647\u0627 \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u062f."
            ],
            "Add a section": [
                "\u0627\u0641\u0632\u0648\u062f\u0646 \u0628\u062e\u0634"
            ],
            "Describe the section": [
                "\u0628\u062e\u0634 \u0631\u0627 \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0646\u06cc\u062f"
            ],
            "For example: \"pricing with three plans for a dog-walking service\". It is built from the section library in your brand style.": [
                "\u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0645\u062b\u0627\u0644: \u00ab\u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u0628\u0627 \u0633\u0647 \u067e\u0644\u0646 \u0628\u0631\u0627\u06cc \u062e\u062f\u0645\u0627\u062a \u06af\u0631\u062f\u0634 \u0633\u06af\u00bb. \u0627\u06cc\u0646 \u0628\u062e\u0634 \u0627\u0632 \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0628\u062e\u0634\u200c\u0647\u0627 \u0648 \u0628\u0627 \u0633\u0628\u06a9 \u0628\u0631\u0646\u062f \u0634\u0645\u0627 \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a."
            ],
            "Generate section": [
                "\u062a\u0648\u0644\u06cc\u062f \u0628\u062e\u0634"
            ],
            "SEO and alt text": [
                "\u0633\u0626\u0648 \u0648 \u0645\u062a\u0646 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646"
            ],
            "Install Yoast SEO, Rank Math, SEOPress or All in One SEO to save a meta title and description.": [
                "\u0628\u0631\u0627\u06cc \u0630\u062e\u06cc\u0631\u0647 \u0639\u0646\u0648\u0627\u0646 \u0648 \u062a\u0648\u0636\u06cc\u062d\u0627\u062a \u0645\u062a\u0627\u060c Yoast SEO\u060c Rank Math\u060c SEOPress \u06cc\u0627 All in One SEO \u0631\u0627 \u0646\u0635\u0628 \u06a9\u0646\u06cc\u062f."
            ],
            "Focus keyword (optional)": [
                "\u06a9\u0644\u06cc\u062f\u0648\u0627\u0698\u0647 \u06a9\u0627\u0646\u0648\u0646\u06cc (\u0627\u062e\u062a\u06cc\u0627\u0631\u06cc)"
            ],
            "Suggest title and description": [
                "\u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0639\u0646\u0648\u0627\u0646 \u0648 \u062a\u0648\u0636\u06cc\u062d\u0627\u062a"
            ],
            "Meta title": [
                "\u0639\u0646\u0648\u0627\u0646 \u0645\u062a\u0627"
            ],
            "Meta description": [
                "\u062a\u0648\u0636\u06cc\u062d\u0627\u062a \u0645\u062a\u0627"
            ],
            "Saved to: %s": [
                "\u0630\u062e\u06cc\u0631\u0647\u200c\u0634\u062f\u0647 \u062f\u0631: %s"
            ],
            "Save to my SEO plugin": [
                "\u0630\u062e\u06cc\u0631\u0647 \u062f\u0631 \u0627\u0641\u0632\u0648\u0646\u0647\u0654 \u0633\u0626\u0648\u06cc \u0645\u0646"
