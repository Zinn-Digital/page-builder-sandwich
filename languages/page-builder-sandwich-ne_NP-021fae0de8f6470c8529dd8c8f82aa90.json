                "domain": "messages",
                "lang": "ne_NP",
                "plural-forms": "nplurals=2; plural=(n != 1);"
            },
            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0905\u0928\u092b\u093f\u0932\u094d\u091f\u0930 \u0917\u0930\u093f\u090f\u0915\u094b HTML \u0925\u092a\u094d\u0928 \u0938\u0915\u094d\u0928\u0947 \u092a\u094d\u0930\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0939\u0930\u0942\u0932\u0947 \u092e\u093e\u0924\u094d\u0930 \u0915\u0938\u094d\u091f\u092e CSS \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0917\u0930\u094d\u0928 \u0938\u0915\u094d\u091b\u0928\u094d\u0964"
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u092f\u0938 CSS \u0915\u094b \u0915\u0947\u0939\u0940 \u0905\u0902\u0936 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u093f\u0928\u0947 \u091b\u0948\u0928: \u0938\u0941\u0930\u0915\u094d\u0937\u093e\u0915\u093e \u0932\u093e\u0917\u093f @import, expression(), javascript: URLs, \"<\" \u0930 \u0905\u0938\u0928\u094d\u0924\u0941\u0932\u093f\u0924 \u0915\u094b\u0937\u094d\u0920\u0915\u0939\u0930\u0942 \u0939\u091f\u093e\u0907\u0928\u094d\u091b\u0928\u094d\u0964"
            ],
            "Page CSS": [
                "\u092a\u0947\u091c \u0938\u0940\u090f\u0938\u090f\u0938"
            ],
            "Global classes": [
                "\u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u0935\u0930\u094d\u0917\u0939\u0930\u0942"
            ],
            "Classes": [
                "\u0915\u0915\u094d\u0937\u093e\u0939\u0930\u0942"
            ],
            "Create classes in Site design, then add them here.": [
                "\u0938\u093e\u0907\u091f \u0921\u093f\u091c\u093e\u0907\u0928\u092e\u093e \u0915\u0915\u094d\u0937\u093e\u0939\u0930\u0942 \u0938\u093f\u0930\u094d\u091c\u0928\u093e \u0917\u0930\u094d\u0928\u0941\u0939\u094b\u0938\u094d, \u0924\u094d\u092f\u0938\u092a\u091b\u093f \u0924\u093f\u0928\u0940\u0939\u0930\u0942\u0932\u093e\u0908 \u092f\u0939\u093e\u0901 \u0925\u092a\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964"
            ],
            "Custom CSS": [
                "\u0915\u0938\u094d\u091f\u092e \u0938\u0940\u090f\u0938\u090f\u0938"
            ],
            "Write rules for this element. \"selector\" means this element, e.g. selector:hover { opacity: .8 } \u2014 plain declarations apply to the element itself.": [
                "\u092f\u094b \u0924\u0924\u094d\u0935\u0915\u094b \u0932\u093e\u0917\u093f \u0928\u093f\u092f\u092e\u0939\u0930\u0942 \u0932\u0947\u0916\u094d\u0928\u0941\u0939\u094b\u0938\u094d\u0964 \"selector\" \u0915\u094b \u0905\u0930\u094d\u0925 \u092f\u094b \u0924\u0924\u094d\u0935 \u0939\u094b, \u0909\u0926\u093e\u0939\u0930\u0923\u0915\u093e \u0932\u093e\u0917\u093f selector:hover { opacity: .8 } \u2014 \u0938\u093e\u0927\u093e\u0930\u0923 \u0918\u094b\u0937\u0923\u093e \u0938\u0940\u0927\u0948 \u0924\u0924\u094d\u0935\u092e\u093e \u0932\u093e\u0917\u0942 \u0939\u0941\u0928\u094d\u091b\u0928\u094d\u0964"
            ],
            "CSS for this page": [
                "\u092f\u0938 \u092a\u0943\u0937\u094d\u0920\u0915\u094b \u0932\u093e\u0917\u093f CSS"
            ],
            "Loaded only on this page, after the site\u2019s styles. Saved with the page.": [
                "\u0938\u093e\u0907\u091f\u0915\u094b \u0938\u094d\u091f\u093e\u0907\u0932 \u092a\u091b\u093f, \u092f\u094b \u092a\u0943\u0937\u094d\u0920\u092e\u093e \u092e\u093e\u0924\u094d\u0930 \u0932\u094b\u0921 \u0939\u0941\u0928\u094d\u091b\u0964 \u092a\u0943\u0937\u094d\u0920\u0938\u0901\u0917\u0948 \u0938\u0947\u092d \u0939\u0941\u0928\u094d\u091b\u0964"
            ]
        }
    }
}
