            },
            "Import and export": [
                "\u0906\u092f\u093e\u0924 \u0914\u0930 \u0928\u093f\u0930\u094d\u092f\u093e\u0924"
            ],
            "Import": [
                "\u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"
            ],
            "%d new": [
                "%d \u0928\u090f",
                "%d \u0928\u090f"
            ],
            "%d replaced": [
                "%d \u092c\u0926\u0932\u0947 \u0917\u090f",
                "%d \u092c\u0926\u0932\u0947 \u0917\u090f"
            ],
            "%d kept as they were": [
                "%d \u091c\u0948\u0938\u0947 \u0925\u0947 \u0935\u0948\u0938\u0947 \u0939\u0940 \u0930\u0916\u0947 \u0917\u090f",
                "%d \u0915\u094b \u091c\u0948\u0938\u093e \u0925\u093e \u0935\u0948\u0938\u093e \u0939\u0940 \u0930\u0916\u093e \u0917\u092f\u093e"
            ],
            "%d setting": [
                "%d \u0938\u0947\u091f\u093f\u0902\u0917",
                "%d \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938"
            ],
            "Importing will give: %s.": [
                "\u0906\u092f\u093e\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e: %s."
            ],
            "Imported: %s.": [
                "\u0906\u092f\u093e\u0924\u093f\u0924: %s."
            ],
            "Exported %d item.": [
                "%d \u0906\u0907\u091f\u092e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964",
                "%d \u0906\u0907\u091f\u092e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u093f\u090f \u0917\u090f\u0964"
            ],
            "That file could not be read as an export file.": [
                "\u0909\u0938 \u092b\u093c\u093e\u0907\u0932 \u0915\u094b \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092a\u0922\u093c\u093e \u091c\u093e \u0938\u0915\u093e\u0964"
            ],
            "Export": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0938\u093e\u0907\u091f \u092a\u0930 \u0906\u092f\u093e\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u091f\u0947\u092e\u094d\u092a\u094d\u0932\u0947\u091f, \u092a\u0948\u091f\u0930\u094d\u0928 \u0914\u0930 \u0938\u093e\u0907\u091f \u0921\u093f\u091c\u093c\u093e\u0907\u0928 \u0915\u094b \u090f\u0915 \u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964"
            ],
            "There are no templates or patterns to export yet.": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092d\u0940 \u0915\u094b\u0908 \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u092f\u093e \u092a\u0948\u091f\u0930\u094d\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964"
            ],
            "Include the settings": [
                "\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902"
            ],
            "Download the export file": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093c\u093e\u0907\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902"
            ],
            "Choose an export file": [
                "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092b\u093c\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 %2$s \u0938\u0947 %1$d \u0906\u0907\u091f\u092e \u0939\u0948\u0964",
                "\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 %2$s \u0938\u0947 %1$d \u0906\u0907\u091f\u092e \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964"
            ],
            "When an item with the same name already exists here": [
                "\u091c\u092c \u0909\u0938\u0940 \u0928\u093e\u092e \u0915\u093e \u0915\u094b\u0908 \u0906\u0907\u091f\u092e \u092f\u0939\u093e\u0902 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u094b"
            ],
            "Keep the one on this site": [
                "\u0907\u0938 \u0938\u093e\u0907\u091f \u092a\u0930 \u092e\u094c\u091c\u0942\u0926 \u0915\u094b \u0930\u0916\u0947\u0902"
            ],
            "Replace it with the imported one": [
                "\u0907\u0938\u0947 \u0906\u092f\u093e\u0924 \u0915\u093f\u090f \u0917\u090f \u0938\u0947 \u092c\u0926\u0932\u0947\u0902"
            ],
            "Import a copy beside it": [
                "\u0907\u0938\u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 \u092a\u094d\u0930\u0924\u093f \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"
            ],
            "Apply the settings in the file": [
                "\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u092e\u094c\u091c\u0942\u0926 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0932\u093e\u0917\u0942 \u0915\u0930\u0947\u0902"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u091b\u0935\u093f\u092f\u094b\u0902 \u0915\u094b \u0907\u0938 \u0938\u093e\u0907\u091f \u0915\u0940 \u092e\u0940\u0921\u093f\u092f\u093e \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940 \u092e\u0947\u0902 \u0915\u0949\u092a\u0940 \u0915\u0930\u0947\u0902"
            ],
            "Show what will happen": [
                "\u0926\u093f\u0916\u093e\u090f\u0902 \u0915\u093f \u0915\u094d\u092f\u093e \u0939\u094b\u0917\u093e"
            ]
        }
    }
