#: blocks/language-switcher/block.json
msgctxt "block title"
msgid "Language switcher"
msgstr "Penukar bahasa"

#: blocks/language-switcher/block.json
msgctxt "block description"
msgid "Lets visitors read this page in another language, styled to match your page. Needs the Tranzly plugin for the languages."
msgstr "Membolehkan pelawat membaca halaman ini dalam bahasa lain, dengan gaya yang sepadan dengan halaman anda. Memerlukan pelayan pemalam Tranzly untuk bahasa tersebut."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "terjemahan"

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "berbilang bahasa"

#: blocks/pro__premium_only/dark-mode-switch/block.json
msgctxt "block title"
msgid "Dark mode switch"
msgstr "Suis mod gelap"

#: blocks/pro__premium_only/dark-mode-switch/block.json
msgctxt "block description"
msgid "A button that switches the website between its light and dark colours, and remembers the visitor's choice."
msgstr "Butang yang menukar tapak web antara warna cerah dan gelapnya, serta mengingati pilihan pelawat."

