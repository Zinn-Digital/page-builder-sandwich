msgid "light"
msgstr "cerah"

#: blocks/pro__premium_only/dark-mode-switch/block.json
msgctxt "block keyword"
msgid "colour scheme"
msgstr "skema warna"

#: blocks/row/block.json
msgctxt "block title"
msgid "Row"
msgstr "Baris"

#: blocks/row/block.json
msgctxt "block description"
msgid "A row of columns. Stays readable if the plugin is ever turned off."
msgstr "Satu baris lajur. Kekal boleh dibaca jika palam masuk dimatikan pada bila-bila masa."

