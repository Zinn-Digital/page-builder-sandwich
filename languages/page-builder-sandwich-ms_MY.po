#: blocks/section/block.json
msgctxt "block title"
msgid "Section"
msgstr "Bahagian"

#: blocks/section/block.json
msgctxt "block description"
msgid "A full-width band of the page that lays its content out with flexbox or a grid. Stays readable if the plugin is ever turned off."
msgstr "Jalur lebar penuh halaman yang menyusun kandungannya menggunakan flexbox atau grid. Kekal boleh dibaca sekiranya palam ini dimatikan."

#: blocks/section/block.json
msgctxt "block keyword"
