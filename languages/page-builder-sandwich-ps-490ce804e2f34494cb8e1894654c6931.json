            "Accessibility checker": [
                "\u062f \u0644\u0627\u0633\u0631\u0633\u064a \u0648\u0693\u062a\u06cc\u0627 \u0645\u0639\u0627\u06cc\u0646\u0647 \u06a9\u0648\u0646\u06a9\u06cc"
            ],
            "Problem": [
                "\u0633\u062a\u0648\u0646\u0632\u0647"
            ],
            "Check": [
                "\u0645\u0639\u06cc\u0646 \u06a9\u0648\u0644"
            ],
            "Show block": [
                "\u0628\u0644\u0627\u06a9 \u069a\u06a9\u0627\u0631\u0647 \u06a9\u0648\u0644"
            ],
            "Use a readable theme colour": [
                "\u062f \u0644\u0648\u0633\u062a\u0644\u0648 \u0648\u0693 \u0645\u0648\u0636\u0648\u0639 \u0631\u0646\u06ab \u0648\u06a9\u0627\u0631\u0648\u0626"
            ],
            "Make it H%d": [
                "H%d \u06cc\u06d0 \u06a9\u0693\u0626"
            ],
            "Alt text": [
                "\u0628\u062f\u06cc\u0644 \u0645\u062a\u0646"
            ],
            "Save alt text": [
                "\u0645\u062a\u0646 \u0628\u062f\u06cc\u0644 \u062e\u0648\u0646\u062f\u064a \u06a9\u0693\u0626"
            ],
            "This image is decorative": [
                "\u062f\u0627 \u0627\u0646\u0681\u0648\u0631 \u062a\u0632\u0626\u064a\u0646\u064a \u062f\u06cc"
            ],
            "Checking\u2026": [
                "\u0686\u06a9 \u06a9\u0648\u0644\u2026"
            ],
            "No accessibility problems found on this page.": [
                "\u067e\u0647 \u062f\u06d0 \u067e\u0627\u06bc\u0647 \u06a9\u06d0 \u062f \u0644\u0627\u0633\u0631\u0633\u064a \u0647\u06d0\u0685 \u0633\u062a\u0648\u0646\u0632\u0647 \u0648\u0646\u0647 \u0645\u0648\u0646\u062f\u0644 \u0634\u0648\u0647."
            ],
            "%1$s, %2$s.": [
                "%1$s\u060c %2$s."
            ],
            "%d problem": [
                "%d \u0633\u062a\u0648\u0646\u0632\u0647",
                "%d \u0633\u062a\u0648\u0646\u0632\u06d0"
            ],
            "%d thing to check": [
                "\u062f \u0686\u0627\u06bc \u0644\u067e\u0627\u0631\u0647 %d \u0634\u06cc",
                "\u062f \u06a9\u062a\u0644\u0648 \u0644\u067e\u0627\u0631\u0647 %d \u0634\u064a\u0627\u0646"
            ],
            "Check again": [
                "\u0628\u06cc\u0627 \u0648\u06ab\u0648\u0631\u0626"
            ],
            "An automatic check finds many problems but not all of them. Also try the page with the keyboard alone and with a screen reader.": [
                "\u064a\u0648 \u0627\u062a\u0648\u0645\u0627\u062a\u064a\u06a9 \u0686\u06a9 \u0689\u06d0\u0631\u06d0 \u0633\u062a\u0648\u0646\u0632\u06d0 \u0645\u0648\u0646\u062f\u0644\u06cc \u0634\u064a \u062e\u0648 \u067c\u0648\u0644\u06d0 \u0646\u0647. \u067e\u0627\u06bc\u0647 \u062f \u06a9\u064a\u0628\u0648\u0631\u062f \u067e\u0647 \u0645\u0631\u0633\u062a\u0647 \u064a\u0648\u0627\u0632\u06d0 \u0627\u0648 \u062f \u0633\u06a9\u0631\u06cc\u0646 \u0644\u0648\u0633\u062a\u0648\u0646\u06a9\u064a \u0633\u0631\u0647 \u0647\u0645 \u0648 \u0627\u0632\u0645\u0648\u0626."
            ],
            "Text contrast is %1$s:1; it needs at least %2$s:1 to be readable.": [
                "\u062f \u0645\u062a\u0646 \u0628\u0631\u0639\u06a9\u0633\u0648\u0627\u0644\u06cc %1$s:1 \u062f\u06cc\u061b \u062f \u0644\u0648\u0633\u062a\u0644\u0648 \u0648\u0693\u062a\u06cc\u0627 \u0644\u067e\u0627\u0631\u0647 \u0644\u0696 \u062a\u0631 \u0644\u0696\u0647 %2$s:1 \u062a\u0647 \u0627\u0693\u062a\u06cc\u0627 \u062f\u0647."
            ],
            "click here,here,read more,more,link,this link,learn more,go": [
                "\u062f\u0644\u062a\u0647 \u06a9\u0644\u06cc\u06a9 \u0648\u06a9\u0693\u0626, \u062f\u0644\u062a\u0647, \u0646\u0648\u0631 \u0648\u0644\u0648\u0644\u0626, \u0646\u0648\u0631, \u0644\u06cc\u0646\u06a9, \u062f\u0627 \u0644\u06cc\u0646\u06a9, \u0646\u0648\u0631 \u0632\u062f\u0647 \u06a9\u0693\u0626, \u0644\u0627\u0693 \u0634\u0626"
            ],
            "A link has no text, so a screen reader announces only \u201clink\u201d. Add text or a label.": [
                "\u06cc\u0648 \u0644\u06cc\u0646\u06a9 \u0647\u06cc\u0685 \u0645\u062a\u0646 \u0646\u0647 \u0644\u0631\u064a\u060c \u0646\u0648 \u062f \u0633\u06a9\u0631\u06cc\u0646 \u0644\u0648\u0633\u062a\u0648\u0646\u06a9\u06cc \u06cc\u0648\u0627\u0632\u06d0 \u00ab\u0644\u06cc\u0646\u06a9\u00bb \u0627\u0639\u0644\u0627\u0646\u0648\u064a. \u0645\u062a\u0646 \u06cc\u0627 \u0644\u06cc\u0628\u0644 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626."
            ],
            "The link text \u201c%s\u201d does not say where it goes. Describe the destination instead.": [
                "\u062f \u0644\u06cc\u0646\u06a9 \u0645\u062a\u0646 \u00ab%s\u00bb \u0646\u0647 \u069a\u064a\u064a \u0686\u06d0 \u0686\u06cc\u0631\u06d0 \u0681\u064a. \u067e\u0631\u0681\u0627\u06cc \u06cc\u06d0 \u0645\u0646\u0632\u0644 \u062a\u0634\u0631\u06cc\u062d \u06a9\u0693\u0626."
            ],
            "An element has a positive tabindex, which changes the keyboard order away from the reading order. Use 0 or remove it.": [
                "\u064a\u0648 \u0639\u0646\u0635\u0631 \u0645\u062b\u0628\u062a tabindex \u0644\u0631\u064a\u060c \u06a9\u0648\u0645 \u0686\u06d0 \u062f \u06a9\u064a\u0628\u0648\u0631\u062f \u062a\u0631\u062a\u064a\u0628 \u062f \u0644\u0648\u0633\u062a\u0644\u0648 \u0644\u0647 \u062a\u0631\u062a\u064a\u0628 \u0685\u062e\u0647 \u0628\u062f\u0644\u0648\u064a. 0 \u0648\u06a9\u0627\u0631\u0648\u0626 \u06cc\u0627 \u06cc\u06d0 \u0644\u0631\u06d0 \u06a9\u0693\u0626."
            ],
            "Something clickable cannot be reached with the keyboard. Use a real button or link.": [
                "\u064a\u0648 \u0685\u0647 \u0686\u06d0 \u062f \u06a9\u0644\u06cc\u06a9 \u0648\u0693 \u062f\u06cc \u062f \u06a9\u06cc\u0628\u0648\u0631\u0689 \u067e\u0647 \u0648\u0627\u0633\u0637\u0647 \u0646\u0647 \u0634\u064a \u0644\u0627\u0633 \u062a\u0647 \u0631\u0627\u062a\u0644\u06cc. \u0627\u0635\u0644\u064a \u062a\u06bc\u06cd \u06cc\u0627 \u0644\u06cc\u0646\u06a9 \u0648\u06a9\u0627\u0631\u0648\u0626."
            ],
            "An embedded frame has no title, so a screen reader cannot say what it is.": [
                "\u06cc\u0648 \u0681\u0627\u06cc \u067e\u0631 \u0681\u0627\u06cc \u0634\u0648\u06cc \u0686\u0648\u06a9\u0627\u067c \u0633\u0631\u0644\u06cc\u06a9 \u0646\u0647 \u0644\u0631\u064a\u060c \u0646\u0648 \u062f \u0633\u06a9\u0631\u06cc\u0646 \u0644\u0648\u0633\u062a\u0648\u0646\u06a9\u06cc \u0646\u0634\u06cc \u06a9\u0648\u0644\u06cc \u0648\u0648\u0627\u06cc\u064a \u0686\u06d0 \u062f\u0627 \u0685\u0647 \u062f\u06cc."
            ],
            "A form field has no label, so its purpose is not announced.": [
                "\u062f \u0641\u0648\u0631\u0645\u0647 \u0633\u0627\u062d\u0647 \u06a9\u0648\u0645\u0647 \u062a\u0648\u0645\u063a\u0647 \u0646\u0647 \u0644\u0631\u064a\u060c \u0646\u0648 \u0647\u062f\u0641 \u06cc\u06d0 \u0646\u0647 \u0627\u0639\u0644\u0627\u0646\u06d0\u0696\u064a."
            ],
            "This heading is empty. Screen reader users navigate by headings; remove it or add text.": [
                "\u062f\u0627 \u0633\u0631\u0644\u06cc\u06a9 \u062e\u0627\u0644\u064a \u062f\u06cc. \u062f \u0633\u06a9\u0631\u06cc\u0646 \u0644\u0648\u0633\u062a\u0648\u0646\u06a9\u064a \u06a9\u0627\u0631\u0648\u0648\u0646\u06a9\u064a \u062f \u0633\u0631\u0644\u06cc\u06a9\u0648\u0646\u0648 \u0644\u0647 \u0645\u062e\u06d0 \u062d\u0631\u06a9\u062a \u06a9\u0648\u064a\u061b \u062f\u0627 \u0644\u06cc\u0631\u06d0 \u06a9\u0693\u0626 \u06cc\u0627 \u0645\u062a\u0646 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0693\u0626."
            ],
            "The page title is already the H1; use H2 for the top level of the content.": [
                "\u062f \u0645\u062e \u0633\u0631\u0644\u06cc\u06a9 \u062f\u0645\u062e\u0647 H1 \u062f\u06cc\u061b \u062f \u0645\u0646\u0681\u067e\u0627\u0646\u06ab\u06d0 \u062f \u067e\u0648\u0631\u062a\u0646\u06cd \u06a9\u0686\u06d0 \u0644\u067e\u0627\u0631\u0647 H2 \u0648\u06a9\u0627\u0631\u0648\u0626."
            ],
            "This H%1$d skips a level; the one before it is H%2$d. Make it an H%3$d.": [
                "\u062f\u0627 H%1$d \u06cc\u0648 \u06a9\u0686\u0647 \u067e\u0631\u06d0\u0696\u062f\u064a\u061b \u0645\u062e\u06a9\u06d0\u0646\u06cc \u06cc\u06d0 H%2$d \u062f\u06cc. \u062f\u0627 \u067e\u0647 H%3$d \u0628\u062f\u0644 \u06a9\u0693\u0626."
            ],
            "This image has no alt text. Describe it, or mark it as decorative if it adds nothing.": [
                "\u062f\u0627 \u0627\u0646\u0681\u0648\u0631 \u062f \u0628\u062f\u06cc\u0644 \u0645\u062a\u0646 (alt text) \u0646\u0647 \u0644\u0631\u064a. \u062f\u0627 \u062a\u0634\u0631\u06cc\u062d \u06a9\u0693\u0626\u060c \u06cc\u0627 \u06a9\u0647 \u062f\u0627 \u0647\u06d0\u0685 \u0627\u0631\u0632\u069a\u062a \u0646\u0647 \u0632\u06cc\u0627\u062a\u0648\u064a\u060c \u062f \u062a\u0632\u0626\u064a\u0646\u064a \u067e\u0647 \u062a\u0648\u06ab\u0647 \u06cc\u06d0 \u0648\u067c\u0627\u06a9\u0626."
            ],
            "Close panel": [
                "\u067e\u06cc\u0646\u0644 \u0648\u062a\u0693\u0626"
            ]
        }
    }
