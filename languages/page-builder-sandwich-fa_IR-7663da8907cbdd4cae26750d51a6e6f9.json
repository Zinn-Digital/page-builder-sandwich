            "Write a test file": [
                "\u0646\u0648\u0634\u062a\u0646 \u06cc\u06a9 \u067e\u0631\u0648\u0646\u062f\u0647 \u0622\u0632\u0645\u0627\u06cc\u0634\u06cc"
            ],
            "Read it back": [
                "\u062f\u0648\u0628\u0627\u0631\u0647 \u0622\u0646 \u0631\u0627 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f"
            ],
            "Delete it": [
                "\u062d\u0630\u0641\u0634 \u06a9\u0646\u06cc\u062f"
            ],
            "In your Cloudflare dashboard, open R2 Object Storage and create a bucket (for example \u201cmy-pbs-library\u201d). Keep it private: do not connect a public domain.": [
                "\u062f\u0631 \u067e\u06cc\u0634\u062e\u0648\u0627\u0646 Cloudflare \u062e\u0648\u062f\u060c R2 Object Storage \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f \u0648 \u06cc\u06a9 \u0628\u0627\u06a9\u062a \u0628\u0633\u0627\u0632\u06cc\u062f (\u0628\u0631\u0627\u06cc \u0645\u062b\u0627\u0644 \u00abmy-pbs-library\u00bb). \u0622\u0646 \u0631\u0627 \u062e\u0635\u0648\u0635\u06cc \u0646\u06af\u0647 \u062f\u0627\u0631\u06cc\u062f: \u062f\u0627\u0645\u0646\u0647 \u0639\u0645\u0648\u0645\u06cc \u0645\u062a\u0635\u0644 \u0646\u06a9\u0646\u06cc\u062f."
            ],
            "Open \u201cManage API tokens\u201d in R2 and create an API token with \u201cObject Read & Write\u201d permission, limited to that one bucket.": [
                "\u0628\u062e\u0634 \u00ab\u0645\u062f\u06cc\u0631\u06cc\u062a \u062a\u0648\u06a9\u0646\u200c\u0647\u0627\u06cc API\u00bb \u0631\u0627 \u062f\u0631 R2 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f \u0648 \u06cc\u06a9 \u062a\u0648\u06a9\u0646 API \u0628\u0627 \u0645\u062c\u0648\u0632 \u00ab\u062e\u0648\u0627\u0646\u062f\u0646 \u0648 \u0646\u0648\u0634\u062a\u0646 \u0634\u06cc\u0621\u00bb\u060c \u0645\u062d\u062f\u0648\u062f \u0628\u0647 \u0647\u0645\u0627\u0646 \u06cc\u06a9 \u0628\u0627\u06a9\u062a \u0627\u06cc\u062c\u0627\u062f \u0646\u0645\u0627\u06cc\u06cc\u062f."
            ],
            "Copy the Access Key ID and the Secret Access Key it shows (the secret is shown only once).": [
                "\u0634\u0646\u0627\u0633\u0647 \u06a9\u0644\u06cc\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u0648 \u06a9\u0644\u06cc\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u0645\u062e\u0641\u06cc \u0646\u0645\u0627\u06cc\u0634\u200c\u062f\u0627\u062f\u0647\u200c\u0634\u062f\u0647 \u0631\u0627 \u06a9\u067e\u06cc \u06a9\u0646\u06cc\u062f (\u06a9\u0644\u06cc\u062f \u0645\u062e\u0641\u06cc \u0641\u0642\u0637 \u06cc\u06a9 \u0628\u0627\u0631 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f)."
            ],
            "Copy the S3 endpoint for your account. It looks like https:\/\/<account-id>.r2.cloudflarestorage.com. Region is \u201cauto\u201d.": [
                "\u0646\u0642\u0637\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc S3 \u0631\u0627 \u0628\u0631\u0627\u06cc \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062e\u0648\u062f \u06a9\u067e\u06cc \u06a9\u0646\u06cc\u062f. \u0634\u0628\u06cc\u0647 https:\/\/<account-id>.r2.cloudflarestorage.com \u0627\u0633\u062a. \u0645\u0646\u0637\u0642\u0647 \u00abauto\u00bb \u0627\u0633\u062a."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d. Switch the library to your storage only when the test passes.": [
                "\u0645\u0642\u0627\u062f\u06cc\u0631 \u0632\u06cc\u0631 \u0631\u0627 \u062c\u0627\u06cc\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f\u060c \u0630\u062e\u06cc\u0631\u0647 \u0646\u0645\u0627\u06cc\u06cc\u062f\u060c \u0633\u067e\u0633 \u00ab\u0622\u0632\u0645\u0627\u06cc\u0634 \u0627\u062a\u0635\u0627\u0644\u00bb \u0631\u0627 \u0641\u0634\u0627\u0631 \u062f\u0647\u06cc\u062f. \u062a\u0646\u0647\u0627 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0622\u0632\u0645\u0627\u06cc\u0634 \u0628\u0627 \u0645\u0648\u0641\u0642\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u0634\u062f\u060c \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0631\u0627 \u0628\u0647 \u0641\u0636\u0627\u06cc \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u062e\u0648\u062f \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0647\u06cc\u062f."
            ],
            "Create a private bucket with your provider (Amazon S3, Backblaze B2, Wasabi, MinIO or any S3-compatible service).": [
                "\u06cc\u06a9 \u0628\u0627\u06a9\u062a (bucket) \u062e\u0635\u0648\u0635\u06cc \u0646\u0632\u062f \u0627\u0631\u0627\u0626\u0647\u200c\u062f\u0647\u0646\u062f\u0647 \u062e\u0648\u062f (Amazon S3\u060c Backblaze B2\u060c Wasabi\u060c MinIO \u06cc\u0627 \u0647\u0631 \u0633\u0631\u0648\u06cc\u0633 \u0633\u0627\u0632\u06af\u0627\u0631 \u0628\u0627 S3) \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f."
            ],
            "Create an access key that can read, write and delete objects in that bucket only.": [
                "\u06cc\u06a9 \u06a9\u0644\u06cc\u062f \u062f\u0633\u062a\u0631\u0633\u06cc \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f \u06a9\u0647 \u0641\u0642\u0637 \u0628\u062a\u0648\u0627\u0646\u062f \u0627\u0634\u06cc\u0627\u0621 \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0622\u0646 \u0628\u0627\u06a9\u062a \u0631\u0627 \u0628\u062e\u0648\u0627\u0646\u062f\u060c \u0628\u0646\u0648\u06cc\u0633\u062f \u0648 \u062d\u0630\u0641 \u06a9\u0646\u062f."
            ],
            "Find the S3 endpoint (for Amazon S3: %s) and the bucket\u2019s region.": [
                "\u0646\u0642\u0637\u0647 \u067e\u0627\u06cc\u0627\u0646\u06cc S3 (\u0628\u0631\u0627\u06cc Amazon S3: %s) \u0648 \u0645\u0646\u0637\u0642\u0647 \u0628\u0627\u06a9\u062a \u0631\u0627 \u067e\u06cc\u062f\u0627 \u06a9\u0646\u06cc\u062f."
            ],
            "Amazon S3 uses virtual-hosted addresses: switch off \u201cPath-style addresses\u201d. Most other services use path-style.": [
                "\u0633\u0631\u0648\u06cc\u0633 Amazon S3 \u0627\u0632 \u0622\u062f\u0631\u0633\u200c\u0647\u0627\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646\u06cc \u0645\u062c\u0627\u0632\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f: \u00abPath-style addresses\u00bb \u0631\u0627 \u062e\u0627\u0645\u0648\u0634 \u06a9\u0646\u06cc\u062f. \u0627\u06a9\u062b\u0631 \u0633\u0631\u0648\u06cc\u0633\u200c\u0647\u0627\u06cc \u062f\u06cc\u06af\u0631 \u0627\u0632 \u0633\u0628\u06a9 \u0645\u0633\u06cc\u0631 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d.": [
                "\u0645\u0642\u0627\u062f\u06cc\u0631 \u0631\u0627 \u062f\u0631 \u0632\u06cc\u0631 \u062c\u0627\u06cc\u200c\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f\u060c \u0630\u062e\u06cc\u0631\u0647 \u0646\u0645\u0627\u06cc\u06cc\u062f\u060c \u0633\u067e\u0633 \u00ab\u0622\u0632\u0645\u0627\u06cc\u0634 \u0627\u062a\u0635\u0627\u0644\u00bb \u0631\u0627 \u0641\u0634\u0627\u0631 \u062f\u0647\u06cc\u062f."
            ],
            "Storage settings saved.": [
                "\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0641\u0636\u0627\u06cc \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f."
            ],
            "Your cloud library is kept in Zinn Digital\u00ae storage with the space your plan includes. You can keep it in your own Cloudflare R2 or S3-compatible bucket instead: then no Zinn Digital\u00ae quota applies, and every site you connect to the same bucket shares the library. Team libraries always use Zinn Digital\u00ae storage.": [
                "\u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0627\u0628\u0631\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0641\u0636\u0627\u06cc \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc Zinn Digital\u00ae \u0628\u0627 \u0641\u0636\u0627\u06cc\u06cc \u06a9\u0647 \u0637\u0631\u062d \u0634\u0645\u0627 \u0634\u0627\u0645\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f. \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0639\u0648\u0636 \u0622\u0646 \u0631\u0627 \u062f\u0631 \u0628\u0627\u06a9\u062a Cloudflare R2 \u06cc\u0627 \u0633\u0627\u0632\u06af\u0627\u0631 \u0628\u0627 S3 \u062e\u0648\u062f \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f: \u062f\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a \u0647\u06cc\u0686 \u0633\u0647\u0645\u06cc\u0647 Zinn Digital\u00ae \u0627\u0639\u0645\u0627\u0644 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0647\u0631 \u0633\u0627\u06cc\u062a\u06cc \u06a9\u0647 \u0628\u0647 \u0647\u0645\u0627\u0646 \u0628\u0627\u06a9\u062a \u0645\u062a\u0635\u0644 \u06a9\u0646\u06cc\u062f\u060c \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647 \u0631\u0627 \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0645\u06cc\u200c\u06af\u0630\u0627\u0631\u062f. \u06a9\u062a\u0627\u0628\u062e\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u062a\u06cc\u0645\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0627\u0632 \u0641\u0636\u0627\u06cc \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc Zinn Digital\u00ae \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f."
