                "\u0924\u0947 \u0939\u091f\u0935\u093e"
            ],
            "In your Cloudflare dashboard, open R2 Object Storage and create a bucket (for example \u201cmy-pbs-library\u201d). Keep it private: do not connect a public domain.": [
                "\u0924\u0941\u092e\u091a\u094d\u092f\u093e Cloudflare \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921\u092e\u0927\u094d\u092f\u0947, R2 Object Storage \u0909\u0918\u0921\u093e \u0906\u0923\u093f \u090f\u0915 \u092c\u0915\u0947\u091f \u0924\u092f\u093e\u0930 \u0915\u0930\u093e (\u0909\u0926\u093e\u0939\u0930\u0923\u093e\u0930\u094d\u0925 \u201cmy-pbs-library\u201d). \u0924\u0947 \u0916\u093e\u091c\u0917\u0940 \u0920\u0947\u0935\u093e: \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0921\u094b\u092e\u0947\u0928 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0942 \u0928\u0915\u093e."
            ],
            "Open \u201cManage API tokens\u201d in R2 and create an API token with \u201cObject Read & Write\u201d permission, limited to that one bucket.": [
                "R2 \u092e\u0927\u094d\u092f\u0947 \u201cAPI \u091f\u094b\u0915\u0928\u094d\u0938 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e\u201d \u0909\u0918\u0921\u093e \u0906\u0923\u093f \u0915\u0947\u0935\u0933 \u0924\u094d\u092f\u093e\u091a \u090f\u0915\u093e \u092c\u0915\u0947\u091f\u092a\u0941\u0930\u0924\u0940 \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0905\u0938\u0932\u0947\u0932\u0940 \u201c\u0911\u092c\u094d\u091c\u0947\u0915\u094d\u091f \u0935\u093e\u091a\u093e \u0906\u0923\u093f \u0932\u093f\u0939\u093e\u201d \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0905\u0938\u0932\u0947\u0932\u0947 API \u091f\u094b\u0915\u0928 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e."
            ],
            "Copy the Access Key ID and the Secret Access Key it shows (the secret is shown only once).": [
                "\u0926\u093e\u0916\u0935\u0932\u0947\u0932\u093e Access Key ID \u0906\u0923\u093f Secret Access Key \u0915\u0949\u092a\u0940 \u0915\u0930\u093e (\u0917\u0941\u092a\u094d\u0924 \u0915\u0940 \u0915\u0947\u0935\u0933 \u090f\u0915\u0926\u093e\u091a \u0926\u093e\u0916\u0935\u0932\u0940 \u091c\u093e\u0924\u0947)."
            ],
            "Copy the S3 endpoint for your account. It looks like https:\/\/<account-id>.r2.cloudflarestorage.com. Region is \u201cauto\u201d.": [
                "\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0938\u093e\u0920\u0940 S3 \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f \u0915\u0949\u092a\u0940 \u0915\u0930\u093e. \u0924\u0947 https:\/\/<account-id>.r2.cloudflarestorage.com \u0938\u093e\u0930\u0916\u0947 \u0926\u093f\u0938\u0924\u0947. \u092a\u094d\u0930\u0926\u0947\u0936 \u201cauto\u201d \u0906\u0939\u0947."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d. Switch the library to your storage only when the test passes.": [
                "\u0916\u093e\u0932\u0940\u0932 \u092e\u0942\u0932\u094d\u092f\u0947 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e, \u091c\u0924\u0928 \u0915\u0930\u093e, \u0928\u0902\u0924\u0930 \"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0924\u092a\u093e\u0938\u093e\" \u0926\u093e\u092c\u093e. \u091a\u093e\u091a\u0923\u0940 \u092f\u0936\u0938\u094d\u0935\u0940 \u091d\u093e\u0932\u094d\u092f\u093e\u0935\u0930\u091a \u0932\u093e\u092f\u092c\u094d\u0930\u0930\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u094d\u091f\u094b\u0930\u0947\u091c\u0935\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u093e."
            ],
            "Create a private bucket with your provider (Amazon S3, Backblaze B2, Wasabi, MinIO or any S3-compatible service).": [
                "\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u094d\u092f\u093e\u0938\u0939 (Amazon S3, Backblaze B2, Wasabi, MinIO \u0915\u093f\u0902\u0935\u093e \u0915\u094b\u0923\u0924\u0940\u0939\u0940 S3-\u0938\u0941\u0938\u0902\u0917\u0924 \u0938\u0947\u0935\u093e) \u0916\u093e\u091c\u0917\u0940 \u092c\u0915\u0947\u091f \u0924\u092f\u093e\u0930 \u0915\u0930\u093e."
            ],
            "Create an access key that can read, write and delete objects in that bucket only.": [
                "\u092b\u0915\u094d\u0924 \u0924\u094d\u092f\u093e \u092c\u0915\u0947\u091f\u092e\u0927\u0940\u0932 \u0911\u092c\u094d\u091c\u0947\u0915\u094d\u091f\u094d\u0938 \u0935\u093e\u091a\u0942, \u0932\u093f\u0939\u0942 \u0906\u0923\u093f \u0939\u091f\u0935\u0942 \u0936\u0915\u0947\u0932 \u0905\u0936\u0940 \u0972\u0915\u094d\u0938\u0947\u0938 \u0915\u0940 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e."
            ],
            "Find the S3 endpoint (for Amazon S3: %s) and the bucket\u2019s region.": [
                "S3 \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f (Amazon S3 \u0938\u093e\u0920\u0940: %s) \u0906\u0923\u093f \u092c\u0915\u0947\u091f\u091a\u093e \u092a\u094d\u0930\u0926\u0947\u0936 \u0936\u094b\u0927\u093e."
            ],
            "Amazon S3 uses virtual-hosted addresses: switch off \u201cPath-style addresses\u201d. Most other services use path-style.": [
                "Amazon S3 \u0935\u094d\u0939\u0930\u094d\u091a\u094d\u092f\u0941\u0905\u0932-\u0939\u094b\u0938\u094d\u091f \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u0924\u094d\u0924\u0947 \u0935\u093e\u092a\u0930\u0924\u0947: \u201cPath-style addresses\u201d \u092c\u0902\u0926 \u0915\u0930\u093e. \u0907\u0924\u0930 \u092c\u0939\u0941\u0924\u093e\u0902\u0936 \u0938\u0947\u0935\u093e \u092a\u093e\u0925-\u0936\u0948\u0932\u0940 \u0935\u093e\u092a\u0930\u0924\u093e\u0924."
            ],
            "Paste the values below, save, then press \u201cTest connection\u201d.": [
                "\u0916\u093e\u0932\u0940\u0932 \u092e\u0942\u0932\u094d\u092f\u0947 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e, \u091c\u0924\u0928 \u0915\u0930\u093e, \u0928\u0902\u0924\u0930 \"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0924\u092a\u093e\u0938\u093e\" \u0926\u093e\u092c\u093e."
            ],
            "Storage settings saved.": [
                "\u0938\u094d\u091f\u094b\u0930\u0947\u091c \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u091c\u0924\u0928 \u0915\u0947\u0932\u094d\u092f\u093e."
            ],
            "Your cloud library is kept in Zinn Digital\u00ae storage with the space your plan includes. You can keep it in your own Cloudflare R2 or S3-compatible bucket instead: then no Zinn Digital\u00ae quota applies, and every site you connect to the same bucket shares the library. Team libraries always use Zinn Digital\u00ae storage.": [
                "\u0924\u0941\u092e\u091a\u0940 \u0915\u094d\u0932\u093e\u0909\u0921 \u0932\u093e\u092f\u092c\u094d\u0930\u0930\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092f\u094b\u091c\u0928\u0947\u092e\u0927\u094d\u092f\u0947 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u091c\u093e\u0917\u0947\u0938\u0939 Zinn Digital\u00ae \u0938\u094d\u091f\u094b\u0930\u0947\u091c\u092e\u0927\u094d\u092f\u0947 \u0920\u0947\u0935\u0932\u0940 \u091c\u093e\u0924\u0947. \u0924\u094d\u092f\u093e\u0910\u0935\u091c\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e Cloudflare R2 \u0915\u093f\u0902\u0935\u093e S3-\u0938\u0941\u0938\u0902\u0917\u0924 \u092c\u0915\u0947\u091f\u092e\u0927\u094d\u092f\u0947 \u0920\u0947\u0935\u0942 \u0936\u0915\u0924\u093e: \u092e\u0917 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 Zinn Digital\u00ae \u0915\u094b\u091f\u093e \u0932\u093e\u0917\u0942 \u0939\u094b\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u094d\u092f\u093e\u091a \u092c\u0915\u0947\u091f\u0936\u0940 \u091c\u094b\u0921\u0932\u0947\u0932\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0938\u093e\u0907\u091f \u0932\u093e\u092f\u092c\u094d\u0930\u0930\u0940 \u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0915\u0930\u0924\u0947. \u091f\u0940\u092e \u0932\u093e\u092f\u092c\u094d\u0930\u0930\u0940 \u0928\u0947\u0939\u092e\u0940 Zinn Digital\u00ae \u0938\u094d\u091f\u094b\u0930\u0947\u091c \u0935\u093e\u092a\u0930\u0924\u093e\u0924."
            ],
            "Connect your own storage: step by step": [
                "\u0924\u0941\u092e\u091a\u0947 \u0938\u094d\u0935\u0924\u0903\u091a\u0947 \u0938\u094d\u091f\u094b\u0930\u0947\u091c \u091c\u094b\u0921\u093e: \u091f\u092a\u094d\u092a\u094d\u092f\u093e\u091f\u092a\u094d\u092a\u094d\u092f\u093e\u0928\u0947"
            ],
            "Another S3-compatible service": [
                "\u0926\u0941\u0938\u0930\u0940 S3-\u0938\u0941\u0938\u0902\u0917\u0924 \u0938\u0947\u0935\u093e"
            ],
            "Read the full guide": [
                "\u092a\u0942\u0930\u094d\u0923 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915 \u0935\u093e\u091a\u093e"
            ],
            "S3 endpoint": [
                "S3 \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f"
