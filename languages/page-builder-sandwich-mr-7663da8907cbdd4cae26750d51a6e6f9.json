                "%2$d \u092a\u0948\u0915\u0940 %1$d \u0921\u093f\u091d\u093e\u0907\u0928 \u00b7 \u092a\u094d\u0930\u0924\u093f \u0921\u093f\u091d\u093e\u0907\u0928 \u0915\u092e\u093e\u0932 %3$s \u00b7 \u091a\u093f\u0924\u094d\u0930\u093e\u0902\u091a\u093e \u0906\u0915\u093e\u0930 2560 px \u092a\u0930\u094d\u092f\u0902\u0924 \u092c\u0926\u0932\u0932\u093e \u091c\u093e\u0924\u094b \u0906\u0923\u093f \u090f\u0915\u0926\u093e\u091a \u0938\u093e\u0920\u0935\u0932\u093e \u091c\u093e\u0924\u094b"
