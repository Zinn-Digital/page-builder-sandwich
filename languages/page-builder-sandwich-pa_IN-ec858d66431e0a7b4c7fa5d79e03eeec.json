                "\u0a07\u0a38 \u0a2b\u0a3e\u0a08\u0a32 \u0a35\u0a3f\u0a71\u0a1a %2$s \u0a24\u0a4b\u0a02 %1$d \u0a06\u0a08\u0a1f\u0a2e\u0a3e\u0a02 \u0a39\u0a28\u0964"
            ],
