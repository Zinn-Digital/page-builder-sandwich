msgid "Lets visitors read this page in another language, styled to match your page. Needs the Tranzly plugin for the languages."
msgstr "Permite que os visitantes leiam esta página em outro idioma, com estilo compatível com o da sua página. É necessário o plugin Tranzly para os idiomas."

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "tradução"

#: blocks/language-switcher/block.json
msgctxt "block keyword"
msgid "multilingual"
msgstr "multilíngue"

#: blocks/row/block.json
msgctxt "block title"
msgid "Row"
msgstr "Linha"

#: blocks/row/block.json
msgctxt "block description"
msgid "A row of columns. Stays readable if the plugin is ever turned off."
msgstr "Uma linha de colunas. Continua legível caso o plugin seja desativado."

#: blocks/row/block.json
msgctxt "block keyword"
msgid "row"
msgstr "linha"

#: blocks/row/block.json
msgctxt "block keyword"
msgid "columns"
msgstr "colunas"

