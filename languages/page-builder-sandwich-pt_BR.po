msgid "When"
msgstr "Quando"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
msgid "Who"
msgstr "Quem"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
msgid "Used for"
msgstr "Utilizado para"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
msgid "Model"
msgstr "Modelo"

#: includes/ai-core/pro__premium_only/class-pro-policy.php:253
