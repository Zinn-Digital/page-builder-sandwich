msgstr "Salvo por uma versão mais recente do plugin: atualize este plugin ou insira a chave novamente."

#: includes/ai-core/class-admin.php:275
msgid "The saved key can no longer be opened (the site's security keys changed). Enter it again."
msgstr "A chave salva não pode mais ser aberta (as chaves de segurança do site foram alteradas). Insira-a novamente."

#: includes/ai-core/class-admin.php:278
msgid "Not connected"
msgstr "Não conectado"

#. translators: %s: date and time of the last successful test.
#: includes/ai-core/class-admin.php:284
#, php-format
msgid "Connected — last test passed %s"
msgstr "Conectado — último teste aprovado em %s"

