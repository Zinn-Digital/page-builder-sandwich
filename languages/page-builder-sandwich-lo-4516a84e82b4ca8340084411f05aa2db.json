            "Cleaned %d item(s).": [
                "\u0ead\u0eb0\u0e99\u0eb2\u0ec4\u0ea1\u0ec1\u0ea5\u0ec9\u0ea7 %d \u0ea5\u0eb2\u0e8d\u0e81\u0eb2\u0e99."
            ],
            "Site health and clean-up": [
                "\u0eaa\u0eb8\u0e82\u0eb0\u0e9e\u0eb2\u0e9a\u0ec0\u0ea7\u0eb1\u0e9a\u0ec4\u0e8a \u0ec1\u0ea5\u0eb0 \u0e81\u0eb2\u0e99\u0ead\u0eb0\u0e99\u0eb2\u0ec4\u0ea1"
            ],
            "Finds old revisions, synced patterns nothing uses, heavy original images and design classes no page uses, and cleans each up in one click.": [
                "\u0e8a\u0ead\u0e81\u0eab\u0eb2\u0eaa\u0eb0\u0e9a\u0eb1\u0e9a\u0ec0\u0e81\u0ebb\u0ec8\u0eb2, \u0eae\u0eb9\u0e9a\u0ec1\u0e9a\u0e9a\u0e97\u0eb5\u0ec8\u0e8a\u0eb4\u0ec9\u0e87\u0ec1\u0ea5\u0ec9\u0ea7\u0e97\u0eb5\u0ec8\u0e9a\u0ecd\u0ec8\u0ea1\u0eb5\u0e81\u0eb2\u0e99\u0e99\u0eb3\u0ec3\u0e8a\u0ec9, \u0eae\u0eb9\u0e9a\u0e9e\u0eb2\u0e9a\u0e95\u0ebb\u0ec9\u0e99\u0eaa\u0eb0\u0e9a\u0eb1\u0e9a\u0e97\u0eb5\u0ec8\u0ea1\u0eb5\u0e82\u0eb0\u0edc\u0eb2\u0e94\u0ec3\u0eab\u0e8d\u0ec8 \u0ec1\u0ea5\u0eb0 \u0e84\u0ea5\u0eb2\u0e94\u0e81\u0eb2\u0e99\u0ead\u0ead\u0e81\u0ec1\u0e9a\u0e9a\u0e97\u0eb5\u0ec8\u0e9a\u0ecd\u0ec8\u0ea1\u0eb5\u0edc\u0ec9\u0eb2\u0ec3\u0e94\u0e99\u0eb3\u0ec3\u0e8a\u0ec9, \u0e9e\u0ec9\u0ead\u0ea1\u0e97\u0eb1\u0e87\u0ead\u0eb0\u0e99\u0eb2\u0ec4\u0ea1\u0ec1\u0e95\u0ec8\u0ea5\u0eb0\u0ea5\u0eb2\u0e8d\u0e81\u0eb2\u0e99\u0ec4\u0e94\u0ec9\u0ec3\u0e99\u0e84\u0ea5\u0eb4\u0e81\u0e94\u0ebd\u0ea7."
            ],
            "Run the report again": [
                "\u0ec0\u0e9b\u0eb5\u0e94\u0ec3\u0e8a\u0ec9\u0ea5\u0eb2\u0e8d\u0e87\u0eb2\u0e99\u0ead\u0eb5\u0e81\u0e84\u0eb1\u0ec9\u0e87"
            ],
            "Run the report": [
                "\u0eaa\u0ec9\u0eb2\u0e87\u0ea5\u0eb2\u0e8d\u0e87\u0eb2\u0e99"
            ],
            "%1$d old revisions on %2$d posts (the newest %3$d of each are kept).": [
                "%1$d \u0eaa\u0eb0\u0e9a\u0eb1\u0e9a\u0ec1\u0e81\u0ec9\u0ec4\u0e82\u0ec0\u0e81\u0ebb\u0ec8\u0eb2\u0ec3\u0e99 %2$d \u0ec2\u0e9e\u0eaa (\u0eaa\u0eb0\u0e9a\u0eb1\u0e9a\u0ec3\u0edd\u0ec8\u0eaa\u0eb8\u0e94 %3$d \u0e82\u0ead\u0e87\u0ec1\u0e95\u0ec8\u0ea5\u0eb0\u0ead\u0eb1\u0e99\u0e96\u0eb7\u0e81\u0ec0\u0e81\u0eb1\u0e9a\u0eae\u0eb1\u0e81\u0eaa\u0eb2\u0ec4\u0ea7\u0ec9)."
            ],
            "Delete the old revisions? This cannot be undone.": [
                "\u0ea5\u0eb6\u0e9a\u0e81\u0eb2\u0e99\u0e94\u0eb1\u0e94\u0ec1\u0e81\u0ec9\u0ec0\u0e81\u0ebb\u0ec8\u0eb2\u0e9a\u0ecd? \u0e81\u0eb2\u0e99\u0e81\u0eb0\u0e97\u0eb3\u0e99\u0eb5\u0ec9\u0e9a\u0ecd\u0ec8\u0eaa\u0eb2\u0ea1\u0eb2\u0e94\u0e8d\u0ebb\u0e81\u0ec0\u0ea5\u0eb5\u0e81\u0ec4\u0e94\u0ec9."
            ],
            "Delete old revisions": [
                "\u0ea5\u0eb6\u0e9a\u0e81\u0eb2\u0e99\u0ec1\u0e81\u0ec9\u0ec4\u0e82\u0ec0\u0e81\u0ebb\u0ec8\u0eb2"
            ],
            "%d synced pattern is not used anywhere.": [
                "%d \u0eae\u0eb9\u0e9a\u0ec1\u0e9a\u0e9a\u0e97\u0eb5\u0ec8\u0e8a\u0eb4\u0e87\u0e84\u0ecc\u0e9a\u0ecd\u0ec8\u0ec4\u0e94\u0ec9\u0e96\u0eb7\u0e81\u0e99\u0eb3\u0ec3\u0e8a\u0ec9\u0ea2\u0eb9\u0ec8\u0e9a\u0ec8\u0ead\u0e99\u0ec3\u0e94\u0ec0\u0ea5\u0eb5\u0e8d."
            ],
            "Move them to the trash": [
                "\u0e8d\u0ec9\u0eb2\u0e8d\u0e9e\u0ea7\u0e81\u0ea1\u0eb1\u0e99\u0ec4\u0e9b\u0e97\u0eb5\u0ec8\u0e96\u0eb1\u0e87\u0e82\u0eb5\u0ec9\u0ec0\u0eab\u0e8d\u0eb7\u0ec9\u0ead"
            ],
            "%1$d heavy images (%2$s).": [
                "\u0eae\u0eb9\u0e9a\u0e9e\u0eb2\u0e9a\u0e97\u0eb5\u0ec8\u0ea1\u0eb5\u0e82\u0eb0\u0edc\u0eb2\u0e94\u0ec3\u0eab\u0e8d\u0ec8 %1$d \u0eae\u0eb9\u0e9a (%2$s)."
            ],
            "Make lighter copies (originals kept)": [
                "\u0eaa\u0ec9\u0eb2\u0e87\u0eaa\u0eb3\u0ec0\u0e99\u0ebb\u0eb2\u0e97\u0eb5\u0ec8\u0ec0\u0e9a\u0ebb\u0eb2\u0e81\u0ea7\u0ec8\u0eb2 (\u0eae\u0eb1\u0e81\u0eaa\u0eb2\u0e95\u0ebb\u0ec9\u0e99\u0eaa\u0eb0\u0e9a\u0eb1\u0e9a\u0ec4\u0ea7\u0ec9)"
            ],
            "%d design class is not used.": [
                "\u0e9a\u0ecd\u0ec8\u0ec4\u0e94\u0ec9\u0e99\u0eb3\u0ec3\u0e8a\u0ec9 %d \u0e84\u0ea5\u0eb2\u0eaa\u0e81\u0eb2\u0e99\u0ead\u0ead\u0e81\u0ec1\u0e9a\u0e9a."
            ],
            "Remove unused classes": [
                "\u0ea5\u0eb6\u0e9a\u0e84\u0ea5\u0eb2\u0eaa\u0e97\u0eb5\u0ec8\u0e9a\u0ecd\u0ec8\u0ec4\u0e94\u0ec9\u0ec3\u0e8a\u0ec9\u0ead\u0ead\u0e81"
            ]
        }
    }
