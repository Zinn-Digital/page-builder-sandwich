msgid "Content"
msgstr "අන්තර්ගතය"

#: src/editor/index.js:28
msgid "Heading"
msgstr "ශීර්ෂකය"

#: src/editor/index.js:33
msgid "Text"
msgstr "පෙළ"

#: src/editor/index.js:39
msgid "Style"
msgstr "ශෛලිය"

#: src/editor/index.js:43
msgid "Plain"
msgstr "සරල"

#: src/editor/index.js:47
msgid "Accent"
msgstr "උච්චාරණය"

#: src/editor/index.js:66
msgid "No languages to switch between. The switcher appears when a translation plugin lists two or more languages."
msgstr "මාරු කිරීමට භාෂා නොමැත. පරිවර්තන ප්ලගිනක භාෂා දෙකක් හෝ වැඩි ගණනක් ලැයිස්තුගත කර ඇති විට මාරුකපනය දිස්වේ."

#: src/editor/index.js:78
msgid "Switcher"
msgstr "ස්විචරය"

#: src/editor/index.js:81
msgid "Accessible label"
msgstr "ප්‍රවේශ විය හැකි ලේබලය"

#: src/editor/index.js:89
msgid "Show the current language"
msgstr "වත්මන් භාෂාව පෙන්වන්න"

#: blocks/fixture-switcher/block.json
msgctxt "block title"
msgid "Language switcher (sample)"
msgstr "භාෂා මාරුවකය (ආදර්ශනය)"

#: blocks/fixture-switcher/block.json
msgctxt "block description"
msgid "Lists the site's languages from the translation plugin, when one is active. It renders nothing otherwise."
msgstr "පරිවර්තන ප්ලගිනයක් සක්‍රීයව පවතින විට, අඩවියේ භාෂා ලැයිස්තුගත කරයි. වෙනත් ආකාරයකින් කිසිවක් නොපෙන්වයි."

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "language"
msgstr "භාෂාව"

#: blocks/fixture-switcher/block.json
msgctxt "block keyword"
msgid "switcher"
msgstr "ස්විචරය"

#: blocks/fixture/block.json
msgctxt "block title"
msgid "Sample content"
msgstr "ආදර්ශ අන්තර්ගතය"

#: blocks/fixture/block.json
msgctxt "block description"
msgid "A heading and a paragraph, rendered with neutral class names. It is the reference block for the translation contract."
msgstr "උඩින් දැක්වෙන ශීර්ෂයක් සහ ඡේදයක්, උදාසීන පන්ති නාම සමඟ විදහා දැක්වේ. එය පරිවර්තන ගිවිසුම සඳහා වන ආශ්‍රිත කොටස වේ."

#: blocks/fixture/block.json
msgctxt "block keyword"
msgid "sample"
msgstr "ආදර්ශය"

