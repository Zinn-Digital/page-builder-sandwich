msgstr[0] "%d සටහනකට උපස්ථයක් ඇත."
msgstr[1] "ලිපි %d ක උපස්ථයක් ඇත."

#. translators: %d: number of posts that failed.
#: src/admin/LegacyContent.js:206
#, js-format
msgid "%d post could not be handled"
msgid_plural "%d posts could not be handled"
msgstr[0] "පෝස්ට් %d ක් හසුරුවා ගැනීමට නොහැකි විය"
msgstr[1] "ලිපි %dක් ක්‍රියාවට නැංවිය නොහැකි විය"

