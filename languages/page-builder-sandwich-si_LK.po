#: src/admin/LegacyContent.js:182
#, js-format
msgid "%d post still holds legacy content."
msgid_plural "%d posts still hold legacy content."
msgstr[0] "%d පෝස්ට් එකක තවදුරටත් පැරණි අන්තර්ගතයන් අඩංගු වේ."
msgstr[1] "පෝස්ට් %d ක තවමත් පැරණි අන්තර්ගතය ඇත."

#. translators: %d: number of posts with a backup.
#: src/admin/LegacyContent.js:192
#, js-format
