            "Where to find your %s API key": [
                "\u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u06a9\u0644\u06cc\u062f API %s \u0634\u0645\u0627 \u062f\u0631 \u06a9\u062c\u0627\u0633\u062a"
