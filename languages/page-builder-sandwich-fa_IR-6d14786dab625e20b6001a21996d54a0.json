            "Check and save": [
                "\u0628\u0631\u0631\u0633\u06cc \u0648 \u0630\u062e\u06cc\u0631\u0647"
            ],
            "Connect a mailing-list service once; then any form can add the people who fill it in to one of your lists (the form block's settings \u2192 After sending). Keys are checked with the service, stored encrypted on this site and never shown again.": [
                "\u06cc\u06a9 \u0633\u0631\u0648\u06cc\u0633 \u0641\u0647\u0631\u0633\u062a \u0627\u06cc\u0645\u06cc\u0644 \u0631\u0627 \u06cc\u06a9 \u0628\u0627\u0631 \u0645\u062a\u0635\u0644 \u06a9\u0646\u06cc\u062f\u061b \u0633\u067e\u0633 \u0647\u0631 \u0641\u0631\u0645 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0627\u0641\u0631\u0627\u062f\u06cc \u0631\u0627 \u06a9\u0647 \u0622\u0646 \u0631\u0627 \u067e\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f \u0628\u0647 \u06cc\u06a9\u06cc \u0627\u0632 \u0641\u0647\u0631\u0633\u062a\u200c\u0647\u0627\u06cc \u0634\u0645\u0627 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0646\u062f (\u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0628\u0644\u0648\u06a9 \u0641\u0631\u0645 \u2190 \u067e\u0633 \u0627\u0632 \u0627\u0631\u0633\u0627\u0644). \u06a9\u0644\u06cc\u062f\u0647\u0627 \u0628\u0627 \u0633\u0631\u0648\u06cc\u0633 \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u060c \u0628\u0647 \u0635\u0648\u0631\u062a \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc\u200c\u0634\u062f\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0633\u0627\u06cc\u062a \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f \u0648 \u062f\u06cc\u06af\u0631 \u0647\u0631\u06af\u0632 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f."
            ],
            "Send form submissions and button clicks to your analytics with no code. Leave an ID empty to skip that service. Buttons get a \"Conversion event\" field in their Advanced panel. With the cookie banner on, nothing loads until the visitor agrees.": [
                "\u0627\u0631\u0633\u0627\u0644 \u0641\u0631\u0645\u200c\u0647\u0627 \u0648 \u06a9\u0644\u06cc\u06a9 \u0631\u0648\u06cc \u062f\u06a9\u0645\u0647\u200c\u0647\u0627 \u0628\u0647 \u0628\u062e\u0634 \u062a\u062d\u0644\u06cc\u0644 \u0648\u0628\u200c\u0633\u0627\u06cc\u062a \u0628\u062f\u0648\u0646 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u06a9\u062f\u0646\u0648\u06cc\u0633\u06cc. \u0628\u0631\u0627\u06cc \u0631\u062f \u06a9\u0631\u062f\u0646 \u06cc\u06a9 \u0633\u0631\u0648\u06cc\u0633\u060c \u0634\u0646\u0627\u0633\u0647 \u0645\u0631\u0628\u0648\u0637\u0647 \u0631\u0627 \u062e\u0627\u0644\u06cc \u0628\u06af\u0630\u0627\u0631\u06cc\u062f. \u062f\u06a9\u0645\u0647\u200c\u0647\u0627 \u0641\u06cc\u0644\u062f\u06cc \u0628\u0647 \u0646\u0627\u0645 \u00ab\u0631\u0648\u06cc\u062f\u0627\u062f \u062a\u0628\u062f\u06cc\u0644\u00bb \u062f\u0631 \u067e\u0646\u0644 \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 \u062e\u0648\u062f \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u0628\u0627 \u0641\u0639\u0627\u0644 \u0628\u0648\u062f\u0646 \u0628\u0646\u0631 \u06a9\u0648\u06a9\u06cc\u060c \u0647\u06cc\u0686\u200c\u0686\u06cc\u0632 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u062f \u0645\u06af\u0631 \u0627\u06cc\u0646\u06a9\u0647 \u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0645\u0648\u0627\u0641\u0642\u062a \u06a9\u0646\u062f."
            ],
            "Google Analytics 4 measurement ID": [
                "\u0634\u0646\u0627\u0633 \u0627\u0646\u062f\u0627\u0632\u0647 \u06af\u06cc\u0631\u06cc Google Analytics 4"
            ],
            "Google Tag Manager container ID": [
                "\u0634\u0646\u0627\u0633\u0647 \u06a9\u0627\u0646\u062a\u06cc\u0646\u0631 Google Tag Manager"
            ],
            "Meta Pixel ID (the number shown in Meta Events Manager)": [
                "\u0634\u0646\u0627\u0633\u0647 \u0645\u062a\u0627 \u067e\u06cc\u06a9\u0633\u0644 (\u0634\u0645\u0627\u0631\u0647\u200c\u0627\u06cc \u06a9\u0647 \u062f\u0631 \u0645\u062f\u06cc\u0631 \u0631\u0648\u06cc\u062f\u0627\u062f\u0647\u0627\u06cc \u0645\u062a\u0627 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f)"
            ],
            "Load these tags on my site": [
                "\u0627\u06cc\u0646 \u062a\u06af\u200c\u0647\u0627 \u0631\u0627 \u0631\u0648\u06cc \u0633\u0627\u06cc\u062a \u0645\u0646 \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u06a9\u0646"
            ],
            "Switch off if your theme or another plugin already adds them; events are still sent.": [
                "\u0627\u06af\u0631 \u0642\u0627\u0644\u0628 \u0634\u0645\u0627 \u06cc\u0627 \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0627\u06cc \u062f\u06cc\u06af\u0631 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0627\u0636\u0627\u0641\u0647 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a\u060c \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0631\u0627 \u062e\u0627\u0645\u0648\u0634 \u06a9\u0646\u06cc\u062f\u061b \u0631\u0648\u06cc\u062f\u0627\u062f\u0647\u0627 \u0647\u0645\u0686\u0646\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f."
            ],
            "Event name for form submissions": [
                "\u0646\u0627\u0645 \u0631\u0648\u06cc\u062f\u0627\u062f \u0628\u0631\u0627\u06cc \u0627\u0631\u0633\u0627\u0644\u200c\u0647\u0627\u06cc \u0641\u0631\u0645"
            ],
            "The banner is a popup you design with blocks. Its buttons link to #consent-accept, #consent-reject and #consent-save (with tick boxes named analytics and marketing for \"save\"); a link to #consent-open anywhere shows it again. Until a visitor accepts, tracking tags do not load, Google Consent Mode stays \"denied\", and the scripts you list stay switched off.": [
                "\u0627\u06cc\u0646 \u0628\u0646\u0631 \u06cc\u06a9 \u067e\u0627\u067e\u200c\u0622\u067e \u0627\u0633\u062a \u06a9\u0647 \u0622\u0646 \u0631\u0627 \u0628\u0627 \u0628\u0644\u0648\u06a9\u200c\u0647\u0627 \u0637\u0631\u0627\u062d\u06cc \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f. \u062f\u06a9\u0645\u0647\u200c\u0647\u0627\u06cc \u0622\u0646 \u0628\u0647 #consent-accept\u060c #consent-reject \u0648 #consent-save \u0644\u06cc\u0646\u06a9 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f (\u0628\u0627 \u0686\u06a9\u200c\u0628\u0627\u06a9\u0633\u200c\u0647\u0627\u06cc\u06cc \u0628\u0647 \u0646\u0627\u0645\u200c\u0647\u0627\u06cc analytics \u0648 marketing \u0628\u0631\u0627\u06cc \u0630\u062e\u06cc\u0631\u0647)\u061b \u0644\u06cc\u0646\u06a9\u06cc \u0628\u0647 #consent-open \u062f\u0631 \u0647\u0631 \u0646\u0642\u0637\u0647\u200c\u0627\u06cc \u0622\u0646 \u0631\u0627 \u062f\u0648\u0628\u0627\u0631\u0647 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f. \u062a\u0627 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0646\u067e\u0630\u06cc\u0631\u062f\u060c \u062a\u06af\u200c\u0647\u0627\u06cc \u0631\u062f\u06cc\u0627\u0628\u06cc \u0628\u0627\u0631\u06af\u06cc\u0631\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u060c \u062d\u0627\u0644\u062a \u0631\u0636\u0627\u06cc\u062a Google \u0628\u0647 \u0635\u0648\u0631\u062a \"denied\" \u0628\u0627\u0642\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u062f \u0648 \u0627\u0633\u06a9\u0631\u06cc\u067e\u062a\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0641\u0647\u0631\u0633\u062a \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f \u062e\u0627\u0645\u0648\u0634 \u0645\u06cc\u200c\u0645\u0627\u0646\u0646\u062f."
            ],
            "Create a ready-made banner": [
                "\u0627\u06cc\u062c\u0627\u062f \u06cc\u06a9 \u0628\u0646\u0631 \u0622\u0645\u0627\u062f\u0647"
            ],
            "Show a cookie banner": [
                "\u0646\u0645\u0627\u06cc\u0634 \u0628\u0646\u0631 \u06a9\u0648\u06a9\u06cc"
            ],
            "Banner": [
                "\u0628\u0646\u0631"
            ],
            "Choose a popup\u2026": [
                "\u06cc\u06a9 \u067e\u0646\u062c\u0631\u0647 \u0628\u0627\u0632\u0634\u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f..."
            ],
            "%s (draft)": [
                "%s (\u067e\u06cc\u0634\u200c\u0646\u0648\u06cc\u0633)"
            ],
            "Edit the banner": [
                "\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0628\u0646\u0631"
            ],
            "Remember the choice for (days)": [
                "\u0627\u0646\u062a\u062e\u0627\u0628 \u0631\u0627 \u0628\u0631\u0627\u06cc (\u0631\u0648\u0632) \u0628\u0647 \u062e\u0627\u0637\u0631 \u0628\u0633\u067e\u0627\u0631"
            ],
            "Outside the European Union, the EEA and the UK: load tracking until the visitor says no": [
                "\u062e\u0627\u0631\u062c \u0627\u0632 \u0627\u062a\u062d\u0627\u062f\u06cc\u0647 \u0627\u0631\u0648\u067e\u0627\u060c \u0645\u0646\u0637\u0642\u0647 \u0627\u0642\u062a\u0635\u0627\u062f\u06cc \u0627\u0631\u0648\u067e\u0627 \u0648 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627: \u0631\u062f\u06cc\u0627\u0628\u06cc \u0628\u0627\u0631\u06af\u0630\u0627\u0631\u06cc \u062a\u0627 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0628\u06af\u0648\u06cc\u062f \u0646\u0647"
            ],
            "Off: every visitor must agree first (the strictest rule, and the default). On: only when your host or CDN reports the visitor's country (for example Cloudflare's CF-IPCountry header) and it is outside the EU, EEA, UK and Switzerland. The banner is still shown, and an unknown country is treated as inside the EU.": [
                "\u062e\u0627\u0645\u0648\u0634: \u0647\u0631 \u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0628\u0627\u06cc\u062f \u0627\u0628\u062a\u062f\u0627 \u0645\u0648\u0627\u0641\u0642\u062a \u06a9\u0646\u062f (\u0633\u062e\u062a\u200c\u06af\u06cc\u0631\u0627\u0646\u0647\u200c\u062a\u0631\u06cc\u0646 \u0642\u0627\u0646\u0648\u0646 \u0648 \u062d\u0627\u0644\u062a \u067e\u06cc\u0634\u200c\u0641\u0631\u0636). \u0631\u0648\u0634\u0646: \u062a\u0646\u0647\u0627 \u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0645\u06cc\u0632\u0628\u0627\u0646 \u06cc\u0627 \u0634\u0628\u06a9\u0647 \u062a\u0648\u0632\u06cc\u0639 \u0645\u062d\u062a\u0648\u0627\u06cc (CDN) \u0634\u0645\u0627 \u06a9\u0634\u0648\u0631 \u0628\u0627\u0632\u062f\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0631\u0627 \u06af\u0632\u0627\u0631\u0634 \u06a9\u0646\u062f (\u0628\u0631\u0627\u06cc \u0645\u062b\u0627\u0644 \u0647\u062f\u0631 CF-IPCountry \u062f\u0631 Cloudflare) \u0648 \u0622\u0646 \u06a9\u0634\u0648\u0631 \u062e\u0627\u0631\u062c \u0627\u0632 EU\u060c EEA\u060c \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0648 \u0633\u0648\u0626\u06cc\u0633 \u0628\u0627\u0634\u062f. \u0628\u0646\u0631 \u0647\u0645\u0686\u0646\u0627\u0646 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u06a9\u0634\u0648\u0631 \u0646\u0627\u0634\u0646\u0627\u062e\u062a\u0647 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06a9\u0634\u0648\u0631\u06cc \u062f\u0627\u062e\u0644 EU \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f."
            ],
            "Other scripts to hold until consent (handle:analytics or handle:marketing, comma separated)": [
                "\u0633\u0627\u06cc\u0631 \u0627\u0633\u06a9\u0631\u06cc\u067e\u062a\u200c\u0647\u0627 \u0628\u0631\u0627\u06cc \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u062a\u0627 \u0632\u0645\u0627\u0646 \u0627\u062e\u0630 \u0631\u0636\u0627\u06cc\u062a (\u0634\u0646\u0627\u0633\u0647: analytics \u06cc\u0627 \u0634\u0646\u0627\u0633\u0647: marketing\u060c \u0628\u0627 \u06a9\u0627\u0645\u0627 \u062c\u062f\u0627 \u0634\u0648\u0646\u062f)"
            ],
            "Popups, slide-ins and bars": [
                "\u067e\u0627\u067e\u200c\u0622\u067e\u200c\u0647\u0627\u060c \u0627\u0633\u0644\u0627\u06cc\u062f\u0648\u0626\u06cc\u0646\u200c\u0647\u0627 \u0648 \u0646\u0648\u0627\u0631\u0647\u0627\u06cc \u0627\u0639\u0644\u0627\u0646"
            ],
            "A\/B test results": [
                "\u0646\u062a\u0627\u06cc\u062c \u0622\u0632\u0645\u0627\u06cc\u0634 A\/B"
            ],
            "Guides: forms, popups, motion, tracking, A\/B tests and the cookie banner": [
                "\u0631\u0627\u0647\u0646\u0645\u0627\u0647\u0627: \u0641\u0631\u0645\u200c\u0647\u0627\u060c \u067e\u0627\u067e\u200c\u0622\u067e\u200c\u0647\u0627\u060c \u062d\u0631\u06a9\u062a\u060c \u0631\u062f\u06cc\u0627\u0628\u06cc\u060c \u062a\u0633\u062a\u200c\u0647\u0627\u06cc A\/B \u0648 \u0628\u0646\u0631 \u06a9\u0648\u06a9\u06cc"
            ],
            "Mailing-list connections": [
                "\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0641\u0647\u0631\u0633\u062a \u067e\u0633\u062a\u06cc"
            ]
