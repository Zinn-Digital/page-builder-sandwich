    "domain": "messages",
    "locale_data": {
        "messages": {
            "": {
                "domain": "messages",
                "lang": "th",
                "plural-forms": "nplurals=1; plural=0;"
            },
            "Import and export": [
                "\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32\u0e41\u0e25\u0e30\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01"
            ],
            "Import": [
                "\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32"
            ],
            "%d new": [
                "\u0e43\u0e2b\u0e21\u0e48 %d \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23"
            ],
            "%d replaced": [
                "\u0e41\u0e17\u0e19\u0e17\u0e35\u0e48\u0e41\u0e25\u0e49\u0e27 %d \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23"
            ],
            "%d kept as they were": [
                "%d \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e16\u0e39\u0e01\u0e04\u0e07\u0e44\u0e27\u0e49\u0e15\u0e32\u0e21\u0e40\u0e14\u0e34\u0e21"
            ],
            "%d setting": [
                "%d \u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32"
            ],
            "Importing will give: %s.": [
                "\u0e01\u0e32\u0e23\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32\u0e08\u0e30\u0e43\u0e2b\u0e49: %s"
            ],
            "Imported: %s.": [
                "\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32\u0e41\u0e25\u0e49\u0e27: %s"
            ],
            "Exported %d item.": [
                "\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01\u0e41\u0e25\u0e49\u0e27 %d \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23"
            ],
            "That file could not be read as an export file.": [
                "\u0e44\u0e21\u0e48\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e2d\u0e48\u0e32\u0e19\u0e44\u0e1f\u0e25\u0e4c\u0e14\u0e31\u0e07\u0e01\u0e25\u0e48\u0e32\u0e27\u0e40\u0e1b\u0e47\u0e19\u0e44\u0e1f\u0e25\u0e4c\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01\u0e44\u0e14\u0e49"
            ],
            "Export": [
                "\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01"
            ],
            "Download your templates, patterns and site design as one file, to import on another site.": [
                "\u0e14\u0e32\u0e27\u0e19\u0e4c\u0e42\u0e2b\u0e25\u0e14\u0e40\u0e17\u0e21\u0e40\u0e1e\u0e25\u0e15 \u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a\u0e1a\u0e25\u0e47\u0e2d\u0e01 \u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e2d\u0e2d\u0e01\u0e41\u0e1a\u0e1a\u0e44\u0e0b\u0e15\u0e4c\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e1b\u0e47\u0e19\u0e44\u0e1f\u0e25\u0e4c\u0e40\u0e14\u0e35\u0e22\u0e27 \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32\u0e43\u0e19\u0e2d\u0e35\u0e01\u0e44\u0e0b\u0e15\u0e4c\u0e2b\u0e19\u0e36\u0e48\u0e07"
            ],
            "There are no templates or patterns to export yet.": [
                "\u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e21\u0e35\u0e40\u0e17\u0e21\u0e40\u0e1e\u0e25\u0e15\u0e2b\u0e23\u0e37\u0e2d\u0e41\u0e1e\u0e15\u0e40\u0e17\u0e34\u0e23\u0e4c\u0e19\u0e17\u0e35\u0e48\u0e08\u0e30\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01"
            ],
            "Include the settings": [
                "\u0e23\u0e27\u0e21\u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32"
            ],
            "Download the export file": [
                "\u0e14\u0e32\u0e27\u0e19\u0e4c\u0e42\u0e2b\u0e25\u0e14\u0e44\u0e1f\u0e25\u0e4c\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01"
            ],
            "Choose an export file": [
                "\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e44\u0e1f\u0e25\u0e4c\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01"
            ],
            "The file holds %1$d item from %2$s.": [
                "\u0e44\u0e1f\u0e25\u0e4c\u0e19\u0e35\u0e49\u0e21\u0e35 %1$d \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e08\u0e32\u0e01 %2$s"
            ],
            "When an item with the same name already exists here": [
                "\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e21\u0e35\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e14\u0e35\u0e22\u0e27\u0e01\u0e31\u0e19\u0e19\u0e35\u0e49\u0e2d\u0e22\u0e39\u0e48\u0e41\u0e25\u0e49\u0e27\u0e17\u0e35\u0e48\u0e19\u0e35\u0e48"
            ],
            "Keep the one on this site": [
                "\u0e40\u0e01\u0e47\u0e1a\u0e2d\u0e31\u0e19\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e44\u0e0b\u0e15\u0e4c\u0e19\u0e35\u0e49\u0e44\u0e27\u0e49"
            ],
            "Replace it with the imported one": [
                "\u0e41\u0e17\u0e19\u0e17\u0e35\u0e48\u0e14\u0e49\u0e27\u0e22\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e17\u0e35\u0e48\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32"
            ],
            "Import a copy beside it": [
                "\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32\u0e2a\u0e33\u0e40\u0e19\u0e32\u0e44\u0e27\u0e49\u0e02\u0e49\u0e32\u0e07\u0e46"
            ],
            "Apply the settings in the file": [
                "\u0e43\u0e0a\u0e49\u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e43\u0e19\u0e44\u0e1f\u0e25\u0e4c"
            ],
            "Copy the images into this site\u2019s media library": [
                "\u0e04\u0e31\u0e14\u0e25\u0e2d\u0e01\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e25\u0e07\u0e43\u0e19\u0e04\u0e25\u0e31\u0e07\u0e2a\u0e37\u0e48\u0e2d\u0e02\u0e2d\u0e07\u0e44\u0e0b\u0e15\u0e4c\u0e19\u0e35\u0e49"
            ],
            "Show what will happen": [
                "\u0e41\u0e2a\u0e14\u0e07\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e08\u0e30\u0e40\u0e01\u0e34\u0e14\u0e02\u0e36\u0e49\u0e19"
            ]
        }
    }
}
