            ],
            "Beta updates": [
                "\u092c\u0940\u091f\u093e \u0905\u092a\u0921\u0947\u091f"
            ],
            "This site receives beta versions as updates.": [
                "\u092f\u0939 \u0938\u093e\u0907\u091f \u0905\u092a\u0921\u0947\u091f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092c\u0940\u091f\u093e \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964"
