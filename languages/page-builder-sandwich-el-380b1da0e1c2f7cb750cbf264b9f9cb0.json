            ],
            "AI uses your own AI provider account. Connect one to start.": [
                "\u03a4\u03bf AI \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b5\u03af \u03c4\u03bf\u03bd \u03b4\u03b9\u03ba\u03cc \u03c3\u03b1\u03c2 \u03bb\u03bf\u03b3\u03b1\u03c1\u03b9\u03b1\u03c3\u03bc\u03cc \u03c0\u03b1\u03c1\u03cc\u03c7\u03bf\u03c5 AI. \u03a3\u03c5\u03bd\u03b4\u03ad\u03c3\u03c4\u03b5 \u03ad\u03bd\u03b1\u03bd \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03be\u03b5\u03ba\u03b9\u03bd\u03ae\u03c3\u03b5\u03c4\u03b5."
            ],
            "Set up AI": [
