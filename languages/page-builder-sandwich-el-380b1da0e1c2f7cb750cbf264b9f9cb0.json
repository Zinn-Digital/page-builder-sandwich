            "The AI request failed. Try again.": [
                "\u03a4\u03bf \u03b1\u03af\u03c4\u03b7\u03bc\u03b1 AI \u03b1\u03c0\u03ad\u03c4\u03c5\u03c7\u03b5. \u0394\u03bf\u03ba\u03b9\u03bc\u03ac\u03c3\u03c4\u03b5 \u03be\u03b1\u03bd\u03ac."
            ],
            "Page %d": [
