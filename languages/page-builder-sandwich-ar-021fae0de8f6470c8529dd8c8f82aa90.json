            "Only users who may add unfiltered HTML can change custom CSS.": [
                "\u0641\u0642\u0637 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0645\u0643\u0646\u0647\u0645 \u0625\u0636\u0627\u0641\u0629 \u0644\u063a\u0629 HTML \u063a\u064a\u0631 \u0627\u0644\u0645\u0635\u0641\u0627\u0629 \u064a\u0645\u0643\u0646\u0647\u0645 \u062a\u063a\u064a\u064a\u0631 CSS \u0627\u0644\u0645\u062e\u0635\u0635."
            ],
            "Some of this CSS will not be used: @import, expression(), javascript: URLs, \"<\" and unbalanced braces are removed for safety.": [
                "\u0644\u0646 \u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u0639\u0636 \u0623\u0643\u0648\u0627\u062f CSS \u0647\u0630\u0647: \u062a\u062a\u0645 \u0625\u0632\u0627\u0644\u0629 @import\u060c \u0648 expression()\u060c \u0648\u0639\u0646\u0627\u0648\u064a\u0646 URLs \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0640 javascript:\u060c \u0648\u0639\u0644\u0627\u0645\u0629 \"<\" \u0648\u0627\u0644\u0623\u0642\u0648\u0627\u0633 \u063a\u064a\u0631 \u0627\u0644\u0645\u062a\u0648\u0627\u0632\u0646\u0629 \u0644\u0623\u0633\u0628\u0627\u0628 \u062a\u062a\u0639\u0644\u0642 \u0628\u0627\u0644\u0633\u0644\u0627\u0645\u0629."
            ],
            "Page CSS": [
                "CSS \u0627\u0644\u0635\u0641\u062d\u0629"
            ],
            "Global classes": [
