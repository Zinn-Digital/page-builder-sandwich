            "Network settings saved.": [
                "\u062f \u0634\u0628\u06a9\u06d0 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u0644."
            ],
            "These settings apply to the %d site in this network.": [
                "\u062f\u0627 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u067e\u0647 \u062f\u06d0 \u0634\u0628\u06a9\u0647 \u06a9\u06d0 \u067e\u0647 %d \u0633\u0627\u06cc\u067c \u062a\u0637\u0628\u06cc\u0642 \u06a9\u06cc\u0696\u064a.",
                "\u062f\u0627 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u067e\u0647 \u062f\u06d0 \u0634\u0628\u06a9\u0647 \u06a9\u06d0 \u067e\u0631 %d \u0633\u0627\u06cc\u067c\u0648\u0646\u0648 \u062a\u0637\u0628\u06cc\u0642 \u06a9\u06d0\u0696\u064a\u06d4"
            ],
            "Shared templates": [
                "\u06ab\u0689 \u06a9\u064a\u0646\u0689\u06cd"
            ],
            "Patterns saved on the main site that are ticked here appear on every site, under \u201cNetwork templates\u201d. Each site inserts its own copy.": [
                "\u067e\u0647 \u0627\u0635\u0644\u064a \u0633\u0627\u06cc\u067c \u06a9\u06d0 \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u064a \u0646\u0645\u0648\u0646\u06d0 \u0686\u06d0 \u062f\u0644\u062a\u0647 \u067c\u06cc\u06a9 \u0634\u0648\u06d0 \u0648\u064a\u060c \u067e\u0647 \u0647\u0631 \u0633\u0627\u06cc\u067c \u06a9\u06d0 \u062f \"\u0634\u0628\u06a9\u06d0 \u06a9\u064a\u0646\u0689\u06cc\u0648\" \u0644\u0627\u0646\u062f\u06d0 \u069a\u06a9\u0627\u0631\u064a. \u0647\u0631 \u0633\u0627\u06cc\u067c \u062e\u067e\u0644\u0647 \u06a9\u0627\u067e\u064a \u062f\u0627\u062e\u0644\u0648\u064a."
            ],
            "The main site has no saved patterns yet.": [
                "\u0627\u0635\u0644\u064a \u0633\u0627\u06cc\u067c \u0644\u0627 \u062a\u0631 \u0627\u0648\u0633\u0647 \u0647\u06d0\u0685 \u062e\u0648\u0646\u062f\u064a \u0634\u0648\u064a \u0628\u06d0\u0644\u06ab\u06d0 \u0646\u0647 \u0644\u0631\u064a."
            ],
            "White label for every site": [
                "\u062f \u0647\u0631\u06d0 \u0633\u0627\u06cc\u067c \u0644\u067e\u0627\u0631\u0647 \u0633\u067e\u06cc\u0646 \u0644\u06cc\u0628\u0644"
            ],
            "Used by every site that has not saved its own white-label settings.": [
                "\u062f \u0647\u063a\u0648 \u067c\u0648\u0644\u0648 \u0633\u0627\u06cc\u067c\u0648\u0646\u0648 \u0644\u062e\u0648\u0627 \u06a9\u0627\u0631\u0648\u0644 \u06a9\u06cc\u0696\u064a \u0686\u06d0 \u062e\u067e\u0644 \u0633\u067e\u06cc\u0646 \u0644\u06cc\u0628\u0644 (white-\u0644\u0647\u0628\u0644) \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u06cc\u06d0 \u0646\u0647 \u062f\u064a \u062e\u0648\u0646\u062f\u064a \u06a9\u0693\u064a."
            ],
            "Turn white label on": [
                "\u0633\u067e\u064a\u0646 \u0644\u064a\u0628\u0644 \u0641\u0639\u0627\u0644 \u06a9\u0693\u0626"
            ],
            "Builder name": [
