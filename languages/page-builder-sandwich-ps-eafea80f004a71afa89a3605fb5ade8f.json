            ],
            "Role settings saved.": [
                "\u062f \u0631\u0648\u0644 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0648\u0698\u063a\u0648\u0631\u0644 \u0634\u0648\u06d0."
            ],
            "Roles and client mode": [
                "\u0631\u0648\u0644\u0648\u0646\u0647 \u0627\u0648 \u062f \u067e\u06d0\u0631\u0648\u062f\u0648\u0646\u06a9\u064a \u062d\u0627\u0644\u062a"
            ],
            "Choose what each role can do in the builder. Administrators can always do everything. Client mode locks the layout and design, so the role can only change text and images.": [
                "\u067e\u0647 \u062c\u0648\u0693\u0648\u0646\u06a9\u06cc \u06a9\u06d0 \u0648\u067c\u0627\u06a9\u0626 \u0686\u06d0 \u0647\u0631 \u0631\u0648\u0644 \u0685\u0647 \u06a9\u0648\u0644\u06cc \u0634\u064a. \u0645\u062f\u06cc\u0631\u0627\u0646 \u062a\u0644 \u0647\u0631 \u0685\u0647 \u06a9\u0648\u0644\u06cc \u0634\u064a. \u062f \u067e\u06cc\u0631\u0648\u062f\u0648\u0646\u06a9\u064a \u062d\u0627\u0644\u062a \u0628\u06bc\u0647 \u0627\u0648 \u0689\u06cc\u0632\u0627\u06cc\u0646 \u062a\u0627\u0644\u0627 \u06a9\u0648\u064a\u060c \u0646\u0648 \u0631\u0648\u0644 \u06cc\u0648\u0627\u0632\u06d0 \u0645\u062a\u0646 \u0627\u0648 \u0627\u0646\u0681\u0648\u0631\u0648\u0646\u0647 \u0628\u062f\u0644\u0648\u0644\u06cc \u0634\u064a."
            ],
            "Role": [
                "\u0631\u0648\u0644"
            ],
            "Save role settings": [
                "\u062f \u0631\u0648\u0644 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0693\u0626"
            ]
        }
    }
