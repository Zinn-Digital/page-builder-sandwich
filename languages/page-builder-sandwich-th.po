msgstr "รีเฟรชรายการโมเดลจากผู้ให้บริการ"

#: includes/ai-core/class-admin.php:344
msgid "best quality"
msgstr "คุณภาพดีที่สุด"

#: includes/ai-core/class-admin.php:346
msgid "lowest cost"
msgstr "ต้นทุนต่ำที่สุด"

#: includes/ai-core/class-admin.php:348
