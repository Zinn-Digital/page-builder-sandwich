            ],
            "Add a section": [
                "\u0418\u043b\u043e\u0432\u0430 \u043a\u0430\u0440\u0434\u0430\u043d\u0438 \u0431\u0430\u0445\u0448"
            ],
            "Describe the section": [
                "\u049a\u0438\u0441\u043c\u0440\u043e \u0448\u0430\u0440\u04b3 \u0434\u0438\u04b3\u0435\u0434"
            ],
            "For example: \"pricing with three plans for a dog-walking service\". It is built from the section library in your brand style.": [
                "\u0411\u0430\u0440\u043e\u0438 \u043d\u0430\u043c\u0443\u043d\u0430: \u00ab\u043d\u0430\u0440\u0445\u0433\u0443\u0437\u043e\u0440\u04e3 \u0431\u043e \u0441\u0435 \u043d\u0430\u049b\u0448\u0430 \u0431\u0430\u0440\u043e\u0438 \u0445\u0438\u0434\u043c\u0430\u0442\u0438 \u0441\u0430\u0439\u0440\u0443\u0433\u0430\u0448\u0442\u0438 \u0441\u0430\u0433\u04b3\u043e\u00bb. \u041e\u043d \u0430\u0437 \u043a\u0438\u0442\u043e\u0431\u0445\u043e\u043d\u0430\u0438 \u0431\u0430\u0445\u0448\u04b3\u043e \u0431\u043e \u0441\u0430\u0431\u043a\u0438 \u0431\u0440\u0435\u043d\u0434\u0438 \u0448\u0443\u043c\u043e \u0441\u043e\u0445\u0442\u0430 \u0448\u0443\u0434\u0430\u0430\u0441\u0442."
            ],
            "Generate section": [
                "\u042d\u04b7\u043e\u0434\u0438 \u0431\u0430\u0445\u0448"
            ],
            "SEO and alt text": [
