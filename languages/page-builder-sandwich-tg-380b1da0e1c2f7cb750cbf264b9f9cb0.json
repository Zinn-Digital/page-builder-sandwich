            ],
            "For example: \"make the hero shorter and friendlier\", \"add an FAQ about delivery after the pricing\", \"translate this section into Spanish\". Select a block first to point at it.": [
                "\u0411\u0430\u0440\u043e\u0438 \u043c\u0438\u0441\u043e\u043b: \"\u0431\u0430\u0445\u0448\u0438 \u0430\u0441\u043e\u0441\u0438\u0440\u043e \u043a\u04ef\u0442\u043e\u04b3\u0442\u0430\u0440 \u0432\u0430 \u0441\u0430\u043c\u0438\u043c\u04e3 \u043a\u0443\u043d\u0435\u0434\", \"\u043f\u0430\u0441 \u0430\u0437 \u043d\u0430\u0440\u0445\u043d\u043e\u043c\u0430 \u0441\u0430\u0432\u043e\u043b\u0443 \u04b7\u0430\u0432\u043e\u0431\u04b3\u043e\u0438 \u043c\u0430\u044a\u043c\u0443\u043b\u0440\u043e \u0434\u0430\u0440 \u0431\u043e\u0440\u0430\u0438 \u0440\u0430\u0441\u043e\u043d\u0438\u0434\u0430\u043d \u0438\u043b\u043e\u0432\u0430 \u043a\u0443\u043d\u0435\u0434\", \"\u0438\u043d \u0431\u0430\u0445\u0448\u0440\u043e \u0431\u0430 \u0437\u0430\u0431\u043e\u043d\u0438 \u0438\u0441\u043f\u0430\u043d\u04e3 \u0442\u0430\u0440\u04b7\u0443\u043c\u0430 \u043a\u0443\u043d\u0435\u0434\". \u0410\u0432\u0432\u0430\u043b \u0431\u0430\u0440\u043e\u0438 \u0438\u0448\u043e\u0440\u0430 \u043a\u0430\u0440\u0434\u0430\u043d \u0431\u0430 \u0431\u043b\u043e\u043a \u043e\u043d\u0440\u043e \u0438\u043d\u0442\u0438\u0445\u043e\u0431 \u043a\u0443\u043d\u0435\u0434."
            ],
            "Ask": [
                "\u041f\u0443\u0440\u0441\u0438\u0434\u0430\u043d"
            ],
            "Build a website": [
                "\u0421\u043e\u0445\u0442\u0430\u043d\u0438 \u0441\u043e\u043c\u043e\u043d\u0430"
            ],
            "Describe the business": [
                "\u0422\u0438\u04b7\u043e\u0440\u0430\u0442\u0440\u043e \u0442\u0430\u0432\u0441\u0438\u0444 \u043a\u0443\u043d\u0435\u0434"
            ],
            "Plan the pages": [
                "\u0421\u0430\u04b3\u0438\u0444\u0430\u04b3\u043e\u0440\u043e \u0431\u0430 \u043d\u0430\u049b\u0448\u0430 \u0433\u0438\u0440\u0435\u0434"
            ],
            "Build these pages as drafts": [
                "\u0418\u043d \u0441\u0430\u04b3\u0438\u0444\u0430\u04b3\u043e\u0440\u043e \u04b3\u0430\u043c\u0447\u0443\u043d \u0441\u0438\u0451\u04b3\u043d\u0430\u0432\u0438\u0441 \u0441\u043e\u0437\u0435\u0434"
            ],
            "Create with AI": [
                "\u0411\u043e \u0451\u0440\u0438\u0438 AI \u0441\u043e\u0445\u0442\u0430\u043d"
            ],
            "A custom block": [
                "\u0411\u043b\u043e\u043a\u0438 \u0444\u0430\u0440\u043c\u043e\u0438\u0448\u04e3"
            ],
            "Describe a component (\"a team member card with photo, name, role and a short bio\"). It is saved to My patterns, with its texts editable on every page that uses it.": [
                "\u049a\u0438\u0441\u043c\u0430\u0442\u0435\u0440\u043e \u0442\u0430\u0432\u0441\u0438\u0444 \u043a\u0443\u043d\u0435\u0434 (\u00ab\u043a\u043e\u0440\u0442\u0438 \u0443\u0437\u0432\u0438 \u0434\u0430\u0441\u0442\u0430 \u0431\u043e \u0430\u043a\u0441, \u043d\u043e\u043c, \u043d\u0430\u049b\u0448 \u0432\u0430 \u0448\u0430\u0440\u04b3\u0438 \u04b3\u043e\u043b\u0438 \u043a\u04ef\u0442\u043e\u04b3\u00bb). \u041e\u043d \u0434\u0430\u0440 \u00ab\u041d\u0430\u043c\u0443\u043d\u0430\u04b3\u043e\u0438 \u043c\u0430\u043d\u00bb \u0437\u0430\u0445\u0438\u0440\u0430 \u043c\u0435\u0448\u0430\u0432\u0430\u0434 \u0432\u0430 \u043c\u0430\u0442\u043d\u04b3\u043e\u0438 \u043e\u043d\u0440\u043e \u0434\u0430\u0440 \u04b3\u0430\u0440 \u0441\u0430\u04b3\u0438\u0444\u0430\u0435, \u043a\u0438 \u0438\u0441\u0442\u0438\u0444\u043e\u0434\u0430 \u043c\u0435\u0431\u0430\u0440\u0430\u0434, \u0442\u0430\u04b3\u0440\u0438\u0440 \u043a\u0430\u0440\u0434\u0430\u043d \u043c\u0443\u043c\u043a\u0438\u043d \u0430\u0441\u0442."
            ],
            "Block created and added to the page.": [
                "\u0411\u043b\u043e\u043a \u0441\u043e\u0445\u0442\u0430 \u0448\u0443\u0434 \u0432\u0430 \u0431\u0430 \u0441\u0430\u04b3\u0438\u0444\u0430 \u0438\u043b\u043e\u0432\u0430 \u0433\u0430\u0440\u0434\u0438\u0434."
