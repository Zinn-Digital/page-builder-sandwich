            "AI uses your own AI provider account. Connect one to start.": [
                "AI \u04b3\u0438\u0441\u043e\u0431\u0438 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u0438 AI-\u0438 \u0445\u0443\u0434\u0438 \u0448\u0443\u043c\u043e\u0440\u043e \u0438\u0441\u0442\u0438\u0444\u043e\u0434\u0430 \u043c\u0435\u0431\u0430\u0440\u0430\u0434. \u0411\u0430\u0440\u043e\u0438 \u043e\u0493\u043e\u0437 \u043a\u0430\u0440\u0434\u0430\u043d, \u044f\u043a\u0435\u0440\u043e \u043f\u0430\u0439\u0432\u0430\u0441\u0442 \u043a\u0443\u043d\u0435\u0434."
            ],
            "Set up AI": [
