            "Edit the block": [
                "\u0411\u043b\u043e\u043a\u0440\u043e \u0432\u0438\u0440\u043e\u0438\u0448 \u043a\u0443\u043d\u0435\u0434"
            ],
            "Create block": [
                "\u042d\u04b7\u043e\u0434\u0438 \u0431\u043b\u043e\u043a"
            ],
            "Design a page from a screenshot or a website address: AI recreates its layout as editable blocks in a new draft.": [
