            "Your theme\u2019s palette. A change here is saved as your site\u2019s version of the colour, the same way the Site Editor saves it, and applies everywhere the colour is used.": [
                "\u067e\u0627\u0644\u062a \u067e\u0648\u0633\u062a\u0647\u0654 \u0634\u0645\u0627. \u0647\u0631 \u062a\u063a\u06cc\u06cc\u0631\u06cc \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0646\u0633\u062e\u0647\u0654 \u0631\u0646\u06af \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0633\u0627\u06cc\u062a \u0634\u0645\u0627 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \u062f\u0631\u0633\u062a \u0645\u0627\u0646\u0646\u062f \u0634\u06cc\u0648\u0647\u200c\u0627\u06cc \u06a9\u0647 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 \u0633\u0627\u06cc\u062a \u0622\u0646 \u0631\u0627 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0648 \u062f\u0631 \u0647\u0631 \u06a9\u062c\u0627\u06cc\u06cc \u06a9\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0631\u0646\u06af \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f \u0627\u0639\u0645\u0627\u0644 \u0645\u06cc\u200c\u06af\u0631\u062f\u062f."
            ],
            "Theme colours are back to the theme\u2019s own values.": [
                "\u0631\u0646\u06af\u200c\u0647\u0627\u06cc \u067e\u0648\u0633\u062a\u0647 \u0628\u0647 \u0645\u0642\u0627\u062f\u06cc\u0631 \u0627\u0635\u0644\u06cc \u067e\u0648\u0633\u062a\u0647 \u0628\u0627\u0632\u06af\u0634\u062a\u0646\u062f."
